//
// The checks call the shipped std.detmath surface through `import std.detmath;`
// (cross-module f64 signatures, roadmap 17.1, landed in 0.10.3), so a change to
// std/detmath.mind is what this KAT measures. Earlier copies of the kernels in
// this file had drifted from std. sqrt is checked through `det_sqrt`, the std
// wrapper that returns a pinned quiet NaN out of domain.
//
// This driver is ALSO the runnable KAT gate that the `[test]` interpreter cannot
// provide: that interpreter mis-evaluates an f64 branch condition (it takes the
// then-branch unconditionally), so every guarded function would return its input
// and an interpreted check would pass vacuously. The native backend evaluates the
// f64 branches correctly, so the gate is build-and-run: exit code 0 == every KAT
// passed, and stdout is the number of passed checks (44).

import std.detmath;

// Absolute value without a libm call (KAT harness only).
fn kat_absf(x: f64) -> f64 {
    if x < 0.0 {
        return 0.0 - x;
    }
    return x;
}

// +inf by a deterministic IEEE overflow (KAT harness only).
fn kat_inf() -> f64 {
    let mut v: f64 = 1.0;
    let mut i: i64 = 0;
    while i < 350 {
        v = v * 10.0;
        i = i + 1;
    }
    return v;
}

// ===========================================================================
// Value-oracle KAT harness.
//
// Each reference value was cross-checked once against an independent oracle
// (CPython `math`) and then pinned below.  `chk_ulp` returns 1 on pass (result
// within `ulps` of the reference), 0 on fail; `chk_abs` uses an absolute band
// for references at or near zero (band 0.0 asserts exact bit-equality).
//
// main() returns the number of FAILED checks: exit code 0 == every KAT passed.
// The final block is adversarial — a deliberately wrong reference MUST be
// rejected, so a spurious acceptance there is counted as a failure, proving the
// bands discriminate rather than passing vacuously.
// ===========================================================================

fn chk_ulp(got: f64, want: f64, ulps: f64) -> i64 {
    let eps: f64 = 0.0000000000000002220446049250313;
    let tol: f64 = ulps * eps * kat_absf(want);
    if kat_absf(got - want) <= tol {
        return 1;
    }
    return 0;
}

fn chk_abs(got: f64, want: f64, abstol: f64) -> i64 {
    if kat_absf(got - want) <= abstol {
        return 1;
    }
    return 0;
}

fn is_nan(x: f64) -> i64 {
    if x != x {
        return 1;
    }
    return 0;
}

fn is_pos_inf(x: f64) -> i64 {
    if x >= kat_inf() {
        return 1;
    }
    return 0;
}

fn is_neg_inf(x: f64) -> i64 {
    if x <= 0.0 - kat_inf() {
        return 1;
    }
    return 0;
}

// A NaN for edge tests, synthesised only here (never in the shipped surface):
// inf - inf is NaN by IEEE, produced without a byte-identity-sensitive divide.
fn a_nan() -> f64 {
    let bignum: f64 = kat_inf();
    return bignum - bignum;
}

pub fn main() -> i64 {
    let mut fails: i64 = 0;
    let mut ran: i64 = 0;

    // --- exp: <= 1 ulp on the certified range ---
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(exp(1.0), 2.718281828459045, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(exp(0.0), 1.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(exp(0.0 - 1.0), 0.36787944117144233, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(exp(2.0), 7.38905609893065, 2.0));
    ran = ran + 1;
    fails = fails + (1 - is_pos_inf(exp(710.0)));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(exp(0.0 - 800.0), 0.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - is_nan(exp(a_nan())));

    // --- log: <= 1 ulp on the certified range ---
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(log(2.718281828459045), 1.0, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(log(2.0), 0.6931471805599453, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(log(10.0), 2.302585092994046, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(log(1.0), 0.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(log(0.0 - 1.0), 0.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - is_neg_inf(log(0.0)));
    ran = ran + 1;
    fails = fails + (1 - is_nan(log(a_nan())));

    // --- sqrt: IEEE correctly-rounded intrinsic (roadmap 17.5), 0 ulp on the
    //     valid domain; out-of-domain sqrt(neg) is a NaN (verified via is_nan) ---
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(det_sqrt(2.0), 1.4142135623730951, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(det_sqrt(4.0), 2.0, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(det_sqrt(0.00000001), 0.0001, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(det_sqrt(100000000.0), 10000.0, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(det_sqrt(0.5), 0.7071067811865476, 2.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(det_sqrt(0.0), 0.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - is_nan(det_sqrt(0.0 - 4.0)));

    // --- pow: exact on the integer path, <= 4 ulp otherwise ---
    ran = ran + 1;
    fails = fails + (1 - chk_abs(pow(2.0, 10.0), 1024.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(pow(10.0, 3.0), 1000.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(pow(2.0, 0.5), 1.4142135623730951, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(pow(9.0, 0.5), 3.0, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(pow(2.0, 0.0 - 1.0), 0.5, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(pow(5.0, 0.0), 1.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(pow(0.0 - 2.0, 3.0), 0.0 - 8.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(pow(0.0 - 2.0, 0.5), 0.0, 0.0));

    // --- sin / cos: <= 2 ulp for |x| <= 2^20 ---
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(sin(0.5235987755982988), 0.49999999999999994, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(sin(0.0), 0.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(sin(1.5707963267948966), 1.0, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(sin(1.0), 0.8414709848078965, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(sin(0.0 - 1.0), 0.0 - 0.8414709848078965, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(sin(100.0), 0.0 - 0.5063656411097588, 8.0));
    ran = ran + 1;
    fails = fails + (1 - chk_abs(cos(0.0), 1.0, 0.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(cos(1.0471975511965976), 0.5000000000000001, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(cos(3.141592653589793), 0.0 - 1.0, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(cos(1.0), 0.5403023058681398, 4.0));
    ran = ran + 1;
    fails = fails + (1 - chk_ulp(cos(100.0), 0.8623188722876839, 8.0));
    // cos(pi/2): true value ~6.12e-17. detmath's cos carries ~1e-16 absolute
    // error at its zero from the 2-step Cody-Waite pi/2 reduction (documented
    // <=2 ulp is relative; near a zero the honest contract is absolute). The
    // near-zero band is 1e-15 — still 10^15x tighter than any research use of
    // cos needs (it feeds Newton-refined quadrature-node guesses). Not a bug.
    ran = ran + 1;
    fails = fails + (1 - chk_abs(cos(1.5707963267948966), 0.0, 0.000000000000001));

    // --- adversarial: bands MUST reject wrong values (spurious accept = fail) ---
    ran = ran + 1;
    fails = fails + chk_ulp(exp(1.0), 2.719281828459045, 2.0);
    ran = ran + 1;
    fails = fails + chk_ulp(det_sqrt(2.0), 1.415213562373095, 2.0);
    ran = ran + 1;
    fails = fails + chk_ulp(sin(0.5235987755982988), 0.51, 4.0);

    print(ran - fails);
    return fails;
}
