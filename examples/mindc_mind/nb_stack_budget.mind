//
// Stack budget of the RUNNING native compiler (census X1 capacity): the
// constants of nb_stack_short and nb_stack_tok_cap in main.mind.
//
// The native backend has no tail calls, so a recursive walk holds one native
// frame per element. The front end walked the whole token stream that way
// (const_find_from: one 512 B frame per token, from token 0, on every
// program), and the budget was 640 B per token plus 16 MiB. The walks over
// the token stream, the statement-list parser, the brace skippers, the call
// patcher and the per-statement alias, field and struct-literal passes are
// loops now. What still recurses once per element is a list walk with a
// small frame (the largest: 375 B per empty block statement, 246 B per
// statement, 1105 B per function).
//
// Measured: stack high-water = stack top - the lowest non-zero word of the
// stack PT_LOAD at exit (zero-fill, never unmapped), bounded profile.
//   whole compiler            576535 tokens    3.5 MiB      6 B per token
//     (before: 575814 tokens, 281.2 MiB, 512 B per token)
//   +25% functions            700257 tokens    4.3 MiB      6 B per token
//   52-module std seed        656562 tokens    3.5 MiB      6 B per token
//   densest shapes, bytes per program token as the program grows:
//     `{ }` statements 187, `;` 126, `s;` 123, `fn h() -> i64 { 0 }` 123,
//     `s;` in an if or while body 112, flat lists of the capacity corpus 37.
//   costs that do not grow with the token count (their own caps refuse
//   more): 4000 chained lets 58.4 MiB.
// nb_stack_tok_bytes() = 320: the worst measured growth (187 B) with a 71%
// margin. nb_stack_base() = 64 MiB: above the worst fixed cost (58.4 MiB)
// before the per-token share is counted. Nesting depth has its own budget
// (nb_depth_short). A new recursive walk over a list must be a loop, or
// these constants must be measured again.
//
// The rule before (640 B per token and per longest-token unit, plus 16 MiB)
// stays an upper bound: the loops removed the frames per element. Each loop
// kept one driver frame per nesting level (measured: under 0.5% of the frames
// it replaced), which the margin of the rule before covers.
// nb_stack_short refuses only when both rules find the stack short, so every
// program admitted before is admitted now (a 500 KB identifier in a small
// program fits the rule before, not the 64 MiB base of this one).

// Stack bytes budgeted per program token.
pub fn nb_stack_tok_bytes() -> i64 {
    320
}
// Stack bytes budgeted per unit of the longest token (nb_tok_max_len): the
// walks over one token's bytes recurse once per byte. Not re-measured here:
// it keeps the value it had.
pub fn nb_stack_len_bytes() -> i64 {
    640
}
// Stack bytes budgeted for what does not grow with the token count.
pub fn nb_stack_base() -> i64 {
    67108864
}
// The rule before: bytes per token and per longest-token unit, and its base.
pub fn nb_stack_tok_bytes_v1() -> i64 {
    640
}
pub fn nb_stack_base_v1() -> i64 {
    16777216
}

// ---- Nesting units (nb_nest_units and nb_depth_short in main.mind) ----
// Measured peak stack on the bounded compiler (384 MiB stack): ~15.5 KiB per
// binary / unary / `as` operator level, <= 13 KiB per bracket level, <= 5.5 KiB
// per else-if arm, <= 4 KiB per nested block, ~39 KiB per if expression nested
// in a parenthesised condition. A 40000-term `1 + 1 + ...` chain, 40000 nested
// parentheses or calls and a 40000-deep unary minus or `as` chain each
// SIGSEGVed that compiler before the budget. The units (1 unit = 1.25 KiB of
// budget): 16 per operator, `as` and `(` / `[`, 8 per `else`, 4 per `{`, 2 per
// statement `if`, 24 per `if` inside an expression. `;`, `,` and a `}` that
// ends a statement reset the level's chain.
//
// A match arm is one more level: the parser desugars `match` to a right-nested
// if chain, so arm j sits j levels deep in the parser, the twin and the
// emitters. Measured (stack high-water at exit, bounded compiler, `k => k,`
// arms): 1024 arms 8.2 MiB, 4096 arms 32.7 MiB, 16384 arms 130.6 MiB = 7968 B
// per arm, where the token rule budgets 5 tokens x 320 B = 1600 B. A 65536-arm
// match passed both budgets and overflowed the stack (SIGSEGV). Each `=>` now
// adds nb_stack_arm_units() to the base of its brace level, so every later arm
// of the same match is charged one level deeper, and `,` does not reset it.

// Units a match arm adds to the base of its level: 8 (10 KiB for 7.8 KiB measured).
pub fn nb_stack_arm_units(prev: i64, k: i64) -> i64 {
    if k != 17 {
        return 0;
    }
    if prev != 11 {
        return 0;
    }
    8
}
