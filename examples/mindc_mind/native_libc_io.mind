    if fresh==0 { return __mind_load_i64(diag); }
    let n:i64=__mind_load_i64(fresh+8);
    let mut same:i64=0;
    if n==length { same=nio_same(bundle,fresh,n); }
    __mind_free(fresh);
    if same==0 { let _e:i64=nio_error(diag,4,0,0); return 4; }
    0
}
