pub fn nio_build(profile:i64,diag:i64)->i64 {
    let _clear:i64=nio_zero(diag,32);
    if profile!=1 { return nio_error(diag,2,0,0); }
    let source:String=nio_source();
    if string_len(source)==0 { return nio_error(diag,5,0,0); }
    let r:i64=nb_cabi_build(string_addr(source),string_len(source));
    if nio_registry_ok(r)==0 {
        let offset:i64=if r==0 { 0 } else { __mind_load_i64(r+40) };
        let error:i64=if r==0 { 0 } else { __mind_load_i64(r+32) };
        let _free:i64=nb_cabi_free(r);
        __mind_free(r);
        __mind_free(string_addr(source));
        return nio_error(diag,3,offset,error);
    }
    let wire:String=nb_cabi_encode(r);
    let code:String=nio_code();
    let out:i64=nio_bundle(r,source,wire,code,diag);
    let _free:i64=nb_cabi_free(r);
    __mind_free(r);
    __mind_free(string_addr(source));
    __mind_free(string_addr(wire));
    __mind_free(string_addr(code));
    out
}
pub fn nio_check(bundle:i64,length:i64,profile:i64,diag:i64)->i64 {
    let _clear:i64=nio_zero(diag,32);
    if length<192 { let _e:i64=nio_error(diag,1,0,0); return 1; }
    if length>16384 { let _e:i64=nio_error(diag,1,0,0); return 1; }
    if bundle<=0 { let _e:i64=nio_error(diag,1,0,0); return 1; }
    if bundle>9223372036854775807-length { let _e:i64=nio_error(diag,1,0,0); return 1; }
