// tc twin of the std-surface registry: tc_is_std_surface_intrinsic (moved out of
// main.mind) is the generated Rust/MLIR-selectable table; tc_shoc_eq moved with it
// (its only caller). Native-only (frozen_native_*) rows are never added here; E2024
// skips them through tcp_native_only (any-profile registration, as resolve.rs does).

// One packed-name equality: 1 iff (w0..w3,len) == (e0..e3,elen).
pub fn tc_shoc_eq(w0: i64, w1: i64, w2: i64, w3: i64, len: i64, e0: i64, e1: i64, e2: i64, e3: i64, elen: i64) -> i64 {
    if len != elen {
        return 0;
    }
    if w0 != e0 {
        return 0;
    }
    if w1 != e1 {
        return 0;
    }
    if w2 != e2 {
        return 0;
    }
    if w3 != e3 {
        return 0;
    }
    1
}

