pub fn vv_read(a: i64, n: i64) -> i64 {
    let mut done: i64 = 0;
    while done < n {
        let got: i64 = __mind_read(0, a + done, n - done, 0 - 1);
        if got <= 0 { return 0; }
        if got > n - done { return 0; }
        done = done + got;
    }
    1
}
pub fn vv_write(fd: i64, a: i64, n: i64) -> i64 {
