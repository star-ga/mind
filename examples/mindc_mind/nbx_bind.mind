// Import binding of the fixed-arity C ABI lane: the import ids of the dynamic
// image writer (nbx_imports, moved out of main.mind unchanged) and the pure
// steps of the seed-region binding (nbs_*).
// A part: it calls intrinsics and other parts only, never a main.mind fn.
//
// The binding rule (one rule; src/ir/native_lane_profile/seed.rs is its
// admission twin). The image binds every `extern "C"` declaration of the user
// region, as before. It binds a declaration of the std seed region only when a
// kept seed function calls that name. Each seed declaration of a called name
// must match its nbx_row; one that does not refuses the image. A seed
// declaration that no kept seed function calls is not read. An image that
// calls none keeps the table it had (or the static writer), byte for byte.
// The import order stays the first-call order of nbx_imports.
//
// stage1 holds the user boundary itself (the flat stdin protocol has no Rust
// admission). A call in the user region never binds a seed declaration
// (nbs_pick): it finds no row and the lowering refuses the image. A user
// function never calls a private seed function (nbs_private_fns): private std
// helpers do not cross the user boundary, and the image refuses.
//
// Registry words (nb_cabi): source, length, rows, count, error, error offset.
// The seed registry `all` keeps the token cursor of its last block in the
// error-offset word. Row words: name lo, name hi, then the declaration facts.

import nb_ast;
import nb_lastdef;

// Capability mark: SEED EXTERN V1. This compiler binds the seed-region
// declarations a kept seed function calls (the rule above). Compiled natively
// this body is `movabs rax, imm64` whose little-endian immediate spells
// "nbsext01"; the Rust bridge (src/build/native_bridge/seed.rs,
// SEED_EXTERN_MARK) admits a seed-body call of a seed declaration only for a
// compiler ELF that carries those bytes. Earlier seeds do not carry it.
pub fn nbs_cap_seed_extern_v1() -> i64 {
    3544460967187538542
}

// 1 when kept function `node` is a seed function (its name starts before the
// user region).
pub fn nbs_seed_fn(node: i64, user_lo: i64) -> i64 {
    if ast_span_lo(ast_child0(node)) < user_lo {
        return 1;
    }
    0
}

// 1 when the seed pass has no work: a single-file image (user_lo 0), a refused
// user table, or no kept seed function. The caller then keeps the user table.
pub fn nbs_off(user_lo: i64, ut: i64, fns: i64, n_fns: i64) -> i64 {
    if user_lo <= 0 {
        return 1;
    }
    if ut < 0 {
        return 1;
    }
    let mut seed: i64 = 0;
    let mut i: i64 = 0;
    while i < n_fns {
        seed = seed + nbs_seed_fn(__mind_load_i64(fns + i * 8), user_lo);
        i = i + 1;
    }
    if seed == 0 {
        return 1;
    }
    0
}

// 1 when function node `node` is public: its aux word is twice the parameter
// count plus the public bit.
pub fn nbs_fn_pub(node: i64) -> i64 {
    let a: i64 = ast_aux(node);
    a - (a / 2) * 2
}

// 1 when kept function `node` is a private seed function.
pub fn nbs_private_fn(node: i64, user_lo: i64) -> i64 {
    if nbs_seed_fn(node, user_lo) == 0 {
        return 0;
    }
    if nbs_fn_pub(node) == 1 {
        return 0;
    }
    1
}

// Append `node` to counted list `list` (word 0 the count, the nodes from word
// 1) when `keep` is 1.
pub fn nbs_list_put(list: i64, node: i64, keep: i64) -> i64 {
    if keep == 0 {
        return 0;
    }
    let n: i64 = __mind_load_i64(list);
    __mind_store_i64(list + 8 + n * 8, node);
    __mind_store_i64(list, n + 1);
    1
}

// The kept private seed functions, a counted list. A kept function is the last
// definition of its name, so a name the user region defines is not in it. The
// entries carry their name table, which the reach walk's lookup reads.
pub fn nbs_private_fns(src: i64, fns: i64, n_fns: i64, user_lo: i64) -> i64 {
    let list: i64 = nbs_zero(n_fns * 8 + 16);
    let mut i: i64 = 0;
    while i < n_fns {
        let _p: i64 = nbs_list_put(list, __mind_load_i64(fns + i * 8), nbs_private_fn(__mind_load_i64(fns + i * 8), user_lo));
        i = i + 1;
    }
    let _t: i64 = nb_last_def_attach(src, list + 8, __mind_load_i64(list));
    list
}

// The count of marks in reach[0..n).
pub fn nbs_any(reach: i64, n: i64) -> i64 {
    let mut m: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        m = m + __mind_load_i64(reach + i * 8);
        i = i + 1;
    }
    m
}

// `bytes` (a multiple of 8) of zeroed heap.
pub fn nbs_zero(bytes: i64) -> i64 {
    let p: i64 = __mind_alloc(bytes);
    let mut i: i64 = 0;
    while i < bytes {
        __mind_store_i64(p + i, 0);
        i = i + 8;
    }
    p
}

// An empty registry over src[0..end) with room for 4096 rows.
pub fn nbs_registry(src: i64, end: i64) -> i64 {
    let r: i64 = nbs_zero(48);
    __mind_store_i64(r, src);
    __mind_store_i64(r + 8, end);
    __mind_store_i64(r + 16, __mind_alloc(4096 * 8));
    r
}

// Append one row to registry `r`.
pub fn nbs_put(r: i64, row: i64) -> i64 {
    let n: i64 = __mind_load_i64(r + 24);
    __mind_store_i64(__mind_load_i64(r + 16) + n * 8, row);
    __mind_store_i64(r + 24, n + 1);
    0
}

// The rows of one parsed seed block `r` join `all`. A block with a registry
// error gives no row: a call of one of its names then finds no declaration and
// the image refuses. This is fail-closed by design. A declaration the registry
// cannot parse is a defect of the seed, and a refusal shows it. To bind the
// rows before the bad declaration only would hide it and make the bound set
// depend on declaration order. Rows past the registry capacity poison `all`.
pub fn nbs_take(all: i64, r: i64) -> i64 {
    if __mind_load_i64(r + 32) != 0 {
        return 0;
    }
    let n: i64 = __mind_load_i64(r + 24);
    if __mind_load_i64(all + 24) + n > 4096 {
        __mind_store_i64(all + 32, 10);
        return 0;
    }
    let mut i: i64 = 0;
    while i < n {
        let _p: i64 = nbs_put(all, __mind_load_i64(__mind_load_i64(r + 16) + i * 8));
        i = i + 1;
    }
    n
}

// A stand-in function node for one row: the reach walker (main.mind
// nb_reach_stmts) marks a call through the name span of child 0.
pub fn nbs_node(row: i64) -> i64 {
    let name: i64 = nbs_zero(56);
    __mind_store_i64(name + 8, __mind_load_i64(row));
    __mind_store_i64(name + 16, __mind_load_i64(row + 8));
    let f: i64 = nbs_zero(56);
    __mind_store_i64(f + 24, name);
    f
}

// One stand-in node for each row of `all`, in row order.
pub fn nbs_nodes(all: i64) -> i64 {
    let n: i64 = __mind_load_i64(all + 24);
    let xf: i64 = __mind_alloc(n * 8 + 8);
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i64(xf + i * 8, nbs_node(__mind_load_i64(__mind_load_i64(all + 16) + i * 8)));
        i = i + 1;
    }
    let _t: i64 = nb_last_def_attach(__mind_load_i64(all), xf, n);
    xf
}

pub fn nbs_byte_eq(a: i64, b: i64) -> i64 {
    if a == b {
        return 1;
    }
    0
}

// 1 when src[alo..ahi) and src[blo..bhi) hold the same bytes.
pub fn nbs_same(src: i64, alo: i64, ahi: i64, blo: i64, bhi: i64) -> i64 {
    if ahi - alo != bhi - blo {
        return 0;
    }
    let mut eq: i64 = 1;
    let mut i: i64 = 0;
    while i < ahi - alo {
        eq = eq * nbs_byte_eq(__mind_load_i8(src + alo + i), __mind_load_i8(src + blo + i));
        i = i + 1;
    }
    eq
}

// 1 when row i, or another row of the same name, is marked.
pub fn nbs_named_mark(all: i64, reach: i64, i: i64) -> i64 {
    let src: i64 = __mind_load_i64(all);
    let rows: i64 = __mind_load_i64(all + 16);
    let a: i64 = __mind_load_i64(rows + i * 8);
    let mut hit: i64 = 0;
    let mut j: i64 = 0;
    while j < __mind_load_i64(all + 24) {
        let b: i64 = __mind_load_i64(rows + j * 8);
        hit = hit + __mind_load_i64(reach + j * 8) * nbs_same(src, __mind_load_i64(a), __mind_load_i64(a + 8), __mind_load_i64(b), __mind_load_i64(b + 8));
        j = j + 1;
    }
    if hit > 0 {
        return 1;
    }
    0
}

// The walker marks the last declaration of a called name. Mark each
// declaration of that name: every one must match its nbx_row.
pub fn nbs_spread(all: i64, reach: i64) -> i64 {
    let mut i: i64 = 0;
    while i < __mind_load_i64(all + 24) {
        __mind_store_i64(reach + i * 8, nbs_named_mark(all, reach, i));
        i = i + 1;
    }
    0
}

// A copy of `row` with its name span moved by `shift` bytes.
pub fn nbs_row_copy(row: i64, shift: i64) -> i64 {
    let c: i64 = __mind_alloc(64);
    let mut i: i64 = 0;
    while i < 64 {
        __mind_store_i64(c + i, __mind_load_i64(row + i));
        i = i + 8;
    }
    __mind_store_i64(c, __mind_load_i64(row) + shift);
    __mind_store_i64(c + 8, __mind_load_i64(row + 8) + shift);
    c
}

pub fn nbs_put_marked(r: i64, row: i64, mark: i64) -> i64 {
    if mark == 0 {
        return 0;
    }
    nbs_put(r, row)
}

// The row count of user table `ut` (0 without a user extern block).
pub fn nbs_user_rows(ut: i64) -> i64 {
    if ut <= 0 {
        return 0;
    }
    __mind_load_i64(__mind_load_i64(ut) + 24)
}

// User row i of table `ut`, its name span made relative to the whole image.
pub fn nbs_user_row(ut: i64, i: i64, user_lo: i64) -> i64 {
    nbs_row_copy(__mind_load_i64(__mind_load_i64(__mind_load_i64(ut) + 16) + i * 8), user_lo)
}

// The registry of the joined image, name spans relative to the whole image:
// the user rows of `ut`, then each marked seed row in declaration order. 0 when
// no seed row is marked (the caller keeps `ut`), -1 when the rows do not fit.
// A call binds the first visible row of its name (nbs_pick), so a name both
// regions declare gives one import.
pub fn nbs_join(ut: i64, all: i64, reach: i64, user_lo: i64, src_len: i64) -> i64 {
    let n: i64 = __mind_load_i64(all + 24);
    let mut m: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        m = m + __mind_load_i64(reach + i * 8);
        i = i + 1;
    }
    if m == 0 {
        return 0;
    }
    if __mind_load_i64(all + 32) != 0 {
        return 0 - 1;
    }
    let un: i64 = nbs_user_rows(ut);
    if un + m > 4096 {
        return 0 - 1;
    }
    let dst: i64 = nbs_registry(__mind_load_i64(all), src_len);
    i = 0;
    while i < un {
        let _u: i64 = nbs_put(dst, nbs_user_row(ut, i, user_lo));
        i = i + 1;
    }
    i = 0;
    while i < n {
        let _s: i64 = nbs_put_marked(dst, __mind_load_i64(__mind_load_i64(all + 16) + i * 8), __mind_load_i64(reach + i * 8));
        i = i + 1;
    }
    dst
}

// The table for a join that made no registry: the user table when no seed row
// is marked (r == 0), the refusal (-1) when the rows do not fit.
pub fn nbs_keep(ut: i64, r: i64) -> i64 {
    if r == 0 {
        return ut;
    }
    r
}

// Table word t+40 of a joined table: the start of the user region. 0 on a
// user-only table, whose rows are all user rows.
pub fn nbs_edge(t: i64, user_lo: i64) -> i64 {
    if t <= 0 {
        return t;
    }
    __mind_store_i64(t + 40, user_lo);
    t
}

// The row a call binds (nbx_lookup step): the first row of its name that the
// call site can see. A seed row (its name starts before the user region) is
// not visible to a call site of the user region. The user rows come first, so
// a name both regions declare binds one row and gives one import.
pub fn nbs_pick(found: i64, i: i64, t: i64, row: i64, call_lo: i64) -> i64 {
    if found >= 0 {
        return found;
    }
    let edge: i64 = __mind_load_i64(t + 40);
    if __mind_load_i64(row) < edge {
        if call_lo >= edge {
            return found;
        }
    }
    i
}

// ---- import ids of the dynamic image (from main.mind) ----
// Assign import ids to the called rows (first-call order) and count patches.
// Every import therefore has at least one patch; dormant declarations import
// nothing. Returns the patch count.
pub fn nbx_imports(t: i64, calls: i64, ncalls: i64) -> i64 {
    let recs: i64 = __mind_load_i64(t + 16);
    let mut np: i64 = 0;
    let mut c: i64 = 0;
    while c < ncalls {
        np = np + nbx_import_step(t, recs, __mind_load_i64(calls + (c * 3 + 1) * 8));
        c = c + 1;
    }
    np
}
pub fn nbx_import_step(t: i64, recs: i64, lo: i64) -> i64 {
    if lo >= 0 {
        return 0;
    }
    let rec: i64 = recs + (0 - 1 - lo) * 40;
    if __mind_load_i64(rec + 32) < 0 {
        __mind_store_i64(rec + 32, __mind_load_i64(t + 24));
        __mind_store_i64(t + 24, __mind_load_i64(t + 24) + 1)
    }
    1
}
