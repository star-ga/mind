// Bare-builtin name membership for the E2012 fn-value check: the two-word packed-name
// equality and the resolve.rs BARE_BUILTINS table, moved verbatim from main.mind.
// A part calls std.* and other parts only.

// Two-word packed-name equality: 1 iff (w0, w1, len) == (e0, e1, elen).
pub fn tc_fvc_eq2(w0: i64, w1: i64, len: i64, e0: i64, e1: i64, elen: i64) -> i64 {
    if len != elen {
        return 0;
    }
    if w0 != e0 {
        return 0;
    }
    if w1 != e1 {
        return 0;
    }
    1
}

// Membership in resolve.rs BARE_BUILTINS (all 34 entries; longest is
// "random_normal", 13 bytes, so two packed words are a bijection). Constants
// are regenerated from the Rust table by the smoke on every run — a table
// drift fails loud there rather than silently here.
pub fn tc_fvc_is_bare_builtin(w0: i64, w1: i64, len: i64) -> i64 {
    // "abs"
    if tc_fvc_eq2(w0, w1, len, 7561825, 0, 3) == 1 {
        return 1;
    }
    // "argmax"
    if tc_fvc_eq2(w0, w1, len, 132359842656865, 0, 6) == 1 {
        return 1;
    }
