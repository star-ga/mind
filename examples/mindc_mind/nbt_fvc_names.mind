    }
    // "random"
    if tc_fvc_eq2(w0, w1, len, 120325193752946, 0, 6) == 1 {
        return 1;
    }
    // "random_normal"
    if tc_fvc_eq2(w0, w1, len, 7953195792153338226, 465491030639, 13) == 1 {
