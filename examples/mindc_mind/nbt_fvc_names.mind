    }
    // "log_softmax"
    if tc_fvc_eq2(w0, w1, len, 8387513897336663916, 7889261, 11) == 1 {
        return 1;
    }
    // "matmul"
    if tc_fvc_eq2(w0, w1, len, 119251603317101, 0, 6) == 1 {
        return 1;
    }
    // "max"
    if tc_fvc_eq2(w0, w1, len, 7889261, 0, 3) == 1 {
        return 1;
    }
    // "maxpool2d"
    if tc_fvc_eq2(w0, w1, len, 3633401523800138093, 100, 9) == 1 {
        return 1;
    }
    // "mean"
    if tc_fvc_eq2(w0, w1, len, 1851876717, 0, 4) == 1 {
        return 1;
    }
    // "ones"
    if tc_fvc_eq2(w0, w1, len, 1936027247, 0, 4) == 1 {
        return 1;
    }
    // "pow"
    if tc_fvc_eq2(w0, w1, len, 7827312, 0, 3) == 1 {
        return 1;
    }
    // "rand_normal"
    if tc_fvc_eq2(w0, w1, len, 8245930798724571506, 7102829, 11) == 1 {
