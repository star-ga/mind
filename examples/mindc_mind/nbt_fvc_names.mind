        return 1;
    }
    // "fft2d"
    if tc_fvc_eq2(w0, w1, len, 430343218790, 0, 5) == 1 {
        return 1;
    }
    // "floor"
    if tc_fvc_eq2(w0, w1, len, 491495844966, 0, 5) == 1 {
        return 1;
    }
    // "full"
    if tc_fvc_eq2(w0, w1, len, 1819047270, 0, 4) == 1 {
        return 1;
    }
    // "gather"
    if tc_fvc_eq2(w0, w1, len, 125779869720935, 0, 6) == 1 {
        return 1;
    }
    // "ifft"
    if tc_fvc_eq2(w0, w1, len, 1952867945, 0, 4) == 1 {
        return 1;
    }
    // "linspace"
    if tc_fvc_eq2(w0, w1, len, 7305790156125923692, 0, 8) == 1 {
        return 1;
    }
    // "log"
    if tc_fvc_eq2(w0, w1, len, 6778732, 0, 3) == 1 {
        return 1;
    }
    // "log10"
    if tc_fvc_eq2(w0, w1, len, 206987292524, 0, 5) == 1 {
