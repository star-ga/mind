// Standalone Linux x86-64 LP64 libc startup and returning main adapter.
// Requires std.string, nb_le/nb_i64le and native_dynamic_layout.mind.
// Input buffers must be live, immutable and disjoint from metadata64 bytes.
pub fn nsa_code_size() -> i64 {
    365
}
pub fn nsa_adapter_offset() -> i64 {
    135
}
pub fn nsa_libc_fixup() -> i64 {
    115
}
pub fn nsa_init_fixup() -> i64 {
    221
}
pub fn nsa_main_fixup() -> i64 {
    302
}

pub fn nsa_zero(metadata: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 8 {
        __mind_store_i64(metadata + i * 8, 0);
        i = i + 1;
    }
    0
}
pub fn nsa_range(offset: i64, length: i64, total: i64) -> i64 {
    if offset < 0 {
        return 0;
    }
    if length < 1 {
        return 0;
    }
    if length > total {
        return 0;
    }
    if offset > total - length {
        return 0;
    }
    1
}
// Called only after each complete range has passed nsa_range.
pub fn nsa_disjoint(a: i64, an: i64, b: i64, bn: i64) -> i64 {
    if a + an <= b {
        return 1;
    }
    if b + bn <= a {
        return 1;
    }
    0
}
pub fn nsa_symbols_ok(symbols: i64, total: i64) -> i64 {
    if __mind_load_i64(symbols) != 1 {
        return 0;
    }
    let start: i64 = __mind_load_i64(symbols + 8);
    let runtime: i64 = __mind_load_i64(symbols + 16);
    let runtime_size: i64 = __mind_load_i64(symbols + 24);
    let init: i64 = __mind_load_i64(symbols + 32);
    let main: i64 = __mind_load_i64(symbols + 40);
    let main_size: i64 = __mind_load_i64(symbols + 48);
    if nsa_range(start, nsa_code_size(), total) == 0 {
        return 0;
    }
    if nsa_range(runtime, runtime_size, total) == 0 {
        return 0;
    }
    if nsa_range(main, main_size, total) == 0 {
        return 0;
    }
    if init < 0 {
        return 0;
    }
    if init >= runtime_size {
        return 0;
    }
    if nsa_disjoint(start, nsa_code_size(), runtime, runtime_size) == 0 {
        return 0;
    }
    if nsa_disjoint(start, nsa_code_size(), main, main_size) == 0 {
        return 0;
    }
    if nsa_disjoint(runtime, runtime_size, main, main_size) == 0 {
        return 0;
    }
    let argc: i64 = __mind_load_i64(symbols + 56);
    if argc < 0 {
        return 0;
    }
    if argc > 2 {
        return 0;
    }
    if __mind_load_i64(symbols + 64) != 7 {
        return 0;
    }
    let import_id: i64 = __mind_load_i64(symbols + 72);
    if import_id < 0 {
        return 0;
    }
    if import_id > 255 {
        return 0;
    }
    1
}
pub fn nsa_emit(request: i64, symbols: i64, metadata: i64) -> String {
    let _clear: i64 = nsa_zero(metadata);
    let layout: i64 = __mind_alloc(256);
    if layout == 0 {
        return string_new();
    }
    if ndl_plan(request, layout) != 0 {
        __mind_free(layout);
        return string_new();
    }
    if nsa_symbols_ok(symbols, __mind_load_i64(request + 8)) == 0 {
        __mind_free(layout);
        return string_new();
    }
    let start: i64 = __mind_load_i64(symbols + 8);
    let init_target: i64 = __mind_load_i64(symbols + 16) + __mind_load_i64(symbols + 32);
    let main_target: i64 = __mind_load_i64(symbols + 40);
    let init_delta: i64 = init_target - (start + nsa_init_fixup() + 4);
    let main_delta: i64 = main_target - (start + nsa_main_fixup() + 4);
    // The checked low code window is smaller than signed rel32 reach.
    let context: i64 = __mind_load_i64(layout + 88);
    let arena: i64 = __mind_load_i64(layout + 120);
    let stack_top: i64 = __mind_load_i64(layout + 168);
    __mind_free(layout);
    let code: String = nsa_blob_p1(string_new(), context, arena, stack_top, init_delta, main_delta);
    if string_len(code) != nsa_code_size() {
        __mind_free(string_addr(code));
        return string_new();
    }
    __mind_store_i64(metadata + 8, 0);
    __mind_store_i64(metadata + 16, nsa_adapter_offset());
    __mind_store_i64(metadata + 24, nsa_code_size());
    __mind_store_i64(metadata + 32, nsa_libc_fixup());
    __mind_store_i64(metadata + 40, __mind_load_i64(symbols + 72));
    __mind_store_i64(metadata + 48, 1);
    __mind_store_i64(metadata, 1);
    code
}

