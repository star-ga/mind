// Regression class (twin-emitter review round 3): alias-break over a PARAMETER candidate (cond read).
fn fz(p: i64, q: i64) -> i64 {
    let mut b: i64 = q;
    let mut k: i64 = 0;
    while b > k {
        k = (k + 1);
        let mut q: i64 = 0;
        q = (q + k);
    }
    return k;
}
fn main() -> i64 {
    return fz(1, 3);
}
