// Regression class (twin-emitter review round 3): alias-break over a PARAMETER candidate.
fn fz(p: i64) -> i64 {
    let mut b: i64 = p;
    let mut k: i64 = 0;
    while k < 2 {
        k = (k + 1);
        let mut p: i64 = b;
        p = 1;
    }
    return b;
}
fn main() -> i64 {
    return fz(5);
}
