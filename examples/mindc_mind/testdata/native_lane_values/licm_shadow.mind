// LICM slice 1 with a body-local shadow (native-only row: the MLIR leg refuses
// loop shadowing): `y` hoists (outer x), the shadowing `let x` and `z` (which reads
// the shadow) stay, `x2` reads the hoisted `y` and hoists with it.
fn sh(n: i64, x: i64) -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let y: i64 = x * 2;
        let x: i64 = i + 1;
        let z: i64 = x * 5;
        let x2: i64 = y + 1;
        s = s + y + z + x2;
        i = i + 1;
    }
    s + x
}

fn main() -> i64 {
    sh(5, 4) % 223
}
