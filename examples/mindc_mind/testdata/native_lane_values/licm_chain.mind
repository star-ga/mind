// LICM slice 1: a chain of invariant lets after a `continue` hoists as a whole
// (later lets read earlier hoisted ones); the loop leaves through `break`.
fn h(a: i64, b: i64, n: i64) -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        i = i + 1;
        if i == 3 {
            continue
        }
        let x: i64 = a + b;
        let y: i64 = x * x - a;
        let z: i64 = (y & 255) | 1;
        if i > 7 {
            break
        }
        s = s + z + i;
    }
    s
}

fn main() -> i64 {
    (h(6, 5, 20) + h(1, 2, 2)) % 247
}
