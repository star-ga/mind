// M-A3 fixture: the only __mind_rdtscp_v1 call sits in a helper reached from
// main, so the start guard must come from the reachable-fn scan, not the entry
// body. Exit 0 when the two reads grow, 1 when they do not.
fn stamp(salt: i64) -> i64 {
    __mind_rdtscp_v1() + salt - salt
}

fn main() -> i64 {
    let a: i64 = stamp(3);
    let b: i64 = stamp(4);
    if b > a {
        return 0;
    }
    1
}
