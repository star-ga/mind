// M-A3 fixture: two __mind_rdtscp_v1 reads around a fenced busy loop. The
// counter is a positive 64-bit EDX:EAX value that grows; exit 0 when it does,
// 1..3 name the failed property. The RDTSCP start guard runs first.
fn spin(n: i64, acc: i64) -> i64 {
    if n <= 0 {
        return acc;
    }
    spin(n - 1, acc + n)
}

fn main() -> i64 {
    let t1: i64 = __mind_rdtscp_v1();
    let f1: i64 = __mind_lfence_v1();
    let s: i64 = spin(2000, 0);
    let t2: i64 = __mind_rdtscp_v1();
    if t1 <= 0 {
        return 1;
    }
    if t2 <= t1 {
        return 2;
    }
    if s + f1 != 2001000 {
        return 3;
    }
    0
}
