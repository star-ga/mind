extern "C" { unsafe fn __errno_location()->*mut i32; }
fn main()->i64 {
 let ep:i64=__errno_location() as i64;
 if ep==0 { return 90; }
 __mind_store_i32(ep,77);
 let a:i64=__mind_read(0-1,0,1,0-1);
 let b:i64=__mind_write(0-1,0,0,0-1);
 let observed:i64=__mind_load_i32(ep) as i64;
 if a!=0 { return 91; }
 if b!=0 { return 92; }
 if observed!=77 { return 93; } 0
}
