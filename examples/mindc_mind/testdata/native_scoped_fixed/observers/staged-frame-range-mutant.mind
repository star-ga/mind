    __mind_store_i64(scope + 80, __mind_load_i64(scope + 56));
    __mind_store_i64(scope + 96, 0);
    1
}

pub fn nb_fc_rollback(ctx: i64) -> i64 {
    let scope: i64 = nb_fc_scope(ctx);
    if scope != 0 { __mind_store_i64(scope + 56, __mind_load_i64(scope + 80)); }
    0
}

pub fn nb_fc_frame(ctx: i64, frame: i64) -> i64 {
    let scope: i64 = nb_fc_scope(ctx);
    if scope == 0 { return 0; }
    let mut i: i64 = 0;
    while i < __mind_load_i64(scope + 56) {
        __mind_store_i64(__mind_load_i64(scope + 48) + i * 64 + 48, frame);
        i = i + 1;
