}

pub fn nb_fc_rebase(ctx: i64, base: i64, bytes: i64) -> i64 {
    let scope: i64 = nb_fc_scope(ctx);
    if scope == 0 { return 1; }
    let mut i: i64 = __mind_load_i64(scope + 80);
    while i < __mind_load_i64(scope + 56) {
        let row: i64 = __mind_load_i64(scope + 48) + i * 64;
        let off: i64 = __mind_load_i64(row);
        if off < 0 { return 0; }
        if off > bytes - 64 { return 0; }
        if base > 4194304 - off { return 0; }
        if __mind_load_i64(row + 48) < 16 { return 0; }
        __mind_store_i64(row, base + off);
        i = i + 1;
    }
    1
}

