pub fn nb_fc_unit(scope: i64, lo: i64, hi: i64) -> i64 {
    if lo < 0 { return 0 - 1; }
    if hi <= lo { return 0 - 1; }
    let mut i: i64 = 0;
    while i < __mind_load_i64(scope + 32) {
