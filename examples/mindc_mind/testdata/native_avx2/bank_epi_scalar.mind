// Scalar twin of bank_epi_forms.mind: the same inputs and the same 320 bytes, lane by
// lane in i64 (no bank name, no ymm). Logical shift right = arithmetic shift, masked.

fn lane(o: i64, slot: i64, i: i64, v: i64) -> i64 {
    __mind_store_i64(o + slot * 32 + i * 8, v);
    0
}

fn gt(x: i64, y: i64) -> i64 {
    if x > y {
        return 0 - 1;
    }
    0
}

fn main() -> i64 {
    let a: i64 = __mind_alloc(32);
    let b: i64 = __mind_alloc(32);
    let o: i64 = __mind_alloc(320);
    let mut i: i64 = 0;
    let mut x: i64 = 4242;
    while i < 32 {
        x = (x * 1103515245 + 12345) & 2147483647;
        __mind_store_i8(a + i, x / 65536);
        x = (x * 1103515245 + 12345) & 2147483647;
        __mind_store_i8(b + i, x / 65536);
        i = i + 1;
    }
    i = 0;
    while i < 4 {
        let p: i64 = __mind_load_i64(a + i * 8);
        let q: i64 = __mind_load_i64(b + i * 8);
        let _0: i64 = lane(o, 0, i, (p & 4294967295) * (q & 4294967295));
        let _1: i64 = lane(o, 1, i, q & p);
        let _2: i64 = lane(o, 2, i, p | q);
        let _3: i64 = lane(o, 3, i, gt(p, q));
        let _4: i64 = lane(o, 4, i, gt(q, p));
        let _5: i64 = lane(o, 5, i, (p >> 13) & 2251799813685247);
        let _6: i64 = lane(o, 6, i, q << 13);
        let _7: i64 = lane(o, 7, i, 0);
        let _8: i64 = lane(o, 8, i, 0);
        let _9: i64 = lane(o, 9, i, q << 5);
        i = i + 1;
    }
    __mind_write(1, o, 320, 0 - 1);
    0
}
