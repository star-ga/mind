// R-02e finish-row sequence on 4 fixed i64 lanes at shifts 63, 47, 32, 16, using only
// kinds 70, 71, 80-83, 94-99 and the ruling's substitutes: per-row constants from a
// 32-byte cell (kind 70), select = y + ((x - y) & m), abs = a - 2(a & m), and the
// guard bad = bad | gt(out, limit) kept in a cell (kind 71) and read back with 4
// scalar loads; a row whose guard is set is not written. Exit 0 iff the vector
// rows, guards and skips equal the scalar twin's (exit = mismatch count).

fn quad(x: i64, k: i64, o: i64, g: i64) -> i64 {
    __mind_ymm_vmovdqu_ld(0, x, 0);
    __mind_ymm_vmovdqu_ld(1, k, 0);
    __mind_ymm_vmovdqu_ld(2, k, 32);
    __mind_ymm_vmovdqu_ld(3, k, 64);
    __mind_ymm_vmovdqu_ld(4, k, 96);
    __mind_ymm_vpmuludq_i64x4_r(5, 0, 1);
    __mind_ymm_vpsrlq_i64x4_r(6, 5, 2);
    __mind_ymm_vpsllq_i64x4_r(7, 6, 2);
    __mind_ymm_vpsubq_i64x4_r(8, 5, 7);
    __mind_ymm_vpcmpgtq_i64x4_r(9, 4, 0);
    __mind_ymm_vpand_i64x4_r(10, 0, 9);
    __mind_ymm_vpaddq_i64x4_r(10, 10, 10);
    __mind_ymm_vpsubq_i64x4_r(11, 0, 10);
    __mind_ymm_vpcmpgtq_i64x4_r(12, 8, 11);
    __mind_ymm_vpsubq_i64x4_r(13, 8, 11);
    __mind_ymm_vpand_i64x4_r(13, 13, 12);
    __mind_ymm_vpaddq_i64x4_r(13, 11, 13);
    __mind_ymm_vpaddq_i64x4_r(13, 13, 6);
    __mind_ymm_vpaddq_i64x4_m(13, k, 128);
    __mind_ymm_vpsubq_i64x4_m(13, k, 160);
    __mind_ymm_vmovdqu_ld(14, g, 0);
    __mind_ymm_vpcmpgtq_i64x4_r(12, 13, 3);
    __mind_ymm_vpor_i64x4_r(14, 14, 12);
    __mind_ymm_vmovdqu_st(14, g, 0);
    __mind_ymm_vmovdqu_st(13, o, 0);
    0
}

fn lsr(v: i64, s: i64) -> i64 {
    (v >> s) & ((1 << (64 - s)) - 1)
}

fn sgt(x: i64, y: i64) -> i64 {
    if x > y {
        return 0 - 1;
    }
    0
}

// Scalar twin of one lane; the lane's guard accumulates into g.
fn quad1(v: i64, k: i64, s: i64, i: i64, o: i64, g: i64) -> i64 {
    let p: i64 = (v & 4294967295) * (__mind_load_i64(k + i * 8) & 4294967295);
    let r: i64 = lsr(p, s);
    let rem: i64 = p - (r << s);
    let m: i64 = sgt(0, v);
    let ab: i64 = v - ((v & m) + (v & m));
    let sel: i64 = ab + ((rem - ab) & sgt(rem, ab));
    let out: i64 = sel + r + __mind_load_i64(k + 128 + i * 8) - __mind_load_i64(k + 160 + i * 8);
    let bad: i64 = __mind_load_i64(g + i * 8) | sgt(out, __mind_load_i64(k + 64 + i * 8));
    __mind_store_i64(g + i * 8, bad);
    __mind_store_i64(o + i * 8, out);
    0
}

fn any4(g: i64) -> i64 {
    __mind_load_i64(g) | __mind_load_i64(g + 8) | __mind_load_i64(g + 16) | __mind_load_i64(g + 24)
}

// One row: vector pass into (o, gv), scalar pass into (o + 32, gs); written to the
// result rows only when that pass's guard is clear. Returns the mismatch count.
fn row(x: i64, k: i64, s: i64, o: i64, gv: i64, gs: i64, res: i64) -> i64 {
    __mind_store_i64(k + 32, s);
    let _q: i64 = quad(x, k, o, gv);
    let mut i: i64 = 0;
    while i < 4 {
        let _t: i64 = quad1(__mind_load_i64(x + i * 8), k, s, i, o + 32, gs);
        i = i + 1;
    }
    let mut bad: i64 = 0;
    i = 0;
    while i < 4 {
        if any4(gv) == 0 {
            __mind_store_i64(res + i * 8, __mind_load_i64(o + i * 8))
        }
        if any4(gs) == 0 {
            __mind_store_i64(res + 32 + i * 8, __mind_load_i64(o + 32 + i * 8))
        }
        if __mind_load_i64(gv + i * 8) != __mind_load_i64(gs + i * 8) {
            bad = bad + 1;
        }
        if __mind_load_i64(res + i * 8) != __mind_load_i64(res + 32 + i * 8) {
            bad = bad + 1;
        }
        i = i + 1;
    }
    bad
}

fn main() -> i64 {
    let x: i64 = __mind_alloc(32);
    let k: i64 = __mind_alloc(192);
    let o: i64 = __mind_alloc(64);
    let gv: i64 = __mind_alloc(32);
    let gs: i64 = __mind_alloc(32);
    let res: i64 = __mind_alloc(64);
    __mind_store_i64(x, 305419896);
    __mind_store_i64(x + 8, 0 - 19088743);
    __mind_store_i64(x + 16, 4294967295);
    __mind_store_i64(x + 24, 0 - 2);
    let mut i: i64 = 0;
    while i < 24 {
        __mind_store_i64(k + i * 8, 0);
        i = i + 1;
    }
    i = 0;
    while i < 4 {
        __mind_store_i64(k + i * 8, 2654435761);
        __mind_store_i64(k + 64 + i * 8, 1099511627776);
        __mind_store_i64(k + 128 + i * 8, i * 2 + 3);
        __mind_store_i64(k + 160 + i * 8, i + 1);
        __mind_store_i64(gv + i * 8, 0);
        __mind_store_i64(gs + i * 8, 0);
        i = i + 1;
    }
    row(x, k, 63, o, gv, gs, res) + row(x, k, 47, o, gv, gs, res) + row(x, k, 32, o, gv, gs, res) + row(x, k, 16, o, gv, gs, res)
}
