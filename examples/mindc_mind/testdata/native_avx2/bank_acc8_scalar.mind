// Scalar twin of bank_acc8.mind: the same accumulations lane by lane (i32 wrap
// by the 4-byte store). Builds on both backends (native and MLIR); must print the
// same 256 bytes as bank_acc8.mind and bank_acc8_layer_a.mind.

fn acc8(tab: i64, n: i64, out: i64) -> i64 {
    let mut j: i64 = 0;
    while j < n {
        let s: i64 = tab + j * 256;
        let mut l: i64 = 0;
        while l < 64 {
            __mind_store_i32(out + l * 4, __mind_load_i32(out + l * 4) + __mind_load_i32(s + l * 4));
            l = l + 1;
        }
        j = j + 1;
    }
    0
}

fn main() -> i64 {
    let tab: i64 = __mind_alloc(64 * 256);
    let out: i64 = __mind_alloc(256);
    let mut i: i64 = 0;
    let mut x: i64 = 12345;
    while i < 64 * 64 {
        x = (x * 1103515245 + 12345) & 2147483647;
        __mind_store_i32(tab + i * 4, x * 2 + (x & 1));
        i = i + 1;
    }
    let mut k: i64 = 0;
    while k < 64 {
        __mind_store_i32(out + k * 4, k * 7 - 100);
        k = k + 1;
    }
    let _r: i64 = acc8(tab, 64, out);
    __mind_write(1, out, 256, 0 - 1);
    0
}
