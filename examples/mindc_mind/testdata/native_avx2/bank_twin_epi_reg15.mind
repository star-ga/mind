// R-02e positive twin of bank_refuse_epi_reg15.mind: the fixed form builds and runs.

fn bank(p: i64) -> i64 {
    __mind_ymm_vmovdqu_ld(0, p, 0);
    __mind_ymm_vmovdqu_ld(1, p, 32);
    __mind_ymm_vpand_i64x4_r(14, 0, 1);
    __mind_ymm_vmovdqu_st(14, p, 64);
    0
}

fn main() -> i64 {
    let p: i64 = __mind_alloc(96);
    let mut i: i64 = 0;
    while i < 12 {
        __mind_store_i64(p + i * 8, i * 3 + 5);
        i = i + 1;
    }
    let _b: i64 = bank(p);
    __mind_load_i64(p + 64) + __mind_load_i64(p + 72) + __mind_load_i64(p + 80)
}
