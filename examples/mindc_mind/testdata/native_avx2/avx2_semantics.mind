// Layer-A / R-02 semantics, self-checking: wraparound per lane width, the in-lane
// vpshufb rule (dst[i] = mask[i] >= 0x80 ? 0 : src[16 * (i / 16) + mask[i] % 16]),
// the return value (arg 0), inputs left intact, no write outside the 32 bytes, and
// in-place calls (every op reads all inputs before its one write). Operands sit at
// odd addresses (never 32-aligned). Exits 0, or the code of the first failed check.

fn fill8(p: i64, i: i64, n: i64, v: i64) -> i64 {
    if i >= n {
        return 0;
    }
    __mind_store_i8(p + i, v);
    fill8(p, i + 1, n, v)
}

// Little-endian 32-bit lane i of p = v (0 <= v < 2^32).
fn put32(p: i64, i: i64, v: i64) -> i64 {
    __mind_store_i8(p + 4 * i, v % 256);
    __mind_store_i8(p + 4 * i + 1, (v / 256) % 256);
    __mind_store_i8(p + 4 * i + 2, (v / 65536) % 256);
    __mind_store_i8(p + 4 * i + 3, v / 16777216);
    0
}

fn get32(p: i64, i: i64) -> i64 {
    let b0: i64 = __mind_load_i8(p + 4 * i);
    let b1: i64 = __mind_load_i8(p + 4 * i + 1);
    let b2: i64 = __mind_load_i8(p + 4 * i + 2);
    b0 + b1 * 256 + b2 * 65536 + __mind_load_i8(p + 4 * i + 3) * 16777216
}

fn fill32(p: i64, i: i64, v: i64) -> i64 {
    if i >= 8 {
        return 0;
    }
    put32(p, i, v);
    fill32(p, i + 1, v)
}

// 1 iff every 32-bit lane of p equals v.
fn all32(p: i64, i: i64, v: i64) -> i64 {
    if i >= 8 {
        return 1;
    }
    if get32(p, i) != v {
        return 0;
    }
    all32(p, i + 1, v)
}

fn all8(p: i64, i: i64, n: i64, v: i64) -> i64 {
    if i >= n {
        return 1;
    }
    if __mind_load_i8(p + i) != v {
        return 0;
    }
    all8(p, i + 1, n, v)
}

fn fill64(p: i64, i: i64, v: i64) -> i64 {
    if i >= 4 {
        return 0;
    }
    __mind_store_i64(p + 8 * i, v);
    fill64(p, i + 1, v)
}

fn all64(p: i64, i: i64, v: i64) -> i64 {
    if i >= 4 {
        return 1;
    }
    if __mind_load_i64(p + 8 * i) != v {
        return 0;
    }
    all64(p, i + 1, v)
}

// src[i] = i + 1 ; mask: 0x80 at 0 and 0x8F at 31 (bit 7 zeroes), 0 at 16 (the
// upper lane reads src[16], not src[0]), 15 at 17 (src[31]), 3 at 1, else i % 16.
fn shuf_inputs(s: i64, m: i64, i: i64) -> i64 {
    if i >= 32 {
        __mind_store_i8(m, 128);
        __mind_store_i8(m + 1, 3);
        __mind_store_i8(m + 16, 0);
        __mind_store_i8(m + 17, 15);
        __mind_store_i8(m + 31, 143);
        return 0;
    }
    __mind_store_i8(s + i, i + 1);
    __mind_store_i8(m + i, i % 16);
    shuf_inputs(s, m, i + 1)
}

// 1 iff d[i] follows the in-lane rule for every byte, read from s and m.
fn shuf_ok(d: i64, s: i64, m: i64, i: i64) -> i64 {
    if i >= 32 {
        return 1;
    }
    let k: i64 = __mind_load_i8(m + i);
    let want: i64 = if k >= 128 {
        0
    } else {
        __mind_load_i8(s + 16 * (i / 16) + k % 16)
    };
    if __mind_load_i8(d + i) != want {
        return 0;
    }
    shuf_ok(d, s, m, i + 1)
}

// a = p + 1 with fence bytes 0x5A at a - 1 and a + 32; b, c, e at odd offsets.
fn check32(p: i64) -> i64 {
    let a: i64 = p + 1;
    let b: i64 = p + 65;
    __mind_store_i8(a - 1, 90);
    __mind_store_i8(a + 32, 90);
    fill32(a, 0, 2147483647);
    fill32(b, 0, 1);
    if __mind_vpaddd_i32x8(a, b) != a {
        return 12;
    }
    if all32(a, 0, 2147483648) == 0 {
        return 11;
    }
    if all32(b, 0, 1) == 0 {
        return 13;
    }
    if __mind_load_i8(a - 1) != 90 {
        return 14;
    }
    if __mind_load_i8(a + 32) != 90 {
        return 15;
    }
    let _s: i64 = __mind_vpsubd_i32x8(a, b);
    if all32(a, 0, 2147483647) == 0 {
        return 21;
    }
    fill32(a, 0, 0);
    let _u: i64 = __mind_vpsubd_i32x8(a, b);
    if all32(a, 0, 4294967295) == 0 {
        return 22;
    }
    fill32(a, 0, 5);
    let _i: i64 = __mind_vpaddd_i32x8(a, a);
    if all32(a, 0, 10) == 0 {
        return 81;
    }
    0
}

fn check8(p: i64) -> i64 {
    let a: i64 = p + 1;
    let b: i64 = p + 65;
    fill8(a, 0, 32, 128);
    fill8(b, 0, 32, 128);
    if __mind_vpaddb_i8x32(a, b) != a {
        return 32;
    }
    if all8(a, 0, 32, 0) == 0 {
        return 31;
    }
    if all8(b, 0, 32, 128) == 0 {
        return 33;
    }
    fill8(a, 0, 32, 255);
    fill8(b, 0, 32, 2);
    let _w: i64 = __mind_vpaddb_i8x32(a, b);
    if all8(a, 0, 32, 1) == 0 {
        return 34;
    }
    0
}

fn check_shuf(p: i64) -> i64 {
    let d: i64 = p + 1;
    let s: i64 = p + 65;
    let m: i64 = p + 129;
    shuf_inputs(s, m, 0);
    fill8(d, 0, 32, 77);
    if __mind_vpshufb_i8x32(d, s, m) != d {
        return 42;
    }
    if shuf_ok(d, s, m, 0) == 0 {
        return 41;
    }
    if __mind_load_i8(d + 16) != 17 {
        return 45;
    }
    if __mind_load_i8(s + 31) != 32 {
        return 43;
    }
    if __mind_load_i8(m + 16) != 0 {
        return 44;
    }
    let _x: i64 = __mind_vpshufb_i8x32(s, s, m);
    if __mind_load_i8(s + 16) != 17 {
        return 82;
    }
    if __mind_load_i8(s + 17) != 32 {
        return 83;
    }
    0
}

fn check_move(p: i64) -> i64 {
    let d: i64 = p + 1;
    let s: i64 = p + 65;
    fill8(d, 0, 32, 0);
    fill8(s, 0, 32, 201);
    __mind_store_i8(d + 32, 90);
    if __mind_vmovdqu_i32x8(d, s) != d {
        return 52;
    }
    if all8(d, 0, 32, 201) == 0 {
        return 51;
    }
    if __mind_load_i8(d + 32) != 90 {
        return 53;
    }
    0
}

fn check64(p: i64) -> i64 {
    let a: i64 = p + 1;
    let b: i64 = p + 65;
    let max: i64 = 9223372036854775807;
    fill64(a, 0, max);
    fill64(b, 0, 1);
    if __mind_vpaddq_i64x4(a, b) != a {
        return 62;
    }
    if all64(a, 0, 0 - max - 1) == 0 {
        return 61;
    }
    fill64(a, 0, 0);
    if __mind_vpsubq_i64x4(a, b) != a {
        return 72;
    }
    if all64(a, 0, 0 - 1) == 0 {
        return 71;
    }
    if all64(b, 0, 1) == 0 {
        return 73;
    }
    0
}

fn main() -> i64 {
    let p: i64 = __mind_alloc(512);
    let r1: i64 = check32(p);
    if r1 != 0 {
        return r1;
    }
    let r2: i64 = check8(p);
    if r2 != 0 {
        return r2;
    }
    let r3: i64 = check_shuf(p);
    if r3 != 0 {
        return r3;
    }
    let r4: i64 = check_move(p);
    if r4 != 0 {
        return r4;
    }
    check64(p)
}
