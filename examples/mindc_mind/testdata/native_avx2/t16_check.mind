// Kind 89 bit 4 value check (u16 offset lists). Exit 0 when every mode matches
// the bit-clear walk on the byte list and the scalar twin. Modes per case:
// bits 3+4, bit 4 alone, bit clear. Stdout is the bad-lane count.
// The u16 list holds the same logical offsets as the byte list, in lanes.

fn t_neq(a: i64, b: i64) -> i64 {
    if a != b {
        return 1;
    }
    0
}

fn t_sext(u: i64) -> i64 {
    if u >= 2147483648 {
        return u - 4294967296;
    }
    u
}

fn t_ld32(addr: i64) -> i64 {
    t_sext(__mind_load_i32(addr))
}

fn t_add32(s: i64, v: i64) -> i64 {
    let u: i64 = (s + v) & 4294967295;
    t_sext(u)
}

fn t_fill(buf: i64, n: i64, v: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i64(buf + i * 8, v);
        i = i + 1;
    }
    0
}

fn t_bad(got: i64, exp: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut bad: i64 = 0;
    while i < n {
        bad = bad + t_neq(__mind_load_i64(got + i * 8), __mind_load_i64(exp + i * 8));
        i = i + 1;
    }
    bad
}

fn t_mode(d: i64, flags: i64, bound: i64) -> i64 {
    __mind_store_i64(d + 56, flags);
    __mind_store_i32(d + 60, bound);
    0
}

fn t_put(starts: i64, j0: i64, j1: i64, j2: i64) -> i64 {
    __mind_store_i64(starts, j0);
    __mind_store_i64(starts + 8, j1);
    __mind_store_i64(starts + 16, j2);
    0
}

fn t_sum64(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        s = s + __mind_load_i64(bank + __mind_load_i64(off + j * 8) + lane * 8);
        j = j + 1;
    }
    s
}

fn t_row64(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, exp: i64, base: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 32 {
        let s: i64 = t_sum64(bank, off, j0, j1, lane) - t_sum64(bank, off, j1, j2, lane) + base;
        __mind_store_i64(exp + lane * 8, s);
        lane = lane + 1;
    }
    0
}

fn t_sum32(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        s = t_add32(s, t_ld32(bank + __mind_load_i64(off + j * 8) + lane * 4));
        j = j + 1;
    }
    s
}

fn t_row32(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, exp: i64, base: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 64 {
        let s: i64 = t_add32(t_sum32(bank, off, j0, j1, lane), 0 - t_sum32(bank, off, j1, j2, lane));
        __mind_store_i64(exp + lane * 8, s + base);
        lane = lane + 1;
    }
    0
}

fn t_sumw(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        s = s + t_ld32(bank + __mind_load_i64(off + j * 8) + lane * 4);
        j = j + 1;
    }
    s
}

fn t_roww(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, exp: i64, base: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 64 {
        let s: i64 = t_sumw(bank, off, j0, j1, lane) - t_sumw(bank, off, j1, j2, lane) + base;
        __mind_store_i64(exp + lane * 8, s);
        lane = lane + 1;
    }
    0
}


fn t_code64(j: i64, lane: i64) -> i64 {
    if j == 4 {
        if lane == 0 {
            return (0 - 9223372036854775807) - 1;
        }
        if lane == 1 {
            return 9223372036854775807;
        }
        return 1;
    }
    (j + 1) * 10 + lane
}

fn t_fill64(bank: i64, off: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 8 {
        __mind_store_i64(off + j * 8, j * 256);
        t_fill64_j(bank, j);
        j = j + 1;
    }
    0
}

fn t_fill64_j(bank: i64, j: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 32 {
        __mind_store_i64(bank + j * 256 + lane * 8, t_code64(j, lane));
        lane = lane + 1;
    }
    0
}

fn t_code32(j: i64, lane: i64) -> i64 {
    if j == 4 {
        return 2147483647;
    }
    if j == 5 {
        return 2147483647;
    }
    if j == 6 {
        if lane == 0 {
            return 0 - 2147483648;
        }
        return 0;
    }
    if j == 7 {
        if lane == 0 {
            return 0 - 2147483647;
        }
        return 1;
    }
    (j + 1) + lane
}

fn t_fill32(bank: i64, off: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 8 {
        __mind_store_i64(off + j * 8, j * 256);
        t_fill32_j(bank, j);
        j = j + 1;
    }
    0
}

fn t_fill32_j(bank: i64, j: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 64 {
        __mind_store_i32(bank + j * 256 + lane * 4, t_code32(j, lane));
        lane = lane + 1;
    }
    0
}

fn t_tail(out: i64, n: i64, v: i64) -> i64 {
    let mut i: i64 = n;
    let mut bad: i64 = 0;
    while i < 64 {
        bad = bad + t_neq(__mind_load_i64(out + i * 8), v);
        i = i + 1;
    }
    bad
}


fn t_desc(out: i64, bank: i64, off8: i64, off16: i64, starts: i64, rows: i64) -> i64 {
    let d: i64 = __mind_alloc(80);
    __mind_store_i64(d, out);
    __mind_store_i64(d + 8, 512);
    __mind_store_i64(d + 16, bank);
    __mind_store_i64(d + 24, off8);
    __mind_store_i64(d + 32, starts);
    __mind_store_i64(d + 40, 24);
    __mind_store_i64(d + 48, rows);
    __mind_store_i64(d + 56, 0);
    __mind_store_i64(d + 64, off8);
    __mind_store_i64(d + 72, off16);
    d
}

fn t_lanes(off8: i64, off16: i64, n: i64, div: i64) -> i64 {
    let mut j: i64 = 0;
    while j < n {
        let v: i64 = __mind_load_i64(off8 + j * 8) / div;
        __mind_store_i16(off16 + j * 2, v);
        j = j + 1;
    }
    0
}

fn t_call(d: i64, out: i64, flags: i64, bound: i64, base: i64) -> i64 {
    t_fill(out, 64, base);
    __mind_store_i64(d, out);
    t_mode(d, flags, bound);
    let bit4: i64 = flags & 16;
    if bit4 != 0 {
        __mind_store_i64(d + 24, __mind_load_i64(d + 72));
        return __mind_group_accrows_i64(d);
    }
    __mind_store_i64(d + 24, __mind_load_i64(d + 64));
    __mind_group_accrows_i64(d)
}

fn t_trio(d: i64, out: i64, alt: i64, rf: i64, exp: i64, lo: i64, bound: i64, base: i64, n: i64) -> i64 {
    t_call(d, out, lo + 24, bound, base);
    t_call(d, alt, lo + 16, bound, base);
    t_call(d, rf, lo, bound, base);
    t_bad(out, exp, n) + t_bad(alt, exp, n) + t_bad(rf, exp, n) + t_bad(out, rf, n)
}

fn t_sweep64(d: i64, out: i64, alt: i64, rf: i64, exp: i64, b64: i64, off8: i64, starts: i64) -> i64 {
    let mut bad: i64 = 0;
    let mut j0: i64 = 0;
    while j0 < 6 {
        let mut j1: i64 = j0;
        while j1 < 6 {
            let mut j2: i64 = j1;
            while j2 < 6 {
                t_put(starts, j0, j1, j2);
                t_row64(b64, off8, j0, j1, j2, exp, 0);
                bad = bad + t_trio(d, out, alt, rf, exp, 0, 0, 0, 32);
                bad = bad + t_tail(out, 32, 0);
                t_row64(b64, off8, j0, j1, j2, exp, 5);
                bad = bad + t_trio(d, out, alt, rf, exp, 1, 0, 5, 32);
                j2 = j2 + 1;
            }
            j1 = j1 + 1;
        }
        j0 = j0 + 1;
    }
    bad
}

fn t_sweep32(d: i64, out: i64, alt: i64, rf: i64, exp: i64, b32: i64, off8: i64, starts: i64) -> i64 {
    let mut bad: i64 = 0;
    let mut j0: i64 = 0;
    while j0 < 8 {
        let mut j1: i64 = j0;
        while j1 < 8 {
            let mut j2: i64 = j1;
            while j2 < 8 {
                t_put(starts, j0, j1, j2);
                t_row32(b32, off8, j0, j1, j2, exp, 0);
                bad = bad + t_trio(d, out, alt, rf, exp, 4, 0, 0, 64);
                t_row32(b32, off8, j0, j1, j2, exp, 7);
                bad = bad + t_trio(d, out, alt, rf, exp, 5, 0, 7, 64);
                t_roww(b32, off8, j0, j1, j2, exp, 0);
                bad = bad + t_trio(d, out, alt, rf, exp, 4, 2147483648, 0, 64);
                t_roww(b32, off8, j0, j1, j2, exp, 7);
                bad = bad + t_trio(d, out, alt, rf, exp, 5, 2147483648, 7, 64);
                j2 = j2 + 1;
            }
            j1 = j1 + 1;
        }
        j0 = j0 + 1;
    }
    bad
}

fn t_rows0(d: i64, out: i64, exp: i64, flags: i64, rows: i64) -> i64 {
    t_fill(out, 64, 3);
    t_fill(exp, 64, 3);
    __mind_store_i64(d + 48, rows);
    t_mode(d, flags, 0);
    __mind_store_i64(d, out);
    __mind_store_i64(d + 24, __mind_load_i64(d + 72));
    __mind_group_accrows_i64(d);
    let bad: i64 = t_bad(out, exp, 64);
    __mind_store_i64(d + 48, 1);
    bad
}

fn t_big64(d: i64, out: i64, alt: i64, rf: i64, exp: i64, starts: i64) -> i64 {
    let boff: i64 = __mind_alloc(24);
    let boff16: i64 = __mind_alloc(8);
    let big: i64 = __mind_alloc(524544);
    __mind_store_i64(boff, 0);
    __mind_store_i64(boff + 8, 524280);
    __mind_store_i64(boff + 16, 320000);
    __mind_store_i64(big, 11);
    __mind_store_i64(big + 524280, 22);
    __mind_store_i64(big + 320000, 33);
    t_lanes(boff, boff16, 3, 8);
    __mind_store_i64(d + 16, big);
    __mind_store_i64(d + 64, boff);
    __mind_store_i64(d + 72, boff16);
    t_put(starts, 0, 2, 3);
    t_row64(big, boff, 0, 2, 3, exp, 0);
    let mut bad: i64 = t_trio(d, out, alt, rf, exp, 0, 0, 0, 32);
    t_put(starts, 2, 3, 3);
    t_row64(big, boff, 2, 3, 3, exp, 1);
    bad + t_trio(d, out, alt, rf, exp, 1, 0, 1, 32)
}

fn t_big32(d: i64, out: i64, alt: i64, rf: i64, exp: i64, starts: i64) -> i64 {
    let boff: i64 = __mind_alloc(24);
    let boff16: i64 = __mind_alloc(8);
    let b4: i64 = __mind_alloc(262400);
    __mind_store_i64(boff, 0);
    __mind_store_i64(boff + 8, 262140);
    __mind_store_i64(boff + 16, 160000);
    __mind_store_i32(b4, 5);
    __mind_store_i32(b4 + 262140, 6);
    __mind_store_i32(b4 + 160000, 2147483647);
    t_lanes(boff, boff16, 3, 4);
    __mind_store_i64(d + 16, b4);
    __mind_store_i64(d + 64, boff);
    __mind_store_i64(d + 72, boff16);
    t_put(starts, 0, 3, 3);
    t_row32(b4, boff, 0, 3, 3, exp, 0);
    let mut bad: i64 = t_trio(d, out, alt, rf, exp, 4, 0, 0, 64);
    t_roww(b4, boff, 0, 3, 3, exp, 0);
    bad = bad + t_trio(d, out, alt, rf, exp, 4, 2147483648, 0, 64);
    t_put(starts, 1, 2, 3);
    t_roww(b4, boff, 1, 2, 3, exp, 1);
    bad + t_trio(d, out, alt, rf, exp, 5, 2147483648, 1, 64)
}

fn main() -> i64 {
    let b64: i64 = __mind_alloc(2048);
    let b32: i64 = __mind_alloc(2048);
    let off8: i64 = __mind_alloc(64);
    let off16: i64 = __mind_alloc(16);
    let starts: i64 = __mind_alloc(24);
    let out: i64 = __mind_alloc(512);
    let alt: i64 = __mind_alloc(512);
    let rf: i64 = __mind_alloc(512);
    let exp: i64 = __mind_alloc(512);
    let sec: i64 = __mind_alloc(64);
    t_fill64(b64, off8);
    t_lanes(off8, off16, 8, 8);
    let d: i64 = t_desc(out, b64, off8, off16, starts, 1);
    __mind_store_i64(sec + 8, t_sweep64(d, out, alt, rf, exp, b64, off8, starts));
    __mind_store_i64(sec + 16, t_rows0(d, out, exp, 16, 0) + t_rows0(d, out, exp, 24, 0 - 1));
    __mind_store_i64(sec + 24, t_big64(d, out, alt, rf, exp, starts));
    t_fill32(b32, off8);
    t_lanes(off8, off16, 8, 4);
    __mind_store_i64(d + 16, b32);
    __mind_store_i64(d + 64, off8);
    __mind_store_i64(d + 72, off16);
    __mind_store_i64(d + 48, 1);
    __mind_store_i64(sec + 32, t_sweep32(d, out, alt, rf, exp, b32, off8, starts));
    __mind_store_i64(sec + 40, t_rows0(d, out, exp, 20, 0) + t_rows0(d, out, exp, 28, 0 - 1));
    __mind_store_i64(sec + 48, t_big32(d, out, alt, rf, exp, starts));
    let bad: i64 = __mind_load_i64(sec + 8) + __mind_load_i64(sec + 16) + __mind_load_i64(sec + 24) + __mind_load_i64(sec + 32) + __mind_load_i64(sec + 40) + __mind_load_i64(sec + 48);
    __mind_store_i64(sec, bad);
    if bad != 0 {
        __mind_write(1, sec, 56, 0 - 1);
        return 1;
    }
    __mind_write(1, sec, 8, 0 - 1);
    0
}
