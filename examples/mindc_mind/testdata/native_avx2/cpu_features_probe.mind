// __mind_cpu_features_v1 probe. Exits 0 iff the mask has only bits 0..5, bit 2
// (AVX2) is set and bit 1 (AVX usable) implies bit 0 (SSE2); 3 when bit 2 is clear
// (a host or emulated CPU without AVX2: the reader must not fault there, and with
// no ymm row reachable the program carries no ISA guard, so it never exits 132).
fn bit(x: i64, k: i64) -> i64 {
    if k <= 0 {
        return x % 2;
    }
    bit(x / 2, k - 1)
}

fn main() -> i64 {
    let f: i64 = __mind_cpu_features_v1();
    if f < 0 {
        return 9;
    }
    if f >= 64 {
        return 8;
    }
    if bit(f, 1) == 1 {
        if bit(f, 0) == 0 {
            return 4;
        }
    }
    if bit(f, 2) == 0 {
        return 3;
    }
    0
}
