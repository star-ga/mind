// A ymm program whose entry takes (argc, argv), run as `prog mind-arg`: the W4b
// argc/argv binding stays the first bytes of the entry and the ISA guard follows it,
// keeping rdi/rsi. Exits 0 when argc == 2, argv[1] spells "mind-arg", argv[argc] is
// NULL and one vmovdqu_i32x8 copy of 32 bytes is exact; else the first failed check.

fn fill(p: i64, i: i64) -> i64 {
    if i >= 32 {
        return 0;
    }
    __mind_store_i8(p + i, i * 7 + 1);
    fill(p, i + 1)
}

fn same(a: i64, b: i64, i: i64) -> i64 {
    if i >= 32 {
        return 1;
    }
    if __mind_load_i8(a + i) != __mind_load_i8(b + i) {
        return 0;
    }
    same(a, b, i + 1)
}

fn main(argc: i64, argv: i64) -> i64 {
    if argc != 2 {
        return 1;
    }
    let a1: i64 = __mind_load_i64(argv + 8);
    // "mind-arg", little-endian, then its NUL
    if __mind_load_i64(a1) != 7454127180837972333 {
        return 2;
    }
    if __mind_load_i8(a1 + 8) != 0 {
        return 3;
    }
    if __mind_load_i64(argv + 16) != 0 {
        return 4;
    }
    let src: i64 = __mind_alloc(96) + 1;
    let dst: i64 = src + 40;
    let _f: i64 = fill(src, 0);
    if __mind_vmovdqu_i32x8(dst, src) != dst {
        return 5;
    }
    if same(dst, src, 0) != 1 {
        return 6;
    }
    0
}
