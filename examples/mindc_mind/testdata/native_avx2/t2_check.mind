// Kind 89 bit 3 value check. Exit 0 when the paired loop matches the bit-clear
// walk and the scalar twin. Stdout is the bad-lane count.

fn t_neq(a: i64, b: i64) -> i64 {
    if a != b {
        return 1;
    }
    0
}

fn t_sext(u: i64) -> i64 {
    if u >= 2147483648 {
        return u - 4294967296;
    }
    u
}

fn t_ld32(addr: i64) -> i64 {
    t_sext(__mind_load_i32(addr))
}

fn t_add32(s: i64, v: i64) -> i64 {
    let u: i64 = (s + v) & 4294967295;
    t_sext(u)
}

fn t_fill(buf: i64, n: i64, v: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i64(buf + i * 8, v);
        i = i + 1;
    }
    0
}

fn t_bad(got: i64, exp: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut bad: i64 = 0;
    while i < n {
        bad = bad + t_neq(__mind_load_i64(got + i * 8), __mind_load_i64(exp + i * 8));
        i = i + 1;
    }
    bad
}

fn t_desc(out: i64, bank: i64, off: i64, starts: i64, rows: i64) -> i64 {
    let d: i64 = __mind_alloc(64);
    __mind_store_i64(d, out);
    __mind_store_i64(d + 8, 512);
    __mind_store_i64(d + 16, bank);
    __mind_store_i64(d + 24, off);
    __mind_store_i64(d + 32, starts);
    __mind_store_i64(d + 40, 24);
    __mind_store_i64(d + 48, rows);
    __mind_store_i64(d + 56, 0);
    d
}

fn t_mode(d: i64, flags: i64, bound: i64) -> i64 {
    __mind_store_i64(d + 56, flags);
    __mind_store_i32(d + 60, bound);
    0
}

fn t_put(starts: i64, j0: i64, j1: i64, j2: i64) -> i64 {
    __mind_store_i64(starts, j0);
    __mind_store_i64(starts + 8, j1);
    __mind_store_i64(starts + 16, j2);
    0
}

fn t_sum64(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        s = s + __mind_load_i64(bank + __mind_load_i64(off + j * 8) + lane * 8);
        j = j + 1;
    }
    s
}

fn t_row64(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, exp: i64, base: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 32 {
        let s: i64 = t_sum64(bank, off, j0, j1, lane) - t_sum64(bank, off, j1, j2, lane) + base;
        __mind_store_i64(exp + lane * 8, s);
        lane = lane + 1;
    }
    0
}

fn t_sum32(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        s = t_add32(s, t_ld32(bank + __mind_load_i64(off + j * 8) + lane * 4));
        j = j + 1;
    }
    s
}

fn t_row32(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, exp: i64, base: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 64 {
        let s: i64 = t_add32(t_sum32(bank, off, j0, j1, lane), 0 - t_sum32(bank, off, j1, j2, lane));
        __mind_store_i64(exp + lane * 8, s + base);
        lane = lane + 1;
    }
    0
}

fn t_sumw(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        s = s + t_ld32(bank + __mind_load_i64(off + j * 8) + lane * 4);
        j = j + 1;
    }
    s
}

fn t_roww(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, exp: i64, base: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 64 {
        let s: i64 = t_sumw(bank, off, j0, j1, lane) - t_sumw(bank, off, j1, j2, lane) + base;
        __mind_store_i64(exp + lane * 8, s);
        lane = lane + 1;
    }
    0
}

fn t_call(d: i64, out: i64, flags: i64, bound: i64, base: i64) -> i64 {
    t_fill(out, 64, base);
    __mind_store_i64(d, out);
    t_mode(d, flags, bound);
    __mind_group_accrows_i64(d)
}

fn t_both(d: i64, out: i64, alt: i64, exp: i64, hi: i64, lo: i64, bound: i64, base: i64, n: i64) -> i64 {
    t_call(d, out, hi, bound, base);
    t_call(d, alt, lo, bound, base);
    t_bad(out, exp, n) + t_bad(alt, exp, n) + t_bad(out, alt, n)
}

fn t_code64(j: i64, lane: i64) -> i64 {
    if j == 4 {
        if lane == 0 {
            return (0 - 9223372036854775807) - 1;
        }
        if lane == 1 {
            return 9223372036854775807;
        }
        return 1;
    }
    (j + 1) * 10 + lane
}

fn t_fill64(bank: i64, off: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 8 {
        __mind_store_i64(off + j * 8, j * 256);
        t_fill64_j(bank, j);
        j = j + 1;
    }
    0
}

fn t_fill64_j(bank: i64, j: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 32 {
        __mind_store_i64(bank + j * 256 + lane * 8, t_code64(j, lane));
        lane = lane + 1;
    }
    0
}

fn t_code32(j: i64, lane: i64) -> i64 {
    if j == 4 {
        return 2147483647;
    }
    if j == 5 {
        return 2147483647;
    }
    if j == 6 {
        if lane == 0 {
            return 0 - 2147483648;
        }
        return 0;
    }
    if j == 7 {
        if lane == 0 {
            return 0 - 2147483647;
        }
        return 1;
    }
    (j + 1) + lane
}

fn t_fill32(bank: i64, off: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 8 {
        __mind_store_i64(off + j * 8, j * 256);
        t_fill32_j(bank, j);
        j = j + 1;
    }
    0
}

fn t_fill32_j(bank: i64, j: i64) -> i64 {
    let mut lane: i64 = 0;
    while lane < 64 {
        __mind_store_i32(bank + j * 256 + lane * 4, t_code32(j, lane));
        lane = lane + 1;
    }
    0
}

fn t_tail(out: i64, n: i64, v: i64) -> i64 {
    let mut i: i64 = n;
    let mut bad: i64 = 0;
    while i < 64 {
        bad = bad + t_neq(__mind_load_i64(out + i * 8), v);
        i = i + 1;
    }
    bad
}

fn main() -> i64 {
    let b64: i64 = __mind_alloc(2048);
    let b32: i64 = __mind_alloc(2048);
    let off: i64 = __mind_alloc(64);
    let starts: i64 = __mind_alloc(24);
    let out: i64 = __mind_alloc(512);
    let alt: i64 = __mind_alloc(512);
    let exp: i64 = __mind_alloc(512);
    t_fill64(b64, off);
    let d: i64 = t_desc(out, b64, off, starts, 1);
    let mut bad: i64 = 0;
    t_put(starts, 0, 3, 3);
    t_row64(b64, off, 0, 3, 3, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 8, 0, 0, 0, 32);
    bad = bad + t_tail(out, 32, 0);
    t_row64(b64, off, 0, 2, 3, exp, 5);
    t_put(starts, 0, 2, 3);
    bad = bad + t_both(d, out, alt, exp, 9, 1, 0, 5, 32);
    t_put(starts, 1, 2, 2);
    t_row64(b64, off, 1, 2, 2, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 8, 0, 0, 0, 32);
    t_put(starts, 2, 2, 2);
    t_fill(exp, 32, 0);
    bad = bad + t_both(d, out, alt, exp, 8, 0, 0, 9, 32);
    t_fill(exp, 32, 9);
    bad = bad + t_both(d, out, alt, exp, 9, 1, 0, 9, 32);
    t_put(starts, 3, 3, 5);
    t_row64(b64, off, 3, 3, 5, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 8, 0, 0, 0, 32);
    t_put(starts, 0, 4, 4);
    t_row64(b64, off, 0, 4, 4, exp, 1);
    bad = bad + t_both(d, out, alt, exp, 9, 1, 0, 1, 32);
    t_put(starts, 4, 5, 5);
    t_row64(b64, off, 4, 5, 5, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 8, 0, 0, 0, 32);
    t_fill(out, 64, 3);
    t_fill(exp, 64, 3);
    __mind_store_i64(d + 48, 0);
    t_mode(d, 8, 0);
    let r0: i64 = __mind_group_accrows_i64(d);
    bad = bad + t_bad(out, exp, 64);
    __mind_store_i64(d + 48, 0 - 1);
    t_mode(d, 12, 0);
    let r1: i64 = __mind_group_accrows_i64(d);
    bad = bad + t_bad(out, exp, 64);
    __mind_store_i64(d + 48, 1);
    t_fill32(b32, off);
    __mind_store_i64(d + 16, b32);
    t_put(starts, 0, 3, 4);
    t_row32(b32, off, 0, 3, 4, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 12, 4, 0, 0, 64);
    t_row32(b32, off, 0, 1, 1, exp, 7);
    t_put(starts, 0, 1, 1);
    bad = bad + t_both(d, out, alt, exp, 13, 5, 0, 7, 64);
    t_put(starts, 2, 4, 4);
    t_row32(b32, off, 2, 4, 4, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 12, 4, 0, 0, 64);
    t_put(starts, 4, 6, 6);
    t_row32(b32, off, 4, 6, 6, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 12, 4, 0, 0, 64);
    t_roww(b32, off, 4, 6, 6, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 12, 4, 2147483648, 0, 64);
    t_put(starts, 6, 7, 7);
    t_row32(b32, off, 6, 7, 7, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 12, 4, 0, 0, 64);
    t_roww(b32, off, 6, 7, 7, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 12, 4, 2147483648, 0, 64);
    let big: i64 = __mind_alloc(524544);
    let boff: i64 = __mind_alloc(16);
    __mind_store_i64(boff, 0);
    __mind_store_i64(boff + 8, 524280);
    __mind_store_i64(big, 11);
    __mind_store_i64(big + 524280, 22);
    __mind_store_i64(d + 16, big);
    __mind_store_i64(d + 24, boff);
    t_put(starts, 0, 2, 2);
    t_row64(big, boff, 0, 2, 2, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 8, 0, 0, 0, 32);
    let b4: i64 = __mind_alloc(262400);
    __mind_store_i32(b4, 5);
    __mind_store_i32(b4 + 262140, 6);
    __mind_store_i64(boff + 8, 262140);
    __mind_store_i64(d + 16, b4);
    t_row32(b4, boff, 0, 2, 2, exp, 0);
    bad = bad + t_both(d, out, alt, exp, 12, 4, 0, 0, 64);
    let w: i64 = __mind_alloc(8);
    __mind_store_i64(w, bad);
    __mind_write(1, w, 8, 0 - 1);
    if bad != 0 {
        return 1;
    }
    r0 + r1
}
