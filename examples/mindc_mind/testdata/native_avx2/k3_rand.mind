// i32-walk fast-path oracle (bound field 0, init 4). 10 rows x 10000 terms, plus one edge row.
// Codes are seeded pseudo-random (LCG, fixed seed 20261110), range -2^18..2^18-1, so the
// 5000-term partial sums stay inside i32. Signed codes make carries cross lane pairs.
// The fallback is covered by k3_fallback.mind and k3_bound.mind.
// Term count is 100001. Codes at j = 100000 are the i32 edges.
// Exit 0 when i32-walk, i64-walk (both halves) and the scalar twin match.
// Stdout: term count, then the bad-lane count.

fn kr_sext(u: i64) -> i64 {
    if u >= 2147483648 {
        return u - 4294967296;
    }
    u
}

fn kr_next(rng: i64) -> i64 {
    let x: i64 = (__mind_load_i64(rng) * 1103515245 + 12345) % 2147483648;
    __mind_store_i64(rng, x);
    x
}

fn kr_code(j: i64, lane: i64, rng: i64) -> i64 {
    if j == 100000 {
        if lane == 0 {
            return 2147483647;
        }
        if lane == 1 {
            return 0 - 1;
        }
        if lane == 2 {
            return 0 - 2147483648;
        }
        return lane;
    }
    (kr_next(rng) / 64) % 524288 - 262144
}

fn kr_fill_j(b32: i64, lo: i64, hi: i64, off: i64, j: i64, rng: i64) -> i64 {
    __mind_store_i64(off + j * 8, j * 256);
    let mut lane: i64 = 0;
    while lane < 64 {
        kr_store(b32, lo, hi, j, lane, kr_code(j, lane, rng));
        lane = lane + 1;
    }
    0
}

fn kr_store(b32: i64, lo: i64, hi: i64, j: i64, lane: i64, v: i64) -> i64 {
    __mind_store_i32(b32 + j * 256 + lane * 4, v);
    if lane < 32 {
        __mind_store_i64(lo + j * 256 + lane * 8, v);
        return 0;
    }
    __mind_store_i64(hi + j * 256 + (lane - 32) * 8, v);
    0
}

fn kr_fill(b32: i64, lo: i64, hi: i64, off: i64) -> i64 {
    let rng: i64 = __mind_alloc(8);
    __mind_store_i64(rng, 20261110);
    let mut j: i64 = 0;
    while j < 100001 {
        kr_fill_j(b32, lo, hi, off, j, rng);
        j = j + 1;
    }
    0
}

fn kr_sum32(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        let at: i64 = bank + __mind_load_i64(off + j * 8) + lane * 4;
        s = s + kr_sext(__mind_load_i32(at));
        j = j + 1;
    }
    s
}

fn kr_lane(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, lane: i64) -> i64 {
    kr_sum32(bank, off, j0, j1, lane) - kr_sum32(bank, off, j1, j2, lane)
}

fn kr_sum64(bank: i64, off: i64, j0: i64, j1: i64, lane: i64) -> i64 {
    let mut s: i64 = 0;
    let mut j: i64 = j0;
    while j < j1 {
        s = s + __mind_load_i64(bank + __mind_load_i64(off + j * 8) + lane * 8);
        j = j + 1;
    }
    s
}

fn kr_lane64(bank: i64, off: i64, j0: i64, j1: i64, j2: i64, lane: i64) -> i64 {
    kr_sum64(bank, off, j0, j1, lane) - kr_sum64(bank, off, j1, j2, lane)
}

fn kr_neq(a: i64, b: i64) -> i64 {
    if a != b {
        return 1;
    }
    0
}

fn kr_desc(out: i64, bank: i64, off: i64, starts: i64, init: i64) -> i64 {
    let d: i64 = __mind_alloc(64);
    __mind_store_i64(d, out);
    __mind_store_i64(d + 8, 512);
    __mind_store_i64(d + 16, bank);
    __mind_store_i64(d + 24, off);
    __mind_store_i64(d + 32, starts);
    __mind_store_i64(d + 40, 24);
    __mind_store_i64(d + 48, 11);
    __mind_store_i64(d + 56, init);
    d
}

fn kr_starts(starts: i64) -> i64 {
    let mut r: i64 = 0;
    while r < 10 {
        let b: i64 = starts + r * 24;
        __mind_store_i64(b, r * 10000);
        __mind_store_i64(b + 8, r * 10000 + 5000);
        __mind_store_i64(b + 16, r * 10000 + 10000);
        r = r + 1;
    }
    let e: i64 = starts + 10 * 24;
    __mind_store_i64(e, 100000);
    __mind_store_i64(e + 8, 100001);
    __mind_store_i64(e + 16, 100001);
    0
}

fn kr_bad_k3(b32: i64, off: i64, starts: i64, out: i64) -> i64 {
    let mut r: i64 = 0;
    let mut bad: i64 = 0;
    while r < 11 {
        bad = bad + kr_bad_one(b32, off, starts, out, r);
        r = r + 1;
    }
    bad
}

fn kr_bad_one(b32: i64, off: i64, starts: i64, out: i64, r: i64) -> i64 {
    let b: i64 = starts + r * 24;
    let j0: i64 = __mind_load_i64(b);
    let j1: i64 = __mind_load_i64(b + 8);
    let j2: i64 = __mind_load_i64(b + 16);
    let mut lane: i64 = 0;
    let mut bad: i64 = 0;
    while lane < 64 {
        let got: i64 = __mind_load_i64(out + r * 512 + lane * 8);
        bad = bad + kr_neq(got, kr_lane(b32, off, j0, j1, j2, lane));
        lane = lane + 1;
    }
    bad
}

fn kr_bad_k2(bank: i64, off: i64, starts: i64, out: i64, skew: i64) -> i64 {
    let mut r: i64 = 0;
    let mut bad: i64 = 0;
    while r < 11 {
        bad = bad + kr_bad_k2_row(bank, off, starts, out, skew, r);
        r = r + 1;
    }
    bad
}

fn kr_bad_k2_row(bank: i64, off: i64, starts: i64, out: i64, skew: i64, r: i64) -> i64 {
    let b: i64 = starts + r * 24;
    let j0: i64 = __mind_load_i64(b);
    let j1: i64 = __mind_load_i64(b + 8);
    let j2: i64 = __mind_load_i64(b + 16);
    let mut lane: i64 = 0;
    let mut bad: i64 = 0;
    while lane < 32 {
        let got: i64 = __mind_load_i64(out + r * 512 + lane * 8);
        bad = bad + kr_neq(got, kr_lane64(bank, off, j0, j1, j2, lane));
        lane = lane + 1;
    }
    bad + skew - skew
}

fn main() -> i64 {
    let b32: i64 = __mind_alloc(25600256);
    let lo: i64 = __mind_alloc(25600256);
    let hi: i64 = __mind_alloc(25600256);
    let off: i64 = __mind_alloc(800008);
    let starts: i64 = __mind_alloc(264);
    let out: i64 = __mind_alloc(5632);
    let klo: i64 = __mind_alloc(5632);
    let khi: i64 = __mind_alloc(5632);
    kr_fill(b32, lo, hi, off);
    kr_starts(starts);
    let d3: i64 = kr_desc(out, b32, off, starts, 4);
    let r3: i64 = __mind_group_accrows_i64(d3);
    let mut bad: i64 = kr_bad_k3(b32, off, starts, out);
    let dlo: i64 = kr_desc(klo, lo, off, starts, 0);
    let rlo: i64 = __mind_group_accrows_i64(dlo);
    bad = bad + kr_bad_k2(lo, off, starts, klo, 0);
    let dhi: i64 = kr_desc(khi, hi, off, starts, 0);
    let rhi: i64 = __mind_group_accrows_i64(dhi);
    bad = bad + kr_bad_k2(hi, off, starts, khi, 0);
    let w: i64 = __mind_alloc(16);
    __mind_store_i64(w, 100001);
    __mind_store_i64(w + 8, bad);
    __mind_write(1, w, 16, 0 - 1);
    if bad != 0 {
        return 1;
    }
    r3 + rlo + rhi
}
