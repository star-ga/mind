// Acceptance shape through kind 89: one row, eight add terms.
// The add-list body is the objdump count (12 instructions, 0 frame operands).

fn ew_block(bank: i64, j: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i64(bank + j * 256 + i * 8, j * 10 + i + 1);
        i = i + 1;
    }
    0
}

fn main() -> i64 {
    let bank: i64 = __mind_alloc(2048);
    let off: i64 = __mind_alloc(64);
    let starts: i64 = __mind_alloc(72);
    let out: i64 = __mind_alloc(256);
    let mut j: i64 = 0;
    while j < 8 {
        ew_block(bank, j);
        __mind_store_i64(off + j * 8, j * 256);
        j = j + 1;
    }
    __mind_store_i64(starts, 0);
    __mind_store_i64(starts + 8, 8);
    __mind_store_i64(starts + 16, 8);
    let d: i64 = __mind_alloc(64);
    __mind_store_i64(d, out);
    __mind_store_i64(d + 8, 576);
    __mind_store_i64(d + 16, bank);
    __mind_store_i64(d + 24, off);
    __mind_store_i64(d + 32, starts);
    __mind_store_i64(d + 40, 72);
    __mind_store_i64(d + 48, 1);
    __mind_store_i64(d + 56, 0);
    let r: i64 = __mind_group_accrows_i64(d);
    __mind_write(1, out, 256, 0 - 1);
    r
}
