// R-01b fence: register 15 (Layer A's scratch) is refused by name (ymm.register_out_of_range); twin: bank_twin_reg15.mind.

fn bank(p: i64) -> i64 {
    __mind_ymm_vmovdqu_ld(15, p, 0);
    __mind_ymm_vmovdqu_st(15, p, 32);
    0
}

fn main() -> i64 {
    let p: i64 = __mind_alloc(96);
    let mut i: i64 = 0;
    while i < 12 {
        __mind_store_i64(p + i * 8, i * 3 + 5);
        i = i + 1;
    }
    let _b: i64 = bank(p);
    __mind_load_i64(p + 32) + __mind_load_i64(p + 56) + __mind_load_i64(p + 64)
}
