// 8760 calls, 64 rows, 10 add terms and 10 sub terms, i32 mode. One checksum.
// desc[7] = 4. Each call replaces the row. Codes stay inside the i32 bound.

fn kp_block(bank: i64, j: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 64 {
        __mind_store_i32(bank + j * 256 + i * 4, (j + 3) * 17 + i);
        i = i + 1;
    }
    0
}

fn kp_bank(bank: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 20 {
        kp_block(bank, j);
        j = j + 1;
    }
    0
}

fn kp_off(off: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 20 {
        __mind_store_i64(off + j * 8, j * 256);
        j = j + 1;
    }
    0
}

fn kp_starts(starts: i64) -> i64 {
    let mut r: i64 = 0;
    while r < 64 {
        let b: i64 = starts + r * 24;
        __mind_store_i64(b, 0);
        __mind_store_i64(b + 8, 10);
        __mind_store_i64(b + 16, 20);
        r = r + 1;
    }
    0
}

fn kp_sum(buf: i64, words: i64) -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < words {
        s = s * 31 + __mind_load_i64(buf + i * 8);
        i = i + 1;
    }
    s
}

fn main() -> i64 {
    let bank: i64 = __mind_alloc(5120);
    let off: i64 = __mind_alloc(160);
    let starts: i64 = __mind_alloc(1536);
    let out: i64 = __mind_alloc(36864);
    kp_bank(bank);
    kp_off(off);
    kp_starts(starts);
    let d: i64 = __mind_alloc(64);
    __mind_store_i64(d, out);
    __mind_store_i64(d + 8, 576);
    __mind_store_i64(d + 16, bank);
    __mind_store_i64(d + 24, off);
    __mind_store_i64(d + 32, starts);
    __mind_store_i64(d + 40, 24);
    __mind_store_i64(d + 48, 64);
    __mind_store_i64(d + 56, 4);
    let mut n: i64 = 0;
    while n < 8760 {
        __mind_group_accrows_i64(d);
        n = n + 1;
    }
    let w: i64 = __mind_alloc(8);
    __mind_store_i64(w, kp_sum(out, 4608));
    __mind_write(1, w, 8, 0 - 1);
    0
}
