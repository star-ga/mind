// Kind 88 with a negative init, no guarded row, no other probe-skip call. The
// init top two bits are 3, 2 and 3: zero start, the probe runs as for init 1. Prior
// lanes are 7. One add term. Stdout is the three results in call order.
// A K1 skip that also took the negative inits would leave the probe out and die
// at the first VEX op (SIGILL) on a CPU with no AVX2.

fn st(p: i64, i: i64, v: i64) -> i64 {
    __mind_store_i64(p + i * 8, v);
    0
}

fn fill(p: i64, n: i64, v: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        st(p, i, v);
        i = i + 1;
    }
    0
}

fn main() -> i64 {
    let bank: i64 = __mind_alloc(256);
    let mut i: i64 = 0;
    while i < 32 {
        st(bank, i, 100 + i);
        i = i + 1;
    }
    let off: i64 = __mind_alloc(8);
    st(off, 0, 0);
    let o1: i64 = __mind_alloc(256);
    let o2: i64 = __mind_alloc(256);
    let o3: i64 = __mind_alloc(256);
    fill(o1, 32, 7);
    fill(o2, 32, 7);
    fill(o3, 32, 7);
    let r1: i64 = __mind_group_acc32_i64(o1, bank, off, 1, 0, 0 - 1);
    let r2: i64 = __mind_group_acc32_i64(o2, bank, off, 1, 0, 0 - 9223372036854775807 - 1);
    let r3: i64 = __mind_group_acc32_i64(o3, bank, off, 1, 0, 0 - 4611686018427387904);
    __mind_write(1, o1, 256, 0 - 1);
    __mind_write(1, o2, 256, 0 - 1);
    __mind_write(1, o3, 256, 0 - 1);
    r1 + r2 + r3
}
