// Kind 87 with a group whose low four bits are 8..15: group 11, then 27 (16 + 11).
// "Any other group reads and writes nothing": the bank keeps its sentinel 42. A
// 3-bit group mask would map both to group 3 and write its 13 rows. Stdout = the
// 832-byte bank, all sentinel. Host row only: group 27 has bit 4 set, no probe.

fn gs_a(p: i64) -> i64 {
    if p == 0 {
        return 1;
    }
    if p == 1 {
        return 2;
    }
    if p == 2 {
        return 3;
    }
    if p == 3 {
        return 4;
    }
    if p == 4 {
        return 100;
    }
    if p == 5 {
        return 549755813888;
    }
    return 0;
}

fn gs_b(p: i64) -> i64 {
    if p == 0 {
        return 5;
    }
    if p == 1 {
        return 0;
    }
    if p == 2 {
        return 9;
    }
    if p == 3 {
        return 1;
    }
    if p == 4 {
        return 1;
    }
    if p == 5 {
        return 2;
    }
    return 0;
}

fn gs_c(p: i64) -> i64 {
    if p == 0 {
        return 8;
    }
    if p == 1 {
        return 7;
    }
    if p == 2 {
        return 6;
    }
    if p == 3 {
        return 0;
    }
    if p == 4 {
        return 3;
    }
    if p == 5 {
        return 4;
    }
    return 0;
}

fn gs_x(p: i64) -> i64 {
    if p == 0 {
        return 2;
    }
    if p == 1 {
        return 4;
    }
    if p == 2 {
        return 6;
    }
    if p == 3 {
        return 8;
    }
    return 0;
}

fn gs_plane(n: i64, which: i64) -> i64 {
    let dst: i64 = __mind_alloc(n * 8 + 8);
    let mut p: i64 = 0;
    while p < n {
        let mut v: i64 = gs_x(p);
        if which == 0 {
            v = gs_a(p);
        }
        if which == 1 {
            v = gs_b(p);
        }
        if which == 2 {
            v = gs_c(p);
        }
        __mind_store_i64(dst + p * 8, v);
        p = p + 1;
    }
    dst
}

fn gs_ptrs(n: i64) -> i64 {
    let ptrs: i64 = __mind_alloc(32);
    __mind_store_i64(ptrs, gs_plane(n, 0));
    __mind_store_i64(ptrs + 8, gs_plane(n, 1));
    __mind_store_i64(ptrs + 16, gs_plane(n, 2));
    __mind_store_i64(ptrs + 24, gs_plane(n, 3));
    ptrs
}

fn gs_fill(dst: i64, words: i64, v: i64) -> i64 {
    let mut i: i64 = 0;
    while i < words {
        __mind_store_i64(dst + i * 8, v);
        i = i + 1;
    }
    0
}

fn main() -> i64 {
    let b: i64 = __mind_alloc(832);
    gs_fill(b, 104, 42);
    let r1: i64 = __mind_group_bank_i64(gs_ptrs(8), b, 64, 8, 11);
    let r2: i64 = __mind_group_bank_i64(gs_ptrs(8), b, 64, 8, 27);
    __mind_write(1, b, 832, 0 - 1);
    r1 + r2
}
