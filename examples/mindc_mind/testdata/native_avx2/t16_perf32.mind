// 8760 calls, 64 rows, 10 add terms and 10 sub terms. desc[7] is argv[1] (decimal).
// Bit 4 selects the u16 lane list. Same shape as the bit-clear walk. One checksum.

fn tq_block(bank: i64, j: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 64 {
        __mind_store_i32(bank + j * 256 + i * 4, (j + 3) * 17 + i);
        i = i + 1;
    }
    0
}

fn tq_bank(bank: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 20 {
        tq_block(bank, j);
        j = j + 1;
    }
    0
}

fn tq_put(off: i64, j: i64, u16: i64) -> i64 {
    if u16 == 1 {
        __mind_store_i16(off + j * 2, j * 64);
        return 0;
    }
    __mind_store_i64(off + j * 8, j * 256);
    0
}

fn tq_off(off: i64, u16: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 20 {
        tq_put(off, j, u16);
        j = j + 1;
    }
    0
}

fn tq_starts(starts: i64) -> i64 {
    let mut r: i64 = 0;
    while r < 64 {
        let b: i64 = starts + r * 24;
        __mind_store_i64(b, 0);
        __mind_store_i64(b + 8, 10);
        __mind_store_i64(b + 16, 20);
        r = r + 1;
    }
    0
}

fn tq_sum(buf: i64, words: i64) -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < words {
        s = s * 31 + __mind_load_i64(buf + i * 8);
        i = i + 1;
    }
    s
}

fn tt_num(p: i64) -> i64 {
    let mut i: i64 = 0;
    let mut n: i64 = 0;
    let mut b: i64 = __mind_load_i8(p + i);
    while b != 0 {
        n = n * 10 + (b - 48);
        i = i + 1;
        b = __mind_load_i8(p + i);
    }
    n
}

fn main(argc: i64, argv: i64) -> i64 {
    let mut mode: i64 = 13;
    if argc == 2 {
        mode = tt_num(__mind_argv(1));
    }
    let bit4: i64 = mode & 16;
    let mut u16: i64 = 0;
    if bit4 != 0 {
        u16 = 1;
    }
    let bank: i64 = __mind_alloc(5120);
    let off: i64 = __mind_alloc(160);
    let starts: i64 = __mind_alloc(1536);
    let out: i64 = __mind_alloc(36864);
    tq_bank(bank);
    tq_off(off, u16);
    tq_starts(starts);
    let d: i64 = __mind_alloc(64);
    __mind_store_i64(d, out);
    __mind_store_i64(d + 8, 576);
    __mind_store_i64(d + 16, bank);
    __mind_store_i64(d + 24, off);
    __mind_store_i64(d + 32, starts);
    __mind_store_i64(d + 40, 24);
    __mind_store_i64(d + 48, 64);
    __mind_store_i64(d + 56, mode);
    let mut n: i64 = 0;
    while n < 8760 {
        __mind_group_accrows_i64(d);
        n = n + 1;
    }
    let w: i64 = __mind_alloc(8);
    __mind_store_i64(w, tq_sum(out, 4608));
    __mind_write(1, w, 8, 0 - 1);
    0
}
