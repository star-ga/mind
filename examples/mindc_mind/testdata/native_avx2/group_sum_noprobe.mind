// Probe-skip on the acc32, bank3 and bank4 inputs. Kind 88 uses K1 =
// 4611686018427387904 (zero start, no probe) and K1 + 1 (keep, no probe).
// group 3/4 become 19/20 (bit 4 set, low 4 bits keep the group). Stdout is
// acc32 then bank3 then bank4, the same bytes as the unflagged fixtures.
// The host AVX2 path does not need a guarded row. On a CPU with no AVX2 the
// skipped probe dies at the first VEX op (SIGILL, status 132).

fn gs_block(dst: i64, base: i64, step: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i64(dst + i * 8, base + step * i);
        i = i + 1;
    }
    0
}

fn gs_a(p: i64) -> i64 {
    if p == 0 {
        return 1;
    }
    if p == 1 {
        return 2;
    }
    if p == 2 {
        return 3;
    }
    if p == 3 {
        return 4;
    }
    if p == 4 {
        return 100;
    }
    if p == 5 {
        return 549755813888;
    }
    return 0;
}

fn gs_b(p: i64) -> i64 {
    if p == 0 {
        return 5;
    }
    if p == 1 {
        return 0;
    }
    if p == 2 {
        return 9;
    }
    if p == 3 {
        return 1;
    }
    if p == 4 {
        return 1;
    }
    if p == 5 {
        return 2;
    }
    return 0;
}

fn gs_c(p: i64) -> i64 {
    if p == 0 {
        return 8;
    }
    if p == 1 {
        return 7;
    }
    if p == 2 {
        return 6;
    }
    if p == 3 {
        return 0;
    }
    if p == 4 {
        return 3;
    }
    if p == 5 {
        return 4;
    }
    return 0;
}

fn gs_x(p: i64) -> i64 {
    if p == 0 {
        return 2;
    }
    if p == 1 {
        return 4;
    }
    if p == 2 {
        return 6;
    }
    if p == 3 {
        return 8;
    }
    return 0;
}

fn gs_plane(n: i64, which: i64) -> i64 {
    let dst: i64 = __mind_alloc(n * 8 + 8);
    let mut p: i64 = 0;
    while p < n {
        let mut v: i64 = gs_x(p);
        if which == 0 {
            v = gs_a(p);
        }
        if which == 1 {
            v = gs_b(p);
        }
        if which == 2 {
            v = gs_c(p);
        }
        __mind_store_i64(dst + p * 8, v);
        p = p + 1;
    }
    dst
}

fn gs_ptrs(n: i64) -> i64 {
    let ptrs: i64 = __mind_alloc(32);
    __mind_store_i64(ptrs, gs_plane(n, 0));
    __mind_store_i64(ptrs + 8, gs_plane(n, 1));
    __mind_store_i64(ptrs + 16, gs_plane(n, 2));
    __mind_store_i64(ptrs + 24, gs_plane(n, 3));
    ptrs
}

fn gs_fill(dst: i64, words: i64, v: i64) -> i64 {
    let mut i: i64 = 0;
    while i < words {
        __mind_store_i64(dst + i * 8, v);
        i = i + 1;
    }
    0
}

fn main() -> i64 {
    let bank: i64 = __mind_alloc(1312);
    gs_block(bank + 8, 10, 1);
    gs_block(bank + 264, 5, 0);
    gs_block(bank + 528, 3, 0);
    gs_block(bank + 784, 4, 0);
    gs_block(bank + 1048, 8, 0);
    let off: i64 = __mind_alloc(40);
    __mind_store_i64(off, 8);
    __mind_store_i64(off + 8, 264);
    __mind_store_i64(off + 16, 528);
    __mind_store_i64(off + 24, 784);
    __mind_store_i64(off + 32, 1048);
    let out1: i64 = __mind_alloc(256);
    gs_block(out1, 1000, 7);
    let out2: i64 = __mind_alloc(256);
    gs_block(out2, 0, 1);
    let r1: i64 = __mind_group_acc32_i64(out1, bank, off, 2, 2, 4611686018427387904);
    let r2: i64 = __mind_group_acc32_i64(out2, bank, off + 32, 1, 0, 4611686018427387905);
    __mind_write(1, out1, 256, 0 - 1);
    __mind_write(1, out2, 256, 0 - 1);
    let b3: i64 = __mind_alloc(832);
    gs_fill(b3, 104, 0);
    let r3: i64 = __mind_group_bank_i64(gs_ptrs(8), b3, 64, 8, 19);
    __mind_write(1, b3, 832, 0 - 1);
    let b4: i64 = __mind_alloc(1280);
    gs_fill(b4, 160, 0);
    let r4: i64 = __mind_group_bank_i64(gs_ptrs(4), b4, 32, 4, 20);
    __mind_write(1, b4, 1280, 0 - 1);
    r1 + r2 + r3 + r4
}
