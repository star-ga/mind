// Group 3 over the N2 corpus (gs_a/b/c = n2s_a/b/c of the scalar oracle program
// native_avx2_i64_scalar.mind; pixels 6 and 7 are zero): 8 pixels, 13 rows 64
// bytes apart. Stdout = the 832-byte bank (the oracle's bytes 0..832); exit = the
// call's result (0).

fn gs_a(p: i64) -> i64 {
    if p == 0 {
        return 1;
    }
    if p == 1 {
        return 2;
    }
    if p == 2 {
        return 3;
    }
    if p == 3 {
        return 4;
    }
    if p == 4 {
        return 100;
    }
    if p == 5 {
        return 549755813888;
    }
    return 0;
}

fn gs_b(p: i64) -> i64 {
    if p == 0 {
        return 5;
    }
    if p == 1 {
        return 0;
    }
    if p == 2 {
        return 9;
    }
    if p == 3 {
        return 1;
    }
    if p == 4 {
        return 1;
    }
    if p == 5 {
        return 2;
    }
    return 0;
}

fn gs_c(p: i64) -> i64 {
    if p == 0 {
        return 8;
    }
    if p == 1 {
        return 7;
    }
    if p == 2 {
        return 6;
    }
    if p == 3 {
        return 0;
    }
    if p == 4 {
        return 3;
    }
    if p == 5 {
        return 4;
    }
    return 0;
}

fn gs_x(p: i64) -> i64 {
    if p == 0 {
        return 2;
    }
    if p == 1 {
        return 4;
    }
    if p == 2 {
        return 6;
    }
    if p == 3 {
        return 8;
    }
    return 0;
}

// which 0 a, 1 b, 2 c, 3 x: n pixels of that corpus plane.
fn gs_plane(n: i64, which: i64) -> i64 {
    let dst: i64 = __mind_alloc(n * 8 + 8);
    let mut p: i64 = 0;
    while p < n {
        let mut v: i64 = gs_x(p);
        if which == 0 {
            v = gs_a(p);
        }
        if which == 1 {
            v = gs_b(p);
        }
        if which == 2 {
            v = gs_c(p);
        }
        __mind_store_i64(dst + p * 8, v);
        p = p + 1;
    }
    dst
}

fn gs_ptrs(n: i64) -> i64 {
    let ptrs: i64 = __mind_alloc(32);
    __mind_store_i64(ptrs, gs_plane(n, 0));
    __mind_store_i64(ptrs + 8, gs_plane(n, 1));
    __mind_store_i64(ptrs + 16, gs_plane(n, 2));
    __mind_store_i64(ptrs + 24, gs_plane(n, 3));
    ptrs
}

fn gs_fill(dst: i64, words: i64, v: i64) -> i64 {
    let mut i: i64 = 0;
    while i < words {
        __mind_store_i64(dst + i * 8, v);
        i = i + 1;
    }
    0
}

fn main() -> i64 {
    let bank: i64 = __mind_alloc(832);
    gs_fill(bank, 104, 0);
    let r: i64 = __mind_group_bank_i64(gs_ptrs(8), bank, 64, 8, 3);
    __mind_write(1, bank, 832, 0 - 1);
    r
}
