// Store intrinsic used as a VALUE: the C runtime (MLIR build) returns 0 for
// __mind_store_i64/i8/i16/i32, so every read of a store's result must be 0.
// `junk` first dirties the stack so a stale result slot would be visible.
// Shape: value-if branch tail (store_i8): exit 40.
fn junk(a: i64, b: i64, c: i64) -> i64 {
    let x: i64 = a * 3;
    let y: i64 = x + b;
    let z: i64 = y + c;
    let u: i64 = z * 7;
    let v: i64 = u + 1;
    let q: i64 = v + 2;
    q
}

fn put(w: i64, v: i64) -> i64 {
    let r: i64 = if v > 3 {
        __mind_store_i8(w, v)
    } else {
        5
    };
    r
}

fn main() -> i64 {
    let w: i64 = __mind_alloc(64);
    let j: i64 = junk(11, 22, 33);
    put(w, 9) + 40
}
