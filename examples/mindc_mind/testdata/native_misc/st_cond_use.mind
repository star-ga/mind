// Store intrinsic used as a VALUE: the C runtime (MLIR build) returns 0 for
// __mind_store_i64/i8/i16/i32, so every read of a store's result must be 0.
// `junk` first dirties the stack so a stale result slot would be visible.
// Shape: a store-tail fn's result read in an if condition and in a while condition, and the same fn also called as a plain statement: exit 64.
fn junk(a: i64, b: i64, c: i64) -> i64 {
    let x: i64 = a * 3;
    let y: i64 = x + b;
    let z: i64 = y + c;
    let u: i64 = z * 7;
    let v: i64 = u + 1;
    let q: i64 = v + 2;
    q
}

fn b_set(w: i64, v: i64) -> i64 {
    __mind_store_i8(w, v)
}

fn main() -> i64 {
    let w: i64 = __mind_alloc(64);
    let j: i64 = junk(11, 22, 33);
    b_set(w, 3);
    let mut n: i64 = 0;
    if b_set(w, 30) == 0 {
        n = n + 10;
    }
    let mut k: i64 = 0;
    while b_set(w + 1, k) + k < 3 {
        k = k + 1;
    }
    n + k * 9 + __mind_load_i8(w) - 27 + 27 - 3
}
