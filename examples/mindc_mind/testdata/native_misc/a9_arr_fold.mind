// Array literal elements that fold by spec 3.2 (0 - 1, 2 * 3, (9 - 2) / 2, -(4)),
// read through a `let mut` loop index. Independent value: a = [-1, 6, 3, -4],
// s = -1 + 6 + 3 - 4 = 4; b = [10, -10] adds 0; 4 + 0 + 40 = 44.
fn main() -> i64 {
    let a = [0 - 1, 2 * 3, (9 - 2) / 2, -(4)];
    let b: [i64; 2] = [10, 0 - 10];
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < 4 {
        s = s + a[i];
        i = i + 1;
    }
    s + b[0] + b[1] + 40
}
