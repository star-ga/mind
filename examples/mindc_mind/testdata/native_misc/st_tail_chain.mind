// Store intrinsic used as a VALUE: the C runtime (MLIR build) returns 0 for
// __mind_store_i64/i8/i16/i32, so every read of a store's result must be 0.
// `junk` first dirties the stack so a stale result slot would be visible.
// Shape: a store result reaching the caller through TWO tail calls and a nested value-if (inner branch tail): exit 40.
fn junk(a: i64, b: i64, c: i64) -> i64 {
    let x: i64 = a * 3;
    let y: i64 = x + b;
    let z: i64 = y + c;
    let u: i64 = z * 7;
    let v: i64 = u + 1;
    let q: i64 = v + 2;
    q
}

fn w_set(w: i64, i: i64, v: i64) -> i64 {
    __mind_store_i64(w + i * 8, v)
}

fn via(w: i64, v: i64) -> i64 {
    let d: i64 = junk(v, 5, 6);
    if v > 3 {
        if v > 5 {
            w_set(w, 1, v)
        } else {
            w_set(w, 2, v)
        }
    } else {
        7
    }
}

fn outer(w: i64, v: i64) -> i64 {
    via(w, v)
}

fn main() -> i64 {
    let w: i64 = __mind_alloc(64);
    let j: i64 = junk(11, 22, 33);
    let a: i64 = outer(w, 9);
    let b: i64 = outer(w, 4);
    let c: i64 = outer(w, 1);
    a + b + c + __mind_load_i64(w + 8) + __mind_load_i64(w + 16) + 20
}
