fn byte_sum(s: String) -> i64 {
    let mut t: i64 = 0;
    let mut i: i64 = 0;
    while i < s.len {
        t = t + __mind_load_i8(s.addr + i);
        i = i + 1;
    }
    return t;
}

fn middle(s: String) -> i64 {
    return byte_sum(s) + byte_sum(s);
}

fn outer(s: String) -> i64 {
    return middle(s);
}

fn main() -> i64 {
    return outer("ABCD") % 256;
}
