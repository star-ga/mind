// Regression: triple-nested while + a post-loop alias in a 5-param fn (body-local
// lets and alias-break copies collided with param vids in the base0=0 probe).
fn fz(p0: i64, p1: i64, p2: i64, p3: i64, p4: i64) -> i64 {
    let mut s: i64 = p4;
    let mut c: i64 = 0;
    while c < 2 {
        let t: i64 = (c + p1);
        let mut u: i64 = t;
        let mut d: i64 = 0;
        while d < 2 {
            let mut e: i64 = 0;
            while e < 2 {
                u = (u + p3);
                e = (e + 1);
            }
            d = (d + 1);
        }
        s = (s + u);
        c = (c + 1);
    }
    let mut w: i64 = s;
    let mut k: i64 = 0;
    while k < 2 {
        w = (w + s);
        k = (k + 1);
    }
    return w;
}
fn main() -> i64 {
    return fz(0, 1, 2, 3, 4);
}
