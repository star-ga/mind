// Regression class (twin-emitter review round 3): loop in an if-then writes an outer var first seen inside the loop.
fn main() -> i64 {
    let mut y: i64 = 0;
    let mut c: i64 = 2;
    if c > 1 {
        let mut z: i64 = 2;
        while z < 5 {
            z = (z + 1);
            y = (y + z);
        }
    }
    let mut q: i64 = y;
    let mut k: i64 = 0;
    while k < 2 {
        k = (k + 1);
        q = (q + y);
    }
    return q;
}
