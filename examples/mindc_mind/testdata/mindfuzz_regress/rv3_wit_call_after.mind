// Regression class (twin-emitter review round 3): loop in an if-then writes an outer var first seen inside the loop.
fn h(v: i64) -> i64 {
    return (v * 2);
}
fn main() -> i64 {
    let mut y: i64 = 0;
    let mut c: i64 = 2;
    if c > 1 {
        let mut z: i64 = 2;
        while z < 5 {
            z = (z + 1);
            y = (y + z);
        }
    }
    return h(y);
}
