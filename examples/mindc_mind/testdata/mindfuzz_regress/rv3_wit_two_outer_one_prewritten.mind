// Regression class (twin-emitter review round 3): loop in an if-then writes an outer var first seen inside the loop.
fn main() -> i64 {
    let mut y: i64 = 0;
    let mut w: i64 = 0;
    let mut c: i64 = 2;
    if c > 1 {
        w = 1;
        let mut z: i64 = 2;
        while z < 5 {
            z = (z + 1);
            y = (y + z);
            w = (w + z);
        }
    }
    return (y + w);
}
