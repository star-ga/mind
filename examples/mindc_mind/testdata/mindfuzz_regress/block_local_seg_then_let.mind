// Regression class: block-local names (a then-block `let` shadowing an outer
// carried name) must not escape the block.
fn main() -> i64 {
    let a: i64 = 3;
    let mut x: i64 = 1;
    if a > 1 {
        if a > 2 {
            x = (a + 4);
        }
        let x: i64 = 9;
        if a > 0 {
            x = (x + 1);
        }
    }
    return x;
}
