// Regression class: assign-before-shadow (src/eval/lower.rs If arm, GAP 2).
// x = 5; let mut x = 7; x = 9 in a then-block: after the if, x carries the
// pre-shadow write (5) — the post-shadow assign writes the block-local shadow.
fn main() -> i64 {
    let mut a: i64 = 0;
    let mut x: i64 = 0;
    if a >= 1 {
        x = 5;
        let mut x: i64 = 7;
        x = 9;
    }
    return x;
}
