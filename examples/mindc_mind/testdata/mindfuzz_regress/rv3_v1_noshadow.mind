// Regression class (twin-emitter review round 3): minimized blind-review reproducer.
fn main() -> i64 {
    let mut x: i64 = 1;
    let mut y: i64 = 0;
    let mut c: i64 = 2;
    if c > 1 {
        let mut z: i64 = 2;
        while z < 5 {
            z = (z + 1);
            y = (y + z);
        }
    }
    return (x + y);
}
