// Regression class: assign-before-shadow (src/eval/lower.rs If arm, GAP 2).
// Two outer writes (the second reads the first), shadow, read-modify-write of the shadow.
fn main() -> i64 {
    let mut a: i64 = 1;
    let mut x: i64 = 0;
    if a >= 1 {
        x = 5;
        x = x + 2;
        let mut x: i64 = 7;
        x = x + 9;
    }
    return x;
}
