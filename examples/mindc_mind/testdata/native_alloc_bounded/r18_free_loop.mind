fn main() -> i64 {
    let mut i: i64 = 0;
    let mut a: i64 = 0;
    while i < 2000 {
        let p: i64 = __mind_alloc(1000000);
        __mind_store_i64(p, i);
        a = a + __mind_load_i64(p) - i;
        let f: i64 = __mind_free(p);
        a = a + f;
        i = i + 1;
    }
    return a + 33;
}
