// std vec_push itself: std/vec.mind vec_new + vec_push growing through
// __mind_realloc, vec_get, then __mind_free(vec_addr(v)) (the MLIR build
// resolves std vec to the C runtime, which has no vec_free). 20 rounds of
// 200000 pushes; std vec_push links and runs natively with the values MLIR
// computes. Sum of 0..199999 = 19999900000. Expected stdout "std\n", exit 9.
// Scale is kept moderate: every Vec value vec_push returns is a fresh native
// struct record that is never released (~32 bytes per push), whatever the
// allocator does.
import std.vec;

fn fill(n: i64) -> i64 {
    let mut v: Vec = vec_new();
    let mut i: i64 = 0;
    while i < n {
        v = vec_push(v, i);
        i = i + 1;
    }
    let mut s: i64 = 0;
    let mut j: i64 = 0;
    while j < n {
        s = s + vec_get(v, j);
        j = j + 1;
    }
    let f: i64 = __mind_free(vec_addr(v));
    s + f
}
fn say(a: i64, b: i64, c: i64, d: i64) -> i64 {
    let buf: i64 = __mind_alloc(8);
    __mind_store_i8(buf, a);
    __mind_store_i8(buf + 1, b);
    __mind_store_i8(buf + 2, c);
    __mind_store_i8(buf + 3, d);
    __mind_write(1, buf, 4, 0 - 1)
}
fn main() -> i64 {
    let mut k: i64 = 0;
    let mut acc: i64 = 0;
    while k < 20 {
        acc = acc + fill(200000) - 19999900000;
        k = k + 1;
    }
    let w: i64 = say(115, 116, 100, 10);
    acc + w + 5
}
