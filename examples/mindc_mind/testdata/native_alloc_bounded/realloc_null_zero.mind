// realloc(NULL, 0) (verifier repro edge/e04, W11c round 2). The C runtime's
// __mind_realloc is glibc realloc, and realloc(NULL, 0) == malloc(0) returns a
// non-null minimum block; native must agree. The block is usable, can be grown
// and freed. Expected exit 104, empty stdout.
fn main() -> i64 {
    let p: i64 = __mind_realloc(0, 0);
    let z: i64 = if p == 0 {
        0
    } else {
        100
    };
    let q: i64 = __mind_realloc(p, 16);
    __mind_store_i64(q + 8, 4);
    let v: i64 = __mind_load_i64(q + 8);
    let f: i64 = __mind_free(q);
    z + v + f
}
