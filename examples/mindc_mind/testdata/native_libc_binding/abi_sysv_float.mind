// extern "C" ABI row, System V: the f32 and f64 returns, kept apart from
// abi_sysv.mind so a failure here does not hide the other rows. Callee in abi_callees.c.
extern "C" {
    fn s_f32(a: f32) -> f32;
    fn s_f64(a: f64) -> f64;
}

pub fn t_s_f32() -> f32 {
    let a: f32 = 1.5 as f32;
    return s_f32(a)
}
pub fn t_s_f64() -> f64 {
    return s_f64(2.25)
}
