extern "C" {
    unsafe fn sendto(sockfd: i32, buf: *const u8, len: i32, flags: i32, dest_addr: *const u8, addrlen: i32) -> i64;
}

fn main() -> i64 {
    let minus_one: i64 = 0 - 1;
    let p: i64 = __mind_alloc(64);
    __mind_store_i64(p, 0);
    let r: i64 = sendto(minus_one as i32, p as *const u8, 1 as i32, 0 as i32, p as *const u8, 16 as i32) as i64;
    if r != minus_one {
        return 1;
    }
    return 42;
}
