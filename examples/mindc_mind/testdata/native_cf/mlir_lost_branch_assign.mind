// Known MLIR-backend defect, pinned: a value-if passed to a call that is used
// as an expression statement loses its branch's assignment on MLIR
// (`out(if x > 0 { x = 8; x } else { 0 }); x` exits 1 there). MIND keeps the
// store: the native backend and the interpreter both exit 8.
// expect: exit=8
// stdout:
// note: 2
// mlir: exit=1
fn out(v: i64) -> i64 {
    v
}
fn main() -> i64 {
    let mut x: i64 = 1;
    out(if x > 0 {
        x = 8;
        x
    } else {
        0
    });
    x
}
