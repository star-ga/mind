// f64 values through the HOME lowering: && in an if condition inside a loop, a float
// value-if nested in an assignment, break inside the else branch (A1 A7 L2).
// pick(1.5, 2.5, 6) = 5.5, pick(3.0, 1.0, 9) = -0.75 (break at i = 3),
// pick(-4.0, 8.0, 5) = 23.5; (5.5 - 1.5 + 23.5) * 16 + 1000 = 1440 = 160 mod 256.
// Known MLIR-backend defect, pinned: MLIR types the float loop-carried value
// as i64 in the loop's block arguments and fails to build.
// expect: exit=160
// stdout:
// note: 2
// mlir: nobuild=prior use here
fn pick(x: f64, y: f64, k: i64) -> f64 {
    let mut r: f64 = 0.0;
    let mut i: i64 = 0;
    while i < k {
        if x < y && i > 1 {
            r = r + (if x > 0.0 { x } else { y });
        } else {
            if i == 3 {
                break;
            }
            r = r - 0.25;
        }
        i = i + 1;
    }
    r
}
fn main() -> i64 {
    let v: f64 = pick(1.5, 2.5, 6) + pick(3.0, 1.0, 9) * 2.0 + pick(0.0 - 4.0, 8.0, 5);
    (v * 16.0) as i64 + 1000
}
