// Arbitrary nesting: six levels of if / while / value-if mixing every exit
// kind, in a function with parameters.
// expect: exit=58
// stdout: SAYG
// note: 2
fn out(v: i64) -> i64 {
    let p: i64 = __mind_alloc(8);
    __mind_store_i8(p, 65 + (v % 26 + 26) % 26);
    __mind_write(1, p, 1, 0 - 1);
    v
}
fn walk(n: i64, m: i64) -> i64 {
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < n {
        i = i + 1;
        if i % 2 == 1 {
            let mut j: i64 = 0;
            while j < m {
                j = j + 1;
                if j == 2 {
                    continue;
                } else if j > 3 {
                    if i > 4 && (if acc > 30 { 1 } else { 0 }) == 1 {
                        return acc + 1000;
                    }
                    break;
                }
                acc = acc + (if i > 2 { j * i } else { let t: i64 = j; t + 1 });
            }
        } else {
            if acc > 50 {
                break;
            }
        }
    }
    acc
}
fn main() -> i64 {
    let a: i64 = walk(3, 5);
    let b: i64 = walk(10, 5);
    let c: i64 = walk(10, 2);
    out(a % 26);
    out(c % 26);
    out(b % 26);
    out(walk(1, 9));
    return a + b % 256 + c;
}
