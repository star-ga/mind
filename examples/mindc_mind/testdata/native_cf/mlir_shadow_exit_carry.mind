// Known MLIR-backend defect, pinned: a let that shadows an outer variable
// inside an if block, followed by continue or break out of that block, makes
// MLIR carry the SHADOW's value into the outer variable (k20 gives 1000, k21
// 77, k11 51 there; exit (1000 + 77 + 51) & 255 = 104). MIND scopes the
// shadow to its block: the native backend and the interpreter give k20 9,
// k21 3, k11 9.
// expect: exit=21
// stdout: JDJ
// note: 2
// mlir: exit=104
fn out(v: i64) -> i64 {
    let p: i64 = __mind_alloc(8);
    __mind_store_i8(p, 65 + (v % 26 + 26) % 26);
    __mind_write(1, p, 1, 0 - 1);
    v
}
fn k20() -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < 6 {
        i = i + 1;
        if i % 2 == 0 {
            let s: i64 = 1000;
            continue;
        }
        s = s + i;
    }
    return s;
}
fn k21() -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < 6 {
        i = i + 1;
        if i == 3 {
            let s: i64 = 77;
            break;
        }
        s = s + i;
    }
    return s;
}
fn k11() -> i64 {
    let mut y: i64 = 7;
    let mut i: i64 = 0;
    while i < 3 {
        if i == 1 {
            let y: i64 = 50;
            i = i + y - 49;
            continue;
        }
        y = y + 1;
        i = i + 1;
        if y > 100 {
            return 0;
        }
    }
    return y;
}
fn main() -> i64 {
    let a: i64 = k20();
    let b: i64 = k21();
    let c: i64 = k11();
    out(a);
    out(b);
    out(c);
    return a + b + c;
}
