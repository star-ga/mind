// Lets that shadow an outer name inside loop bodies and if branches, on the
// HOME lowering (return inside a loop routes these functions there): the
// shadow lives until the end of its block and the outer variable is
// untouched, through break, continue, early return and fall-through. Every
// value is hand-derived: f01 35, f02 5, f12 33, h16 16, f22 9, f23 21.
// expect: exit=119
// stdout: JFHQJV
// note: 2
fn out(v: i64) -> i64 {
    let p: i64 = __mind_alloc(8);
    __mind_store_i8(p, 65 + (v % 26 + 26) % 26);
    __mind_write(1, p, 1, 0 - 1);
    v
}
fn f01() -> i64 {
    let x: i64 = 5;
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < 3 {
        let x: i64 = i * 10;
        acc = acc + x;
        i = i + 1;
        if acc > 100 {
            return 99;
        }
    }
    return acc + x;
}
fn f02() -> i64 {
    let mut t: i64 = 1;
    let mut k: i64 = 0;
    while k < 4 {
        let mut t: i64 = t + 100;
        t = t + 1;
        if t > 1000 {
            return 0;
        }
        k = k + 1;
    }
    t = t + k;
    return t;
}
fn f12() -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < 3 {
        let a: i64 = i;
        let a: i64 = a + 10;
        s = s + a;
        i = i + 1;
        if s > 500 {
            return 0;
        }
    }
    return s;
}
fn h16(p: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut s: i64 = 0;
    while i < n {
        let p: i64 = p * 2 + i;
        s = s + p;
        i = i + 1;
        if s > 1000 {
            return 0;
        }
    }
    return s + p;
}
fn f22() -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < 6 {
        i = i + 1;
        let s: i64 = s + 500;
        if i % 2 == 0 {
            continue;
        }
        if s < 0 {
            return 0;
        }
    }
    return s + 9;
}
fn f23() -> i64 {
    let mut s: i64 = 0;
    let mut i: i64 = 0;
    while i < 6 {
        i = i + 1;
        if i % 2 == 0 {
            let s: i64 = 1000;
            i = i + s - 1000;
        }
        s = s + i;
        if s > 5000 {
            return 0;
        }
    }
    return s;
}
fn main() -> i64 {
    let a: i64 = f01();
    let b: i64 = f02();
    let c: i64 = f12();
    let d: i64 = h16(3, 2);
    let e: i64 = f22();
    let f: i64 = f23();
    out(a);
    out(b);
    out(c);
    out(d);
    out(e);
    out(f);
    return a + b + c + d + e + f;
}
