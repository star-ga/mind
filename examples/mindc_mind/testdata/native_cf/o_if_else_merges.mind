// O1 / O2 / O3: if/else outside loops that merges assigned outer variables,
// branches where one arm returns and the other assigns, and an early-return
// branch that holds its own if/else.
// expect: exit=147
// stdout: CDHC
fn out(v: i64) -> i64 {
    let p: i64 = __mind_alloc(8);
    __mind_store_i8(p, 65 + (v % 26 + 26) % 26);
    __mind_write(1, p, 1, 0 - 1);
    v
}
fn merge(c: i64) -> i64 {
    let mut a: i64 = 1;
    let mut b: i64 = 2;
    if c > 0 {
        a = 10;
        if c > 5 {
            b = 20;
        }
    } else {
        b = 30;
        a = a + b;
    }
    a + b
}
fn mixed(x: i64) -> i64 {
    let mut r: i64 = 0;
    if x < 0 {
        return 0 - x;
    } else {
        r = x * 2;
    }
    if x == 3 {
        r = r + 1;
    } else if x == 4 {
        return 40;
    } else {
        r = r + 2;
    }
    r
}
fn early(x: i64, y: i64) -> i64 {
    if x > y {
        if x > 10 {
            return 1;
        } else {
            return 2;
        }
    }
    let mut z: i64 = x + y;
    if z > 10 {
        z = z - 10;
    } else {
        z = z + 100;
    }
    z
}
fn main() -> i64 {
    out(merge(1) - 10);
    out(mixed(0 - 3));
    out(mixed(3));
    out(early(4, 9) - 105);
    return merge(7) + merge(0) + mixed(4) + mixed(5) + early(20, 1) + early(5, 6) + early(3, 9);
}
