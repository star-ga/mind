// L1: `return` inside while bodies, from 1, 2 and 3 levels of nesting, inside
// if branches, in functions with and without parameters.
// expect: exit=151
// stdout: HHD
// note: 2
fn out(v: i64) -> i64 {
    let p: i64 = __mind_alloc(8);
    __mind_store_i8(p, 65 + (v % 26 + 26) % 26);
    __mind_write(1, p, 1, 0 - 1);
    v
}
fn find(limit: i64, target: i64) -> i64 {
    let mut i: i64 = 0;
    while i < limit {
        if i * i == target {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}
fn grid(n: i64) -> i64 {
    let mut a: i64 = 0;
    while a < n {
        let mut b: i64 = 0;
        while b < n {
            let mut c: i64 = 0;
            while c < n {
                if a * 100 + b * 10 + c == 123 {
                    return a + b + c;
                }
                c = c + 1;
            }
            b = b + 1;
        }
        a = a + 1;
    }
    0
}
fn first_odd() -> i64 {
    let mut k: i64 = 10;
    while k > 0 {
        k = k - 1;
        if k % 2 == 1 {
            out(k - 6);
            return k;
        }
    }
    100
}
fn main() -> i64 {
    out(find(10, 49));
    out(grid(5) + 1);
    return find(10, 50) + grid(4) * 20 + first_odd() * 3 + 5;
}
