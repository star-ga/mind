// Part-dispatch check, group-sum kinds 87..89 (split from part_dispatch_check_driver.mind so
// each composed program fits the frozen bounded seed's arena). Composed after main.mind and
// COMPILER_COMPONENTS, it calls the part chains directly. Exit 0 = every check holds; exit 64 =
// an owned group-sum kind emitted nothing with slot ids, emitted bytes with no ids or under an
// emission ctx, or failed nbp_kind_ok at exactly its arity (87: five, 88: six, 89: one).
// No while and no bitwise operator, so the bare-surface formatter parses this file.

pub fn pdc_mark(t: i64, g: i64, ok: i64) -> i64 {
    if ok == 1 {
        return 0;
    }
    __mind_store_i64(t + g * 8, 1);
    0
}

pub fn pdc_eq(a: i64, b: i64) -> i64 {
    if a == b {
        return 1;
    }
    0
}

pub fn pdc_le0(a: i64) -> i64 {
    if a <= 0 {
        return 1;
    }
    0
}

pub fn pdc_code() -> String {
    nb_push(nb_push(nb_push(string_new(), 72), 49), 192)
}

pub fn pdc_slots() -> i64 {
    let ids: i64 = __mind_alloc(48);
    __mind_store_i64(ids, 1);
    __mind_store_i64(ids + 8, 2);
    __mind_store_i64(ids + 16, 3);
    __mind_store_i64(ids + 24, 4);
    __mind_store_i64(ids + 32, 5);
    __mind_store_i64(ids + 40, 6);
    ids
}

// The group-sum parts own kinds 87..89 (k / 3 is 29): kind 87 (bank, five operands), 88
// (acc32, six), 89 (accrows, one desc). With slot ids each emits its real body (more than
// the 3 bytes of pdc_code) through both dispatchers; with no ids or under an emission ctx it
// emits nothing; nbp_kind_ok holds at exactly its arity (group 64). 1 = owned and checked.
pub fn pdc_group_owned(t: i64, k: i64) -> i64 {
    if pdc_eq(k / 3, 29) == 0 {
        return 0;
    }
    let ids: i64 = pdc_slots();
    let n: i64 = 5 + pdc_eq(k, 88) - 4 * pdc_eq(k, 89);
    pdc_mark(t, 6, pdc_eq(pdc_le0(string_len(nbp_emit_intrinsic(pdc_code(), k, ids, 7, 0)) - 3), 0));
    pdc_mark(t, 6, pdc_eq(pdc_le0(string_len(nb_emit_intrinsic(pdc_code(), k, ids, 7)) - 3), 0));
    pdc_mark(t, 6, pdc_eq(string_len(nbp_emit_intrinsic(pdc_code(), k, 0, 7, 0)), 0));
    pdc_mark(t, 6, pdc_eq(string_len(nbp_emit_intrinsic(pdc_code(), k, ids, 7, 1)), 0));
    pdc_mark(t, 6, pdc_eq(nbp_kind_ok(k, n), 1) * pdc_eq(nbp_kind_ok(k, n + 1), 0) * pdc_eq(nbp_kind_ok(k, n - 1), 0));
    1
}

pub fn pdc_groups(t: i64, k: i64) -> i64 {
    if k > 89 {
        return 0;
    }
    pdc_group_owned(t, k);
    pdc_groups(t, k + 1)
}

pub fn main() -> i64 {
    let t: i64 = __mind_alloc(64);
    __mind_store_i64(t + 48, 0);
    pdc_groups(t, 87);
    64 * __mind_load_i64(t + 48)
}
