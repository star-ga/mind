// Recursion without a loop frees on every level. Not counted: BUMP, and the image equals the base compiler's. Exit status 33.
fn rec(n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    let q: i64 = __mind_alloc(64);
    let z: i64 = __mind_free(q);
    return rec(n - 1) + z;
}
fn main() -> i64 {
    return rec(100) + 33;
}
