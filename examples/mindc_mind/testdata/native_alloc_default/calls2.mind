// A free 2 call(s) below the loop; each caller is defined before its callee. 1,100 x 1 MB. Exit status 33.
fn main() -> i64 {
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < 1100 {
        let p: i64 = __mind_alloc(1000000);
        __mind_store_i64(p, i);
        acc = acc + __mind_load_i64(p) - i;
        let z: i64 = step1(p);
        i = i + 1;
    }
    return acc + 33;
}
fn step1(p: i64) -> i64 {
    return step2(p);
}
fn step2(p: i64) -> i64 {
    return __mind_free(p);
}
