// The directive sits after code, outside the leading comment block: it does not count. RECLAIM. 1,100 x 1 MB. Exit status 33.
fn main() -> i64 {
    // mind: native_alloc = bump
    let mut i: i64 = 0;
    let mut acc: i64 = 0;
    while i < 1100 {
        let p: i64 = __mind_alloc(1000000);
        __mind_store_i64(p, i);
        acc = acc + __mind_load_i64(p) - i;
        let z: i64 = __mind_free(p);
        i = i + 1;
    }
    return acc + 33;
}
