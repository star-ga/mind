// getaddrinfo (a libc call that allocates with malloc) runs first, then 1 MB blocks stay live in a linked list
// until the arena (1 GiB) is full, then a free loop. One byte goes to stdout per block that the arena gave, so
// the count at the stop is the length of stdout: the image ends with `error: native arena exhausted` and exit
// status 70 at the same count on every run, with address-space randomization on.
extern "C" {
    unsafe fn getaddrinfo(node: *const u8, service: *const u8, hints: *const u8, res: *mut u8) -> i32;
}

fn main() -> i64 {
    let name: i64 = __mind_alloc(16);
    // "localhost"
    __mind_store_i64(name, 8317981851476258668);
    __mind_store_i64(name + 8, 116);
    let res: i64 = __mind_alloc(8);
    let none: i64 = 0;
    let rc: i32 = getaddrinfo(name as *const u8, none as *const u8, none as *const u8, res as *mut u8);
    let dot: i64 = __mind_alloc(8);
    __mind_store_i8(dot, 46);
    let mut prev: i64 = 0;
    let mut i: i64 = 0;
    while i < 1100 {
        let p: i64 = __mind_alloc(1000000);
        __mind_store_i64(p, prev);
        prev = p;
        let w: i64 = __mind_write(1, dot, 1, 0 - 1);
        i = i + 1;
    }
    while prev != 0 {
        let nx: i64 = __mind_load_i64(prev);
        let z: i64 = __mind_free(prev);
        prev = nx;
    }
    return 33;
}
