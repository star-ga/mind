// A function that frees, called once outside every loop and from a loop 1,100 x 1 MB. Exit status 33.
fn main() -> i64 {
    let q: i64 = __mind_alloc(64);
    let mut acc: i64 = release(q);
    let mut i: i64 = 0;
    while i < 1100 {
        let p: i64 = __mind_alloc(1000000);
        __mind_store_i64(p, i);
        acc = acc + __mind_load_i64(p) - i;
        acc = acc + release(p);
        i = i + 1;
    }
    return acc + 33;
}
fn release(p: i64) -> i64 {
    return __mind_free(p);
}
