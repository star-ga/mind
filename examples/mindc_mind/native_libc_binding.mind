pub fn ncb_text(kind: i64, p: i64) -> i64 {
    if kind == 0 {
        return ncb_text_0(p);
    }
    if kind == 1 {
        return ncb_text_1(p);
    }
    if kind == 2 {
        return ncb_text_2(p);
    }
    if kind == 3 {
        return ncb_text_3(p);
    }
    if kind == 4 {
        return ncb_text_4(p);
    }
    if kind == 5 {
        return ncb_text_5(p);
    }
    if kind == 6 {
        return ncb_text_6(p);
    }
    if kind == 7 {
        return ncb_text_7(p);
    }
    if kind == 8 {
        return ncb_text_8(p);
    }
    1
}

pub fn ncb_mask(catalog: i64, slot: i64) -> i64 {
    let mut mask: i64 = 1;
    let kind: i64 = __mind_load_i64(catalog + 16);
