pub fn ncb_size(n: i64, wn: i64, slots: i64, name: i64, version: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    if n > 4194304 {
        return 0;
    }
    if wn < 12 {
        return 0;
    }
    if wn > 8388608 {
        return 0;
    }
    if slots < 1 {
        return 0;
    }
    if slots > 6 {
        return 0;
    }
    if name < 1 {
        return 0;
    }
    if name > 16 {
        return 0;
    }
    if version < 1 {
        return 0;
    }
    if version > 16 {
        return 0;
    }
    let fixed: i64 = 192 + slots * 40 + name + version + ncb_text_len(7) + ncb_text_len(8);
    if n > 16777216 - fixed {
        return 0;
    }
    if wn > 16777216 - fixed - n {
        return 0;
    }
    fixed + n + wn
}
