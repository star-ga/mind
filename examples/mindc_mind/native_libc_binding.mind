pub fn ncb_zero(p: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(p + i, 0);
        i = i + 1;
    }
    0
}

pub fn ncb_copy(dst: i64, src: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + i, __mind_load_i8(src + i));
        i = i + 1;
    }
    0
}

pub fn ncb_same_step(same: i64, a: i64, b: i64, i: i64) -> i64 {
    if same == 0 {
        return 0;
    }
    if __mind_load_i8(a + i) != __mind_load_i8(b + i) {
        return 0;
    }
    1
}

pub fn ncb_same(a: i64, b: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    let mut same: i64 = 1;
    while i < n {
        same = ncb_same_step(same, a, b, i);
        i = i + 1;
    }
    same
}

pub fn ncb_error(diag: i64, error: i64, offset: i64, registry: i64) -> i64 {
    __mind_store_i64(diag, error);
    __mind_store_i64(diag + 8, offset);
    __mind_store_i64(diag + 16, registry);
    0
}

pub fn ncb_input(source: i64, n: i64) -> i64 {
    if n < 0 {
        return 0;
    }
    if n > 4194304 {
        return 0;
    }
    if source < 0 {
        return 0;
    }
    if source == 0 {
        if n != 0 {
            return 0;
        }
    }
    if source > 9223372036854775807 - n {
        return 0;
    }
    1
}

pub fn ncb_type_key(ty: i64) -> i64 {
    let n: i64 = __mind_load_i64(ty);
    if n < 1 {
        return 0 - 1;
    }
    if n > 3 {
        return 0 - 1;
    }
    let mut bits: i64 = n << 32;
    let mut i: i64 = 0;
    while i < n {
        bits = bits | (__mind_load_i8(ty + 8 + i) << (8 * i));
        i = i + 1;
    }
    bits
}

