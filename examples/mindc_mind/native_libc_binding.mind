    let base: i64 = out + 192 + slots * 40;
    let _src: i64 = ncb_copy(base, snapshot, n);
    let _wire: i64 = ncb_copy(base + n, wire, wn);
    let name: i64 = __mind_load_i64(catalog + 40);
    let _name: i64 = ncb_copy(base + n + wn, catalog + 48, name);
    let version: i64 = __mind_load_i64(catalog + 32);
    let vlen: i64 = ncb_text_len(version);
    let _version: i64 = ncb_text(version, base + n + wn + name);
    let _soname: i64 = ncb_text(7, base + n + wn + name + vlen);
    let _interp: i64 = ncb_text(8, base + n + wn + name + vlen + ncb_text_len(7));
