pub fn ncb_find_step(src: i64, row: i64, catalog: i64, id: i64, found: i64) -> i64 {
    if found != 0 {
        return found;
    }
    let _load: i64 = ncb_contract(id, catalog);
    let lo: i64 = __mind_load_i64(row);
    let n: i64 = __mind_load_i64(row + 8) - lo;
    if n != __mind_load_i64(catalog + 40) {
        return 0;
    }
    if ncb_same(src + lo, catalog + 48, n) == 0 {
        return 0;
    }
    id
}

pub fn ncb_find(src: i64, row: i64, catalog: i64) -> i64 {
    let mut found: i64 = 0;
    let mut id: i64 = 1;
    while id <= 36 {
        found = ncb_find_step(src, row, catalog, id, found);
        id = id + 1;
    }
    found
}

pub fn ncb_param_same(row: i64, catalog: i64, i: i64, same: i64) -> i64 {
    if same == 0 {
        return 0;
    }
    let ty: i64 = __mind_load_i64(__mind_load_i64(row + 48) + i * 8);
    if ncb_type_key(ty) != __mind_load_i64(catalog + 72 + i * 8) {
        return 0;
    }
    1
}

pub fn ncb_shape(row: i64, catalog: i64) -> i64 {
    let cc: i64 = __mind_load_i64(row + 16);
    if cc != 0 {
        if cc != 1 {
            return 0;
        }
    }
    let safety: i64 = __mind_load_i64(row + 24);
    if safety < 0 {
        return 0;
    }
    if safety > 1 {
        return 0;
    }
    if __mind_load_i64(row + 32) != 0 {
        return 0;
    }
    let np: i64 = __mind_load_i64(row + 40);
    if np != __mind_load_i64(catalog) {
        return 0;
    }
    if ncb_type_key(__mind_load_i64(row + 56)) != __mind_load_i64(catalog + 64) {
        return 0;
    }
    let mut same: i64 = 1;
    let mut i: i64 = 0;
    while i < np {
        same = ncb_param_same(row, catalog, i, same);
        i = i + 1;
    }
    same
}

pub fn ncb_text_len(kind: i64) -> i64 {
    if kind == 0 {
        return 11;
    }
    if kind == 1 {
        return 9;
    }
    if kind == 2 {
        return 9;
    }
    if kind == 3 {
        return 10;
    }
    if kind == 4 {
        return 10;
    }
    if kind == 5 {
        return 10;
    }
    if kind == 6 {
        return 10;
    }
    if kind == 7 {
        return 9;
    }
    if kind == 8 {
        return 27;
    }
    0
}

