pub fn ncb_row_binding(registry: i64, index: i64, diag: i64) -> i64 {
    let count: i64 = __mind_load_i64(registry + 24);
    if index < 0 {
        return ncb_error(diag, 4, 0, 0);
    }
    if index >= count {
        return ncb_error(diag, 4, 0, 0);
    }
    let row: i64 = __mind_load_i64(__mind_load_i64(registry + 16) + index * 8);
    let catalog: i64 = __mind_alloc(256);
    if catalog == 0 {
        return ncb_error(diag, 7, 0, 0);
    }
    let source: i64 = __mind_load_i64(registry);
    let n: i64 = __mind_load_i64(registry + 8);
    let id: i64 = ncb_find(source, row, catalog);
    if id == 0 {
        __mind_free(catalog);
        return ncb_error(diag, 5, __mind_load_i64(row), 0);
    }
    if ncb_shape(row, catalog) == 0 {
        __mind_free(catalog);
        return ncb_error(diag, 6, __mind_load_i64(row), 0);
    }
    let wire: String = nb_cabi_encode(registry);
    let wn: i64 = string_len(wire);
    let total: i64 = ncb_size(n, wn, __mind_load_i64(catalog) + 1, __mind_load_i64(catalog + 40), ncb_text_len(__mind_load_i64(catalog + 32)));
    if total == 0 {
        __mind_free(string_addr(wire));
        __mind_free(catalog);
        return ncb_error(diag, 8, 0, 0);
    }
    let out: i64 = __mind_alloc(total);
    if out == 0 {
        __mind_free(string_addr(wire));
        __mind_free(catalog);
        return ncb_error(diag, 7, 0, 0);
    }
    let _head: i64 = ncb_header(out, total, n, wn, row, index, id, catalog);
    let _body: i64 = ncb_payload(out, source, n, string_addr(wire), wn, catalog);
    __mind_free(string_addr(wire));
    __mind_free(catalog);
    out
}
pub fn ncb_build(source: i64, n: i64, row: i64, profile: i64, diag: i64) -> i64 {
    let _clear: i64 = ncb_zero(diag, 32);
    if profile != 1 {
        return ncb_error(diag, 2, 0, 0);
    }
    if ncb_input(source, n) == 0 {
        return ncb_error(diag, 1, 0, 0);
    }
    let snapshot: i64 = __mind_alloc(n + 8);
    if snapshot == 0 {
        return ncb_error(diag, 7, 0, 0);
    }
    let _copy: i64 = ncb_copy(snapshot, source, n);
    __mind_store_i64(snapshot + n, 0);
    let registry: i64 = nb_cabi_build(snapshot, n);
    if registry == 0 {
        __mind_free(snapshot);
        return ncb_error(diag, 7, 0, 0);
    }
    let error: i64 = __mind_load_i64(registry + 32);
    if error != 0 {
        let _e: i64 = ncb_error(diag, 3, __mind_load_i64(registry + 40), error);
        let _release: i64 = ncb_release(registry, snapshot, 0, 0);
        return 0;
    }
    let out: i64 = ncb_row_binding(registry, row, diag);
    let _release: i64 = ncb_release(registry, snapshot, 0, 0);
    out
}
pub fn ncb_check(plan: i64, length: i64, source: i64, n: i64, row: i64, profile: i64, diag: i64) -> i64 {
    let _clear: i64 = ncb_zero(diag, 32);
    if length < 192 {
        let _e: i64 = ncb_error(diag, 1, 0, 0);
        return 1;
    }
    if length > 16777216 {
        let _e: i64 = ncb_error(diag, 1, 0, 0);
        return 1;
    }
    if plan <= 0 {
        let _e: i64 = ncb_error(diag, 1, 0, 0);
        return 1;
    }
    if plan > 9223372036854775807 - length {
        let _e: i64 = ncb_error(diag, 1, 0, 0);
        return 1;
    }
    let fresh: i64 = ncb_build(source, n, row, profile, diag);
    if fresh == 0 {
        return __mind_load_i64(diag);
    }
    let size: i64 = __mind_load_i64(fresh + 8);
    let mut same: i64 = 0;
    if size == length {
        same = ncb_same(plan, fresh, size);
    }
    __mind_free(fresh);
    if same == 0 {
        let _e: i64 = ncb_error(diag, 9, 0, 0);
        return 9;
    }
    0
}
pub fn ncb_free(plan: i64) -> i64 {
    __mind_free(plan);
    0
}
// Explicit low32 view only. This helper grants no permission to emit a call.
pub fn ncb_low32_view(value: i64, action: i64, out: i64) -> i64 {
    __mind_store_i64(out, 0);
    if action != 1 {
        if action != 2 {
            return 1;
        }
    }
    let lo: i64 = value & 4294967295;
    let mut result: i64 = lo;
    if action == 2 {
        if lo >= 2147483648 {
            result = lo - 4294967296;
        }
    }
    __mind_store_i64(out, result);
    0
}
