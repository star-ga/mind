    if (__mind_load_i64(catalog + 64 + slot * 8) >> 32) > 1 {
        mask = mask | 8;
    }
    let action: i64 = __mind_load_i64(catalog + 160 + slot * 8);
    if action == 1 {
        mask = mask | 16;
    }
    if action == 2 {
        mask = mask | 16;
    }
    if __mind_load_i64(catalog + 24) == 1 {
        mask = mask | 32;
    }
    mask
}

pub fn ncb_slot(out: i64, catalog: i64, i: i64) -> i64 {
