    __mind_store_i64(slot + 24, __mind_load_i64(catalog + 112 + i * 8));
    __mind_store_i64(slot + 32, ncb_mask(catalog, i));
    0
}

pub fn ncb_lib_varargs(catalog: i64) -> i64 {
