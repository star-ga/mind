pub fn main() -> i64 {
    let mut mode: i64 = 0;
    if __mind_argc() > 1 {
        let p: i64 = __mind_argv(1);
        let mut i: i64 = 0;
        while __mind_load_i8(p + i) != 0 {
            mode = mode * 10 + __mind_load_i8(p + i) - 48;
            i = i + 1;
