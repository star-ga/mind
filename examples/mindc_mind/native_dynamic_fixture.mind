pub fn nd_hex_nibble(b: i64) -> i64 {
    if b >= 97 { if b <= 102 { return b - 87; } }
    if b >= 48 { if b <= 57 { return b - 48; } }
    0 - 1
}
pub fn nd_hex(s: String) -> String {
    if string_len(s) % 2 != 0 { return string_new(); }
    let mut out: String = string_new();
    let mut i: i64 = 0;
    while i < string_len(s) {
        let a: i64 = nd_hex_nibble(string_get_byte(s, i));
        let b: i64 = nd_hex_nibble(string_get_byte(s, i + 1));
        if a < 0 { return string_new(); }
        if b < 0 { return string_new(); }
        out = nb_push(out, a * 16 + b);
        i = i + 2;
    }
    out
}
