    }
    let out: String = nd_fixture(mode);
    let mut pos: i64 = 0;
    while pos < string_len(out) {
        let n: i64 = __mind_write(1, string_addr(out) + pos, string_len(out) - pos, 0 - 1);
        if n <= 0 { return 70; }
        pos = pos + n;
    }
    0
}
