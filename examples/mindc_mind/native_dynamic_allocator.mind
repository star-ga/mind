// Standalone checked dynamic allocator emitter. No native admission or startup.
// Requires std.string, nb_le/nb_i64le encoders and native_dynamic_layout.mind.
// Caller pointers must be valid; request80B/metadata64B must not overlap.
pub fn nda_code_size() -> i64 {
    2358
}
pub fn nda_emit(request: i64, metadata: i64) -> String {
    let mut i: i64 = 0;
    while i < 8 {
        __mind_store_i64(metadata + i * 8, 0);
        i = i + 1;
    }
    let layout: i64 = __mind_alloc(256);
    if layout == 0 {
        return string_new();
    }
    let status: i64 = ndl_plan(request, layout);
    if status != 0 {
        __mind_free(layout);
        return string_new();
    }
    if __mind_load_i64(request + 8) < nda_code_size() {
        __mind_free(layout);
        return string_new();
    }
    let a: i64 = __mind_load_i64(layout + 120);
    let st: i64 = __mind_load_i64(layout + 136);
    let ob: i64 = __mind_load_i64(layout + 144);
    let oe: i64 = __mind_load_i64(layout + 152);
    __mind_free(layout);
    let code: String = nda_blob_p1(string_new(), a, a + 8, st, ob, a + 72, ob + 8, oe, a + 64);
    if string_len(code) != nda_code_size() {
        return string_new();
    }
    __mind_store_i64(metadata + 8, 0);
    __mind_store_i64(metadata + 16, 291);
    __mind_store_i64(metadata + 24, 344);
    __mind_store_i64(metadata + 32, 393);
    __mind_store_i64(metadata + 40, nda_code_size());
    __mind_store_i64(metadata, 1);
    code
}

