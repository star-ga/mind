pub fn main() -> i64 {
    // Real OS argv (proven self-hosted in task #225). Flags are recognized here;
    // the source is read BY PATH (task #228, __mind_open) when a positional
    // path arg is given, else the stdin fallback — see ckd_read_src below.
    let a: Args = args_from_os();
    let no_tc: i64 = args_has_flag(a, ckd_s_no_tc(), ckd_s_empty());
    let has_fix: i64 = args_has_flag(a, ckd_s_fix(), ckd_s_empty());
    let _nofmt: i64 = args_has_flag(a, ckd_s_no_fmt(), ckd_s_empty());
    let _nolint: i64 = args_has_flag(a, ckd_s_no_lint(), ckd_s_empty());
    // --reporter <value>: human (default), json, or lsp. Uses the recursive
    // ckd_arg_after (NOT cli's args_flag_value, which hits the in-loop-mut native
    // miscompile). ckd_reporter_kind: 1 = json, 2 = lsp, 0 = human.
    let reporter: String = ckd_arg_after(a, ckd_s_reporter(), 0, args_len(a));
    let kind: i64 = ckd_reporter_kind(reporter);

    // --fix is recognized + STUBBED (no source rewrite yet). Surface the stub as a
    // note ONLY in human mode — a "note:" line would corrupt the JSON/LSP array.
    if has_fix == 1 {
        if kind == 0 {
            let _n: i64 = ckd_note(ckd_msg_fix());
        }
    }

    // Read the source to check: BY PATH (RI-C task #228, __mind_open) if a
    // positional path arg is given, else the stdin fallback. Ask for ONE byte
    // beyond `cap` so a source that fills `cap` and one LARGER than `cap` are
    // distinguishable (see the overflow probe below).
    let cap: i64 = 4194304;
    let src: i64 = __mind_alloc(cap + 16);
    let src_len: i64 = ckd_read_src(a, src, cap + 1);
    // The path could not be opened, OR a read(2) failed partway through -> report
    // + exit 1 (never proceed on a partial read). Machine reporters emit an empty
    // array so a consumer still gets valid JSON; the exit code carries the failure.
    if src_len < 0 {
        if kind == 0 {
            let _e: i64 = ckd_note(ckd_msg_openerr());
        }
        if kind != 0 {
            let _ea: i64 = ckd_puts(ckd_arr_empty_nl());
        }
        return 1;
    }
    // The source did not fit in `cap` bytes -> report + exit 1 rather than
    // silently typechecking only the first `cap` bytes.
    if src_len > cap {
        if kind == 0 {
            let _t: i64 = ckd_note(ckd_msg_toolarge());
        }
        if kind != 0 {
            let _ta: i64 = ckd_puts(ckd_arr_empty_nl());
        }
        return 1;
    }

    // --no-typecheck gates the (only) self-hosted pass: no diagnostics. Machine
    // reporters still emit an empty array; human emits nothing. Report clean.
    if no_tc == 1 {
        if kind != 0 {
            let _na: i64 = ckd_puts(ckd_arr_empty_nl());
        }
        return 0;
    }

    // Front-end: lex -> parse -> typecheck (all already self-hosted in main.mind).
    let toks: Vec = lex(src, src_len);
    let ast_root: i64 = parse(toks, src);
    let report: String = typecheck(ast_root, src);

    // Emit in the selected reporter shape. json/lsp parse the human report's
    // "ERROR: <msg> at span [lo,hi)" lines into structured diagnostics with
    // byte-offset -> 1-based line/col resolved against the source.
    let file: String = ckd_path_field(a);
    if kind == 1 {
        let _j: i64 = ckd_puts(ckd_emit_diags(report, src, file, 0));
    }
    if kind == 2 {
        let _l: i64 = ckd_puts(ckd_emit_diags(report, src, file, 1));
    }
    if kind == 0 {
        let _w: i64 = ckd_puts(report);
    }

    // Exit code: 1 if any "ERROR:" diagnostic, else 0 — regardless of reporter.
    if ckd_report_has_error(string_addr(report), string_len(report), 0) == 1 {
        return 1;
    }
    0
}
