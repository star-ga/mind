// RI-D1a: fail-close reporter. Scans the user region for the unsupported construct,
// writes an EXACT diagnostic to fd 2, returns a NON-ZERO exit code (3). Called only
// when selftest_native_elf_u fail-closed (0-byte ELF).
pub fn nb_report_unsupported(src: i64, user_lo: i64, src_len: i64) -> i64 {
    let abi: i64 = nxa_user_refusal(src, user_lo, src_len);
    if abi > 0 {
        return nxa_report(abi);
    }
    let dst: i64 = __mind_alloc(128);
    let p: i64 = __mind_alloc(16);
    let pt: i64 = nb_pat_tensor(p);
    if nb_region_has(src, user_lo, src_len, p, pt) == 1 {
        let n: i64 = nb_diag_tensor(dst);
        let _w: i64 = __mind_write(2, dst, n, 0 - 1);
        return 3;
    }
    let ptr: i64 = nb_pat_trait(p);
    if nb_region_has(src, user_lo, src_len, p, ptr) == 1 {
        let n2: i64 = nb_diag_trait(dst);
        let _w2: i64 = __mind_write(2, dst, n2, 0 - 1);
        return 3;
    }
    let pim: i64 = nb_pat_impl(p);
    if nb_region_has(src, user_lo, src_len, p, pim) == 1 {
        let n3: i64 = nb_diag_impl(dst);
        let _w3: i64 = __mind_write(2, dst, n3, 0 - 1);
        return 3;
    }
    let sw: i64 = nblr_string_word(src, user_lo, src_len);
    if sw != 0 {
        return nb_report_lane(sw, src, user_lo, src_len);
    }
    let n4: i64 = nb_diag_generic(dst);
    let _w4: i64 = __mind_write(2, dst, n4, 0 - 1);
    return 3;
}

// Lane refusal report (lane frame): ONE line on fd 2 and the exit status 3, in the shape of the
// host's lane refusals (the helpers are nb_lane_report.mind). `word` is a lane reason word
// (nb_lane_keys.mind). The fn name comes from a flat pass over the composed source's tokens.
pub fn nb_report_lane(word: i64, src: i64, user_lo: i64, src_len: i64) -> i64 {
    let key: i64 = nb_lane_key_of(word);
    let site: i64 = nb_lane_site_of(word);
    let buf: i64 = __mind_alloc(512 + src_len);
    let cap: i64 = nblr_cap();
    let toks: Vec = lex_capped(src, src_len, cap);
    let name_tok: i64 = nblr_fn_tok(toks, site, cap);
    let name_lo: i64 = nblr_name_lo(toks, name_tok);
    let name_len: i64 = nblr_name_len(toks, name_tok);
    let p0: i64 = nb_lane_frag(buf, 0);
    let p1: i64 = p0 + nblr_put_key(buf + p0, key);
    let p2: i64 = p1 + nb_lane_frag(buf + p1, 1);
    let p3: i64 = p2 + nblr_put_fn(buf + p2, src, name_lo, name_len);
    let p4: i64 = p3 + nblr_put_pos(buf + p3, src, user_lo, src_len, site);
    let p5: i64 = p4 + nblr_put_tail(buf + p4, src, src_len, key, site);
    let _w: i64 = __mind_write(2, buf, p5, 0 - 1);
    return 3;
}

// The stage's token budget: the smaller of the stack and arena caps (the stage's own rule).
pub fn nblr_cap() -> i64 {
    let scap: i64 = nb_stack_tok_cap();
    let acap: i64 = nb_arena_tok_cap();
    if acap < scap {
        return acap;
    }
    scap
}

// The start and the length of the fn name token, 0 and 0 when there is none (no fn holds the
// site, or the token after `fn` is not a name).
pub fn nblr_name_lo(toks: Vec, name_tok: i64) -> i64 {
    if name_tok < 0 {
        return 0;
    }
    tok_lo(toks, name_tok)
}

pub fn nblr_name_len(toks: Vec, name_tok: i64) -> i64 {
    if name_tok < 0 {
        return 0;
    }
    if tok_kind(toks, name_tok) != tk_ident() {
        return 0;
    }
    tok_hi(toks, name_tok) - tok_lo(toks, name_tok)
}

// The index of the name token of the top-level fn that holds the site, or -1 when the site lies in
// no fn or the stream is over the budget cap: one flat pass over the tokens up to the site.
pub fn nblr_fn_tok(toks: Vec, site: i64, cap: i64) -> i64 {
    let n: i64 = tok_count(toks);
    if n > cap {
        return 0 - 1;
    }
    let mut depth: i64 = 0;
    let mut name: i64 = 0 - 1;
    let mut closed: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        let k: i64 = tok_kind(toks, i);
        let lo: i64 = tok_lo(toks, i);
        let live: i64 = nblr_live(lo, site);
        let isfn: i64 = nblr_is_fn(k, depth, live, tk_kw_fn());
        name = nblr_pick(isfn, i + 1, name);
        closed = nblr_closed(closed, isfn, k, tk_rbrace(), depth, live, lo, site);
        depth = nblr_depth(depth, k, live, tk_lbrace(), tk_rbrace());
        i = nblr_next(i, n, live);
    }
    nblr_pick(closed, 0 - 1, name)
}

// A refused string literal of the user region [user_lo, src_len), named: the lane word of
// lane.string.raw_newline (40) or lane.string.escape (41) at the opening quote, else 0. It reads
// only the failure path: the lexer's refusal of a literal (scan_string_end) leaves a tk_unsupported
// token on its opening quote, and the first byte that made the scan fail names the kind. A stream
// over the stage's token budget is left unnamed.
pub fn nblr_string_word(src: i64, user_lo: i64, src_len: i64) -> i64 {
    let cap: i64 = nblr_cap();
    let toks: Vec = lex_capped(src + user_lo, src_len - user_lo, cap);
    if tok_count(toks) > cap {
        return 0;
    }
    let at: i64 = nblr_bad_quote(toks, src + user_lo);
    if at < 0 {
        return 0;
    }
    let key: i64 = nblr_str_fail(src, user_lo + at + 1, src_len);
    if key == 0 {
        return 0;
    }
    nb_lane_pack(key, user_lo + at)
}

pub fn nblr_first_quote(at: i64, toks: Vec, base: i64, i: i64) -> i64 {
    if at >= 0 {
        return at;
    }
    if tok_kind(toks, i) == tk_unsupported() {
        if load_byte(base, tok_lo(toks, i)) == 34 {
            return tok_lo(toks, i);
        }
    }
    0 - 1
}

// The start (relative to base) of the first tk_unsupported token on a double quote, or -1.
pub fn nblr_bad_quote(toks: Vec, base: i64) -> i64 {
    let n: i64 = tok_count(toks);
    let mut at: i64 = 0 - 1;
    let mut i: i64 = 0;
    while i < n {
        at = nblr_first_quote(at, toks, base, i);
        i = i + 1;
    }
    at
}

// The class of the byte at i inside a literal, as scan_str_leaf reads it: 3 closing quote,
// 40 raw line feed, 41 an escape the lexer does not know (a backslash that ends the buffer too),
// 1 a known escape pair, 0 any other byte.
pub fn nblr_str_class(buf: i64, i: i64, hi: i64) -> i64 {
    let b: i64 = load_byte(buf, i);
    if b == 34 {
        return 3;
    }
    if b == 92 {
        if i + 1 >= hi {
            return 41;
        }
        if string_escape_value(load_byte(buf, i + 1)) < 0 {
            return 41;
        }
        return 1;
    }
    if b == 10 {
        return 40;
    }
    0
}

pub fn nblr_str_keep(res: i64, c: i64) -> i64 {
    if res != 0 {
        return res;
    }
    if c == 40 {
        return 40;
    }
    if c == 41 {
        return 41;
    }
    0
}

pub fn nblr_str_adv(i: i64, hi: i64, c: i64) -> i64 {
    if c == 1 {
        return i + 2;
    }
    if c == 0 {
        return i + 1;
    }
    hi
}

// 40, 41, or 0 (no failing byte before the closing quote: an unterminated literal) for the
// literal whose content starts at p.
pub fn nblr_str_fail(buf: i64, p: i64, hi: i64) -> i64 {
    let mut res: i64 = 0;
    let mut i: i64 = p;
    while i < hi {
        let c: i64 = nblr_str_class(buf, i, hi);
        res = nblr_str_keep(res, c);
        i = nblr_str_adv(i, hi, c);
    }
    res
}

// Native layout v2 (bounded / explicit memory profile). When the stdin image
// starts with nb_layout_magic() the header is 48 bytes:
//   [magic][arena_bytes][stack_bytes][guard_bytes][user_lo][src_len]
// and the requested layout is validated (nb_layout_check) and published in the
// layout cell before anything is compiled, so EVERY layout-derived byte of the
// emitted image (PT_LOAD sizes, stack vaddr, entry rsp, allocation guards) comes
// from the same three values. Without the magic the 16-byte v1 header is read
// exactly as before and the default layout applies. A refused request writes a
// diagnostic to fd 2 and exits 64 + the nb_layout_check reason (65..75); no
// image bytes are written.
pub fn nb_layout_refuse(reason: i64) -> i64 {
    let m: i64 = __mind_alloc(64);
    __mind_store_i64(m + 0, 7020649416171352677);
    __mind_store_i64(m + 8, 8746390893561801076);
    __mind_store_i64(m + 16, 7955925651774797167);
    __mind_store_i64(m + 24, 8241904408702247286);
    __mind_store_i64(m + 32, 7161132920560774757);
    __mind_store_i64(m + 40, 2334116269791850347);
    __mind_store_i64(m + 48, 8223700967308747116);
    __mind_store_i64(m + 56, 2942788739363173);
    let _w: i64 = __mind_write(2, m, 63, 0 - 1);
    64 + reason
}

pub fn nb_main_v2(lay: i64, hdr: i64) -> i64 {
    let got: i64 = nb_read_fully(0, hdr + 16, 32, 0);
    if got != 32 {
        return nb_layout_refuse(11);
    }
    if lay != nb_layout_cell() {
        return nb_layout_refuse(11);
    }
    let arena: i64 = __mind_load_i64(hdr + 8);
    let stack: i64 = __mind_load_i64(hdr + 16);
    let guard: i64 = __mind_load_i64(hdr + 24);
    let bad: i64 = nb_layout_check(arena, stack, guard);
    if bad != 0 {
        return nb_layout_refuse(bad);
    }
    __mind_store_i64(lay + 8, arena);
    __mind_store_i64(lay + 16, stack);
    __mind_store_i64(lay + 24, guard);
    __mind_store_i64(lay + 32, 1);
    __mind_store_i64(lay, nb_layout_magic());
    nb_compile_image(__mind_load_i64(hdr + 32), __mind_load_i64(hdr + 40))
}

pub fn nb_compile_image(user_lo: i64, src_len: i64) -> i64 {
    let src: i64 = __mind_alloc(src_len + 16);
    let _r: i64 = nb_read_fully(0, src, src_len, 0);
    let es: EmitState = selftest_native_elf_stage(src, src_len, user_lo);
    let elf_len: i64 = string_len(es.buf);
    if elf_len > 0 {
        let _w: i64 = __mind_write(1, string_addr(es.buf), elf_len, 0 - 1);
        return 0;
    }
    if __mind_load_i64(nb_layout_cell() + 40) == 1 {
        return nb_report_capacity();
    }
    if __mind_load_i64(nb_layout_cell() + 40) == 2 {
        return nb_report_arena();
    }
    if __mind_load_i64(nb_layout_cell() + 40) >= nb_lane_floor() {
        return nb_report_lane(__mind_load_i64(nb_layout_cell() + 40), src, user_lo, src_len);
    }
    return nb_report_unsupported(src, user_lo, src_len);
}

// Census X1 capacity: the stage refused the program because compiling it could
// overflow the compiler's own stack (nb_stack_short / nb_depth_short: too many
// tokens, or nested too deeply). Writes that diagnostic to fd 2 and returns 3.
pub fn nb_report_capacity() -> i64 {
    let m: i64 = __mind_alloc(128);
    __mind_store_i64(m + 0, 7017271716450824805);
    __mind_store_i64(m + 8, 7020598778489301859);
    __mind_store_i64(m + 16, 8079521904311298420);
    __mind_store_i64(m + 24, 7286944462384099186);
    __mind_store_i64(m + 32, 8367814982689448824);
    __mind_store_i64(m + 40, 8532478930838381928);
    __mind_store_i64(m + 48, 7811898643973349477);
    __mind_store_i64(m + 56, 7022364302185558629);
    __mind_store_i64(m + 64, 7306919375752162147);
    __mind_store_i64(m + 72, 7791349879831797876);
    __mind_store_i64(m + 80, 2338053341489623649);
    __mind_store_i64(m + 88, 8367798494562575726);
    __mind_store_i64(m + 96, 7813856839633760111);
    __mind_store_i64(m + 104, 2334398928750586233);
    __mind_store_i64(m + 112, 7954882391399607597);
    __mind_store_i64(m + 120, 2940546883337572);
    let _w: i64 = __mind_write(2, m, 127, 0 - 1);
    3
}

// Census X1 capacity: the stage refused the program because compiling it would
// exhaust the compiler's own arena (nb_arena_low, refusal reason 2). Writes that
// diagnostic to fd 2 and returns 3 (it used to be the arena trap: exit 70).
pub fn nb_report_arena() -> i64 {
    let m: i64 = __mind_alloc(104);
    __mind_store_i64(m + 0, 7017271716450824805);
    __mind_store_i64(m + 8, 7020598778489301859);
    __mind_store_i64(m + 16, 8079521904311298420);
    __mind_store_i64(m + 24, 7286944462384099186);
    __mind_store_i64(m + 32, 8367814982689448824);
    __mind_store_i64(m + 40, 8532478930838381928);
    __mind_store_i64(m + 48, 7811898643973349477);
    __mind_store_i64(m + 56, 7882826708920267365);
    __mind_store_i64(m + 64, 7310011970147152495);
    __mind_store_i64(m + 72, 7450208747884470638);
    __mind_store_i64(m + 80, 2334398928750605413);
    __mind_store_i64(m + 88, 7954882391399607597);
    __mind_store_i64(m + 96, 2940546883337572);
    let _w: i64 = __mind_write(2, m, 103, 0 - 1);
    3
}

pub fn nb_zero_words(p: i64, n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }
    __mind_store_i64(p, 0);
    nb_zero_words(p + 8, n - 1)
}

// Lane frame: the mode word (cell word 12: 1 lane, the default; 2 self, after nb_lane_self_magic())
// and the test word (cell word 13: the rule word nb_lane_rules_run returns, 0 unless the input starts
// with nb_lane_hook_magic()). Each magic is read from the first 16 bytes and the next 16 (hook) or the
// next 8 (self) are read in its place, so the order is: hook and its word, then self, then the header.
pub fn nb_main_mode(lay: i64, hdr: i64) -> i64 {
    __mind_store_i64(lay + 96, 1);
    __mind_store_i64(lay + 104, 0);
    if __mind_load_i64(hdr) == nb_lane_hook_magic() {
        __mind_store_i64(lay + 104, __mind_load_i64(hdr + 8));
        let _r: i64 = nb_read_fully(0, hdr, 16, 0);
    }
    if __mind_load_i64(hdr) == nb_lane_self_magic() {
        __mind_store_i64(lay + 96, 2);
        __mind_store_i64(hdr, __mind_load_i64(hdr + 8));
        return nb_read_fully(0, hdr + 8, 8, 0);
    }
    0
}

pub fn main() -> i64 {
    // The layout cell is the FIRST allocation, so in a native run it sits at
    // nb_layout_cell() (the bump allocator hands out arena+16 first). It stays
    // zero (no magic) unless a v2 header publishes a validated layout.
    // Words 5..11 of the cell are the stage's scratch words (nb_xcell): zeroed,
    // then tagged with nb_xcell_magic(). Words 12 and 13 are the lane frame's
    // mode and test words (nb_main_mode).
    let lay: i64 = __mind_alloc(112);
    let _z: i64 = nb_zero_words(lay + 40, 6);
    __mind_store_i64(lay + 88, nb_xcell_magic());
    let hdr: i64 = __mind_alloc(48);
    let _h: i64 = nb_read_fully(0, hdr, 16, 0);
    if __mind_load_i64(hdr) == nb_lane_key_magic() {
        return nb_lane_dump();
    }
    let _m: i64 = nb_main_mode(lay, hdr);
    if __mind_load_i64(hdr) == nb_layout_magic() {
        return nb_main_v2(lay, hdr);
    }
    nb_compile_image(__mind_load_i64(hdr), __mind_load_i64(hdr + 8))
}
