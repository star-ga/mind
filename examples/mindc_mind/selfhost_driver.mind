// RI-D1a: fail-close reporter. Scans the user region for the unsupported construct,
// writes an EXACT diagnostic to fd 2, returns a NON-ZERO exit code (3). Called only
// when selftest_native_elf_u fail-closed (0-byte ELF).
pub fn nb_report_unsupported(src: i64, user_lo: i64, src_len: i64) -> i64 {
    let dst: i64 = __mind_alloc(128);
    let p: i64 = __mind_alloc(16);
    let pt: i64 = nb_pat_tensor(p);
    if nb_region_has(src, user_lo, src_len, p, pt) == 1 {
        let n: i64 = nb_diag_tensor(dst);
        let _w: i64 = __mind_write(2, dst, n, 0 - 1);
        return 3;
    }
    let ptr: i64 = nb_pat_trait(p);
    if nb_region_has(src, user_lo, src_len, p, ptr) == 1 {
        let n2: i64 = nb_diag_trait(dst);
        let _w2: i64 = __mind_write(2, dst, n2, 0 - 1);
        return 3;
    }
    let pim: i64 = nb_pat_impl(p);
    if nb_region_has(src, user_lo, src_len, p, pim) == 1 {
        let n3: i64 = nb_diag_impl(dst);
        let _w3: i64 = __mind_write(2, dst, n3, 0 - 1);
        return 3;
    }
    let n4: i64 = nb_diag_generic(dst);
    let _w4: i64 = __mind_write(2, dst, n4, 0 - 1);
    return 3;
}

pub fn main() -> i64 {
    let hdr: i64 = __mind_alloc(16);
    let _h: i64 = nb_read_fully(0, hdr, 16, 0);
    let user_lo: i64 = __mind_load_i64(hdr);
    let src_len: i64 = __mind_load_i64(hdr + 8);
    let src: i64 = __mind_alloc(src_len + 16);
    let _r: i64 = nb_read_fully(0, src, src_len, 0);
    let es: EmitState = selftest_native_elf_u(src, src_len, user_lo);
    let elf_len: i64 = string_len(es.buf);
    if elf_len > 0 {
        let _w: i64 = __mind_write(1, string_addr(es.buf), elf_len, 0 - 1);
        return 0;
    }
    return nb_report_unsupported(src, user_lo, src_len);
}
