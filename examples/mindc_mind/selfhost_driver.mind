// ===========================================================================
// SELF-HOST NATIVE DRIVER (Rust-independence #14 — stage1==stage2 loop)
//
// A thin bootstrap CLI shim, kept SEPARATE from main.mind (the compiler library)
// on purpose: it is fed to the native backend only as APPENDED SOURCE, never
// built via `mindc --emit-shared`. That keeps main.mind byte-identical to HEAD,
// so the mic@1 fixed-point and mic@3-flip gates are untouched, and there is no
// collision with mindc's reserved module-level `@main` symbol (main.mind defines
// no `main`; this file does, only in the combined self-host source).
//
// When the native backend compiles the combined buffer [std + main.mind + this],
// nb_find_main matches this `main` (the unchanged 4-byte "main" path) and lays it
// as the emitted-ELF entry, so the native ELF is a runnable compiler. That closes
// the loop: stage0 (Rust `.so`) emits stage1.elf; stage1.elf, run on the same
// seeded source, emits stage2 byte-identical to itself, with Rust+LLVM out of the
// stage1->stage2 step.
//
// stdin protocol (fd 0):  [8-byte user_lo LE][8-byte src_len LE][src bytes]
//   src = 21 std/*.mind sources concatenated, then main.mind, then this file;
//   user_lo = byte length of the std prefix (the reachability-prune seam).
// The ELF is written to fd 1 (raw __mind_write, no libc). The note hash is the
// self-computed nb_trace_hash — the loop needs determinism, not Rust-oracle
// parity (the mic@3-vs-Rust match is a separate, non-blocking track).
//
// RI-D1a (task #313): on a NATIVE fail-close (selftest_native_elf_u returns a
// 0-byte EmitState), main() no longer exits 0 with empty stdout — it scans the
// USER region [user_lo, src_len) for the unsupported construct, writes an EXACT
// diagnostic to stderr (fd 2), and exits NON-ZERO, so the Rust bridge
// (run_native_backend_bridge path #1) surfaces the construct instead of a generic
// "0 bytes" message. The scan runs ONLY on the fail path, so the self-host success
// path (and closure) is byte-identical. deferred: line/column not emitted (no
// int->decimal helper in the self-host dialect yet) — upgrade path: add nb_itoa
// and prefix the message with the newline count of [user_lo, match).
// ===========================================================================

// Read exactly `want` bytes from `fd` into `buf` (a pipe read may return short).
// Stops early on EOF/error (n <= 0); returns bytes actually read.
pub fn nb_read_fully(fd: i64, buf: i64, want: i64, got: i64) -> i64 {
    if got >= want {
        return got;
    }
    let n: i64 = __mind_read(fd, buf + got, want - got, 0 - 1);
    if n <= 0 {
        return got;
    }
    nb_read_fully(fd, buf, want, got + n)
}

// RI-D1a: does pattern [pat, patlen) occur anywhere in buf[lo, hi)?  TAIL
// RECURSION (one position per frame), the SAME shape as nb_read_fully above —
// the whole-module native note emitter (selftest_native_elf_u) emits this form
// but fail-closes on the `let mut`+`while`+early-return loop form (bisected
// v2b FAIL / v3 EMIT_OK, 2026-08-14); the inner bytes_eq recurses only patlen
// (<=8) deep. deferred: recursion depth == user-region length, so a very large
// FAIL-CLOSING program could overflow the runtime stack (corpus programs are
// small; the SUCCESS path never calls this) — upgrade path: teach the note
// emitter the while form, or scan in bounded chunks.
pub fn nb_region_has(buf: i64, lo: i64, hi: i64, pat: i64, patlen: i64) -> i64 {
    if lo + patlen > hi {
        return 0;
    }
    if bytes_eq(buf, lo, lo + patlen, pat, 0, patlen) == 1 {
        return 1;
    }
    nb_region_has(buf, lo + 1, hi, pat, patlen)
}

// RI-D1a pattern buffer for `Tensor<` (7 bytes).
pub fn nb_pat_tensor(p: i64) -> i64 {
    __mind_store_i8(p + 0, 84);
    __mind_store_i8(p + 1, 101);
    __mind_store_i8(p + 2, 110);
    __mind_store_i8(p + 3, 115);
    __mind_store_i8(p + 4, 111);
    __mind_store_i8(p + 5, 114);
    __mind_store_i8(p + 6, 60);
    7
}

// RI-D1a pattern buffer for `trait ` (6 bytes).
pub fn nb_pat_trait(p: i64) -> i64 {
    __mind_store_i8(p + 0, 116);
    __mind_store_i8(p + 1, 114);
    __mind_store_i8(p + 2, 97);
    __mind_store_i8(p + 3, 105);
    __mind_store_i8(p + 4, 116);
    __mind_store_i8(p + 5, 32);
    6
}

// RI-D1a pattern buffer for `impl ` (5 bytes).
pub fn nb_pat_impl(p: i64) -> i64 {
    __mind_store_i8(p + 0, 105);
    __mind_store_i8(p + 1, 109);
    __mind_store_i8(p + 2, 112);
    __mind_store_i8(p + 3, 108);
    __mind_store_i8(p + 4, 32);
    5
}

