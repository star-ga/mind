// Copyright 2026 STARGA Inc.
// i32 modes of kinds 87 and 89. No new kind. Bit clear: kinds 87 and 89 emit the
// i64 bodies (the caller jumps over this part).
// Kind 87, group bit 5 (value 32): store the low 32 bits of each code.
// vpshufd ymm7, ymmSrc, 0x88; vpermq ymm7, ymm7, 8; vmovdqu [addr], xmm7.
// Pixel stride is 4. Inputs stay i64 (r14 = p * 8). group & 15 selects 3 or 4.
// Group bits 5 and 6 (N32): the channels are u32 rows (4 bytes per pixel,
// zero-extended), the codes are the low 32 bits of the same i64 codes, computed as
// wrapping 32-bit vpaddd / vpsubd on 8 pixels per step (r14 = p * 4). The bytes
// equal bit 5 alone on i64 channels that hold the same u32 values. The vector steps
// and their running row pointers are in nb_group_bankw.mind.
// Kind 89, desc[7] bit 2 (value 4): 8 zeroed i32x8 accumulators, vpaddd (FE) /
// vpsubd (FA) on the 4-byte bank (64 lanes, 256 bytes per code). Then
// out[i] += sext32(part[i]) when desc[7] bit 0 is set, else out[i] = sext32.
// Bits 63..32 of desc[7] are the segment bound B (32-bit field). One compare:
// field >= 2^31 takes the fallback, else the i32 path. A caller that leaves the
// high half 0 takes the i32 path. Contract for the caller:
// 1. Bank32 codes are 4-byte values and every code must fit in i32. The
//    fallback sign-extends each 4-byte code (movsxd) and sums in i64. It is
//    exact for the partial-sum overflow of i32 codes only. It is not the i64 walk: a code
//    that the i64 walk holds in 8 bytes and that needs more than 32 bits is already cut
//    to its low 32 bits in the bank. Use bit 2 clear (the i64 walk) for such codes.
// 2. Write the field as min(B, 0xFFFFFFFF). Any B >= 2^31 must give a field
//    >= 2^31. An unsaturated B >= 2^32 wraps in the 32-bit field, can fall
//    below 2^31, and then the row takes the i32 path with a silent wrong value.
// 3. Set bit 2 with a field below 2^31 only when each partial sum is in
//    -2^31..2^31-1. Bit 1 is not a mode bit here.
// 4. Overlap: the fallback keeps the order of the i64 walk. Its 64 lane sums go to a 512-byte
//    stack buffer and reach out only after every read of the row (off, bank32,
//    out for init keep), as on the fast path. Fixture: k3_fallback.mind alias row.
// Fixtures: k3_fallback.mind (fallback rows, sub lists, init keep, rows > 1),
// k3_bound.mind (field edges 2^31-1, 2^31, 0xFFFFFFFF; partial sum above 2^32).
// llvm-mc (avx2), before this emitter:
// vpaddd ymm0, ymm0, [rbx+rax] = c5 fd fe 04 03
// vpaddd ymm1, ymm1, [rbx+rax+32] = c5 f5 fe 4c 03 20
// vpsubd ymm0 = c5 fd fa 04 03 (same SIB, opcode fa)
// vpshufd ymm7, ymm0, 0x88 = c5 fd 70 f8 88
// vpermq ymm7, ymm7, 8 = c4 e3 fd 00 ff 08
// vmovdqu [rax], xmm7 = c5 fa 7f 38
// vextracti128 [rsp-16], ymm0, 1 = c4 e3 7d 39 44 24 f0 01
// vpmovsxdq ymm0, xmm0 = c4 e2 7d 25 c0
// vpmovsxdq ymm0, [rsp-16] = c4 e2 7d 25 44 24 f0

import std.string;
import nb_group_sum_enc;
import nb_group_fuse32;
import nb_group_bankw;

// rax = row * plane + bank + p*4 (r14 = p*8, or p*4 for N32). Clobbers rcx.
pub fn nbi_addr4(code: String, row: i64, n32: i64) -> String {
    let c1: String = nbg_b4(nbg_u32(nbg_push(code, 184), row), 73, 15, 175, 195);
    let c2: String = nbg_rr(nbg_rr(c1, 1, 0, 3), 137, 1, 14);
    if n32 == 1 {
        return nbg_rr(c2, 1, 0, 1);
    }
    nbg_rr(nbg_b3(c2, 72, 209, 233), 1, 0, 1)
}

// r14 = p*8, or p*4 for N32 (u32 channels).
pub fn nbi_set_r14(code: String, n32: i64) -> String {
    nbg_b4(nbg_rr(code, 137, 14, 6), 73, 193, 230, 3 - n32)
}

pub fn nbi_rax_sp(code: String, op: i64, disp: i64) -> String {
    let opc: i64 = if op == 0 {
        139
    } else {
        if op == 1 {
            3
        } else {
            43
        }
    };
    if disp == 0 {
        return nbg_b4(code, 72, opc, 4, 36);
    }
    nbg_b5(code, 72, opc, 68, 36, disp)
}

pub fn nbi_z(code: String, k: i64, adj: i64) -> String {
    let cd: i64 = adj;
    let bd: i64 = adj + 8;
    let ad: i64 = adj + 16;
    if k == 0 {
        return nbi_rax_sp(code, 0, cd);
    }
    if k == 1 {
        return nbi_rax_sp(nbi_rax_sp(code, 0, bd), 2, cd);
    }
    if k == 2 {
        return nbi_rax_sp(code, 0, bd);
    }
    if k == 3 {
        return nbi_rax_sp(nbi_rax_sp(code, 0, bd), 1, cd);
    }
    if k == 4 {
        return nbi_rax_sp(nbi_rax_sp(nbi_rax_sp(code, 0, ad), 2, bd), 2, cd);
    }
    if k == 5 {
        return nbi_rax_sp(nbi_rax_sp(code, 0, ad), 2, bd);
    }
    if k == 6 {
        return nbi_rax_sp(nbi_rax_sp(nbi_rax_sp(code, 0, ad), 2, bd), 1, cd);
    }
    if k == 7 {
        return nbi_rax_sp(nbi_rax_sp(code, 0, ad), 2, cd);
    }
    if k == 8 {
        return nbi_rax_sp(code, 0, ad);
    }
    if k == 9 {
        return nbi_rax_sp(nbi_rax_sp(code, 0, ad), 1, cd);
    }
    if k == 10 {
        return nbi_rax_sp(nbi_rax_sp(nbi_rax_sp(code, 0, ad), 1, bd), 2, cd);
    }
    if k == 11 {
        return nbi_rax_sp(nbi_rax_sp(code, 0, ad), 1, bd);
    }
    nbi_rax_sp(nbi_rax_sp(nbi_rax_sp(code, 0, ad), 1, bd), 1, cd)
}

pub fn nbi_store_eax(code: String, row: i64, n32: i64) -> String {
    let c1: String = nbg_rr(nbi_addr4(nbg_push(code, 80), row, n32), 137, 1, 0);
    nbg_b3(c1, 88, 137, 1)
}

// push the channel word at [base + r14]: i64, or (N32) the zero-extended u32 (mov eax, [rax]).
pub fn nbi_push_mem(code: String, base: i64, n32: i64) -> String {
    let c1: String = nbg_rr(nbg_rr(code, 137, 0, 14), 1, 0, base);
    if n32 == 1 {
        return nbg_b3(c1, 139, 0, 80);
    }
    nbg_b4(c1, 72, 139, 0, 80)
}

pub fn nbi_scalar(code: String, g4: i64, n32: i64) -> String {
    let c0: String = nbi_set_r14(code, n32);
    let mut c: String = nbi_push_mem(nbi_push_mem(nbi_push_mem(c0, 10, n32), 12, n32), 2, n32);
    let adj: i64 = if g4 == 1 {
        8
    } else {
        0
    };
    if g4 == 1 {
        c = nbi_push_mem(c, 15, n32);
    }
    let mut k: i64 = 0;
    while k < 13 {
        c = nbi_z(c, k, adj);
        if g4 == 1 {
            c = nbi_store_eax(nbg_push(c, 80), k, n32);
            c = nbi_store_eax(nbi_rax_sp(nbi_rax_sp(c, 0, 8), 2, 0), 25 - k, n32);
            c = nbi_store_eax(nbi_rax_sp(nbi_rax_sp(c, 0, 8), 1, 0), 27 + k, n32);
            c = nbg_push(c, 88);
        } else {
            c = nbi_store_eax(c, k, n32);
        }
        k = k + 1;
    }
    if g4 == 1 {
        c = nbg_push(nbi_store_eax(nbi_rax_sp(c, 0, 0), 26, n32), 88);
    }
    nbg_b3(c, 88, 88, 88)
}

pub fn nbi_overlap_q(code: String, q: i64) -> String {
    let ok1: i64 = nbg_cell();
    let ok2: i64 = nbg_cell();
    let c1: String = nbg_jcc(nbg_rr(code, 57, q, 1), 131, ok1);
    let c2: String = nbg_rr(nbg_rr(nbg_rr(c1, 137, 6, q), 1, 6, 0), 57, 6, 3);
    let c3: String = nbg_b3(nbg_jcc(c2, 134, ok2), 77, 49, 192);
    nbg_here(nbg_here(c3, ok1), ok2)
}

// Write tail is pixels*4. Read span stays pixels*8 (inputs are i64).
pub fn nbi_overlap(code: String, g4: i64, n32: i64) -> String {
    let skip: i64 = nbg_cell();
    let wide: i64 = nbg_cell();
    let rows: i64 = if g4 == 1 {
        39
    } else {
        12
    };
    let mut c: String = nbg_jcc(nbg_b4(code, 73, 131, 248, 1), 133, skip);
    c = nbg_b4(nbg_rr(c, 137, 0, 9), 72, 193, 224, 2);
    c = nbg_here(nbg_b3(nbg_jcc(nbg_rr(c, 57, 11, 0), 141, wide), 77, 49, 192), wide);
    c = nbg_rr(nbg_rr(nbg_b4(c, 73, 107, 203, rows), 1, 1, 0), 1, 1, 3);
    c = nbg_b4(nbg_rr(c, 137, 0, 9), 72, 193, 224, 3 - n32);
    c = nbi_overlap_q(nbi_overlap_q(nbi_overlap_q(c, 10), 12), 2);
    if g4 == 1 {
        c = nbi_overlap_q(c, 15);
    }
    nbg_b3(nbg_here(c, skip), 72, 49, 246)
}

pub fn nbi_channels(code: String, g4: i64) -> String {
    let mut c: String = nbg_b5(nbg_b4(code, 77, 139, 20, 36), 73, 139, 84, 36, 16);
    if g4 == 1 {
        c = nbg_b5(c, 77, 139, 124, 36, 24);
    }
    nbg_b5(c, 77, 139, 100, 36, 8)
}

// The pixel loops; jumps to `exit` when p reaches pixels (group 4: pop r13 first).
// N32: 8 pixels per vector step, u32 channels, the d ops.
pub fn nbi_bank_path(code: String, g4: i64, exit: i64, n32: i64) -> String {
    let scalar: i64 = nbg_cell();
    let rem: i64 = nbg_cell();
    let back: i64 = nbg_cell();
    let pback: i64 = nbg_cell();
    let fin: i64 = nbg_cell();
    let lim: i64 = if g4 == 1 {
        fin
    } else {
        exit
    };
    let step: i64 = 4 + 4 * n32;
    let c0: String = nbw_g4_enter(code, g4);
    let mut c: String = nbg_jcc(nbg_b4(nbi_overlap(c0, g4, n32), 73, 131, 248, 1), 133, scalar);
    let head: i64 = string_len(c);
    c = nbg_b4(nbg_rr(nbg_rr(c, 137, 0, 9), 41, 0, 6), 72, 131, 248, step);
    c = nbg_jcc(c, 140, rem);
    c = nbg_jmp(nbg_add_rsi(nbw_step(nbi_set_r14(c, n32), g4, 1 + n32), step), back);
    c = nbg_link(c, back, head);
    c = nbg_here(nbg_here(c, scalar), rem);
    let phead: i64 = string_len(c);
    c = nbg_jcc(nbg_rr(c, 57, 6, 9), 141, lim);
    c = nbg_jmp(nbg_add_rsi(nbi_scalar(c, g4, n32), 1), pback);
    c = nbg_link(c, pback, phead);
    if g4 == 1 {
        return nbg_jmp(nbw_g4_leave(nbg_here(c, fin)), exit);
    }
    c
}

// Slots are already loaded. rdi still holds group (bits 4, 5 and 6 included).
pub fn nbi_bank_w(code: String, n32: i64) -> String {
    let j3: i64 = nbg_cell();
    let j4: i64 = nbg_cell();
    let skip: i64 = nbg_cell();
    let none: i64 = nbg_cell();
    let x3: i64 = nbg_cell();
    let x4: i64 = nbg_cell();
    let mut c: String = nbg_b4(nbg_rr(nbg_probe_skip(code, 7, 16), 137, 3, 15), 72, 131, 231, 15);
    c = nbg_jcc(nbg_rr(c, 133, 9, 9), 142, none);
    c = nbg_jcc(nbg_b4(c, 72, 131, 255, 3), 132, j3);
    c = nbg_jcc(nbg_b4(c, 72, 131, 255, 4), 132, j4);
    c = nbg_jmp(c, skip);
    c = nbi_bank_path(nbi_channels(nbg_here(c, j3), 0), 0, x3, n32);
    c = nbi_bank_path(nbi_channels(nbg_here(c, j4), 1), 1, x4, n32);
    nbg_here(nbg_here(nbg_here(nbg_here(c, skip), none), x3), x4)
}

// Group bit 5. test dil, 64 ; jne: N32 (u32 channels), else i64 channels.
pub fn nbi_bank_i32(code: String) -> String {
    let n32: i64 = nbg_cell();
    let done: i64 = nbg_cell();
    let c0: String = nbg_jcc(nbg_b4(code, 64, 246, 199, 64), 133, n32);
    let c1: String = nbg_jmp(nbi_bank_w(c0, 0), done);
    nbg_here(nbi_bank_w(nbg_here(c1, n32), 1), done)
}

pub fn nbi_sib(code: String, op: i64, k: i64, disp: i64) -> String {
    let c2: String = nbg_b3(code, 197, 128 + (15 - k) * 8 + 5, op);
    if disp == 0 {
        return nbg_b2(c2, k * 8 + 4, 3);
    }
    if disp <= 127 {
        return nbg_b3(c2, 64 + k * 8 + 4, 3, disp);
    }
    nbg_u32(nbg_b2(c2, 128 + k * 8 + 4, 3), disp)
}

pub fn nbi_sips(code: String, op: i64) -> String {
    let mut c: String = code;
    let mut i: i64 = 0;
    while i < 8 {
        c = nbi_sib(c, op, i, i * 32);
        i = i + 1;
    }
    c
}

pub fn nbi_terms(code: String, op: i64) -> String {
    let skip: i64 = nbg_cell();
    let back: i64 = nbg_cell();
    let c1: String = nbg_jcc(nbg_rr(code, 57, 6, 9), 141, skip);
    let head: i64 = string_len(c1);
    let c2: String = nbi_sips(nbg_b4(c1, 72, 139, 4, 242), op);
    let c3: String = nbg_jcc(nbg_rr(nbg_b4(c2, 72, 131, 198, 1), 57, 6, 9), 140, back);
    nbg_here(nbg_link(c3, back, head), skip)
}

pub fn nbi_xor8(code: String) -> String {
    let mut c: String = code;
    let mut i: i64 = 0;
    while i < 8 {
        c = nbg_rrr(c, 239, i, i, i);
        i = i + 1;
    }
    c
}

pub fn nbi_fast(code: String, fused: i64, slot: i64) -> String {
    let done: i64 = nbg_cell();
    let back: i64 = nbg_cell();
    let addp: i64 = nbg_cell();
    let after: i64 = nbg_cell();
    let head: i64 = string_len(code);
    let mut c: String = nbg_jcc(nbg_rr(code, 133, 10, 10), 142, done);
    c = nbg_b4(nbg_b4(nbg_b3(c, 73, 139, 14), 73, 139, 126, 8), 77, 139, 110, 16);
    c = nbi_xor8(c);
    c = nbg_rr(nbg_rr(c, 137, 6, 1), 137, 9, 7);
    c = nbi_terms(c, 254);
    c = nbg_rr(nbg_rr(c, 137, 6, 7), 137, 9, 13);
    c = nbi_terms(c, 250);
    c = nbg_jcc(nbg_b4(c, 65, 246, 195, 1), 133, addp);
    c = nbg_jmp(nbx_end32(c, 0, fused, slot), after);
    c = nbx_end32(nbg_here(c, addp), 1, fused, slot);
    c = nbg_here(c, after);
    c = nbg_rr(nbg_rr(c, 1, 12, 15), 1, 14, 8);
    c = nbg_jmp(nbg_b4(c, 73, 131, 234, 1), back);
    nbg_here(nbg_link(c, back, head), done)
}

// mov r9, [rdx+rax*8]; add r9, rbx; movsxd r9, [r9+rsi*4]; acc += or -= r9.
pub fn nbi_term64(code: String, add: i64) -> String {
    let c1: String = nbg_b4(nbg_rr(nbg_b4(code, 76, 139, 12, 194), 1, 9, 3), 77, 99, 12, 177);
    if add == 1 {
        return nbg_rr(c1, 1, 11, 9);
    }
    nbg_rr(c1, 41, 11, 9)
}

pub fn nbi_fallback(code: String, fused: i64, slot: i64) -> String {
    let done: i64 = nbg_cell();
    let back: i64 = nbg_cell();
    let lane: i64 = nbg_cell();
    let ladd: i64 = nbg_cell();
    let lsub: i64 = nbg_cell();
    let noini: i64 = nbg_cell();
    // sub rsp, 512: the 64 lane sums wait here until every read of the row is done.
    let mut c: String = nbg_b5(nbg_u32(nbg_b3(code, 72, 129, 236), 512), 76, 137, 92, 36, 232);
    let head: i64 = string_len(c);
    c = nbg_jcc(nbg_rr(c, 133, 10, 10), 142, done);
    c = nbg_b4(nbg_b4(nbg_b3(c, 73, 139, 14), 73, 139, 126, 8), 77, 139, 110, 16);
    c = nbg_b2(c, 49, 246);
    let lhead: i64 = string_len(c);
    c = nbg_rr(c, 49, 11, 11);
    c = nbg_jcc(nbg_b5(c, 246, 68, 36, 232, 1), 132, noini);
    c = nbg_b4(c, 77, 139, 28, 244);
    c = nbg_here(c, noini);
    c = nbg_rr(c, 137, 0, 1);
    let hadd: i64 = string_len(c);
    c = nbg_jcc(nbg_rr(c, 57, 0, 7), 141, ladd);
    c = nbi_term64(c, 1);
    c = nbg_jmp(nbg_b4(c, 72, 131, 192, 1), back);
    // The add-loop back cell is reused below; patch it before the sub loop.
    c = nbg_link(c, back, hadd);
    c = nbg_here(c, ladd);
    c = nbg_rr(c, 137, 0, 7);
    let hsub: i64 = string_len(c);
    let sback: i64 = nbg_cell();
    c = nbg_jcc(nbg_rr(c, 57, 0, 13), 141, lsub);
    c = nbi_term64(c, 0);
    c = nbg_jmp(nbg_b4(c, 72, 131, 192, 1), sback);
    c = nbg_link(c, sback, hsub);
    c = nbg_here(c, lsub);
    c = nbg_b4(c, 76, 137, 28, 244);
    c = nbg_jcc(nbg_b4(nbg_b4(c, 72, 131, 198, 1), 72, 131, 254, 64), 140, lane);
    c = nbg_link(c, lane, lhead);
    // Row end after all reads (the overlap order of the i64 walk): copy to out, or the fused finish.
    c = nbx_endfb(c, fused, slot);
    c = nbg_rr(nbg_rr(c, 1, 12, 15), 1, 14, 8);
    let rback: i64 = nbg_cell();
    c = nbg_jmp(nbg_b4(c, 73, 131, 234, 1), rback);
    c = nbg_here(nbg_link(c, rback, head), done);
    nbg_u32(nbg_b3(c, 72, 129, 196), 512)
}

// desc is loaded. r11 = desc[7]. Bit 2 is already known set. fused 1: bit-7 row ends.
pub fn nbi_i32_rows(code: String, fused: i64, slot: i64) -> String {
    let fail: i64 = nbg_cell();
    let done: i64 = nbg_cell();
    let mut c: String = nbg_rr(code, 137, 0, 11);
    c = nbg_b4(c, 72, 193, 232, 32);
    // mov ecx, 2^31. jae: the segment bound does not fit in i32.
    c = nbg_u32(nbg_push(c, 185), 2147483648);
    c = nbg_jcc(nbg_rr(c, 57, 0, 1), 131, fail);
    c = nbg_jmp(nbi_fast(c, fused, slot), done);
    c = nbi_fallback(nbg_here(c, fail), fused, slot);
    nbg_here(c, done)
}
