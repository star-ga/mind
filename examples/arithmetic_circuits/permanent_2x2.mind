// STARGA Pure MIND: small arithmetic-circuit DAG for 2x2 permanent.
// A finite exact demonstration only; NOT a VP/VNP separation theorem.
// Opcode: 1=input index, 2=constant, 3=add, 4=multiply.
// Each node: (op, first, second, scalar), 1-based nodes, 0-based inputs.
fn put(t: i64, i: i64, k: i64, v: i64) -> i64 {
    __mind_store_i64(t + (i * 4 + k) * 8, v);
    return 0;
}
fn get(t: i64, i: i64, k: i64) -> i64 {
    return __mind_load_i64(t + (i * 4 + k) * 8);
}
fn abs_bound(v: i64) -> i64 {
    if v < 0 - 1000000 || v > 1000000 { return 0; }
    return 1;
}
// Refuse invalid gates, forward edges, or out-of-range numeric inputs.
fn evaluate(t: i64, n: i64, inputs: i64, work: i64) -> i64 {
    if n < 1 || n > 7 { return 0; }
    let mut i: i64 = 1;
    while i <= n {
        let op: i64 = get(t,i,0);
        let a: i64 = get(t,i,1);
        let b: i64 = get(t,i,2);
        let scalar: i64 = get(t,i,3);
        let mut v: i64 = 0;
        if op == 1 {
            if a < 0 || a > 3 || b != 0 || scalar != 0 { return 0; }
            v = __mind_load_i64(inputs + a * 8);
            if v < 0 - 1000 || v > 1000 { return 0; }
        } else if op == 2 {
            if a != 0 || b != 0 || scalar < 0 - 1000 || scalar > 1000 { return 0; }
            v = scalar;
        } else if op == 3 || op == 4 {
            if a < 1 || b < 1 || a >= i || b >= i || scalar != 0 { return 0; }
            let x: i64 = __mind_load_i64(work + a * 8);
            let y: i64 = __mind_load_i64(work + b * 8);
            // abs(x),abs(y) <= 1e6, product <= 1e12 fits signed i64.
            if op == 3 { v = x + y; } else { v = x * y; }
        } else {
            return 0;
        }
        if abs_bound(v) == 0 { return 0; }
        __mind_store_i64(work + i * 8, v);
        i = i + 1;
    }
    return 1;
}
fn load_perm(t: i64) -> i64 {
    let mut i: i64 = 1;
    while i <= 4 {
        put(t,i,0,1);
        put(t,i,1,i - 1);
        put(t,i,2,0);
        put(t,i,3,0);
        i = i + 1;
    }
    put(t,5,0,4); put(t,5,1,1); put(t,5,2,4); put(t,5,3,0);
    put(t,6,0,4); put(t,6,1,2); put(t,6,2,3); put(t,6,3,0);
    put(t,7,0,3); put(t,7,1,5); put(t,7,2,6); put(t,7,3,0);
    return 0;
}
fn assign(inputs: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    __mind_store_i64(inputs, a);
    __mind_store_i64(inputs + 8, b);
    __mind_store_i64(inputs + 16, c);
    __mind_store_i64(inputs + 24, d);
    return 0;
}
fn check_one(t: i64, inputs: i64, work: i64, a: i64, b: i64, c: i64, d: i64) -> i64 {
    assign(inputs,a,b,c,d);
    if evaluate(t,7,inputs,work) == 0 { return 0; }
    let got: i64 = __mind_load_i64(work + 7 * 8);
    // Independent arithmetic expression, not dependent on gate traversal.
    if got != a * d + b * c { return 0; }
    return 1;
}
fn main() -> i64 {
    let t: i64 = __mind_alloc(256);
    let inputs: i64 = __mind_alloc(32);
    let work: i64 = __mind_alloc(64);
    if t == 0 || inputs == 0 || work == 0 { return 2; }
    load_perm(t);
    if check_one(t,inputs,work,1,2,3,4) != 1 { return 10; }
    if check_one(t,inputs,work,2,5,7,11) != 1 { return 11; }
    if check_one(t,inputs,work,0,0,0,0) != 1 { return 12; }
    // Deliberately false witness: forward reference must fail closed.
    put(t,5,1,7);
    if evaluate(t,7,inputs,work) != 0 { return 20; }
    put(t,5,1,1);
    // Invalid opcode must never become an accepted arithmetic gate.
    put(t,7,0,99);
    if evaluate(t,7,inputs,work) != 0 { return 21; }
    put(t,7,0,3);
    assign(inputs,1001,0,0,0);
    if evaluate(t,7,inputs,work) != 0 { return 22; }
    assign(inputs,1000,1000,1000,1000);
    if evaluate(t,7,inputs,work) != 0 { return 23; }
    if evaluate(t,8,inputs,work) != 0 { return 24; }
    let output: String = "EXAMPLE=ARITHMETIC_CIRCUIT\nCASES=3\nNEGATIVE=5\nTHEOREM_AUTHORITY=NONE\n";
    let written: i64 = __mind_write(1,output.addr,output.len,0 - 1);
    if written != output.len { return 90; }
    return 0;
}
