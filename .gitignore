# Rust
/target/
.mind-build.lock
**/*.rs.bk
*.pdb
Cargo.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# LLVM
*.bc
*.ll

# Build artifacts
/build/
/dist/
*.o
*.so
*.dylib
*.dll

# Testing
/coverage/
*.profraw
*.profdata

# Documentation
/book/
/target/doc/

# Environment
.env
.env.local

# Benchmarks
/bench_results/

# Examples output
/examples/output/

# Never commit patent/IP documents to public repos
*PATENT*
*patent*
*.patent.*
*_PATENT_*

# arch-mind transient state (Tranche 5). Includes last_summary.json,
# key.local, and store.lock because they embed absolute repo paths.
.arch-mind/store/
.arch-mind/store.pre-rotation-*/
.arch-mind/keys.json
.arch-mind/_log_*
.arch-mind/scan_before.json
.arch-mind/last_summary.json
.arch-mind/key.local
.arch-mind/store.lock

# Private audit reports (external CLI review, internal). The JSON baseline
# arch-mind-v*.json files ARE public-safe (raw metrics, no leak quotes) and
# are tracked individually below the wildcard.
audits/*-audit.md
audits/*-review.md

# mindc doc smoke-test artifacts (canonical output is target/doc/)
std/**/*.html
examples/**/*.html

# Agent worktree isolation (local sub-agent infrastructure, never tracked)
.claude/

# Aspirational examples — use MIND language features not yet implemented in the
# parser (tensor type syntax, for/in loops, tuple destructuring, hex literals,
# compound assignment, &[u8] slices).  These files are git-tracked design
# references; this gitignore entry only excludes them from `mindc check` via the
# VCS integration (vcs.use_ignore_file = true in Mind.toml mindcraft config).
# Remove an entry once the corresponding parser feature ships.
/examples/remizov_benchmark.mind
/examples/remizov_feynman.mind
/examples/remizov_gpu.mind
/examples/remizov_inverse.mind
/examples/remizov_solver.mind
/examples/remizov_verify.mind
/examples/fft_signal.mind
/examples/policy.mind
/examples/compliance/auditable_model.mind
/examples/zoo/

# build artifacts must not be committed (unprotected .so)
examples/**/*.so

# Internal research notes + prior-art papers — keep in mind-internal, never public
docs/research/

# example build artifacts (each example builds its own target/)
examples/*/target/

# Orchestrator session/state DB — never commit to the public compiler repo
.orchestrator_memory/

# Stray local build artifacts / tool caches — never belong in the compiler repo
/a.out
.wrangler/
examples/mindc_mind/mindfuzz_self_host_staged/

# Native record-array refusal and reference programs are test corpus inputs,
# not production examples. Their dedicated native gate executes them with the
# intended feature profile; the broad `mindc check std/ examples/` walk must
# not turn deliberate refusal cases into production-check failures.
/examples/mindc_mind/testdata/native_record_array/
# Canonical record-array trace fixtures — same rule: deliberate refusal
# programs are gate inputs, not production examples.
/examples/mindc_mind/testdata/native_record_trace/

# H2b: per-file exclusions from `mindc check`, never directories (each
# directory still holds sources the walk must keep checking). The check walk
# honours this file; `git ls-files` and ANATOMY still list every entry.
# An excluded file keeps its reviewed bytes (it is not formatted). The line
# above each path gives its reason class and the gate that executes it;
# no-ci-gate-yet names the manual gate and the lane that owns wiring it.
#
# -- refusal-fixture: deliberate check errors (E2001/E2035) ---------------
# refusal-fixture; gate: self_host_native_alloc_bounded_smoke
/examples/mindc_mind/testdata/native_alloc_bounded/dup_struct_name.mind
# refusal-fixture; gate: self_host_native_misc_census_smoke
/examples/mindc_mind/testdata/native_misc/a8_refuse_bool_const.mind
# refusal-fixture; gate: self_host_native_misc_census_smoke
/examples/mindc_mind/testdata/native_misc/a8_refuse_float_const.mind
