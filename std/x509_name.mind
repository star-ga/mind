// std/x509_name.mind — RFC 6125 hostname matching, IPv4/IPv6 literal parsing,
// and RFC 5280 §4.2.1.10 name constraints validation (DNS & IP subtrees).

import std.x509_der;

// ---------------------------------------------------------------------------
// Case folding and byte comparison.
// ---------------------------------------------------------------------------

pub fn xb_fold(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c + 32;
    }
    c
}

pub fn xb_ci_eq(a: i64, la: i64, b: i64, lb: i64) -> i64 {
    if la != lb {
        return 0;
    }
    let mut i: i64 = 0;
    let mut ok: i64 = 1;
    while i < la {
        if xb_fold(xb(a, i)) != xb_fold(xb(b, i)) {
            ok = 0;
        }
        i = i + 1;
    }
    ok
}

pub fn x509_ci_eq(a: i64, la: i64, b: i64, lb: i64) -> i64 {
    if la != lb {
        return 0;
    }
    let mut i: i64 = 0;
    while i < la {
        let mut ca: i64 = __mind_load_i8(a + i) & 255;
        let mut cb: i64 = __mind_load_i8(b + i) & 255;
        if ca >= 65 && ca <= 90 {
            ca = ca + 32;
        }
        if cb >= 65 && cb <= 90 {
            cb = cb + 32;
        }
        if ca != cb {
            return 0;
        }
        i = i + 1;
    }
    1
}

// ---------------------------------------------------------------------------
// RFC 6125 DNS-identity matching (SAN dNSName only; CN fallback NOT used).
// ASCII case-insensitive; wildcards only as a complete LEFT-MOST label
// ("*.example.com"); partial wildcards (e.g. "w*w.example.com") never match.
// IDNA: names are compared in wire A-label form, no U-label conversion.
// ---------------------------------------------------------------------------

// 1 iff p[0..n) is one or more non-empty dot-separated labels.
fn x509_dns_labels_ok(p: i64, n: i64) -> i64 {
    if n < 1 {
        return 0;
    }
    if xb(p, 0) == 46 || xb(p, n - 1) == 46 {
        return 0;
    }
    let mut k: i64 = 1;
    while k < n {
        if xb(p, k) == 46 && xb(p, k - 1) == 46 {
            return 0;
        }
        k = k + 1;
    }
    1
}

pub fn x509_dns_match(pat: i64, pat_len: i64, host: i64, host_len: i64) -> i64 {
    if pat_len < 1 || host_len < 1 {
        return 0;
    }
    // find '*' in pattern
    let mut i: i64 = 0;
    let mut star: i64 = -1;
    while i < pat_len {
        if xb(pat, i) == 42 {
            if star >= 0 {
                // at most one wildcard allowed
                return 0;
            }
            star = i;
        }
        i = i + 1;
    }
    if star < 0 {
        // no wildcard: exact case-insensitive match
        return xb_ci_eq(pat, pat_len, host, host_len);
    }
    // wildcard only as complete left-most label "*."
    if star != 0 {
        return 0;
    }
    if pat_len < 2 {
        return 0;
    }
    if xb(pat, 1) != 46 {
        return 0;
    }
    // the labels after "*." must all be non-empty: "*.", "*..x" and "*.x." are not DNS-IDs
    if x509_dns_labels_ok(pat + 2, pat_len - 2) == 0 {
        return 0;
    }
    // host must be <label> + pat[1..], label nonempty and without '.'
    let suffix_len: i64 = pat_len - 1;
    if host_len <= suffix_len {
        return 0;
    }
    let label_len: i64 = host_len - suffix_len;
    let mut j: i64 = 0;
    while j < label_len {
        if xb(host, j) == 46 {
            // left-most label may not contain a dot
            return 0;
        }
        j = j + 1;
    }
    xb_ci_eq(host + label_len, suffix_len, pat + 1, suffix_len)
}

// ---------------------------------------------------------------------------
// IP address parsing for SAN iPAddress and name constraints.
// ---------------------------------------------------------------------------

pub fn x509_parse_ipv4(host: i64, host_len: i64, out4: i64) -> i64 {
    if host_len < 7 || host_len > 15 {
        return 0;
    }
    let mut octets: i64 = 0;
    let mut p: i64 = 0;
    while p < host_len {
        let mut val: i64 = 0;
        let mut dcnt: i64 = 0;
        // The digit run ends on a flag, not `break`, so `mindc test` runs it
        // as the compiled build does.
        let mut digits: i64 = 1;
        while digits == 1 && p < host_len {
            let c: i64 = __mind_load_i8(host + p) & 255;
            if c >= 48 && c <= 57 {
                val = val * 10 + (c - 48);
                dcnt = dcnt + 1;
                p = p + 1;
            } else {
                digits = 0;
            }
        }
        if dcnt < 1 || dcnt > 3 || val > 255 {
            return 0;
        }
        if octets >= 4 {
            return 0;
        }
        __mind_store_i8(out4 + octets, val & 255);
        octets = octets + 1;
        if octets < 4 {
            if p >= host_len || (__mind_load_i8(host + p) & 255) != 46 {
                return 0;
            }
            p = p + 1;
        }
    }
    if octets == 4 && p == host_len {
        return 1;
    }
    0
}

pub fn x509_parse_ipv6(host: i64, host_len: i64, out16: i64) -> i64 {
    if host_len < 2 || host_len > 39 {
        return 0;
    }
    let mut has_colon: i64 = 0;
    let mut ci: i64 = 0;
    while ci < host_len {
        if (__mind_load_i8(host + ci) & 255) == 58 {
            has_colon = 1;
        }
        ci = ci + 1;
    }
    if has_colon == 0 {
        return 0;
    }
    ci = 0;
    while ci < 16 {
        __mind_store_i8(out16 + ci, 0);
        ci = ci + 1;
    }
    let words: i64 = __mind_alloc(64);
    let mut nwords: i64 = 0;
    let mut dc_pos: i64 = -1;
    let mut p: i64 = 0;
    if p + 1 < host_len && (__mind_load_i8(host + p) & 255) == 58 && (__mind_load_i8(host + p + 1) & 255) == 58 {
        dc_pos = 0;
        p = p + 2;
    }
    while p < host_len {
        let mut val: i64 = 0;
        let mut hcnt: i64 = 0;
        // The hex run ends on a flag, not `break` (see x509_parse_ipv4).
        let mut hexd: i64 = 1;
        while hexd == 1 && p < host_len {
            let c: i64 = __mind_load_i8(host + p) & 255;
            let mut h: i64 = -1;
            if c >= 48 && c <= 57 {
                h = c - 48;
            } else {
                if c >= 97 && c <= 102 {
                    h = c - 87;
                } else {
                    if c >= 65 && c <= 70 {
                        h = c - 55;
                    }
                }
            }
            if h >= 0 {
                val = (val << 4) | h;
                hcnt = hcnt + 1;
                p = p + 1;
            } else {
                hexd = 0;
            }
        }
        if hcnt < 1 || hcnt > 4 || nwords >= 8 {
            return 0;
        }
        __mind_store_i64(words + nwords * 8, val);
        nwords = nwords + 1;
        if p < host_len {
            if (__mind_load_i8(host + p) & 255) != 58 {
                return 0;
            }
            p = p + 1;
            if p == host_len {
                return 0;
            }
            if p < host_len && (__mind_load_i8(host + p) & 255) == 58 {
                if dc_pos >= 0 {
                    return 0;
                }
                dc_pos = nwords;
                p = p + 1;
            }
        }
    }
    if dc_pos >= 0 {
        let fill: i64 = 8 - nwords;
        if fill < 1 {
            return 0;
        }
        let mut out_idx: i64 = 0;
        let mut wi: i64 = 0;
        while wi < dc_pos {
            let wv: i64 = __mind_load_i64(words + wi * 8);
            __mind_store_i8(out16 + out_idx * 2, (wv >> 8) & 255);
            __mind_store_i8(out16 + out_idx * 2 + 1, wv & 255);
            out_idx = out_idx + 1;
            wi = wi + 1;
        }
        out_idx = out_idx + fill;
        while wi < nwords {
            let wv2: i64 = __mind_load_i64(words + wi * 8);
            __mind_store_i8(out16 + out_idx * 2, (wv2 >> 8) & 255);
            __mind_store_i8(out16 + out_idx * 2 + 1, wv2 & 255);
            out_idx = out_idx + 1;
            wi = wi + 1;
        }
        return 1;
    }
    if nwords == 8 {
        let mut wi2: i64 = 0;
        while wi2 < 8 {
            let wv3: i64 = __mind_load_i64(words + wi2 * 8);
            __mind_store_i8(out16 + wi2 * 2, (wv3 >> 8) & 255);
            __mind_store_i8(out16 + wi2 * 2 + 1, wv3 & 255);
            wi2 = wi2 + 1;
        }
        return 1;
    }
    0
}

// ---------------------------------------------------------------------------
// SAN matching.
// ---------------------------------------------------------------------------

// x509_san_match — check whether `host` (length host_len) matches ANY
// dNSName [2] or iPAddress [7] entry inside the GeneralNames sequence
// bounded by cert+off..cert+lim. Returns 1 match / 0 mismatch.
#[protection]
pub fn x509_san_match(cert: i64, off: i64, lim: i64, host: i64, host_len: i64) -> i64 {
    let ip_buf: i64 = __mind_alloc(16);
    let is_v4: i64 = x509_parse_ipv4(host, host_len, ip_buf);
    let is_v6: i64 = if is_v4 == 1 {
        0
    } else {
        x509_parse_ipv6(host, host_len, ip_buf)
    };
    let t: i64 = __mind_alloc(24);
    let mut p: i64 = off;
    let mut found: i64 = 0;
    while p < lim {
        if der_tlv(cert, p, lim, t) != 0 {
            return 0;
        }
        let total: i64 = __mind_load_i64(t + 8) + __mind_load_i64(t + 16);
        let tag: i64 = __mind_load_i64(t + 0);
        let n_off: i64 = p + __mind_load_i64(t + 8);
        let n_len: i64 = __mind_load_i64(t + 16);
        if is_v4 == 1 {
            if tag == 135 && n_len == 4 {
                if xb_eq(cert + n_off, ip_buf, 4) == 1 {
                    found = 1;
                }
            }
        } else {
            if is_v6 == 1 {
                if tag == 135 && n_len == 16 {
                    if xb_eq(cert + n_off, ip_buf, 16) == 1 {
                        found = 1;
                    }
                }
            } else {
                if tag == 130 {
                    if x509_dns_match(cert + n_off, n_len, host, host_len) == 1 {
                        found = 1;
                    }
                }
            }
        }
        p = p + total;
    }
    found
}

// ---------------------------------------------------------------------------
// RFC 5280 §4.2.1.10 Name Constraints validation.
// ---------------------------------------------------------------------------

pub fn x509_nc_dns_match(base: i64, base_len: i64, name: i64, name_len: i64) -> i64 {
    if base_len < 1 || name_len < 1 {
        return 0;
    }
    if (__mind_load_i8(base) & 255) == 46 {
        if name_len <= base_len {
            return 0;
        }
        let off: i64 = name_len - base_len;
        return x509_ci_eq(base, base_len, name + off, base_len);
    }
    if name_len == base_len {
        return x509_ci_eq(base, base_len, name, name_len);
    }
    if name_len > base_len + 1 {
        let off2: i64 = name_len - base_len;
        if (__mind_load_i8(name + off2 - 1) & 255) == 46 {
            return x509_ci_eq(base, base_len, name + off2, base_len);
        }
    }
    0
}

pub fn x509_sub_tlv(cert: i64, pos: i64, lim: i64, out3: i64) -> i64 {
    if pos + 2 > lim {
        return 1;
    }
    let tag: i64 = __mind_load_i8(cert + pos) & 255;
    let b1: i64 = __mind_load_i8(cert + pos + 1) & 255;
    let mut hlen: i64 = 2;
    let mut clen: i64 = 0;
    if b1 < 128 {
        clen = b1;
    } else {
        if b1 == 128 {
            return 1;
        }
        let n: i64 = b1 & 127;
        if n < 1 || n > 3 || pos + 2 + n > lim {
            return 1;
        }
        hlen = 2 + n;
        let mut i: i64 = 0;
        while i < n {
            clen = (clen << 8) | (__mind_load_i8(cert + pos + 2 + i) & 255);
            i = i + 1;
        }
    }
    if pos + hlen + clen > lim {
        return 1;
    }
    __mind_store_i64(out3 + 0, tag);
    __mind_store_i64(out3 + 8, hlen);
    __mind_store_i64(out3 + 16, clen);
    0
}

pub fn x509_nc_scan(cert: i64, start: i64, len: i64, name: i64, nlen: i64, ntag: i64, excluded: i64) -> i64 {
    let t: i64 = __mind_alloc(24);
    let mut p: i64 = start;
    let end: i64 = start + len;
    let mut result: i64 = 0;
    while p < end {
        if x509_sub_tlv(cert, p, end, t) != 0 || __mind_load_i64(t) != 48 {
            return -1;
        }
        let content: i64 = p + __mind_load_i64(t + 8);
        let stop: i64 = content + __mind_load_i64(t + 16);
        p = stop;
        if x509_sub_tlv(cert, content, stop, t) != 0 {
            return -1;
        }
        let tag: i64 = __mind_load_i64(t);
        let base: i64 = cert + content + __mind_load_i64(t + 8);
        let blen: i64 = __mind_load_i64(t + 16);
        let next: i64 = content + __mind_load_i64(t + 8) + blen;
        if tag != 130 && tag != 135 {
            return -12;
        }
        if blen < 1 {
            return -1;
        }
        if tag == 135 && blen != 8 && blen != 32 {
            return -1;
        }
        // RFC 5280 profile: minimum zero and maximum absent.
        if next < stop {
            if x509_sub_tlv(cert, next, stop, t) != 0 {
                return -1;
            }
            if __mind_load_i64(t) != 128 || __mind_load_i64(t + 16) != 1 {
                return -12;
            }
            if (__mind_load_i8(cert + next + __mind_load_i64(t + 8)) & 255) != 0 {
                return -12;
            }
            if next + __mind_load_i64(t + 8) + 1 != stop {
                return -12;
            }
        }
        if tag == ntag {
            result = result | 1;
            if tag == 130 {
                if x509_nc_dns_match(base, blen, name, nlen) == 1 {
                    result = result | 2;
                }
                // A wildcard SAN cannot bypass a narrower excluded subtree.
                if excluded == 1 && nlen > 2 && (__mind_load_i8(name) & 255) == 42 && (__mind_load_i8(name + 1) & 255) == 46 {
                    if x509_nc_dns_match(name + 1, nlen - 1, base, blen) == 1 {
                        result = result | 2;
                    }
                }
            } else {
                if blen == nlen * 2 {
                    let mut ni: i64 = 0;
                    let mut match_ip: i64 = 1;
                    while ni < nlen {
                        let mask: i64 = __mind_load_i8(base + nlen + ni) & 255;
                        if ((__mind_load_i8(name + ni) & 255) & mask) != ((__mind_load_i8(base + ni) & 255) & mask) {
                            match_ip = 0;
                        }
                        ni = ni + 1;
                    }
                    if match_ip == 1 {
                        result = result | 2;
                    }
                }
            }
        }
    }
    result
}

#[protection]
pub fn x509_check_name_constraints(p_cert: i64, nc_off: i64, nc_len: i64, c_cert: i64, san_off: i64, san_len: i64) -> i64 {
    if nc_len < 2 {
        return -1;
    }
    let t: i64 = __mind_alloc(24);
    let nc_lim: i64 = nc_off + nc_len;
    if x509_sub_tlv(p_cert, nc_off, nc_lim, t) != 0 || __mind_load_i64(t) != 48 {
        return -1;
    }
    let mut p: i64 = nc_off + __mind_load_i64(t + 8);
    let end: i64 = p + __mind_load_i64(t + 16);
    if end != nc_lim || p == end {
        return -1;
    }
    let mut perm_off: i64 = 0;
    let mut perm_len: i64 = 0;
    let mut excl_off: i64 = 0;
    let mut excl_len: i64 = 0;
    while p < end {
        if x509_sub_tlv(p_cert, p, end, t) != 0 {
            return -1;
        }
        let tag: i64 = __mind_load_i64(t);
        let hlen: i64 = __mind_load_i64(t + 8);
        let clen: i64 = __mind_load_i64(t + 16);
        if clen < 1 {
            return -1;
        }
        if tag == 160 && perm_len == 0 && excl_len == 0 {
            perm_off = p + hlen;
            perm_len = clen;
        } else {
            if tag == 161 && excl_len == 0 {
                excl_off = p + hlen;
                excl_len = clen;
            } else {
                return -1;
            }
        }
        let valid: i64 = x509_nc_scan(p_cert, p + hlen, clen, 0, 0, 0, 0);
        if valid < 0 {
            return valid;
        }
        p = p + hlen + clen;
    }
    let san_lim: i64 = san_off + san_len;
    let mut sp: i64 = san_off;
    while sp < san_lim {
        if x509_sub_tlv(c_cert, sp, san_lim, t) != 0 {
            return -1;
        }
        let stag: i64 = __mind_load_i64(t);
        let shlen: i64 = __mind_load_i64(t + 8);
        let sclen: i64 = __mind_load_i64(t + 16);
        let name: i64 = c_cert + sp + shlen;
        let ex: i64 = x509_nc_scan(p_cert, excl_off, excl_len, name, sclen, stag, 1);
        if ex < 0 {
            return ex;
        }
        if (ex & 2) != 0 {
            return -17;
        }
        let pe: i64 = x509_nc_scan(p_cert, perm_off, perm_len, name, sclen, stag, 0);
        if pe < 0 {
            return pe;
        }
        if pe == 1 {
            return -17;
        }
        sp = sp + shlen + sclen;
    }
    0
}
