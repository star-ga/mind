// std/mic_record_wire.mind — the limits, value tags, named errors and byte
// primitives of std.mic_record: byte reads and copies, 64-bit patterns,
// zigzag, ULEB128, and the readers of the record header and of lengths.
//
// std/mic_record.mind documents the wire format, the layouts and the error
// rules; `import std.mic_record;` brings this module in. The reader cursor
// (32 bytes) is [ addr | len | pos | value ].
//
// This module imports nothing.

// ---------------------------------------------------------------------------
// Limits, tags and named errors.
// ---------------------------------------------------------------------------

pub fn mrec_max_record_bytes() -> i64 {
    10485760
}

pub fn mrec_max_entries() -> i64 {
    4096
}

pub fn mrec_max_key_bytes() -> i64 {
    256
}

// The fewest bytes one encoded entry can occupy before it is checked: a one-byte
// key length, a tag byte and a one-byte value (an empty key is still read, then
// refused as empty). This matches the compiler's MAP decoder (MIN_ENTRY_BYTES = 3),
// so a count whose entries could not fit in the bytes left is refused before any
// allocation without changing which error a malformed entry reports.
pub fn mrec_min_entry_bytes() -> i64 {
    3
}

pub fn mrec_tag_str() -> i64 {
    0
}

pub fn mrec_tag_int() -> i64 {
    1
}

pub fn mrec_tag_bytes() -> i64 {
    2
}

// Bytes in the empty-module mic@3 body that opens every record.
fn mrec_body_len() -> i64 {
    12
}

// The MAP sentinel 0x4D ('M').
fn mrec_sentinel() -> i64 {
    77
}

pub fn mrec_ok() -> i64 {
    0
}

// The input ends inside an element, or a length passes the bytes left.
pub fn mrec_e_truncated() -> i64 {
    0 - 1
}

// A count or length passes a fixed limit (entries, key bytes, record bytes).
pub fn mrec_e_oversized() -> i64 {
    0 - 2
}

// The first four bytes are not "MIC3".
pub fn mrec_e_magic() -> i64 {
    0 - 3
}

// The mic@3 version byte is not 0x02.
pub fn mrec_e_version() -> i64 {
    0 - 4
}

// The mic@3 body is not the empty module, so the input is not a record.
pub fn mrec_e_body() -> i64 {
    0 - 5
}

// No MAP epilogue follows the body.
pub fn mrec_e_no_map() -> i64 {
    0 - 6
}

// A ULEB128 is zero-padded, longer than 10 bytes, or passes 64 bits.
pub fn mrec_e_varint() -> i64 {
    0 - 7
}

// A key or a String value is not well-formed UTF-8.
pub fn mrec_e_utf8() -> i64 {
    0 - 8
}

// A value tag is not 0, 1 or 2.
pub fn mrec_e_tag() -> i64 {
    0 - 9
}

// The keys are not in ascending byte order.
pub fn mrec_e_order() -> i64 {
    0 - 10
}

// A key is empty or has no '.'.
pub fn mrec_e_key() -> i64 {
    0 - 11
}

// A key starts with `evidence_chain.` or `signature.`.
pub fn mrec_e_reserved() -> i64 {
    0 - 12
}

// Bytes remain after the last entry.
pub fn mrec_e_trailing() -> i64 {
    0 - 13
}

// A key occurs twice.
pub fn mrec_e_duplicate() -> i64 {
    0 - 14
}

// No entry has the key, or the index is out of range.
pub fn mrec_e_not_found() -> i64 {
    0 - 15
}

// The entry holds a different value type.
pub fn mrec_e_type() -> i64 {
    0 - 16
}

// An argument is outside its domain: a negative length, level or action
// count, a score scale <= 0, a game id that is empty or holds a '.', or a
// weights digest that is not 32 bytes.
pub fn mrec_e_value() -> i64 {
    0 - 17
}

// An allocation failed.
pub fn mrec_e_no_memory() -> i64 {
    0 - 18
}

// The record handle is 0.
pub fn mrec_e_handle() -> i64 {
    0 - 19
}

// ---------------------------------------------------------------------------
// Bytes, 64-bit patterns and ULEB128.
// ---------------------------------------------------------------------------

fn mrec_b(a: i64, i: i64) -> i64 {
    __mind_load_i8(a + i) & 255
}

fn mrec_copy(src: i64, dst: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + i, __mind_load_i8(src + i));
        i = i + 1;
    }
    0
}

// Heap copy of n bytes: the address, 0 when n is 0, -1 when allocation fails.
fn mrec_dup(src: i64, n: i64) -> i64 {
    if n == 0 {
        return 0;
    }
    let d: i64 = __mind_alloc(n);
    if d == 0 {
        return 0 - 1;
    }
    let _ = mrec_copy(src, d, n);
    d
}

// Logical right shift by n (1 <= n <= 63). `>>` is arithmetic on i64, so the
// sign-extended bits are masked off (the std/sha512.mind shr64u rule).
fn mrec_shr_u(x: i64, n: i64) -> i64 {
    (x >> n) & ((1 << (64 - n)) - 1)
}

// Zigzag maps an i64 to the 64-bit pattern the MAP Int value carries.
fn mrec_zigzag(v: i64) -> i64 {
    (v << 1) ^ (v >> 63)
}

fn mrec_unzigzag(z: i64) -> i64 {
    mrec_shr_u(z, 1) ^ (0 - (z & 1))
}

// Bytes in the ULEB128 encoding of the 64-bit pattern v.
fn mrec_uleb_len(v: i64) -> i64 {
    let mut n: i64 = 1;
    let mut x: i64 = mrec_shr_u(v, 7);
    while x != 0 {
        n = n + 1;
        x = mrec_shr_u(x, 7);
    }
    n
}

// Write the 64-bit pattern v as ULEB128 at d + p; returns the next position.
fn mrec_uleb_put(d: i64, p: i64, v: i64) -> i64 {
    let mut pos: i64 = p;
    let mut x: i64 = v;
    let mut more: i64 = 1;
    while more == 1 {
        let low: i64 = x & 127;
        x = mrec_shr_u(x, 7);
        if x == 0 {
            __mind_store_i8(d + pos, low);
            more = 0;
        } else {
            __mind_store_i8(d + pos, low | 128)
        }
        pos = pos + 1;
    }
    pos
}

// Write 1..4 constant bytes at d + p; each returns the next position.
fn mrec_w1(d: i64, p: i64, c0: i64) -> i64 {
    __mind_store_i8(d + p, c0);
    p + 1
}

fn mrec_w2(d: i64, p: i64, c0: i64, c1: i64) -> i64 {
    mrec_w1(d, mrec_w1(d, p, c0), c1)
}

fn mrec_w4(d: i64, p: i64, c0: i64, c1: i64, c2: i64, c3: i64) -> i64 {
    mrec_w2(d, mrec_w2(d, p, c0, c1), c2, c3)
}

// 1 when the 5 bytes at a + off equal c0..c4, else 0.
fn mrec_eq5(a: i64, off: i64, c0: i64, c1: i64, c2: i64, c3: i64, c4: i64) -> i64 {
    if mrec_b(a, off) != c0 {
        return 0;
    }
    if mrec_b(a, off + 1) != c1 {
        return 0;
    }
    if mrec_b(a, off + 2) != c2 {
        return 0;
    }
    if mrec_b(a, off + 3) != c3 {
        return 0;
    }
    if mrec_b(a, off + 4) != c4 {
        return 0;
    }
    1
}

// ---------------------------------------------------------------------------
// Record header and length readers.
// ---------------------------------------------------------------------------

// Read one minimal ULEB128 at the cursor into its value slot; 0 or an error.
#[protection]
fn mrec_rd_uleb(rd: i64) -> i64 {
    let a: i64 = __mind_load_i64(rd + 0);
    let n: i64 = __mind_load_i64(rd + 8);
    let mut pos: i64 = __mind_load_i64(rd + 16);
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 10 {
        if pos >= n {
            return mrec_e_truncated();
        }
        let byte: i64 = mrec_b(a, pos);
        pos = pos + 1;
        let low: i64 = byte & 127;
        if i == 9 {
            if low > 1 {
                return mrec_e_varint();
            }
        }
        acc = acc | (low << (i * 7));
        if byte < 128 {
            if byte == 0 {
                if i > 0 {
                    return mrec_e_varint();
                }
            }
            __mind_store_i64(rd + 16, pos);
            __mind_store_i64(rd + 24, acc);
            return 0;
        }
        i = i + 1;
    }
    mrec_e_varint()
}

// Read a length no larger than `limit` and no larger than the bytes left.
#[protection]
fn mrec_rd_len(rd: i64, limit: i64) -> i64 {
    let rc: i64 = mrec_rd_uleb(rd);
    if rc != 0 {
        return rc;
    }
    let v: i64 = __mind_load_i64(rd + 24);
    if v < 0 {
        return mrec_e_oversized();
    }
    if v > limit {
        return mrec_e_oversized();
    }
    if v > __mind_load_i64(rd + 8) - __mind_load_i64(rd + 16) {
        return mrec_e_truncated();
    }
    0
}

// Check the magic, the version, the empty-module body and the MAP sentinel.
#[protection]
fn mrec_check_head(a: i64, n: i64) -> i64 {
    if n < 5 {
        return mrec_e_truncated();
    }
    if mrec_eq5(a, 0, 77, 73, 67, 51, mrec_b(a, 4)) == 0 {
        return mrec_e_magic();
    }
    if mrec_b(a, 4) != 2 {
        return mrec_e_version();
    }
    let mut i: i64 = 5;
    while i < mrec_body_len() {
        if i >= n {
            return mrec_e_truncated();
        }
        if mrec_b(a, i) != 0 {
            return mrec_e_body();
        }
        i = i + 1;
    }
    if n == mrec_body_len() {
        return mrec_e_no_map();
    }
    if mrec_b(a, mrec_body_len()) != mrec_sentinel() {
        return mrec_e_no_map();
    }
    0
}
