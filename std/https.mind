// std.https — authenticated HTTPS GET and POST over the bounded TLS 1.3
// client, and the client itself (its record pump and handshake state machine).
//
// Copyright 2026 STARGA Inc.
// Licensed under the Apache License, Version 2.0.
// Part of the MIND project (Machine Intelligence Native Design).
//
// HTTPS: https_get(url) / https_post(url, body, content_type) resolve the host
// (std.dns tcp_connect_host), draw the TLS randoms and key share from the
// kernel (std.entropy), authenticate the server against the system CA bundle
// (/etc/ssl/certs/ca-certificates.crt; https_get_ca / https_post_ca take
// another path) at the system clock, and speak HTTP/1.1 (std.https_http1).
// https_get_with_headers / https_post_with_headers also send a caller block of
// request headers (X-API-Key, Cookie, ...; std/https_url.mind hx_headers_ok).
// Each call returns a response record (std/https_http1.mind accessors,
// Set-Cookie included; https_free releases it): the error is 0 or a named
// https_err_* code, and a refusal never carries a status or a body. The body
// streams through the client's one-record plaintext window into the record,
// up to https_max_body().
// Error classes (https_error_class(r), std/https_url.mind): 0
// https_class_none, a complete response; 1 https_class_before_send, the call
// failed before any request byte was written (URL, headers, body or CA bundle
// refused, name resolution, TCP connect refused or timed out, TLS handshake,
// or application data that arrived before the request: https_err_response,
// never a success), so the server never saw it and the same request is safe
// to retry; 2 https_class_after_send, the client had begun to write the
// request (a write that fails partway included) and the response is missing,
// partial or garbled, so the server may have acted: the caller must pause and
// never count it as a result. std.https_probe
// https_probe(url, url_len, timeout_ms) resolves the host and opens and
// closes one TCP connection, with a distinct code per failure. Fail closed:
//   - the server profile is TLS 1.3, X25519, AES-128-GCM or ChaCha20-Poly1305,
//     and an RSA-2048 leaf with an rsa_pss_rsae_sha256 CertificateVerify; an
//     ECDSA, RSA-3072+ or other leaf key is refused (https_err_unsupported_key);
//   - the chain must reach a bundle anchor (RFC 5280 path, validity at the
//     system clock, basicConstraints / keyUsage / EKU) and name the host
//     (RFC 6125); revocation (CRL, OCSP) is NOT checked;
//   - redirects are not followed: a 3xx is returned as the response;
//   - bounded: URL, header block, body, request body, the read timeout
//     (https_io_timeout_s()) and the whole call (https_deadline_s()).
// The six request functions read the world (DNS, network, kernel entropy,
// clock, the bundle file) and are classified nondeterministic by name.
//
// TLS 1.3 client (sans-IO; the functions above are its I/O driver):
// No socket, clock, system trust store, or verifier override. Caller owns I/O,
// entropy, time and the trust-anchor buffer (immutable for the connection).
// x509_verify_server_chain (std/x509 path validation) is mandatory for every chain.
// Evidence remains available after refusal: version/suite/group, selected ALPN,
// presented DER chain and verifier verdict (1 = unchecked, 0 = accept, <0 refusal).
// Flags: bit0 enables hybrid; bit3 sends an empty initial key_share for HRR.
// HRR parks status 10. Call build_client_hello2 then seal_client_hello2 once;
// the retry keeps CH1 entropy, random, session id, identity and offered ALPN.
// Initial entropy: random[32], session id[32], x25519 scalar[32], optionally
// hybrid entropy[96]. Build requires the same entropy length on the retry.
// Only RSA-PSS SHA256 CertificateVerify with an RSA-2048 rsaEncryption leaf
// key is implemented: any other leaf key type and RSA-1024 are refused at CV,
// RSA-3072 and above at Certificate (E_OVF). Certificate/handshake
// message cap 8192, transcript cap 16384, cookie cap 254, ALPN offer cap 1024.
// After the handshake, whole NewSessionTicket messages are discarded; any
// other post-handshake message is refused. Decrypted application data is held
// one record at a time (up to the RFC 8446 maximum of 2^14 bytes): the pump
// opens no further record until it is read, so the state stays fixed-size
// however long the stream.
// Tests: tests/std_tls_x509_import.rs (mindc test and the mindc build
// executable), tests/std_https_loopback.rs (a loopback TLS 1.3 server in
// MIND) and tests/std_https_openssl.rs (openssl s_server).
// Modules: tls13_client_core (state layout, transcript, record protection),
// tls13_client_hello (hellos, HelloRetryRequest, traffic keys),
// tls13_client_api (public constants, accessors, application data, the
// EncryptedExtensions and Certificate parsers) and this module (the record
// pump, the handshake state machine, which calls the chain verifier, and the
// HTTPS driver). The client and the driver share one module because the
// import chain under the state machine is already five modules deep.
// x509_bundle is imported for callers: x509_load_anchors builds the
// trust-anchor buffer.

import std.tls13_client_core;
import std.tls13_client_hello;
import std.tls13_client_api;
import std.x509_der;
import std.x509_bundle;
import std.x509_path;
import std.tls13_finished;
import std.rsa_pss;
import std.https_url;
import std.https_http1;
import std.dns;
import std.net;
import std.entropy;

// The system clock for certificate validity (CLOCK_REALTIME). Socket calls go
// through std.net and std.dns, so this module declares nothing they declare.
extern "C" {
    unsafe fn clock_gettime(clk: i32, ts: *mut u8) -> i32;
}

pub fn tls13c_pump(state: i64) -> i64 {
    let st: i64 = tls13ci_status(state);
    if st == tls13ci_st_error() {
        return tls13ci_error(state);
    }
    if st == tls13ci_st_closed() {
        return tls13ci_err_closed();
    }
    let mut guard: i64 = 0;
    let mut rc: i64 = 0;
    while guard < 64 {
        guard = guard + 1;
        let in_len: i64 = tls13c_load_i64(state + 160);
        if in_len < 5 {
            return 0;
        }
        // Decrypted application data waits for tls13c_read_app before the
        // next record is opened, so the receive buffer holds one record.
        if tls13ci_status(state) == tls13ci_st_connected() && tls13c_load_i64(state + 192) > 0 {
            return 0;
        }
        let rec_len: i64 = tls13c_be16(state + 29816 + 3) + 5;
        if rec_len < 5 {
            return tls13c_fail(state, tls13ci_err_record());
        }
        if rec_len > tls13ci_max_record() {
            return tls13c_fail(state, tls13ci_err_ovf());
        }
        if in_len < rec_len {
            return 0;
        }
        let rec: i64 = __mind_alloc(rec_len);
        tls13c_copy(rec, state + 29816, rec_len);
        let mut i: i64 = 0;
        let rem: i64 = in_len - rec_len;
        while i < rem {
            __mind_store_i8(state + 29816 + i, __mind_load_i8(state + 29816 + rec_len + i));
            i = i + 1;
        }
        tls13c_store_i64(state + 160, rem);
        rc = tls13c_handle_record(state, rec, rec_len);
        __mind_free(rec);
        if rc != 0 {
            return rc;
        }
    }
    0
}

#[protection]
pub fn tls13c_parse_and_verify_cv(state: i64, msg_addr: i64, msg_len: i64) -> i64 {
    if msg_len < 4 {
        return tls13ci_err_hs();
    }
    if tls13c_u8(msg_addr + 0) != tls13ci_hs_certificate_verify() {
        return tls13ci_err_hs();
    }
    let blen: i64 = tls13c_be24(msg_addr + 1);
    if blen + 4 != msg_len {
        return tls13ci_err_hs();
    }
    if blen < 4 {
        return tls13ci_err_hs();
    }
    let alg: i64 = tls13c_be16(msg_addr + 4);
    let slen: i64 = tls13c_be16(msg_addr + 6);
    if slen + 4 != blen {
        return tls13ci_err_hs();
    }
    if slen < 1 || slen > 512 {
        return tls13ci_err_hs();
    }
    let sig: i64 = msg_addr + 8;
    tls13c_store_i64(state + 56, alg);

    tls13c_transcript_hash_into(state, state + 4544);
    let content: i64 = __mind_alloc(130);
    tls13_hs_cert_verify_content(state + 4544, content);

    if alg == tls13ci_sig_rsa_pss_rsae_sha256() {
        // 0 unless the leaf carries a verified rsaEncryption key (see
        // tls13c_parse_certificate): an ECDSA or other leaf is refused here.
        // The CertificateVerify key is RSA-2048 only (256-byte modulus); an
        // RSA-1024 leaf is refused here, RSA-3072 and above at Certificate.
        let n_len: i64 = tls13c_load_i64(state + 4752);
        if n_len != 256 {
            return tls13ci_err_cv();
        }
        let e_val: i64 = tls13c_load_i64(state + 4784);
        let ok: i64 = tls13_hs_rsa_pss_verify(state + 4856, n_len, e_val, sig, slen, content, 130, 32);
        if ok != 1 {
            return tls13ci_err_cv();
        }
        0
    } else {
        tls13ci_err_cv()
    }
}

pub fn tls13c_verify_server_finished(state: i64, msg_addr: i64, msg_len: i64) -> i64 {
    if msg_len != 36 {
        return tls13ci_err_hs();
    }
    if tls13c_u8(msg_addr + 0) != tls13ci_hs_finished() {
        return tls13ci_err_hs();
    }
    let blen: i64 = tls13c_be24(msg_addr + 1);
    if blen != 32 {
        return tls13ci_err_hs();
    }
    tls13c_copy(state + 5112, msg_addr + 4, 32);
    tls13c_transcript_hash_into(state, state + 4544);
    let ok: i64 = tls13_hs_verify_server_finished(state + 4128, state + 4544, state + 5112);
    if ok != 1 {
        return tls13ci_err_fin();
    }
    0
}

pub fn tls13c_build_client_finished(state: i64, out_addr: i64) -> i64 {
    tls13c_transcript_hash_into(state, state + 5208);
    tls13_hs_client_finished(state + 4096, state + 5208, state + 5144);
    __mind_store_i8(out_addr + 0, tls13ci_hs_finished());
    tls13c_put_be24(out_addr + 1, 32);
    tls13c_copy(out_addr + 4, state + 5144, 32);
    36
}

// Inbound record and handshake state transitions. Mandatory X.509 gate.

pub fn tls13c_consume_hs_payload(state: i64, data_addr: i64, data_len: i64) -> i64 {
    let mut off: i64 = 0;
    while off < data_len {
        let used: i64 = tls13c_load_i64(state + 184);
        if used >= 8192 {
            return tls13ci_err_ovf();
        }
        __mind_store_i8(state + 21624 + used, tls13c_u8(data_addr + off));
        let have: i64 = used + 1;
        tls13c_store_i64(state + 184, have);
        off = off + 1;
        if have >= 4 {
            let need: i64 = 4 + tls13c_be24(state + 21625);
            if need > 8192 {
                return tls13ci_err_ovf();
            }
            if have == need {
                let before: i64 = tls13ci_status(state);
                let rc: i64 = tls13c_consume_hs_messages(state, state + 21624, need);
                if rc != 0 {
                    return rc;
                }
                tls13c_store_i64(state + 184, 0);
                // No message may straddle the ServerHello/Finished key epoch.
                if before == 1 || before == 2 || before == 6 {
                    if off != data_len {
                        return tls13ci_err_hs();
                    }
                }
            }
        }
    }
    0
}

// Convert the already validated u32be serialized evidence/anchor buffer to
// the x509_verify_server_chain i64 count + (relative offset, length) table ABI.
fn tls13c_x509_blob(src: i64, size: i64) -> i64 {
    let count: i64 = (tls13c_be16(src) << 16) | tls13c_be16(src + 2);
    let dst: i64 = __mind_alloc(8 + count * 16 + size);
    __mind_store_i64(dst, count);
    let mut rp: i64 = 4;
    let mut wp: i64 = 8 + count * 16;
    let mut i: i64 = 0;
    while i < count {
        let n: i64 = (tls13c_be16(src + rp) << 16) | tls13c_be16(src + rp + 2);
        __mind_store_i64(dst + 8 + i * 16, wp);
        __mind_store_i64(dst + 16 + i * 16, n);
        tls13c_copy(dst + wp, src + rp + 4, n);
        rp = rp + 4 + n;
        wp = wp + n;
        i = i + 1;
    }
    dst
}

pub fn tls13c_consume_hs_messages(state: i64, data_addr: i64, data_len: i64) -> i64 {
    let mut off: i64 = 0;
    while off < data_len {
        if off + 4 > data_len {
            return tls13ci_err_hs();
        }
        let mtype: i64 = tls13c_u8(data_addr + off);
        let mlen: i64 = tls13c_be24(data_addr + off + 1);
        if mlen < 0 || mlen + 4 > tls13ci_max_hs_msg() {
            return tls13ci_err_hs();
        }
        if off + 4 + mlen > data_len {
            return tls13ci_err_hs();
        }
        let msg: i64 = data_addr + off;
        let msg_len: i64 = 4 + mlen;
        let st: i64 = tls13ci_status(state);

        if st == tls13ci_st_ch_sent() || st == tls13ci_st_wait_sh() {
            if mtype != tls13ci_hs_server_hello() {
                return tls13ci_err_hs();
            }
            let rc: i64 = tls13c_parse_server_hello(state, msg, msg_len);
            if rc != 0 {
                return tls13c_fail(state, rc);
            }
            if tls13ci_status(state) == tls13ci_st_hrr() {
                if off + msg_len != data_len {
                    return tls13c_fail(state, tls13ci_err_hs());
                }
                return 0;
            }
            let arc: i64 = tls13c_transcript_append(state, msg, msg_len);
            if arc != 0 {
                return tls13c_fail(state, arc);
            }
            let krc: i64 = tls13c_derive_hs_keys(state);
            if krc != 0 {
                return tls13c_fail(state, krc);
            }
            tls13c_set_status(state, tls13ci_st_wait_ee())
        } else {
            if st == tls13ci_st_wait_ee() {
                if mtype != tls13ci_hs_encrypted_extensions() {
                    return tls13c_fail(state, tls13ci_err_hs());
                }
                let rc: i64 = tls13c_parse_ee(state, msg, msg_len);
                if rc != 0 {
                    return tls13c_fail(state, rc);
                }
                let arc: i64 = tls13c_transcript_append(state, msg, msg_len);
                if arc != 0 {
                    return tls13c_fail(state, arc);
                }
                tls13c_set_status(state, tls13ci_st_wait_cert())
            } else {
                if st == tls13ci_st_wait_cert() {
                    if mtype != tls13ci_hs_certificate() {
                        return tls13c_fail(state, tls13ci_err_hs());
                    }
                    let rc: i64 = tls13c_parse_certificate(state, msg, msg_len);
                    if rc != 0 {
                        return tls13c_fail(state, rc);
                    }
                    let chain_addr: i64 = tls13c_x509_blob(state + 65672, tls13c_load_i64(state + 65144));
                    let anchors_addr: i64 = tls13c_x509_blob(tls13c_load_i64(state + 88), tls13c_load_i64(state + 96));
                    let now_unix: i64 = tls13c_load_i64(state + 32);
                    let chain_verdict: i64 = x509_verify_server_chain(chain_addr, anchors_addr, state + 83204, now_unix);
                    // The verifier keeps no pointer into either table.
                    __mind_free(chain_addr);
                    __mind_free(anchors_addr);
                    tls13c_store_i64(state + 240, chain_verdict);
                    if chain_verdict != 0 {
                        return tls13c_fail(state, tls13ci_err_chain());
                    }
                    let arc: i64 = tls13c_transcript_append(state, msg, msg_len);
                    if arc != 0 {
                        return tls13c_fail(state, arc);
                    }
                    tls13c_set_status(state, tls13ci_st_wait_cv())
                } else {
                    if st == tls13ci_st_wait_cv() {
                        if mtype != tls13ci_hs_certificate_verify() {
                            return tls13c_fail(state, tls13ci_err_hs());
                        }
                        let rc: i64 = tls13c_parse_and_verify_cv(state, msg, msg_len);
                        if rc != 0 {
                            return tls13c_fail(state, rc);
                        }
                        let arc: i64 = tls13c_transcript_append(state, msg, msg_len);
                        if arc != 0 {
                            return tls13c_fail(state, arc);
                        }
                        tls13c_set_status(state, tls13ci_st_wait_fin())
                    } else {
                        if st == tls13ci_st_wait_fin() {
                            if mtype != tls13ci_hs_finished() {
                                return tls13c_fail(state, tls13ci_err_hs());
                            }
                            let rc: i64 = tls13c_verify_server_finished(state, msg, msg_len);
                            if rc != 0 {
                                return tls13c_fail(state, rc);
                            }
                            let arc: i64 = tls13c_transcript_append(state, msg, msg_len);
                            if arc != 0 {
                                return tls13c_fail(state, arc);
                            }
                            let fin: i64 = __mind_alloc(36);
                            tls13c_build_client_finished(state, fin);
                            let flen: i64 = 36;
                            tls13c_derive_app_keys(state);
                            let arc2: i64 = tls13c_transcript_append(state, fin, flen);
                            if arc2 != 0 {
                                return tls13c_fail(state, arc2);
                            }
                            let rec: i64 = __mind_alloc(tls13ci_max_record());
                            let suite: i64 = tls13c_load_i64(state + 40);
                            let seq: i64 = tls13c_load_i64(state + 128);
                            let rlen: i64 = tls13ci_record_seal(suite, state + 4160, state + 81928, seq, fin, flen, tls13ci_ct_handshake(), rec);
                            if rlen < 0 {
                                return tls13c_fail(state, rlen);
                            }
                            tls13c_store_i64(state + 128, seq + 1);
                            let orc: i64 = tls13c_out_append(state, rec, rlen);
                            if orc != 0 {
                                return tls13c_fail(state, orc);
                            }
                            tls13c_set_status(state, tls13ci_st_connected())
                        } else {
                            return tls13c_fail(state, tls13ci_err_hs());
                        }
                    }
                }
            }
        }
        off = off + msg_len;
    }
    0
}

// Post-handshake handshake content (RFC 8446 §4.6): every message must be a
// whole NewSessionTicket (type 4) inside this record. KeyUpdate, a request for
// a client certificate, or a message split across records is refused.
fn tls13c_skip_tickets(msg: i64, len: i64) -> i64 {
    if len < 4 {
        return tls13ci_err_hs();
    }
    let mut off: i64 = 0;
    let mut rc: i64 = 0;
    while rc == 0 && off < len {
        if off + 4 > len {
            rc = tls13ci_err_hs();
        } else {
            let mlen: i64 = tls13c_be24(msg + off + 1);
            if tls13c_u8(msg + off) != 4 || off + 4 + mlen > len {
                rc = tls13ci_err_hs();
            } else {
                off = off + 4 + mlen;
            }
        }
    }
    rc
}

pub fn tls13c_handle_record(state: i64, rec_addr: i64, rec_len: i64) -> i64 {
    if rec_len < 5 {
        return tls13c_fail(state, tls13ci_err_record());
    }
    let rtype: i64 = tls13c_u8(rec_addr + 0);
    let ver_hi: i64 = tls13c_u8(rec_addr + 1);
    let ver_lo: i64 = tls13c_u8(rec_addr + 2);
    let rlen: i64 = tls13c_be16(rec_addr + 3);
    if rlen + 5 != rec_len {
        return tls13c_fail(state, tls13ci_err_record());
    }
    if ver_hi != 3 {
        return tls13c_fail(state, tls13ci_err_record());
    }
    if ver_lo != 3 {
        return tls13c_fail(state, tls13ci_err_record());
    }
    if rtype == tls13ci_ct_handshake() && rlen > 16384 {
        return tls13c_fail(state, tls13ci_err_record());
    }
    if rlen > tls13ci_max_record() {
        return tls13c_fail(state, tls13ci_err_ovf());
    }

    let st: i64 = tls13ci_status(state);

    if rtype == tls13ci_ct_change_cipher_spec() {
        if st == tls13ci_st_init() || st == tls13ci_st_connected() || st == tls13ci_st_closed() {
            return tls13c_fail(state, tls13ci_err_record());
        }
        if rlen != 1 {
            return tls13c_fail(state, tls13ci_err_record());
        }
        if tls13c_u8(rec_addr + 5) != 1 {
            return tls13c_fail(state, tls13ci_err_record());
        }
        return 0;
    }
    if st == tls13ci_st_hrr() {
        return tls13c_fail(state, tls13ci_err_hs());
    }
    if st == tls13ci_st_ch_sent() || st == tls13ci_st_wait_sh() {
        if rtype == tls13ci_ct_change_cipher_spec() {
            return 0;
        }
        if rtype == tls13ci_ct_alert() {
            return tls13c_fail(state, tls13ci_err_alert());
        }
        if rtype != tls13ci_ct_handshake() {
            return tls13c_fail(state, tls13ci_err_record());
        }
        let hrc: i64 = tls13c_consume_hs_payload(state, rec_addr + 5, rlen);
        if hrc != 0 {
            return tls13c_fail(state, hrc);
        }
    } else {
        if rtype == tls13ci_ct_change_cipher_spec() {
            return 0;
        }
        if st == tls13ci_st_closed() {
            return tls13ci_err_closed();
        }
        if rtype != tls13ci_ct_app_data() {
            return tls13c_fail(state, tls13ci_err_record());
        }
        // One plaintext scratch per record, released before the next.
        let plain: i64 = __mind_alloc(tls13ci_max_record());
        let orc: i64 = tls13c_open_protected(state, rec_addr, rec_len, st, plain);
        __mind_free(plain);
        if orc != 0 {
            return orc;
        }
    }
    0
}

// A protected record (status after ServerHello): open it with the handshake
// or application keys and act on its inner content type. `plain` is a
// tls13ci_max_record() scratch the caller owns. Returns 0 or the latched error.
fn tls13c_open_protected(state: i64, rec_addr: i64, rec_len: i64, st: i64, plain: i64) -> i64 {
    let suite: i64 = tls13c_load_i64(state + 40);
    let use_app: i64 = 0;
    if st == tls13ci_st_connected() {
        use_app = 1;
    }
    let key: i64 = state + 4192;
    let iv: i64 = state + 81940;
    let seq: i64 = tls13c_load_i64(state + 144);
    if use_app == 1 {
        key = state + 4352;
        iv = state + 81964;
        seq = tls13c_load_i64(state + 152);
    }
    let prc: i64 = tls13ci_record_open(suite, key, iv, seq, rec_addr, rec_len, plain);
    if prc < 0 {
        return tls13c_fail(state, tls13ci_err_record());
    }
    let plen: i64 = prc >> 8;
    if plen > 16384 {
        return tls13c_fail(state, tls13ci_err_record());
    }
    let ptype: i64 = prc & 255;
    if use_app == 0 {
        tls13c_store_i64(state + 144, seq + 1)
    } else {
        tls13c_store_i64(state + 152, seq + 1)
    }
    if ptype == tls13ci_ct_alert() {
        if plen == 2 && use_app == 1 {
            if tls13c_u8(plain + 1) == 0 {
                tls13c_zero_keys(state);
                tls13c_set_status(state, tls13ci_st_closed());
                return 0;
            }
        }
        return tls13c_fail(state, tls13ci_err_alert());
    }
    if ptype == tls13ci_ct_handshake() {
        if use_app == 1 {
            // Post-handshake: only whole NewSessionTicket messages, which
            // are discarded (no resumption is offered).
            let trc: i64 = tls13c_skip_tickets(plain, plen);
            if trc != 0 {
                return tls13c_fail(state, trc);
            }
            return 0;
        }
        let hrc: i64 = tls13c_consume_hs_payload(state, plain, plen);
        if hrc != 0 {
            return tls13c_fail(state, hrc);
        }
    } else {
        if ptype == tls13ci_ct_app_data() {
            if use_app != 1 {
                return tls13c_fail(state, tls13ci_err_app());
            }
            let arx: i64 = tls13c_load_i64(state + 192);
            if arx + plen > tls13ci_app_rx_cap() {
                return tls13c_fail(state, tls13ci_err_ovf());
            }
            tls13c_copy(state + tls13ci_app_rx_off() + arx, plain, plen);
            tls13c_store_i64(state + 192, arx + plen)
        } else {
            return tls13c_fail(state, tls13ci_err_record());
        }
    }
    0
}

// ---------------------------------------------------------------------------
// HTTPS driver
// ---------------------------------------------------------------------------

// Seconds one socket read or write may block.
pub fn https_io_timeout_s() -> i64 {
    30
}

// Seconds one request may take, from the TCP connect to the end of the response.
pub fn https_deadline_s() -> i64 {
    120
}

// The default trust store, "/etc/ssl/certs/ca-certificates.crt" (Debian,
// Ubuntu, Alpine), as a fresh NUL-terminated string.
pub fn https_default_ca_path() -> i64 {
    let p: i64 = __mind_alloc(40);
    __mind_store_i64(p, 7814716425787172143);
    __mind_store_i64(p + 8, 7147058077632914223);
    __mind_store_i64(p + 16, 7379557499099360609);
    __mind_store_i64(p + 24, 7146776538264986473);
    __mind_store_i8(p + 32, 114);
    __mind_store_i8(p + 33, 116);
    __mind_store_i8(p + 34, 0);
    p
}

// Unix seconds from the system clock, or -1.
fn https_now_unix() -> i64 {
    let ts: i64 = __mind_alloc(16);
    __mind_store_i64(ts, 0);
    __mind_store_i64(ts + 8, 0);
    let rc: i64 = clock_gettime(0, ts as *mut u8) as i64;
    let sec: i64 = __mind_load_i64(ts);
    __mind_free(ts);
    if rc != 0 || sec <= 0 {
        return 0 - 1;
    }
    sec
}

// std.net's tcp_close closes the descriptor held in a handle record; the
// bundle file uses it, so this module declares no libc close of its own.
fn https_close_fd(fd: i64) -> i64 {
    let h: i64 = __mind_alloc(8);
    __mind_store_i64(h, fd);
    tcp_close(h);
    __mind_free(h);
    0
}

// The trust-anchor blob (x509_load_anchors) of the bundle file at the
// NUL-terminated `path`, or -1: unreadable, larger than x509_max_bundle_len(),
// malformed PEM/DER, or no certificate.
fn https_read_ca(path: i64) -> i64 {
    if path <= 0 {
        return 0 - 1;
    }
    let fd: i64 = __mind_open(path);
    if fd < 0 {
        return 0 - 1;
    }
    let cap: i64 = x509_max_bundle_len() + 1;
    let buf: i64 = __mind_alloc(cap);
    let mut got: i64 = 0;
    let mut rc: i64 = 0;
    let mut going: i64 = 1;
    while going == 1 {
        let n: i64 = __mind_read(fd, buf + got, cap - got, 0 - 1);
        if n == 0 {
            going = 0;
        } else {
            if n < 0 {
                rc = 0 - 1;
                going = 0;
            } else {
                got = got + n;
                if got >= cap {
                    rc = 0 - 1;
                    going = 0;
                }
            }
        }
    }
    https_close_fd(fd);
    let mut blob: i64 = 0 - 1;
    if rc == 0 {
        blob = x509_load_anchors(buf, got);
        if blob <= 0 {
            blob = 0 - 1;
        }
    }
    __mind_free(buf);
    blob
}

// The u32be anchor buffer tls13c_init takes (count, then length and DER per
// anchor) built from a trust-anchor blob, as a 16-byte record {addr, len}.
fn https_anchor_wire(blob: i64) -> i64 {
    let count: i64 = __mind_load_i64(blob);
    let mut total: i64 = 4;
    let mut i: i64 = 0;
    while i < count {
        total = total + 4 + x509_blob_len(blob, i);
        i = i + 1;
    }
    let w: i64 = __mind_alloc(total);
    tls13c_put_be16(w, (count >> 16) & 65535);
    tls13c_put_be16(w + 2, count & 65535);
    let mut p: i64 = 4;
    i = 0;
    while i < count {
        let n: i64 = x509_blob_len(blob, i);
        tls13c_put_be16(w + p, (n >> 16) & 65535);
        tls13c_put_be16(w + p + 2, n & 65535);
        tls13c_copy(w + p + 4, blob + x509_blob_off(blob, i), n);
        p = p + 4 + n;
        i = i + 1;
    }
    let rec: i64 = __mind_alloc(16);
    __mind_store_i64(rec, w);
    __mind_store_i64(rec + 8, total);
    rec
}

// Name a TLS refusal: the chain verdict, the leaf key and end of stream decide.
fn https_tls_error(state: i64, rc: i64) -> i64 {
    if rc == tls13c_err_chain() {
        let v: i64 = tls13c_verdict(state);
        if v == 0 - 8 || v == 0 - 15 {
            return https_err_hostname();
        }
        if v == 0 - 5 || v == 0 - 6 {
            return https_err_cert_validity();
        }
        if v == 0 - 7 {
            return https_err_unknown_anchor();
        }
        return https_err_chain();
    }
    let kind: i64 = tls13c_leaf_key_kind(state);
    let nlen: i64 = tls13c_leaf_rsa_len(state);
    if rc == tls13c_err_cv() {
        if kind != 1 || nlen != 256 {
            return https_err_unsupported_key();
        }
        return https_err_cert_verify();
    }
    if rc == tls13c_err_ovf() && kind == 1 && nlen > 256 {
        return https_err_unsupported_key();
    }
    if rc == tls13c_err_eof() {
        return https_err_truncated();
    }
    https_err_tls()
}

// Send every pending TLS record. Returns 0 or a negative code.
fn https_flush(state: i64, conn: i64, buf: i64) -> i64 {
    let mut rc: i64 = 0;
    while rc == 0 && tls13c_out_pending(state) > 0 {
        let n: i64 = tls13c_read_out(state, buf, 16640);
        if n <= 0 {
            rc = https_err_tls();
        } else {
            if tcp_write_all(conn, buf, n) != n {
                rc = https_err_io();
            }
        }
    }
    rc
}

// Seal and send the request, one record of at most 16384 bytes at a time.
fn https_send_request(state: i64, conn: i64, req: i64, buf: i64) -> i64 {
    let addr: i64 = __mind_load_i64(req);
    let len: i64 = __mind_load_i64(req + 8);
    let mut off: i64 = 0;
    let mut rc: i64 = 0;
    while rc == 0 && off < len {
        let mut n: i64 = len - off;
        if n > 16384 {
            n = 16384;
        }
        let w: i64 = tls13c_write_app(state, addr + off, n);
        if w != n {
            rc = https_tls_error(state, w);
        } else {
            off = off + n;
            rc = https_flush(state, conn, buf);
        }
    }
    rc
}

// Pump every complete record and hand the decrypted bytes to the parser.
// `sent` is 0 until the first request byte is written: application data that
// arrives before it (with the server's handshake flight) answers no request,
// so it is refused (https_err_response) and the class stays before-send.
// Returns 1 when the response is complete, 0 when more input is needed, or a
// negative code.
fn https_drain(state: i64, resp: i64, app: i64, sent: i64) -> i64 {
    let mut result: i64 = 0;
    let mut going: i64 = 1;
    while result == 0 && going == 1 {
        if tls13c_status(state) == tls13c_st_closed() {
            going = 0;
        } else {
            let prc: i64 = tls13c_pump(state);
            if prc < 0 {
                result = https_tls_error(state, prc);
            } else {
                let k: i64 = tls13c_read_app(state, app, 16384);
                if k > 0 {
                    if sent == 0 {
                        result = https_err_response();
                    } else {
                        result = hx_feed(resp, app, k);
                    }
                } else {
                    going = 0;
                }
            }
        }
    }
    result
}

// The connection loop after ClientHello is queued. Returns 1 (complete
// response) or a negative code.
fn https_session(state: i64, conn: i64, ent: i64, ent_len: i64, req: i64, resp: i64, deadline: i64) -> i64 {
    let buf: i64 = __mind_alloc(16640);
    let app: i64 = __mind_alloc(16384);
    let mut sent: i64 = 0;
    let mut result: i64 = https_flush(state, conn, buf);
    while result == 0 {
        let st: i64 = tls13c_status(state);
        if https_now_unix() > deadline {
            result = https_err_timeout();
        } else {
            if st == tls13c_st_hrr() {
                let ch2: i64 = __mind_alloc(8192);
                let n2: i64 = tls13c_build_client_hello2(state, ent, ent_len, ch2);
                if n2 < 1 {
                    result = https_err_tls();
                } else {
                    if tls13c_seal_client_hello2(state, ch2, n2) != 0 {
                        result = https_err_tls();
                    } else {
                        result = https_flush(state, conn, buf);
                    }
                }
                __mind_free(ch2)
            } else {
                if st == tls13c_st_connected() && sent == 0 {
                    // The measured server profile: an RSA-2048 leaf.
                    if tls13c_leaf_key_kind(state) != 1 || tls13c_leaf_rsa_len(state) != 256 {
                        result = https_err_unsupported_key();
                    } else {
                        sent = 1;
                        // From here a failure is after-send (https_error_class):
                        // marked before the first write, so a write that fails
                        // partway (a reset during the body) is after-send too.
                        hx_mark_sent(resp);
                        result = https_send_request(state, conn, req, buf);
                    }
                } else {
                    if st == tls13c_st_closed() {
                        result = hx_on_close(resp);
                    } else {
                        let mut want: i64 = tls13c_in_space(state);
                        if want > 16640 {
                            want = 16640;
                        }
                        if want < 1 {
                            result = https_err_tls();
                        } else {
                            let n: i64 = tcp_read(conn, buf, want);
                            if n == 0 {
                                if hx_complete(resp) == 1 {
                                    result = 1;
                                } else {
                                    result = https_err_truncated();
                                }
                            } else {
                                if n < 0 {
                                    result = https_err_io();
                                } else {
                                    let frc: i64 = tls13c_feed(state, buf, n);
                                    if frc != 0 {
                                        result = https_tls_error(state, frc);
                                    } else {
                                        result = https_drain(state, resp, app, sent);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    __mind_free(buf);
    __mind_free(app);
    result
}

// One request: GET (is_post 0) or POST (is_post 1) with the caller header
// block [hdr, hdr+hdr_len) against the bundle at the NUL-terminated
// `ca_path` (0: https_default_ca_path()). Always returns a response record.
fn https_request(is_post: i64, url: i64, url_len: i64, hdr: i64, hdr_len: i64, body: i64, body_len: i64, ct: i64, ct_len: i64, ca_path: i64) -> i64 {
    let resp: i64 = hx_resp_new();
    let u: i64 = hx_url_new();
    if hx_url_parse(url, url_len, u) != 0 {
        __mind_free(u);
        return hx_fail(resp, https_err_url());
    }
    let req: i64 = hx_build_request(is_post, url, u, hdr, hdr_len, body, body_len, ct, ct_len);
    if req < 0 {
        __mind_free(u);
        return hx_fail(resp, req);
    }
    let mut ca: i64 = ca_path;
    if ca_path == 0 {
        ca = https_default_ca_path();
    }
    let blob: i64 = https_read_ca(ca);
    if ca_path == 0 {
        __mind_free(ca)
    }
    if blob < 0 {
        __mind_free(u);
        __mind_free(__mind_load_i64(req));
        __mind_free(req);
        return hx_fail(resp, https_err_ca_bundle());
    }
    let wire: i64 = https_anchor_wire(blob);
    __mind_free(blob);
    let unix_s: i64 = https_now_unix();
    if unix_s < 0 {
        return hx_fail(resp, https_err_io());
    }
    let host: i64 = url + hx_url_host_off(u);
    let hlen: i64 = hx_url_host_len(u);
    let port: i64 = hx_url_port(u);
    __mind_free(u);
    let conn: i64 = tcp_connect_host(host, hlen, port);
    if conn == 0 {
        return hx_fail(resp, https_err_connect());
    }
    if tcp_set_io_timeout(conn, https_io_timeout_s() * 1000) != 0 {
        tcp_close(conn);
        return hx_fail(resp, https_err_io());
    }
    let need: i64 = tls13c_entropy_need(0);
    let ent: i64 = __mind_alloc(need);
    if entropy_fill(ent, need) != 0 {
        tcp_close(conn);
        return hx_fail(resp, https_err_entropy());
    }
    let state: i64 = __mind_alloc(tls13c_state_size());
    let mut result: i64 = 0;
    if tls13c_init(state, ent, need, __mind_load_i64(wire), __mind_load_i64(wire + 8), host, hlen, unix_s, 0, 0) != 0 {
        result = https_err_tls();
    } else {
        let ch: i64 = __mind_alloc(8192);
        let n: i64 = tls13c_build_client_hello(state, ent, need, ch);
        if n < 1 {
            result = https_err_tls();
        } else {
            if tls13c_seal_client_hello(state, ch, n) != 0 {
                result = https_err_tls();
            }
        }
        __mind_free(ch)
    }
    if result == 0 {
        result = https_session(state, conn, ent, need, req, resp, unix_s + https_deadline_s());
    }
    hx_set_verdict(resp, tls13c_verdict(state));
    tls13c_close(state);
    tcp_close(conn);
    tls13c_zero(ent, need);
    __mind_free(ent);
    tls13c_zero(state, tls13c_state_size());
    __mind_free(state);
    __mind_free(__mind_load_i64(wire));
    __mind_free(wire);
    __mind_free(__mind_load_i64(req));
    __mind_free(req);
    if result == 1 {
        return resp;
    }
    hx_fail(resp, result)
}

// https_get — GET `url` (https only), authenticated against the system CA
// bundle (https_default_ca_path()). Returns a response record: check
// https_error(r) == 0 before https_status / https_body_addr / https_body_len;
// release it with https_free.
#[protection]
pub fn https_get(url: i64, url_len: i64) -> i64 {
    https_request(0, url, url_len, 0, 0, 0, 0, 0, 0, 0)
}

// https_post — POST `body` with the given content type (0..256 printable
// bytes; 0 sends no Content-Type) to `url`, against the system CA bundle.
#[protection]
pub fn https_post(url: i64, url_len: i64, body: i64, body_len: i64, content_type: i64, content_type_len: i64) -> i64 {
    https_request(1, url, url_len, 0, 0, body, body_len, content_type, content_type_len, 0)
}

// https_get_ca — https_get against the CA bundle at the NUL-terminated path.
#[protection]
pub fn https_get_ca(url: i64, url_len: i64, ca_path: i64) -> i64 {
    https_request(0, url, url_len, 0, 0, 0, 0, 0, 0, ca_path)
}

// https_post_ca — https_post against the CA bundle at the NUL-terminated path.
#[protection]
pub fn https_post_ca(url: i64, url_len: i64, body: i64, body_len: i64, content_type: i64, content_type_len: i64, ca_path: i64) -> i64 {
    https_request(1, url, url_len, 0, 0, body, body_len, content_type, content_type_len, ca_path)
}

// https_get_with_headers — https_get that also sends the request header block
// [headers, headers+headers_len): `name: value` CRLF lines such as
// "X-API-Key: <key>\r\nCookie: <name=value; ...>\r\n" (hx_headers_ok; a
// refused block is https_err_request_headers() before any connection).
// `ca_path` is a NUL-terminated CA bundle path, or 0 for the system bundle.
#[protection]
pub fn https_get_with_headers(url: i64, url_len: i64, headers: i64, headers_len: i64, ca_path: i64) -> i64 {
    https_request(0, url, url_len, headers, headers_len, 0, 0, 0, 0, ca_path)
}

// https_post_with_headers — https_post with a request header block, as
// https_get_with_headers.
#[protection]
pub fn https_post_with_headers(url: i64, url_len: i64, headers: i64, headers_len: i64, body: i64, body_len: i64, content_type: i64, content_type_len: i64, ca_path: i64) -> i64 {
    https_request(1, url, url_len, headers, headers_len, body, body_len, content_type, content_type_len, ca_path)
}
