// std/io.mind — RFC 0005 Phase 2: pure-MIND I/O surface.
//
// `File` is the i64-typed handle the four intrinsics
// `__mind_read` / `__mind_write` already speak.  Today it wraps the
// POSIX file-descriptor space (0/1/2 for stdin/stdout/stderr), but
// callers must not assume that — treat the inner `fd` field as
// opaque.  Higher-level surfaces (open/close, path-based file I/O)
// land once the seventh intrinsic `__mind_open` is wired (RFC 0005
// Phase 3); the four-arg read/write contract here is what mind-nerve's
// streaming-tokens path needs first, so it ships at Phase 2.
//
// Intrinsic contract (mirrors POSIX `pread`/`pwrite`):
//   __mind_read(fd:  i64, buf_addr: i64, count: i64, offset: i64) -> i64
//   __mind_write(fd: i64, buf_addr: i64, count: i64, offset: i64) -> i64
// Returns: number of bytes read/written, or a negative error sentinel.
// An `offset` of -1 means "use the current stream position" — same
// convention `pread`/`pwrite` of `-1` would carry on a regular fd.
//
// Determinism: every input byte sequence round-trips byte-for-byte
// (no buffering at this layer, no implicit newline conversion).

struct File {
    fd: i64,
}

// stdin / stdout / stderr — handles for the three standard streams.
// Wrapping the literal `fd` values lets the rest of the surface stay
// agnostic to whether the runtime layer chose POSIX or a synthetic
// fd allocator.
pub fn stdin() -> File {
    File { fd: 0 }
}

pub fn stdout() -> File {
    File { fd: 1 }
}

pub fn stderr() -> File {
    File { fd: 2 }
}

// file_fd — opaque accessor for the underlying handle.  Same shape
// as `vec_addr` / `string_addr` — the only reason to inspect the
// inner field is for FFI-bridge code already in a privileged layer.
pub fn file_fd(f: File) -> i64 {
    f.fd
}

// file_read — read up to `count` bytes from `f` into `buf_addr`,
// at stream offset `offset` (-1 means "current position").  Returns
// the byte count or a negative sentinel.  Caller owns the buffer
// lifetime — std.vec / std.string typically supplies it.
pub fn file_read(f: File, buf_addr: i64, count: i64, offset: i64) -> i64 {
    __mind_read(f.fd, buf_addr, count, offset)
}

// file_write — write `count` bytes from `buf_addr` into `f` at
// stream offset `offset` (-1 means "current position").  Same
// contract as `file_read` mirrored.
pub fn file_write(f: File, buf_addr: i64, count: i64, offset: i64) -> i64 {
    __mind_write(f.fd, buf_addr, count, offset)
}

// print_bytes — convenience wrapper: write `count` bytes from
// `buf_addr` to stdout at the current position.  The deterministic
// shape lets mind-nerve's streaming-tokens emit one syscall per
// chunk without buffering at this layer.
pub fn print_bytes(buf_addr: i64, count: i64) -> i64 {
    __mind_write(1, buf_addr, count, 0 - 1)
}

// eprint_bytes — same, to stderr.  Negative offset sentinel is the
// "use current position" convention from `pread`/`pwrite`.
pub fn eprint_bytes(buf_addr: i64, count: i64) -> i64 {
    __mind_write(2, buf_addr, count, 0 - 1)
}

// read_stdin_bytes — read up to `count` bytes from stdin into
// `buf_addr` at the current position.  Returns the byte count or
// a negative sentinel.
pub fn read_stdin_bytes(buf_addr: i64, count: i64) -> i64 {
    __mind_read(0, buf_addr, count, 0 - 1)
}

// ---------------------------------------------------------------------------
// Numeric stdout printers — the missing piece for a standalone `mindc run`
// binary that has to emit a numeric result.  Both build the decimal ASCII
// into one fixed 24-byte scratch buffer and hand it to `print_bytes` in a
// single syscall — no per-digit write, no clock, no rand.  The whole path is
// integer division / modulo + byte load/store, so it is byte-identical
// run-to-run and across substrates (x86/ARM) by construction.  24 bytes
// covers the widest case: 20 decimal digits (full u64 / i64 range) plus an
// optional sign byte plus the trailing newline.
// ---------------------------------------------------------------------------

// print_u64_line — write the decimal ASCII of the UNSIGNED 64-bit value `v`
// to stdout, then a trailing newline.  Digits are extracted least-
// significant-first (`% 10` / `/ 10` are unsigned here because `v` is u64,
// so the full 0..=u64::MAX range prints correctly — including bit patterns
// with the high bit set) into the scratch buffer, then reversed in place to
// most-significant-first before the single `print_bytes` call.  Returns the
// `print_bytes` result (bytes written, or a negative sentinel).
fn print_u64_line(v: u64) -> i64 {
    let buf: i64 = __mind_alloc(24);
    let mut n: u64 = v;
    let mut i: i64 = 0;
    if n == 0 {
        __mind_store_i8(buf + 0, 48);
        i = 1;
    } else {
        while n > 0 {
            let d: u64 = n % 10;
            __mind_store_i8(buf + i, 48 + (d as i64));
            n = n / 10;
            i = i + 1;
        }
    }
    // Reverse the `i` emitted digits into most-significant-first order.
    let mut lo: i64 = 0;
    let mut hi: i64 = i - 1;
    while lo < hi {
        let a: i64 = __mind_load_i8(buf + lo);
        let b: i64 = __mind_load_i8(buf + hi);
        __mind_store_i8(buf + lo, b);
        __mind_store_i8(buf + hi, a);
        lo = lo + 1;
        hi = hi - 1;
    }
    __mind_store_i8(buf + i, 10);
    let r: i64 = print_bytes(buf, i + 1);
    __mind_free(buf);
    r
}

// print_i64 — write the decimal ASCII of the SIGNED 64-bit value `v` to
// stdout (leading `-` for negatives, single `0` for zero), then a trailing
// newline.  The magnitude is taken in u64 space via a two's-complement
// negate (`0 - (v as u64)`), which yields the correct absolute value for the
// whole i64 range — including `i64::MIN`, whose signed negation would
// overflow.  The `v < 0` test is a native signed compare on `v: i64`; the
// digit loop runs on the u64 magnitude.  Returns the `print_bytes` result.
pub fn print_i64(v: i64) -> i64 {
    let buf: i64 = __mind_alloc(24);
    let mut i: i64 = 0;
    let mut mag: u64 = v as u64;
    if v < 0 {
        mag = 0 - mag;
    }
    if mag == 0 {
        __mind_store_i8(buf + 0, 48);
        i = 1;
    } else {
        while mag > 0 {
            let d: u64 = mag % 10;
            __mind_store_i8(buf + i, 48 + (d as i64));
            mag = mag / 10;
            i = i + 1;
        }
    }
    if v < 0 {
        __mind_store_i8(buf + i, 45);
        i = i + 1;
    }
    // Reverse the digits (and the sign byte) into most-significant-first.
    let mut lo: i64 = 0;
    let mut hi: i64 = i - 1;
    while lo < hi {
        let a: i64 = __mind_load_i8(buf + lo);
        let b: i64 = __mind_load_i8(buf + hi);
        __mind_store_i8(buf + lo, b);
        __mind_store_i8(buf + hi, a);
        lo = lo + 1;
        hi = hi - 1;
    }
    __mind_store_i8(buf + i, 10);
    let r: i64 = print_bytes(buf, i + 1);
    __mind_free(buf);
    r
}

// print_f64_bits — write the EXACT, trivially-deterministic representation
// of `v`: its IEEE-754 double bit pattern reinterpreted as an unsigned 64-bit
// integer, emitted as decimal (then a newline).  `__mind_f64_to_bits`
// (arity 1) reinterprets the f64 as its raw i64 bit pattern; casting that to
// u64 preserves the bits and lets `print_u64_line` render the full unsigned
// range (a negative float sets the high bit → a value above i64::MAX).  The
// output round-trips exactly back to `v` via `__mind_bits_to_f64`, sidestepping
// the float→shortest-decimal determinism problem entirely.
//
// deferred: a full shortest-round-trip decimal float printer (Ryū / Grisu
// class — the human-readable `2.0` form) is a separate research-grade
// determinism task; an incorrect float→decimal rounding step would silently
// break cross-substrate byte-identity (the wedge), so it is NOT attempted
// here.  upgrade path: implement a fixed-precision integer-only Ryū whose
// every intermediate is exact 128-bit integer arithmetic (no hardware FP in
// the formatting path), gated behind a KAT of the full round-trip and a
// cross-substrate byte-identity check before it may replace this exact form.
pub fn print_f64_bits(v: f64) -> i64 {
    let bits: i64 = __mind_f64_to_bits(v);
    print_u64_line(bits as u64)
}

// ---------------------------------------------------------------------------
// RFC 0013 Tier 1 — TTY detection + ANSI SGR vocabulary.
//
// `isatty` lets a CLI decide whether to emit ANSI escape sequences;
// the SGR constants are the colour / style codes those sequences carry
// (the literal numbers inside `ESC [ N m`).  Higher-level escape
// composition (e.g. an `ansi_color_fg(s, code)` writer) lands once
// std.string ships an integer-to-decimal `itoa` helper; for now,
// callers compose their own escape bytes using std.string's byte-push
// surface and the constants below.
//
// Constants are typed as zero-arg pub fns rather than `const N: i64 =
// ...` so the type-checker side table treats them uniformly with the
// rest of the public surface.  The codes themselves are ECMA-48 §8.3.117.
// ---------------------------------------------------------------------------

extern "C" {
    unsafe fn isatty(fd: i32) -> i32;
}

// io_isatty — does `f` refer to a terminal device?  Returns 1 if so,
// 0 otherwise.  Maps libc `isatty(3)` 1/0 (and -1 on EBADF, which we
// fold to 0 — a bad fd is not a terminal).
pub fn io_isatty(f: File) -> i64 {
    let r: i32 = isatty(f.fd as i32);
    if r != 0 {
        1
    } else {
        0
    }
}

// --- ANSI SGR codes (ECMA-48 §8.3.117) ---
//
// Style:
pub fn sgr_reset() -> i64 {
    0
}
pub fn sgr_bold() -> i64 {
    1
}
pub fn sgr_dim() -> i64 {
    2
}
pub fn sgr_italic() -> i64 {
    3
}
pub fn sgr_underline() -> i64 {
    4
}
pub fn sgr_blink() -> i64 {
    5
}
pub fn sgr_reverse() -> i64 {
    7
}
pub fn sgr_strikethrough() -> i64 {
    9
}

// Foreground colour (standard 8):
pub fn sgr_fg_black() -> i64 {
    30
}
pub fn sgr_fg_red() -> i64 {
    31
}
pub fn sgr_fg_green() -> i64 {
    32
}
pub fn sgr_fg_yellow() -> i64 {
    33
}
pub fn sgr_fg_blue() -> i64 {
    34
}
pub fn sgr_fg_magenta() -> i64 {
    35
}
pub fn sgr_fg_cyan() -> i64 {
    36
}
pub fn sgr_fg_white() -> i64 {
    37
}
pub fn sgr_fg_default() -> i64 {
    39
}

// string_push_ansi_sgr — append a complete SGR escape sequence
// (`ESC [ <code> m`) to `s`.  Composes string_push_i64 with the
// ECMA-48 framing so callers can build coloured output as a single
// String value and emit it through `file_write` / `print_bytes`.
//
// Usage:
//   use std.string;
//   use std.io;
//   let buf: String = string_new();
//   let buf2: String = string_push_ansi_sgr(buf,  sgr_fg_red());
//   // ... push payload bytes via string_push_byte ...
//   let buf3: String = string_push_ansi_sgr(buf2, sgr_reset());
//
// The helper takes the SGR code as an i64 (not a typed style enum)
// so callers can supply any ECMA-48 parameter — including 256-color
// and 24-bit truecolor codes (38;5;n / 38;2;r;g;b) once those
// compose-multiple-params writers land.
pub fn string_push_ansi_sgr(s: String, code: i64) -> String {
    let mut out: String = string_push_byte(s, 27);
    out = string_push_byte(out, 91);
    out = string_push_i64(out, code);
    out = string_push_byte(out, 109);
    out
}

// Background colour (standard 8):
pub fn sgr_bg_black() -> i64 {
    40
}
pub fn sgr_bg_red() -> i64 {
    41
}
pub fn sgr_bg_green() -> i64 {
    42
}
pub fn sgr_bg_yellow() -> i64 {
    43
}
pub fn sgr_bg_blue() -> i64 {
    44
}
pub fn sgr_bg_magenta() -> i64 {
    45
}
pub fn sgr_bg_cyan() -> i64 {
    46
}
pub fn sgr_bg_white() -> i64 {
    47
}
pub fn sgr_bg_default() -> i64 {
    49
}
