// std/x509.mind — X.509v3 DER parsing, RSA PKCS#1 v1.5 (SHA-256) signature
// verification, and authenticated server-certificate chain validation in pure
// MIND, for the TLS 1.3 peer-certificate verification path (RFC 8446 §4.4.2 /
// §4.4.3, RFC 5280 §6, RFC 6125 §6.4).
//
// ============================ SECURITY SCOPE ==============================
// x509_verify_peer / chain authentication IS implemented (see
// x509_verify_server_chain in std/x509_path.mind): bounded fail-closed DER
// parsing, per-link signature verification (ECDSA P-256 SHA-256/384, RSA
// PKCS#1 v1.5 SHA-256, RSASSA-PSS SHA-256, ECDSA P-384 SHA-384),
// basicConstraints cA + pathLen,
// keyUsage/EKU serverAuth, validity windows against a caller-supplied clock,
// name constraints (DNS subtrees and IPv4/IPv6 address/mask subtrees), and
// SAN dNSName / iPAddress matching (RFC 6125, no CN fallback, whole-label
// left-most wildcard only). x509_peer_auth_supported() == 1 reflects that.
//
// RECORDED LIMITS (fail-closed policy):
//   1. Name constraints: only DNS subtrees and IPv4/IPv6 address/mask subtrees
//      are supported; any other constraint name form or non-zero subtree bound
//      fails closed (returns -17).
//   2. Revocation: no CRL or OCSP revocation checking is performed.
//   3. Capacity limits: at most 8 certificates in a chain and at most 32 trust
//      anchors are accepted (exceeding returns -13).
//   4. Issuer matching: issuer/subject matching uses exact DER byte equality;
//      no attribute re-ordering or canonicalization.
//   5. Supported signatures: RSA PKCS#1 v1.5 SHA-256, RSA-PSS with explicit
//      SHA-256/MGF1-SHA-256 and salt, ECDSA P-256 SHA-256/384, ECDSA P-384 SHA-384.
//      SHA-1, MD5, DSA, Ed25519, and implicit PSS defaults are refused.
//   6. Fail-closed: any parse error, truncation, unknown critical extension,
//      or policy violation returns a distinct negative error code.
//
// The x509_parse (std/x509_der.mind) / x509_verify_self_signed (below)
// helpers are signature-math utilities: they authenticate NOTHING by
// themselves.
//
// Layout: this module is the entry point that imports the whole validator;
// the code lives in the modules it imports. x509_verify_server_chain is
// in std/x509_path.mind and x509_parse in std/x509_der.mind, so a client such
// as std.tls13_client calls them without importing this module.
// ==========================================================================

import std.sha256;
import std.sha512;
import std.ecdsa_p256;
import std.x509_p384;
import std.x509_bundle;
import std.rsa_pss;
import std.x509_der;
import std.x509_ext;
import std.x509_name;
import std.x509_sig;
import std.x509_path;

// ---------------------------------------------------------------------------
// Capability flag (fail-closed honesty marker). 1 == true: peer
// authentication is implemented by x509_verify_server_chain.
// ---------------------------------------------------------------------------
pub fn x509_peer_auth_supported() -> i64 {
    1
}

// ---------------------------------------------------------------------------
// x509_verify_self_signed — parse a self-signed certificate and verify its
// signature against its own subjectPublicKeyInfo. Returns 1 (valid) or 0.
// ---------------------------------------------------------------------------
pub fn x509_verify_self_signed(cert_addr: i64, cert_len: i64) -> i64 {
    let f: i64 = __mind_alloc(176);
    // 22 i64 slots
    if x509_parse(cert_addr, cert_len, f) != 0 {
        return 0;
    }
    // malformed certificate — fail closed
    let tbs_off: i64 = __mind_load_i64(f + 0);
    let tbs_len: i64 = __mind_load_i64(f + 8);
    let n_off: i64 = __mind_load_i64(f + 96);
    let n_len: i64 = __mind_load_i64(f + 104);
    let e_off: i64 = __mind_load_i64(f + 112);
    let e_len: i64 = __mind_load_i64(f + 120);
    let sig_off: i64 = __mind_load_i64(f + 144);
    let sig_len: i64 = __mind_load_i64(f + 152);
    if e_len < 1 {
        // bytes_be_to_i64 shifts 8 bits per byte — cap at 8 bytes
        return 0;
    }
    if e_len > 8 {
        return 0;
    }
    let e_val: i64 = bytes_be_to_i64(cert_addr + e_off, e_len);
    rsa_pkcs1_sha256_verify(cert_addr + n_off, n_len, e_val, cert_addr + sig_off, sig_len, cert_addr + tbs_off, tbs_len)
}
