// std/x509_bignum.mind — fixed-width big-integer arithmetic (radix 2^16 limbs,
// one limb per 8 bytes) and RSA modular exponentiation shared by std/rsa_pss
// and std/x509_sig. No imports: it sits below both, so the RSA and X.509
// modules import it instead of each other.

// ---------------------------------------------------------------------------
// Bignum primitives (radix 2^16 limbs, one limb per 8 bytes).
// ---------------------------------------------------------------------------

// bn_zero — set `limbs` limbs to zero.
pub fn bn_zero(buf: i64, limbs: i64) -> i64 {
    let mut i: i64 = 0;
    while i < limbs {
        __mind_store_i64(buf + i * 8, 0);
        i = i + 1;
    }
    0
}

// bn_copy — copy `limbs` limbs from src to dst.
pub fn bn_copy(dst: i64, src: i64, limbs: i64) -> i64 {
    let mut i: i64 = 0;
    while i < limbs {
        __mind_store_i64(dst + i * 8, __mind_load_i64(src + i * 8));
        i = i + 1;
    }
    0
}

// bn_from_bytes — decode `len` big-endian bytes at src into a radix-2^16
// little-endian integer in `out` (zero-extended).
pub fn bn_from_bytes(src: i64, len: i64, out: i64) -> i64 {
    let mut max_limbs: i64 = (len + 1) / 2 + 2;
    if max_limbs < 130 {
        max_limbs = 130;
    }
    bn_zero(out, max_limbs);
    let mut i: i64 = len - 1;
    let mut k: i64 = 0;
    while i >= 0 {
        let lo: i64 = __mind_load_i8(src + i) & 255;
        let mut hi: i64 = 0;
        if i - 1 >= 0 {
            hi = __mind_load_i8(src + i - 1) & 255;
        }
        __mind_store_i64(out + k * 8, lo | (hi << 8));
        k = k + 1;
        i = i - 2;
    }
    0
}

// bn_to_bytes — encode the lowest `byte_len` bytes of a radix-2^16 integer at
// `limbs` to big-endian bytes at `out`.
pub fn bn_to_bytes(limbs: i64, out: i64, byte_len: i64) -> i64 {
    let mut k: i64 = 0;
    let half: i64 = byte_len / 2;
    while k < half {
        let v: i64 = __mind_load_i64(limbs + k * 8);
        __mind_store_i8(out + byte_len - 1 - 2 * k, v & 255);
        __mind_store_i8(out + byte_len - 2 - 2 * k, (v >> 8) & 255);
        k = k + 1;
    }
    0
}

// Multiply-accumulate: p[i+j] += a[i] * b[j].
fn bn_mac_full(p: i64, a: i64, b: i64, n_limbs: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n_limbs {
        let ai: i64 = __mind_load_i64(a + i * 8);
        if ai != 0 {
            let mut j: i64 = 0;
            while j < n_limbs {
                let idx: i64 = i + j;
                let cur: i64 = __mind_load_i64(p + idx * 8);
                __mind_store_i64(p + idx * 8, cur + ai * __mind_load_i64(b + j * 8));
                j = j + 1;
            }
        }
        i = i + 1;
    }
    0
}

// Carry propagate through limbs.
fn bn_normalize(p: i64, limbs: i64) -> i64 {
    let mut carry: i64 = 0;
    let mut k: i64 = 0;
    while k < limbs {
        let v: i64 = __mind_load_i64(p + k * 8) + carry;
        __mind_store_i64(p + k * 8, v & 65535);
        carry = v >> 16;
        k = k + 1;
    }
    0
}

// Full n_limbs x n_limbs -> (2*n_limbs) product.
fn bn_mul_full(p: i64, a: i64, b: i64, n_limbs: i64) -> i64 {
    let p_limbs: i64 = n_limbs * 2;
    bn_zero(p, p_limbs);
    bn_mac_full(p, a, b, n_limbs);
    bn_normalize(p, p_limbs);
    0
}

// Shift r left by 1 bit in-place over `limbs` limbs. Returns the overflow bit.
fn bn_shl1(r: i64, limbs: i64) -> i64 {
    let mut carry: i64 = 0;
    let mut k: i64 = 0;
    while k < limbs {
        let v: i64 = (__mind_load_i64(r + k * 8) << 1) | carry;
        __mind_store_i64(r + k * 8, v & 65535);
        carry = (v >> 16) & 1;
        k = k + 1;
    }
    0
}

// bn_cmp_ge — 1 iff a >= b over `limbs` limbs, else 0.
pub fn bn_cmp_ge(a: i64, b: i64, limbs: i64) -> i64 {
    let mut k: i64 = limbs - 1;
    let mut res: i64 = 1;
    // all-equal => a >= b
    let mut decided: i64 = 0;
    while k >= 0 {
        if decided == 0 {
            let av: i64 = __mind_load_i64(a + k * 8);
            let bv: i64 = __mind_load_i64(b + k * 8);
            if av > bv {
                res = 1;
                decided = 1;
            } else {
                if av < bv {
                    res = 0;
                    decided = 1;
                }
            }
        }
        k = k - 1;
    }
    res
}

// bn_sub — a -= b over `limbs` limbs (caller guarantees a >= b).
fn bn_sub(a: i64, b: i64, limbs: i64) -> i64 {
    let mut borrow: i64 = 0;
    let mut k: i64 = 0;
    while k < limbs {
        let av: i64 = __mind_load_i64(a + k * 8);
        let bv: i64 = __mind_load_i64(b + k * 8);
        let mut d: i64 = av - bv - borrow;
        if d < 0 {
            d = d + 65536;
            borrow = 1;
        } else {
            borrow = 0;
        }
        __mind_store_i64(a + k * 8, d & 65535);
        k = k + 1;
    }
    0
}

// Reduction: out = p mod n.  p is a (2*n_limbs)-limb product, n is a n_limbs modulus.
// out is a (n_limbs + 2)-limb buffer.
fn bn_mod_reduce(p: i64, n: i64, out: i64, n_limbs: i64) -> i64 {
    let buf_limbs: i64 = n_limbs + 2;
    bn_zero(out, buf_limbs);
    let mut bit: i64 = n_limbs * 32 - 1;
    while bit >= 0 {
        bn_shl1(out, buf_limbs);
        let limb: i64 = bit / 16;
        let off: i64 = bit % 16;
        let pbit: i64 = (__mind_load_i64(p + limb * 8) >> off) & 1;
        __mind_store_i64(out + 0, __mind_load_i64(out + 0) | pbit);
        if bn_cmp_ge(out, n, buf_limbs) == 1 {
            bn_sub(out, n, buf_limbs)
        }
        bit = bit - 1;
    }
    0
}

// modmul_rsa — out = (a * b) mod n. a, b, n, out are (n_limbs + 2)-limb buffers.
fn modmul_rsa(a: i64, b: i64, n: i64, out: i64, n_limbs: i64) -> i64 {
    let p: i64 = __mind_alloc(n_limbs * 16);
    bn_mul_full(p, a, b, n_limbs);
    bn_mod_reduce(p, n, out, n_limbs);
    0
}

// modexp_rsa — out = (base ^ e) mod n for a scalar exponent `e > 0`.
pub fn modexp_rsa(base: i64, e: i64, n: i64, out: i64, n_limbs: i64) -> i64 {
    let buf_limbs: i64 = n_limbs + 2;
    bn_zero(out, buf_limbs);
    __mind_store_i64(out + 0, 1);
    let tmp: i64 = __mind_alloc(buf_limbs * 8);
    let mut started: i64 = 0;
    let mut bit: i64 = 62;
    while bit >= 0 {
        let ebit: i64 = (e >> bit) & 1;
        if started == 1 {
            modmul_rsa(out, out, n, tmp, n_limbs);
            bn_copy(out, tmp, buf_limbs)
        }
        if ebit == 1 {
            if started == 0 {
                bn_copy(out, base, buf_limbs);
                started = 1;
            } else {
                modmul_rsa(out, base, n, tmp, n_limbs);
                bn_copy(out, tmp, buf_limbs)
            }
        }
        bit = bit - 1;
    }
    0
}

// modexp_2048 — backward-compatible wrapper for 2048-bit (128-limb) modexp.
pub fn modexp_2048(base: i64, e: i64, n: i64, out: i64) -> i64 {
    modexp_rsa(base, e, n, out, 128)
}
