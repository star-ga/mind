// ClientHello, ServerHello and bounded HRR negotiation, and the handshake and
// application traffic keys. No verifier or I/O.
import std.tls13_client_core;
import std.hkdf;
import std.tls13_keyschedule;
import std.x25519;
import std.x25519mlkem768;

pub fn tls13ci_build_client_hello(state: i64, entropy_addr: i64, entropy_len: i64, out_addr: i64) -> i64 {
    if tls13ci_status(state) != tls13ci_st_init() {
        return tls13ci_err_state();
    }
    tls13c_make_hello(state, entropy_addr, entropy_len, out_addr, 0)
}

pub fn tls13c_make_hello(state: i64, entropy_addr: i64, entropy_len: i64, out_addr: i64, retry: i64) -> i64 {
    let flags: i64 = tls13c_load_i64(state + 64);
    let need: i64 = tls13c_load_i64(state + 72);
    if entropy_len < need {
        return tls13c_fail(state, tls13ci_err_entropy());
    }

    let ch_rand: i64 = state + 256;
    let ch_sid: i64 = state + 288;
    let x_priv: i64 = state + 320;
    let x_pub: i64 = state + 352;
    if retry == 0 {
        tls13c_copy(ch_rand, entropy_addr, 32);
        tls13c_copy(ch_sid, entropy_addr + 32, 32);
        tls13c_copy(x_priv, entropy_addr + 64, 32);
        let base: i64 = __mind_alloc(32);
        tls13c_zero(base, 32);
        __mind_store_i8(base, 9);
        x25519(x_priv, base, x_pub);
        if (flags & 1) != 0 {
            x25519mlkem768_keygen(entropy_addr + 96, state + 2848, state + 416)
        }
    }
    let dns_len: i64 = tls13c_load_i64(state + 112);
    let dns_addr: i64 = tls13c_load_i64(state + 104);

    let ext: i64 = __mind_alloc(4096);
    let mut elen: i64 = 0;

    let mut send_sni: i64 = 1;
    if dns_len <= 0 {
        send_sni = 0;
    }
    if send_sni == 1 {
        if tls13c_is_ip_literal(dns_addr, dns_len) == 1 {
            send_sni = 0;
        }
    }
    if send_sni == 1 {
        let sni_body: i64 = 5 + dns_len;
        let sni_ext: i64 = 4 + sni_body;
        if elen + sni_ext > 4096 {
            return tls13c_fail(state, tls13ci_err_ovf());
        }
        tls13c_put_be16(ext + elen, 0);
        tls13c_put_be16(ext + elen + 2, sni_body);
        tls13c_put_be16(ext + elen + 4, 3 + dns_len);
        __mind_store_i8(ext + elen + 6, 0);
        tls13c_put_be16(ext + elen + 7, dns_len);
        tls13c_copy(ext + elen + 9, dns_addr, dns_len);
        elen = elen + sni_ext;
    }

    if elen + 7 > 4096 {
        return tls13c_fail(state, tls13ci_err_ovf());
    }
    tls13c_put_be16(ext + elen, 43);
    tls13c_put_be16(ext + elen + 2, 3);
    __mind_store_i8(ext + elen + 4, 2);
    tls13c_put_be16(ext + elen + 5, 772);
    elen = elen + 7;

    let mut gbytes: i64 = 2;
    if (flags & 1) != 0 {
        gbytes = 4;
    }
    if elen + 4 + 2 + gbytes > 4096 {
        return tls13c_fail(state, tls13ci_err_ovf());
    }
    tls13c_put_be16(ext + elen, 10);
    tls13c_put_be16(ext + elen + 2, 2 + gbytes);
    tls13c_put_be16(ext + elen + 4, gbytes);
    tls13c_put_be16(ext + elen + 6, tls13ci_group_x25519());
    if (flags & 1) != 0 {
        tls13c_put_be16(ext + elen + 8, tls13ci_group_x25519mlkem768())
    }
    elen = elen + 4 + 2 + gbytes;

    let alpn_addr_c: i64 = tls13c_load_i64(state + 216);
    let alpn_len_c: i64 = tls13c_load_i64(state + 224);
    if alpn_len_c > 0 {
        if elen + 4 + 2 + alpn_len_c > 4096 {
            return tls13c_fail(state, tls13ci_err_ovf());
        }
        tls13c_put_be16(ext + elen, 16);
        tls13c_put_be16(ext + elen + 2, 2 + alpn_len_c);
        tls13c_put_be16(ext + elen + 4, alpn_len_c);
        tls13c_copy(ext + elen + 6, alpn_addr_c, alpn_len_c);
        elen = elen + 4 + 2 + alpn_len_c;
    }

    if elen + 10 > 4096 {
        return tls13c_fail(state, tls13ci_err_ovf());
    }
    tls13c_put_be16(ext + elen, 13);
    tls13c_put_be16(ext + elen + 2, 6);
    tls13c_put_be16(ext + elen + 4, 4);
    tls13c_put_be16(ext + elen + 6, tls13ci_sig_rsa_pss_rsae_sha256());
    // Certificate signatures may use PKCS1; CertificateVerify must use PSS.
    tls13c_put_be16(ext + elen + 8, tls13ci_sig_rsa_pkcs1_sha256());
    elen = elen + 10;

    let selected: i64 = tls13ci_group(state);
    let mut offer_x: i64 = 1;
    let mut offer_h: i64 = flags & 1;
    if retry == 0 && (flags & 8) != 0 {
        offer_x = 0;
        offer_h = 0;
    }
    if retry == 1 && selected != 0 {
        offer_x = 0;
        offer_h = 0;
        if selected == tls13ci_group_x25519() {
            offer_x = 1;
        } else {
            offer_h = 1;
        }
    }
    let ks_body: i64 = 2 + 36 * offer_x + 1220 * offer_h;
    if elen + 4 + ks_body > 4096 {
        return tls13c_fail(state, tls13ci_err_ovf());
    }
    tls13c_put_be16(ext + elen, 51);
    tls13c_put_be16(ext + elen + 2, ks_body);
    tls13c_put_be16(ext + elen + 4, ks_body - 2);
    let mut koff: i64 = elen + 6;
    if offer_x == 1 {
        tls13c_put_be16(ext + koff, tls13ci_group_x25519());
        tls13c_put_be16(ext + koff + 2, 32);
        tls13c_copy(ext + koff + 4, x_pub, 32);
        koff = koff + 36;
    }
    if offer_h == 1 {
        tls13c_put_be16(ext + koff, tls13ci_group_x25519mlkem768());
        tls13c_put_be16(ext + koff + 2, 1216);
        tls13c_copy(ext + koff + 4, state + 2848, 1216)
    }
    elen = elen + 4 + ks_body;
    if retry == 1 {
        let cookie_len: i64 = tls13c_load_i64(state + 65280);
        if cookie_len > 0 {
            if elen + 6 + cookie_len > 4096 {
                return tls13c_fail(state, tls13ci_err_ovf());
            }
            tls13c_put_be16(ext + elen, 44);
            tls13c_put_be16(ext + elen + 2, cookie_len + 2);
            tls13c_put_be16(ext + elen + 4, cookie_len);
            tls13c_copy(ext + elen + 6, state + 65288, cookie_len);
            elen = elen + 6 + cookie_len;
        }
    }

    let body_len: i64 = 2 + 32 + 1 + 32 + 2 + 4 + 1 + 1 + 2 + elen;
    let total: i64 = 4 + body_len;
    if total > tls13ci_max_hs_msg() {
        return tls13c_fail(state, tls13ci_err_ovf());
    }
    __mind_store_i8(out_addr + 0, tls13ci_hs_client_hello());
    tls13c_put_be24(out_addr + 1, body_len);
    let mut p: i64 = 4;
    tls13c_put_be16(out_addr + p, 771);
    p = p + 2;
    tls13c_copy(out_addr + p, ch_rand, 32);
    p = p + 32;
    __mind_store_i8(out_addr + p, 32);
    p = p + 1;
    tls13c_copy(out_addr + p, ch_sid, 32);
    p = p + 32;
    tls13c_put_be16(out_addr + p, 4);
    p = p + 2;
    tls13c_put_be16(out_addr + p, tls13ci_suite_aes128gcm_sha256());
    p = p + 2;
    tls13c_put_be16(out_addr + p, tls13ci_suite_chacha20_poly1305_sha256());
    p = p + 2;
    __mind_store_i8(out_addr + p, 1);
    p = p + 1;
    __mind_store_i8(out_addr + p, 0);
    p = p + 1;
    tls13c_put_be16(out_addr + p, elen);
    p = p + 2;
    tls13c_copy(out_addr + p, ext, elen);

    tls13c_store_i64(state + 120, total);
    if retry == 0 {
        tls13c_store_i64(state + 0, tls13ci_st_ch_sent())
    }
    total
}

pub fn tls13ci_build_client_hello2(state: i64, entropy_addr: i64, entropy_len: i64, out_addr: i64) -> i64 {
    if tls13ci_status(state) != tls13ci_st_hrr() {
        return tls13ci_err_state();
    }
    tls13c_make_hello(state, entropy_addr, entropy_len, out_addr, 1)
}

pub fn tls13ci_seal_client_hello2(state: i64, ch_addr: i64, ch_len: i64) -> i64 {
    if tls13ci_status(state) != tls13ci_st_hrr() {
        return tls13ci_err_state();
    }
    if ch_len < 4 || ch_len > tls13ci_max_hs_msg() {
        return tls13ci_err_ovf();
    }
    let rec: i64 = __mind_alloc(5 + ch_len);
    __mind_store_i8(rec + 0, tls13ci_ct_handshake());
    __mind_store_i8(rec + 1, 3);
    __mind_store_i8(rec + 2, 3);
    tls13c_put_be16(rec + 3, ch_len);
    tls13c_copy(rec + 5, ch_addr, ch_len);
    let orc: i64 = tls13c_out_append(state, rec, 5 + ch_len);
    if orc != 0 {
        return tls13c_fail(state, orc);
    }
    let arc: i64 = tls13c_transcript_append(state, ch_addr, ch_len);
    if arc != 0 {
        return tls13c_fail(state, arc);
    }
    tls13c_store_i64(state + 120, ch_len);
    tls13c_set_status(state, tls13ci_st_wait_sh());
    0
}

pub fn tls13c_is_hrr(rand_addr: i64) -> i64 {
    let mut i: i64 = 0;
    let mut eq: i64 = 1;
    while i < 32 {
        let expect: i64 = 0;
        if i == 0 {
            expect = 207;
        }
        if i == 1 {
            expect = 33;
        }
        if i == 2 {
            expect = 173;
        }
        if i == 3 {
            expect = 116;
        }
        if i == 4 {
            expect = 229;
        }
        if i == 5 {
            expect = 154;
        }
        if i == 6 {
            expect = 97;
        }
        if i == 7 {
            expect = 17;
        }
        if i == 8 {
            expect = 190;
        }
        if i == 9 {
            expect = 29;
        }
        if i == 10 {
            expect = 140;
        }
        if i == 11 {
            expect = 2;
        }
        if i == 12 {
            expect = 30;
        }
        if i == 13 {
            expect = 101;
        }
        if i == 14 {
            expect = 184;
        }
        if i == 15 {
            expect = 145;
        }
        if i == 16 {
            expect = 194;
        }
        if i == 17 {
            expect = 162;
        }
        if i == 18 {
            expect = 17;
        }
        if i == 19 {
            expect = 22;
        }
        if i == 20 {
            expect = 122;
        }
        if i == 21 {
            expect = 187;
        }
        if i == 22 {
            expect = 140;
        }
        if i == 23 {
            expect = 94;
        }
        if i == 24 {
            expect = 7;
        }
        if i == 25 {
            expect = 158;
        }
        if i == 26 {
            expect = 9;
        }
        if i == 27 {
            expect = 226;
        }
        if i == 28 {
            expect = 200;
        }
        if i == 29 {
            expect = 168;
        }
        if i == 30 {
            expect = 51;
        }
        if i == 31 {
            expect = 156;
        }
        if (tls13c_u8(rand_addr + i) & 255) != (expect & 255) {
            eq = 0;
        }
        i = i + 1;
    }
    eq
}

pub fn tls13c_apply_hrr_transcript(state: i64, msg_addr: i64, msg_len: i64) -> i64 {
    tls13c_transcript_hash_into(state, state + 4544);
    __mind_store_i8(state + 5240, 254);
    __mind_store_i8(state + 5241, 0);
    __mind_store_i8(state + 5242, 0);
    __mind_store_i8(state + 5243, 32);
    tls13c_copy(state + 5244, state + 4544, 32);
    tls13c_store_i64(state + 208, 36);
    let arc: i64 = tls13c_transcript_append(state, msg_addr, msg_len);
    if arc != 0 {
        return arc;
    }
    tls13c_store_i64(state + 64, tls13c_load_i64(state + 64) | 2);
    0
}

pub fn tls13c_parse_server_hello(state: i64, msg_addr: i64, msg_len: i64) -> i64 {
    if msg_len < 4 {
        return tls13ci_err_hs();
    }
    if tls13c_u8(msg_addr + 0) != tls13ci_hs_server_hello() {
        return tls13ci_err_hs();
    }
    let blen: i64 = tls13c_be24(msg_addr + 1);
    if blen + 4 != msg_len {
        return tls13ci_err_hs();
    }
    if blen < 2 + 32 + 1 + 2 + 1 + 2 {
        return tls13ci_err_hs();
    }
    let body: i64 = msg_addr + 4;
    let mut p: i64 = 0;
    if tls13c_be16(body) != 771 {
        return tls13ci_err_hs();
    }
    p = p + 2;
    let rand_addr: i64 = body + p;
    let is_hrr: i64 = tls13c_is_hrr(rand_addr);
    let flags_now: i64 = tls13c_load_i64(state + 64);
    if is_hrr == 1 {
        if (flags_now & 2) != 0 {
            return tls13ci_err_hrr();
        }
    }
    p = p + 32;
    let sid_len: i64 = tls13c_u8(body + p);
    p = p + 1;
    if sid_len > 32 {
        return tls13ci_err_hs();
    }
    if p + sid_len + 3 > blen {
        return tls13ci_err_hs();
    }
    let mut i: i64 = 0;
    let mut same: i64 = 1;
    if sid_len != 32 {
        same = 0;
    }
    while i < sid_len {
        if i < 32 {
            if tls13c_u8(body + p + i) != tls13c_u8(state + 288 + i) {
                same = 0;
            }
        }
        i = i + 1;
    }
    if same == 0 {
        return tls13ci_err_hs();
    }
    p = p + sid_len;
    let suite: i64 = tls13c_be16(body + p);
    p = p + 2;
    if suite != tls13ci_suite_aes128gcm_sha256() {
        if suite != tls13ci_suite_chacha20_poly1305_sha256() {
            return tls13ci_err_cipher();
        }
    }
    if (flags_now & 2) != 0 {
        if is_hrr == 0 {
            if suite != tls13c_load_i64(state + 40) {
                return tls13ci_err_cipher();
            }
        }
    }
    let comp: i64 = tls13c_u8(body + p);
    p = p + 1;
    if comp != 0 {
        return tls13ci_err_hs();
    }
    if p + 2 > blen {
        return tls13ci_err_hs();
    }
    let ext_len: i64 = tls13c_be16(body + p);
    p = p + 2;
    if p + ext_len != blen {
        return tls13ci_err_hs();
    }

    let ext: i64 = body + p;
    let mut eoff: i64 = 0;
    let mut found_key: i64 = 0;
    let mut found_ver: i64 = 0;
    let mut found_cookie: i64 = 0;
    while eoff + 4 <= ext_len {
        let etype: i64 = tls13c_be16(ext + eoff);
        let elen: i64 = tls13c_be16(ext + eoff + 2);
        if eoff + 4 + elen > ext_len {
            return tls13ci_err_hs();
        }
        let ebody: i64 = ext + eoff + 4;
        if etype != 43 && etype != 44 && etype != 51 {
            return tls13ci_err_hs();
        }
        if etype == 43 {
            if found_ver != 0 {
                return tls13ci_err_hs();
            }
            if elen != 2 {
                return tls13ci_err_hs();
            }
            if tls13c_be16(ebody) != 772 {
                return tls13ci_err_hs();
            }
            found_ver = 1;
        }
        if etype == 44 {
            if found_cookie != 0 {
                return tls13ci_err_hs();
            }
            found_cookie = 1;
            if is_hrr == 0 {
                return tls13ci_err_hs();
            }
            if elen < 2 || elen > 258 {
                return tls13ci_err_hs();
            }
            let clen: i64 = tls13c_be16(ebody);
            if 2 + clen != elen {
                return tls13ci_err_hs();
            }
            if clen < 1 || clen > 254 {
                return tls13ci_err_hs();
            }
            tls13c_store_i64(state + 65280, clen);
            tls13c_copy(state + 65288, ebody + 2, clen)
        }
        if etype == 51 {
            if found_key != 0 {
                return tls13ci_err_hs();
            }
            if is_hrr == 1 {
                if elen != 2 {
                    return tls13ci_err_hs();
                }
                let grp: i64 = tls13c_be16(ebody);
                let mut offered: i64 = 0;
                if grp == tls13ci_group_x25519() {
                    offered = 1;
                }
                if grp == tls13ci_group_x25519mlkem768() {
                    if (flags_now & 1) != 0 {
                        offered = 1;
                    }
                }
                if (flags_now & 8) == 0 {
                    return tls13ci_err_hrr();
                }
                if offered == 0 {
                    return tls13ci_err_group();
                }
                tls13c_store_i64(state + 48, grp);
                found_key = 1;
            } else {
                if elen < 4 {
                    return tls13ci_err_hs();
                }
                let grp: i64 = tls13c_be16(ebody);
                if (flags_now & 2) != 0 && tls13ci_group(state) != 0 && grp != tls13ci_group(state) {
                    return tls13ci_err_group();
                }
                if (flags_now & 2) == 0 && (flags_now & 8) != 0 {
                    return tls13ci_err_group();
                }
                if grp == tls13ci_group_x25519mlkem768() && (flags_now & 1) == 0 {
                    return tls13ci_err_group();
                }
                let klen: i64 = tls13c_be16(ebody + 2);
                if 4 + klen != elen {
                    return tls13ci_err_hs();
                }
                if grp == tls13ci_group_x25519() {
                    if klen != 32 {
                        return tls13ci_err_group();
                    }
                    tls13c_store_i64(state + 48, grp);
                    tls13c_copy(state + 384, ebody + 4, 32);
                    found_key = 1;
                } else {
                    if grp == tls13ci_group_x25519mlkem768() {
                        if klen != 1120 {
                            return tls13ci_err_group();
                        }
                        tls13c_store_i64(state + 48, grp);
                        tls13c_copy(state + 2848, ebody + 4, 1120);
                        found_key = 1;
                    } else {
                        return tls13ci_err_group();
                    }
                }
            }
        }
        eoff = eoff + 4 + elen;
    }
    if eoff != ext_len {
        return tls13ci_err_hs();
    }
    if found_ver != 1 {
        return tls13ci_err_hs();
    }
    if is_hrr == 0 && found_key != 1 {
        return tls13ci_err_group();
    }
    tls13c_store_i64(state + 40, suite);
    tls13c_store_i64(state + 248, 772);
    if is_hrr == 1 {
        // A cookie cannot authorize adding shares to an initially empty list.
        if found_key == 0 && (flags_now & 8) != 0 {
            return tls13ci_err_hrr();
        }
        if found_key == 0 && found_cookie == 0 {
            return tls13ci_err_group();
        }
        let arc: i64 = tls13c_apply_hrr_transcript(state, msg_addr, msg_len);
        if arc != 0 {
            return arc;
        }
        tls13c_set_status(state, tls13ci_st_hrr());
        return 0;
    }
    0
}

pub fn tls13ci_seal_client_hello(state: i64, ch_addr: i64, ch_len: i64) -> i64 {
    if tls13ci_status(state) != tls13ci_st_ch_sent() {
        return tls13ci_err_state();
    }
    if ch_len < 4 || ch_len > tls13ci_max_hs_msg() {
        return tls13ci_err_ovf();
    }
    let rec: i64 = __mind_alloc(5 + ch_len);
    __mind_store_i8(rec + 0, tls13ci_ct_handshake());
    __mind_store_i8(rec + 1, 3);
    __mind_store_i8(rec + 2, 3);
    tls13c_put_be16(rec + 3, ch_len);
    tls13c_copy(rec + 5, ch_addr, ch_len);
    let orc: i64 = tls13c_out_append(state, rec, 5 + ch_len);
    if orc != 0 {
        return tls13c_fail(state, orc);
    }
    let arc: i64 = tls13c_transcript_append(state, ch_addr, ch_len);
    if arc != 0 {
        return tls13c_fail(state, arc);
    }
    tls13c_set_status(state, tls13ci_st_wait_sh());
    0
}

// Handshake and application traffic keys (RFC 8446 §7.1, §7.3). IV slots
// never overlap 32-byte keys.

pub fn tls13c_derive_key_n(secret_addr: i64, key_len: i64, out_addr: i64) -> i64 {
    let lbl: i64 = __mind_alloc(8);
    __mind_store_i8(lbl + 0, 107);
    __mind_store_i8(lbl + 1, 101);
    __mind_store_i8(lbl + 2, 121);
    tls13_hkdf_expand_label(secret_addr, 32, lbl, 3, secret_addr, 0, key_len, out_addr);
    0
}

pub fn tls13c_handshake_secret(dhe_addr: i64, dhe_len: i64, out_addr: i64) -> i64 {
    let early: i64 = __mind_alloc(32);
    let derived: i64 = __mind_alloc(32);
    let lbl: i64 = __mind_alloc(16);
    __mind_store_i8(lbl + 0, 100);
    __mind_store_i8(lbl + 1, 101);
    __mind_store_i8(lbl + 2, 114);
    __mind_store_i8(lbl + 3, 105);
    __mind_store_i8(lbl + 4, 118);
    __mind_store_i8(lbl + 5, 101);
    __mind_store_i8(lbl + 6, 100);
    tls13_early_secret(early);
    tls13_derive_secret(early, 32, lbl, 7, early, 0, derived);
    hkdf_extract(derived, 32, dhe_addr, dhe_len, out_addr);
    0
}

pub fn tls13c_derive_hs_keys(state: i64) -> i64 {
    let dhe_addr: i64 = __mind_alloc(64);
    let grp: i64 = tls13c_load_i64(state + 48);
    if grp == tls13ci_group_x25519() {
        let spub: i64 = __mind_alloc(32);
        tls13c_copy(spub, state + 384, 32);
        x25519(state + 320, spub, dhe_addr)
    } else {
        if grp == tls13ci_group_x25519mlkem768() {
            if x25519mlkem768_decaps(state + 416, state + 2848, dhe_addr) != 0 {
                return tls13ci_err_group();
            }
        } else {
            return tls13ci_err_group();
        }
    }
    let dhe_len: i64 = 32;
    if grp == tls13ci_group_x25519mlkem768() {
        dhe_len = 64;
    }
    let mut nonzero: i64 = 0;
    let mut di: i64 = dhe_len - 32;
    while di < dhe_len {
        nonzero = nonzero | tls13c_u8(dhe_addr + di);
        di = di + 1;
    }
    if nonzero == 0 {
        return tls13ci_err_group();
    }
    tls13c_transcript_hash_into(state, state + 5176);
    tls13c_handshake_secret(dhe_addr, dhe_len, state + 4064);
    tls13c_zero(dhe_addr, 64);
    tls13_client_handshake_traffic_secret(state + 4064, state + 5176, state + 4096);
    tls13_server_handshake_traffic_secret(state + 4064, state + 5176, state + 4128);
    let suite: i64 = tls13c_load_i64(state + 40);
    let klen: i64 = tls13c_suite_key_len(suite);
    tls13c_derive_key_n(state + 4096, klen, state + 4160);
    tls13_derive_iv(state + 4096, state + 81928);
    tls13c_derive_key_n(state + 4128, klen, state + 4192);
    tls13_derive_iv(state + 4128, state + 81940);
    0
}

pub fn tls13c_derive_app_keys(state: i64) -> i64 {
    tls13c_transcript_hash_into(state, state + 5208);
    tls13_master_secret(state + 4064, state + 4224);
    tls13_client_application_traffic_secret(state + 4224, state + 5208, state + 4256);
    tls13_server_application_traffic_secret(state + 4224, state + 5208, state + 4288);
    let suite: i64 = tls13c_load_i64(state + 40);
    let klen: i64 = tls13c_suite_key_len(suite);
    tls13c_derive_key_n(state + 4256, klen, state + 4320);
    tls13_derive_iv(state + 4256, state + 81952);
    tls13c_derive_key_n(state + 4288, klen, state + 4352);
    tls13_derive_iv(state + 4288, state + 81964);
    0
}

// Public ClientHello calls.

pub fn tls13c_build_client_hello(state: i64, entropy_addr: i64, entropy_len: i64, out_addr: i64) -> i64 {
    tls13ci_build_client_hello(state, entropy_addr, entropy_len, out_addr)
}

pub fn tls13c_build_client_hello2(state: i64, entropy_addr: i64, entropy_len: i64, out_addr: i64) -> i64 {
    tls13ci_build_client_hello2(state, entropy_addr, entropy_len, out_addr)
}

pub fn tls13c_seal_client_hello2(state: i64, ch_addr: i64, ch_len: i64) -> i64 {
    tls13ci_seal_client_hello2(state, ch_addr, ch_len)
}

pub fn tls13c_seal_client_hello(state: i64, ch_addr: i64, ch_len: i64) -> i64 {
    tls13ci_seal_client_hello(state, ch_addr, ch_len)
}
