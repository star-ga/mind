// std.posix_sys — the raw Linux x86-64 system calls of std.posix and
// std.fs_checked, one straight-line wrapper each.
//
// Copyright 2026 STARGA Inc.
// Licensed under the Apache License, Version 2.0.
// Part of the MIND project (Machine Intelligence Native Design).
//
// std.posix keeps its public names, signatures and link names; its bodies
// call these wrappers. The argument defaults (AT_FDCWD for open, the zero
// rusage of waitpid and waitid), the stat mode test of fdopendir, the dirent
// cursor of readdir, the sigaction record of signal and the empty path of
// fexecve live in std.posix. std.fs_checked opens, reads and closes its
// directory through the same wrappers. A function in this module makes one
// __mind_sys_* call with its arguments unchanged and returns its result: no
// branch, no loop and no call to another function. Every result is the
// kernel's: a value >= 0 on success, -errno on failure. Hosts without the
// raw syscall ABI return -ENOSYS.

// ---- Files and descriptors ----

pub fn posix_sys_openat(dirfd: i64, path: i64, flags: i64, mode: i64) -> i64 {
    __mind_sys_openat(dirfd, path, flags, mode)
}

pub fn posix_sys_close(fd: i64) -> i64 {
    __mind_sys_close(fd)
}

pub fn posix_sys_fstat(fd: i64, buf: i64) -> i64 {
    __mind_sys_fstat(fd, buf)
}

pub fn posix_sys_newfstatat(dirfd: i64, path: i64, buf: i64, flags: i64) -> i64 {
    __mind_sys_newfstatat(dirfd, path, buf, flags)
}

pub fn posix_sys_fsync(fd: i64) -> i64 {
    __mind_sys_fsync(fd)
}

pub fn posix_sys_flock(fd: i64, op: i64) -> i64 {
    __mind_sys_flock(fd, op)
}

pub fn posix_sys_fcntl(fd: i64, cmd: i64, arg: i64) -> i64 {
    __mind_sys_fcntl(fd, cmd, arg)
}

pub fn posix_sys_lseek(fd: i64, off: i64, whence: i64) -> i64 {
    __mind_sys_lseek(fd, off, whence)
}

pub fn posix_sys_unlinkat(dirfd: i64, path: i64, flags: i64) -> i64 {
    __mind_sys_unlinkat(dirfd, path, flags)
}

pub fn posix_sys_renameat(olddirfd: i64, old: i64, newdirfd: i64, new: i64) -> i64 {
    __mind_sys_renameat(olddirfd, old, newdirfd, new)
}

pub fn posix_sys_umask(mask: i64) -> i64 {
    __mind_sys_umask(mask)
}

pub fn posix_sys_getuid() -> i64 {
    __mind_sys_getuid()
}

pub fn posix_sys_getdents64(fd: i64, buf: i64, count: i64) -> i64 {
    __mind_sys_getdents64(fd, buf, count)
}

pub fn posix_sys_memfd_create(name: i64, flags: i64) -> i64 {
    __mind_sys_memfd_create(name, flags)
}

pub fn posix_sys_fchdir(fd: i64) -> i64 {
    __mind_sys_fchdir(fd)
}

