// Public constants, accessors and sans-IO calls of std.tls13_client: input
// (feed, tick, EOF), application data, close and the record helpers. The
// record pump and the handshake state machine are in std/tls13_client.mind.

import std.tls13_client_core;

pub fn tls13c_feed(state: i64, data_addr: i64, data_len: i64) -> i64 {
    if data_len < 0 {
        return tls13ci_err_inval();
    }
    if tls13ci_status(state) == tls13ci_st_error() {
        return tls13ci_error(state);
    }
    if tls13ci_status(state) == tls13ci_st_closed() {
        return tls13ci_err_closed();
    }
    let in_len: i64 = tls13c_load_i64(state + 160);
    if data_len > 16640 - in_len {
        return tls13c_fail(state, tls13ci_err_io());
    }
    tls13c_copy(state + 29816 + in_len, data_addr, data_len);
    tls13c_store_i64(state + 160, in_len + data_len);
    0
}

pub fn tls13c_tick(state: i64) -> i64 {
    let st: i64 = tls13ci_status(state);
    if st == tls13ci_st_error() {
        return tls13ci_error(state);
    }
    if st == tls13ci_st_closed() {
        return tls13ci_err_closed();
    }
    let budget: i64 = tls13c_load_i64(state + 24);
    if budget == 0 {
        return 0;
    }
    let used: i64 = tls13c_load_i64(state + 16) + 1;
    tls13c_store_i64(state + 16, used);
    if used > budget {
        return tls13c_fail(state, tls13ci_err_timeout());
    }
    0
}

pub fn tls13c_signal_eof(state: i64) -> i64 {
    let st: i64 = tls13ci_status(state);
    if st == tls13ci_st_closed() {
        return 0;
    }
    if st == tls13ci_st_error() {
        return tls13ci_error(state);
    }
    tls13c_fail(state, tls13ci_err_eof())
}

pub fn tls13c_write_app(state: i64, data_addr: i64, data_len: i64) -> i64 {
    if data_len < 0 {
        return tls13ci_err_inval();
    }
    let st: i64 = tls13ci_status(state);
    if st == tls13ci_st_error() {
        return tls13ci_error(state);
    }
    if st == tls13ci_st_closed() {
        return tls13ci_err_closed();
    }
    if st != tls13ci_st_connected() {
        return tls13ci_err_app();
    }
    if data_len > 16384 {
        return tls13ci_err_ovf();
    }
    let suite: i64 = tls13c_load_i64(state + 40);
    let seq: i64 = tls13c_load_i64(state + 136);
    let rec: i64 = __mind_alloc(tls13ci_max_record());
    let rlen: i64 = tls13ci_record_seal(suite, state + 4320, state + 81952, seq, data_addr, data_len, tls13ci_ct_app_data(), rec);
    if rlen < 0 {
        return tls13c_fail(state, rlen);
    }
    tls13c_store_i64(state + 136, seq + 1);
    let orc: i64 = tls13c_out_append(state, rec, rlen);
    if orc != 0 {
        return tls13c_fail(state, orc);
    }
    data_len
}

pub fn tls13c_read_app(state: i64, out_addr: i64, max_len: i64) -> i64 {
    let st: i64 = tls13ci_status(state);
    if st != tls13ci_st_connected() {
        return 0;
    }
    let avail: i64 = tls13c_load_i64(state + 192);
    let rd: i64 = tls13c_load_i64(state + 200);
    let mut n: i64 = avail - rd;
    if n > max_len {
        n = max_len;
    }
    if n <= 0 {
        return 0;
    }
    tls13c_copy(out_addr, state + 63096 + rd, n);
    tls13c_store_i64(state + 200, rd + n);
    if tls13c_load_i64(state + 200) >= tls13c_load_i64(state + 192) {
        tls13c_store_i64(state + 192, 0);
        tls13c_store_i64(state + 200, 0)
    }
    n
}

pub fn tls13c_close(state: i64) -> i64 {
    let st: i64 = tls13ci_status(state);
    if st == tls13ci_st_error() {
        tls13c_zero_keys(state);
        return tls13ci_error(state);
    }
    if st == tls13ci_st_closed() {
        tls13c_zero_keys(state);
        return 0;
    }
    if st == tls13ci_st_connected() {
        let alert: i64 = __mind_alloc(2);
        __mind_store_i8(alert + 0, 1);
        __mind_store_i8(alert + 1, 0);
        let suite: i64 = tls13c_load_i64(state + 40);
        let seq: i64 = tls13c_load_i64(state + 136);
        let rec: i64 = __mind_alloc(tls13ci_max_record());
        let rlen: i64 = tls13ci_record_seal(suite, state + 4320, state + 81952, seq, alert, 2, tls13ci_ct_alert(), rec);
        if rlen < 0 {
            return tls13c_fail(state, rlen);
        }
        if rlen > 0 {
            tls13c_store_i64(state + 136, seq + 1);
            let orc: i64 = tls13c_out_append(state, rec, rlen);
            if orc != 0 {
                return tls13c_fail(state, orc);
            }
        }
    }
    tls13c_zero_keys(state);
    tls13c_set_status(state, tls13ci_st_closed());
    0
}

