// Bytes tls13c_feed accepts now: the inbound buffer's free space. Feeding more
// latches E_IO, so a transport reads at most this much before the next pump.
pub fn tls13c_in_space(s: i64) -> i64 {
    16640 - tls13c_load_i64(s + 160)
}

// Decrypted application bytes not yet read with tls13c_read_app.
pub fn tls13c_app_pending(s: i64) -> i64 {
    tls13c_load_i64(s + 192) - tls13c_load_i64(s + 200)
}

// The leaf certificate's key, as presented in Certificate: 1 when its SPKI
// decoded as rsaEncryption, 0 otherwise (no Certificate yet, ECDSA or any
// other key type).
pub fn tls13c_leaf_key_kind(s: i64) -> i64 {
    tls13c_load_i64(s + 63096)
}

// The presented RSA modulus length in bytes (256 for RSA-2048), 0 when the
// leaf key is not RSA.
pub fn tls13c_leaf_rsa_len(s: i64) -> i64 {
    tls13c_load_i64(s + 63104)
}

