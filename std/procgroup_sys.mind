// Part of the MIND project (Machine Intelligence Native Design).
//
// std.procgroup is pure bookkeeping over the results of these primitives.
// Every pipe, fork, exec, wait, kill, read, close, poll, clock and environment
// call it makes is here, so the effects of a process group live in this one
// effect module. The primitives keep no state between calls.
//
// POSIX (pipe, fork, execvp, waitpid, kill, read, poll, getenv, setenv) and the
// monotonic clock (clock_gettime: id 1 is CLOCK_MONOTONIC on Linux, 6 on macOS).

extern "C" {
    unsafe fn fork() -> i32;
    unsafe fn execvp(file: *const u8, argv: *const *const u8) -> i32;
    unsafe fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    unsafe fn kill(pid: i32, sig: i32) -> i32;
    unsafe fn pipe(pipefd: *mut i32) -> i32;
    unsafe fn dup2(oldfd: i32, newfd: i32) -> i32;
    unsafe fn close(fd: i32) -> i32;
    unsafe fn open(pathname: *const u8, flags: i32, mode: i32) -> i32;
    unsafe fn read(fd: i32, buf: *mut u8, count: i64) -> i64;
    unsafe fn poll(fds: *mut u8, nfds: i64, timeout: i32) -> i32;
    unsafe fn clock_gettime(clockid: i32, tp: i64) -> i32;
    unsafe fn getenv(name: *const u8) -> *mut u8;
    unsafe fn setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;
    unsafe fn unsetenv(name: *const u8) -> i32;
    unsafe fn memcpy(dst: *mut u8, src: *const u8, n: i64) -> *mut u8;
    safe fn _exit(status: i32);
}

// ---- Internal helpers ----

// Heap copy of the C string at `addr`, NUL-terminated; 0 when the allocation
// fails.
fn pgs_copy_cstr(addr: i64) -> i64 {
    let mut len: i64 = 0;
    while __mind_load_i8(addr + len) != 0 {
        len = len + 1;
    }
    let dst: i64 = __mind_alloc(len + 1);
    if dst == 0 {
        return 0;
    }
    if len > 0 {
        let _ = memcpy(dst as *mut u8, addr as *const u8, len);
    }
    __mind_store_i8(dst + len, 0);
    dst
}

// Store four bytes at p + off.
fn pgs_put4(p: i64, off: i64, b0: i64, b1: i64, b2: i64, b3: i64) -> i64 {
    __mind_store_i8(p + off, b0);
    __mind_store_i8(p + off + 1, b1);
    __mind_store_i8(p + off + 2, b2);
    __mind_store_i8(p + off + 3, b3);
    0
}

// "/dev/null" as a heap C string.
fn pgs_dev_null() -> i64 {
    let p: i64 = __mind_alloc(12);
    let _ = pgs_put4(p, 0, 47, 100, 101, 118);
    let _ = pgs_put4(p, 4, 47, 110, 117, 108);
    let _ = pgs_put4(p, 8, 108, 0, 0, 0);
    p
}

// The forked child: close the inherited descriptors listed at `shut`, wire
// the pipe and /dev/null, exec. Only async-signal-safe calls run here. The
// listed descriptors close first and `rd` before the dup2 calls, so a low
// descriptor (0 or 1 when the parent had closed them) is never clobbered
// afterwards.
fn pgs_child_exec(shut: i64, nshut: i64, rd: i64, wr: i64, devnull: i64, prog: i64, argv: i64) -> i64 {
    let mut j: i64 = 0;
    while j < nshut {
        let fd: i64 = __mind_load_i64(shut + j * 8);
        if fd >= 0 {
            let _ = close(fd as i32);
        }
        j = j + 1;
    }
    let _ = close(rd as i32);
    if wr != 1 {
        let _ = dup2(wr as i32, 1);
        let _ = close(wr as i32);
    }
    if devnull > 0 {
        let _ = dup2(devnull as i32, 0);
        let _ = close(devnull as i32);
    }
    let _ = execvp(prog as *const u8, argv as *const *const u8);
    _exit(127);
    0
}

// Monotonic milliseconds, or -1 when no monotonic clock answers.
fn pgs_clock_ms() -> i64 {
    let ts: i64 = __mind_alloc(16);
    __mind_store_i64(ts + 0, 0);
    __mind_store_i64(ts + 8, 0);
    let mut r: i64 = clock_gettime(1, ts) as i64;
    if r != 0 {
        r = clock_gettime(6, ts) as i64;
    }
    let ms: i64 = __mind_load_i64(ts + 0) * 1000 + __mind_load_i64(ts + 8) / 1000000;
    let _ = __mind_free(ts);
    if r != 0 {
        return 0 - 1;
    }
    ms
}

// ---- Processes: spawn, wait, kill ----

// procgroup_sys_spawn_piped — fork a child that runs `prog` (C string, found
// through PATH) with the NULL-terminated argv array at `argv`. The child's
// stdout is a new pipe, its stdin /dev/null, its stderr inherited; before the
// exec it closes the `nshut` descriptors packed as i64 at `shut` (negative
// entries are skipped). A child that cannot exec exits with code 127.
// Returns the child's pid and stores the pipe's read end (i64) at `rd_out`.
// Returns -1, storing nothing and leaving no descriptor open, when the pipe
// or the fork fails.
pub fn procgroup_sys_spawn_piped(prog: i64, argv: i64, shut: i64, nshut: i64, rd_out: i64) -> i64 {
    let ends: i64 = __mind_alloc(8);
    let piped: i64 = pipe(ends as *mut i32) as i64;
    if piped != 0 {
        let _ = __mind_free(ends);
        return 0 - 1;
    }
    let rd: i64 = __mind_load_i32(ends + 0);
    let wr: i64 = __mind_load_i32(ends + 4);
    let _ = __mind_free(ends);
    let null_path: i64 = pgs_dev_null();
    let devnull: i64 = open(null_path as *const u8, 0, 0) as i64;
    let _ = __mind_free(null_path);
    let pid: i64 = fork() as i64;
    if pid == 0 {
        let _ = pgs_child_exec(shut, nshut, rd, wr, devnull, prog, argv);
    }
    let _ = close(wr as i32);
    if devnull >= 0 {
        let _ = close(devnull as i32);
    }
    if pid < 0 {
        let _ = close(rd as i32);
        return 0 - 1;
    }
    __mind_store_i64(rd_out, rd);
    pid
}

// procgroup_sys_wait — one waitpid(2) on `pid`: without blocking when `nohang`
// is 1 (WNOHANG), blocking when it is 0. Returns `pid` once the child is
// reaped, with its status word stored as an i32 at `status`; 0 while it still
// runs (nohang only); -1 when waitpid refuses the pid.
pub fn procgroup_sys_wait(pid: i64, status: i64, nohang: i64) -> i64 {
    __mind_store_i32(status, 0);
    waitpid(pid as i32, status as *mut i32, nohang as i32) as i64
}

// procgroup_sys_kill — send SIGKILL to `pid`. Returns 0, or -1 when kill(2)
// fails.
pub fn procgroup_sys_kill(pid: i64) -> i64 {
    kill(pid as i32, 9) as i64
}

// ---- Pipes: read, close, poll ----

// procgroup_sys_read — one read(2) of at most `cap` bytes from `fd` into
// `buf`: the bytes the pipe holds now (it waits only while it holds none).
// Returns the byte count, 0 at end of file, -1 on an error.
pub fn procgroup_sys_read(fd: i64, buf: i64, cap: i64) -> i64 {
    read(fd as i32, buf as *mut u8, cap)
}

// procgroup_sys_close — close(2) `fd`. Returns 0, or -1 on an error.
pub fn procgroup_sys_close(fd: i64) -> i64 {
    close(fd as i32) as i64
}

// Bytes per struct pollfd entry: fd (i32), events (i16), revents (i16).
pub fn procgroup_sys_pollfd_size() -> i64 {
    8
}

// procgroup_sys_pollfd_set — make entry `j` of the pollfd array at `pfds`
// wait for input on `fd`. Returns 0.
pub fn procgroup_sys_pollfd_set(pfds: i64, j: i64, fd: i64) -> i64 {
    let e: i64 = pfds + j * procgroup_sys_pollfd_size();
    __mind_store_i32(e, fd);
    __mind_store_i16(e + 4, 1);
    __mind_store_i16(e + 6, 0);
    0
}

// procgroup_sys_pollfd_ready — 1 when the last poll marked entry `j` (input,
// end of file or an error is waiting), else 0.
pub fn procgroup_sys_pollfd_ready(pfds: i64, j: i64) -> i64 {
    if __mind_load_i16(pfds + j * procgroup_sys_pollfd_size() + 6) != 0 {
        return 1;
    }
    0
}

// procgroup_sys_poll — poll(2) the `k` entries at `pfds`, waiting at most
// `wait_ms` milliseconds (0: do not wait; with k 0 it only sleeps). Returns
// the number of ready entries, 0 when none became ready, -1 on an error.
pub fn procgroup_sys_poll(pfds: i64, k: i64, wait_ms: i64) -> i64 {
    poll(pfds as *mut u8, k, wait_ms as i32) as i64
}

// ---- Clock: deadlines ----

// procgroup_sys_deadline — the deadline `timeout_ms` milliseconds after now on
// the monotonic clock, for procgroup_sys_poll_until. When no monotonic clock
// answers, a deadline that has already passed (0).
pub fn procgroup_sys_deadline(timeout_ms: i64) -> i64 {
    let now: i64 = pgs_clock_ms();
    if now < 0 {
        return 0;
    }
    now + timeout_ms
}

// What procgroup_sys_poll_until returns once its deadline has passed.
pub fn procgroup_sys_expired() -> i64 {
    0 - 2
}

// procgroup_sys_poll_until — procgroup_sys_poll for at most `cap_ms`, never
// past `deadline` (from procgroup_sys_deadline; negative: no deadline). Reads
// the clock itself: once the deadline has passed it returns
// procgroup_sys_expired() without polling, and a clock that stops answering
// counts as the deadline passing. Otherwise returns what procgroup_sys_poll
// returns.
pub fn procgroup_sys_poll_until(pfds: i64, k: i64, deadline: i64, cap_ms: i64) -> i64 {
    let mut wait_ms: i64 = cap_ms;
    if deadline >= 0 {
        let now: i64 = pgs_clock_ms();
        let mut left: i64 = 0;
        if now >= 0 {
            left = deadline - now;
        }
        if left <= 0 {
            return procgroup_sys_expired();
        }
        if left < wait_ms {
            wait_ms = left;
        }
    }
    procgroup_sys_poll(pfds, k, wait_ms)
}

// ---- Environment ----

// procgroup_sys_env_read — getenv(3) of the C string `name`: the address of its
// value (a C string the environment owns), or 0 when it is unset.
pub fn procgroup_sys_env_read(name: i64) -> i64 {
    getenv(name as *const u8) as i64
}

// procgroup_sys_env_push — set `name` to `value` (C strings; both are copied)
// for the children forked next. Returns a heap copy of the previous value, or
// 0 when it was unset, to hand to procgroup_sys_env_pop.
pub fn procgroup_sys_env_push(name: i64, value: i64) -> i64 {
    let old: i64 = getenv(name as *const u8) as i64;
    let mut saved: i64 = 0;
    if old != 0 {
        saved = pgs_copy_cstr(old);
    }
    let _ = setenv(name as *const u8, value as *const u8, 1);
    saved
}

// procgroup_sys_env_pop — put back what procgroup_sys_env_push replaced: set
// `name` to `saved` and free it, or unset `name` when `saved` is 0. Returns 0.
pub fn procgroup_sys_env_pop(name: i64, saved: i64) -> i64 {
    if saved != 0 {
        let _ = setenv(name as *const u8, saved as *const u8, 1);
        let _ = __mind_free(saved);
    } else {
        let _ = unsetenv(name as *const u8);
    }
    0
}
