// std.procgroup_sys — the OS calls of std.procgroup, one straight-line wrapper each.
//
// Copyright 2026 STARGA Inc.
// Licensed under the Apache License, Version 2.0.
// Part of the MIND project (Machine Intelligence Native Design).
//
// std.procgroup is pure bookkeeping over the results of these primitives.
// Every pipe, fork, exec, wait, kill, read, close, poll, clock and environment
// call it makes is here. A function in this module is straight-line: one OS
// call (and, for wait, the word it stores), with no branch, no loop and no
// call to another function of this module. The child descriptor walk, the
// pollfd records, the deadline arithmetic, the clock fallback and the
// environment save and restore live in std.procgroup, which calls these
// wrappers. The primitives keep no state between calls.
//
// POSIX (pipe, fork, execvp, waitpid, kill, read, poll, getenv, setenv,
// unsetenv) and the clock (clock_gettime).

extern "C" {
    unsafe fn fork() -> i32;
    unsafe fn execvp(file: *const u8, argv: *const *const u8) -> i32;
    unsafe fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32;
    unsafe fn kill(pid: i32, sig: i32) -> i32;
    unsafe fn pipe(pipefd: *mut i32) -> i32;
    unsafe fn dup2(oldfd: i32, newfd: i32) -> i32;
    unsafe fn close(fd: i32) -> i32;
    unsafe fn open(pathname: *const u8, flags: i32, mode: i32) -> i32;
    unsafe fn read(fd: i32, buf: *mut u8, count: i64) -> i64;
    unsafe fn poll(fds: *mut u8, nfds: i64, timeout: i32) -> i32;
    unsafe fn clock_gettime(clockid: i32, tp: i64) -> i32;
    unsafe fn getenv(name: *const u8) -> *mut u8;
    unsafe fn setenv(name: *const u8, value: *const u8, overwrite: i32) -> i32;
    unsafe fn unsetenv(name: *const u8) -> i32;
    safe fn _exit(status: i32);
}

// ---- Processes: pipe, open, fork, dup, exec, wait, kill ----

// procgroup_sys_pipe — pipe(2) into two i32 file descriptors at `ends`
// (8 bytes). Returns 0, or -1 when pipe(2) fails.
pub fn procgroup_sys_pipe(ends: i64) -> i64 {
    pipe(ends as *mut i32) as i64
}

// procgroup_sys_open — open(2) of the C string `path`. Returns the descriptor,
// or -1 when open(2) fails.
pub fn procgroup_sys_open(path: i64, flags: i64, mode: i64) -> i64 {
    open(path as *const u8, flags as i32, mode as i32) as i64
}

// procgroup_sys_fork — fork(2). Returns 0 in the child, the child pid in the
// parent, or -1 when fork(2) fails.
pub fn procgroup_sys_fork() -> i64 {
    fork() as i64
}

// procgroup_sys_dup2 — dup2(2). Returns the new descriptor, or -1 on an error.
pub fn procgroup_sys_dup2(oldfd: i64, newfd: i64) -> i64 {
    dup2(oldfd as i32, newfd as i32) as i64
}

// procgroup_sys_execvp — execvp(2) of `prog` (C string, found through PATH)
// with the NULL-terminated argv array at `argv`. Returns only when exec fails.
pub fn procgroup_sys_execvp(prog: i64, argv: i64) -> i64 {
    execvp(prog as *const u8, argv as *const *const u8) as i64
}

// procgroup_sys_exit — _exit(2) with `status`. Does not return.
pub fn procgroup_sys_exit(status: i64) -> i64 {
    _exit(status as i32);
    0
}

// procgroup_sys_wait — one waitpid(2) on `pid`: without blocking when `nohang`
// is 1 (WNOHANG), blocking when it is 0. Returns `pid` once the child is
// reaped, with its status word stored as an i32 at `status`; 0 while it still
// runs (nohang only); -1 when waitpid refuses the pid.
pub fn procgroup_sys_wait(pid: i64, status: i64, nohang: i64) -> i64 {
    __mind_store_i32(status, 0);
    waitpid(pid as i32, status as *mut i32, nohang as i32) as i64
}

// procgroup_sys_kill — send SIGKILL to `pid`. Returns 0, or -1 when kill(2)
// fails.
pub fn procgroup_sys_kill(pid: i64) -> i64 {
    kill(pid as i32, 9) as i64
}

// ---- Pipes: read, close, poll ----

// procgroup_sys_read — one read(2) of at most `cap` bytes from `fd` into
// `buf`: the bytes the pipe holds now (it waits only while it holds none).
// Returns the byte count, 0 at end of file, -1 on an error.
pub fn procgroup_sys_read(fd: i64, buf: i64, cap: i64) -> i64 {
    read(fd as i32, buf as *mut u8, cap)
}

// procgroup_sys_close — close(2) `fd`. Returns 0, or -1 on an error.
pub fn procgroup_sys_close(fd: i64) -> i64 {
    close(fd as i32) as i64
}

// procgroup_sys_poll — poll(2) the `k` entries at `pfds`, waiting at most
// `wait_ms` milliseconds (0: do not wait; with k 0 it only sleeps). Returns
// the number of ready entries, 0 when none became ready, -1 on an error.
// The caller fills the pollfd records; this function does not.
pub fn procgroup_sys_poll(pfds: i64, k: i64, wait_ms: i64) -> i64 {
    poll(pfds as *mut u8, k, wait_ms as i32) as i64
}

// ---- Clock ----

// procgroup_sys_clock — clock_gettime(2) of clock `clockid` into the 16-byte
// timespec at `ts` (seconds at +0, nanoseconds at +8). Returns 0, or -1 when
// the clock does not answer. The caller picks the clock id (1 is
// CLOCK_MONOTONIC on Linux, 6 on macOS) and turns the timespec into a deadline.
pub fn procgroup_sys_clock(clockid: i64, ts: i64) -> i64 {
    clock_gettime(clockid as i32, ts) as i64
}

// ---- Environment ----

// procgroup_sys_env_read — getenv(3) of the C string `name`: the address of its
// value (a C string the environment owns), or 0 when it is unset.
pub fn procgroup_sys_env_read(name: i64) -> i64 {
    getenv(name as *const u8) as i64
}

// procgroup_sys_env_set — setenv(3) of `name` to `value` (C strings; both are
// copied), replacing any value. Returns 0, or -1 when setenv fails.
pub fn procgroup_sys_env_set(name: i64, value: i64) -> i64 {
    setenv(name as *const u8, value as *const u8, 1) as i64
}

// procgroup_sys_env_unset — unsetenv(3) of the C string `name`. Returns 0, or
// -1 on an error.
pub fn procgroup_sys_env_unset(name: i64) -> i64 {
    unsetenv(name as *const u8) as i64
}
