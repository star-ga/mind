// std/mic_record.mind — write and read program results as mic@3 MAP records.
//
// A MIND program stores what it measured in the project's own artifact format
// through this module. JSON stays at external API boundaries only.
//
// A record IS a mic@3 artifact: the canonical body of the EMPTY IR module,
// then the MAP epilogue the compiler already defines in
// src/ir/compact/v3/evidence.rs. Nothing in the wire format is new, and the
// compiler's own readers accept a record: `parse_mic3_envelope` decodes it and
// `mic3_canonical_check` finds it canonical.
//
//   4D 49 43 33             magic "MIC3"
//   02                      mic@3 version (the base layout)
//   00 00 00 00 00 00 00    empty module: strings, next_id, exports, instrs,
//                           struct_defs, const_array_defs, repr_c_structs
//   4D                      MAP sentinel ('M')
//   uleb                    entry count
//   per entry, keys in strictly ascending byte order:
//     uleb key_len, key bytes (UTF-8)
//     tag 00 String: uleb len, UTF-8 bytes
//     tag 01 Int:    uleb zigzag(i64)
//     tag 02 Bytes:  uleb len, raw bytes
//
// Every uleb is the minimal ULEB128 encoding. Keys follow the compiler's
// application-key rule (validate_app_entries): not empty, contain a '.', and
// never start with the reserved `evidence_chain.` or `signature.` namespaces.
// Limits: 4096 entries, 256-byte keys, 10 MiB per record (the mic@3 reader's
// input cap).
//
// Determinism: the writer keeps the entries sorted by key bytes, so the bytes
// are a pure function of the key/value set. Insertion order never reaches the
// output, and two runs or two machines write identical records. Integer
// arithmetic only: no clock, no float, no host state.
//
// Errors are negative i64 codes, each with a named function (mrec_e_*). The
// reader checks every count and length against the fixed limits and against
// the bytes that remain BEFORE it allocates, so a hostile length cannot become
// an allocation bomb. It accepts exactly the canonical form the writer emits.
//
// std.mic_results builds the results schema (score, scorecard id, weights
// SHA-256, per-game and per-level actions) on this codec.
//
// Store and load through std.fs:
//   let b: i64 = mic_record.mrec_encode(h);
//   fs.write_string(path, mic_record.mrec_buf_addr(b), mic_record.mrec_buf_len(b));
//   let s: i64 = fs.read_to_string(path);
//   let r: i64 = mic_record.mrec_decode(__mind_load_i64(s + 0), __mind_load_i64(s + 8));
//   // r > 0 is a record handle; r < 0 is a named error.
//   let _ = mic_record.mrec_free(r);   // release the record and its entries
//
// Layouts:
//   record handle (32 bytes): [ table | count | cap | payload ]
//     table   address of `cap` entry pointers, sorted by key bytes
//     payload encoded bytes of every entry, so a put can refuse a record that
//             would pass the size limit
//   entry (48 bytes): [ key_addr | key_len | tag | int | val_addr | val_len ]
//   byte buffer (24 bytes): [ addr | len | cap ], the String record layout
//   reader cursor (32 bytes): [ addr | len | pos | value ]
//
// The codec is three modules: std/mic_record_wire.mind (limits, tags, named
// errors, bytes, ULEB128, the header reader), std/mic_record_table.mind (key
// rules and the sorted entry table) and this one (record handle, encode,
// decode, lookup). `import std.mic_record;` brings in all three.

import std.mic_record_wire;
import std.mic_record_table;

// ---------------------------------------------------------------------------
// Record handle.
// ---------------------------------------------------------------------------

// A new, empty record. Returns the handle, or 0 when allocation fails.
pub fn mrec_new() -> i64 {
    let h: i64 = __mind_alloc(32);
    if h == 0 {
        return 0;
    }
    let t: i64 = __mind_alloc(64);
    if t == 0 {
        // deferred: would free h here, stubbed because no allocation-failure hook of __mind_alloc exists in the runtime or the test harness - upgrade path: free
        // h and test it once a fault-injection hook can fail this allocation.
        return 0;
    }
    __mind_store_i64(h + 0, t);
    __mind_store_i64(h + 8, 0);
    __mind_store_i64(h + 16, 8);
    __mind_store_i64(h + 24, 0);
    h
}

// Number of entries, or mrec_e_handle() for a 0 handle.
pub fn mrec_count(h: i64) -> i64 {
    if h == 0 {
        return mrec_e_handle();
    }
    __mind_load_i64(h + 8)
}

// Store an Int under the key. Returns 0 or a named error.
pub fn mrec_put_int(h: i64, ka: i64, kn: i64, v: i64) -> i64 {
    mrec_put(h, ka, kn, 1, v, 0, 0)
}

// Store a UTF-8 String under the key. Returns 0 or a named error.
pub fn mrec_put_str(h: i64, ka: i64, kn: i64, va: i64, vn: i64) -> i64 {
    mrec_put(h, ka, kn, 0, 0, va, vn)
}

// Store raw Bytes under the key. Returns 0 or a named error.
pub fn mrec_put_bytes(h: i64, ka: i64, kn: i64, va: i64, vn: i64) -> i64 {
    mrec_put(h, ka, kn, 2, 0, va, vn)
}

// Remove the entry with the key. Returns 0 or a named error.
pub fn mrec_remove(h: i64, ka: i64, kn: i64) -> i64 {
    let i: i64 = mrec_find(h, ka, kn);
    if i < 0 {
        return i;
    }
    let e: i64 = mrec_ent(h, i);
    let n: i64 = __mind_load_i64(h + 8);
    let t: i64 = __mind_load_i64(h + 0);
    let mut j: i64 = i;
    while j < n - 1 {
        __mind_store_i64(t + j * 8, __mind_load_i64(t + (j + 1) * 8));
        j = j + 1;
    }
    __mind_store_i64(h + 8, n - 1);
    let size: i64 = mrec_ent_size(e);
    __mind_store_i64(h + 24, __mind_load_i64(h + 24) - size);
    let _ = mrec_ent_free(e);
    0
}

// Free the record h: every entry, its key and value copies, the table and
// the handle. h must not be used again. Returns 0, or mrec_e_handle() for a
// 0 handle.
pub fn mrec_free(h: i64) -> i64 {
    if h == 0 {
        return mrec_e_handle();
    }
    let n: i64 = __mind_load_i64(h + 8);
    let mut i: i64 = 0;
    while i < n {
        let _ = mrec_ent_free(mrec_ent(h, i));
        i = i + 1;
    }
    __mind_free(__mind_load_i64(h + 0));
    __mind_free(h);
    0
}

// ---------------------------------------------------------------------------
// Encode.
// ---------------------------------------------------------------------------

// The record as mic@3 bytes, in a byte buffer [ addr | len | cap ]. Returns 0
// for a 0 handle or when allocation fails.
pub fn mrec_encode(h: i64) -> i64 {
    if h == 0 {
        return 0;
    }
    let n: i64 = __mind_load_i64(h + 8);
    let total: i64 = mrec_total(n, __mind_load_i64(h + 24));
    // deferred: a failed allocation of d or b does not free the other,
    // stubbed because no allocation-failure hook of __mind_alloc exists in the runtime or the test harness - upgrade path: free both and test it once a
    // fault-injection hook can fail one of them.
    let d: i64 = __mind_alloc(total);
    let b: i64 = __mind_alloc(24);
    if d == 0 {
        return 0;
    }
    if b == 0 {
        return 0;
    }
    let mut p: i64 = mrec_w4(d, 0, 77, 73, 67, 51);
    p = mrec_w1(d, p, 2);
    while p < mrec_body_len() {
        p = mrec_w1(d, p, 0);
    }
    p = mrec_w1(d, p, mrec_sentinel());
    p = mrec_uleb_put(d, p, n);
    let mut i: i64 = 0;
    while i < n {
        let e: i64 = mrec_ent(h, i);
        let kn: i64 = __mind_load_i64(e + 8);
        let tag: i64 = __mind_load_i64(e + 16);
        p = mrec_uleb_put(d, p, kn);
        let _ = mrec_copy(__mind_load_i64(e + 0), d + p, kn);
        p = mrec_w1(d, p + kn, tag);
        if tag == 1 {
            p = mrec_uleb_put(d, p, mrec_zigzag(__mind_load_i64(e + 24)));
        } else {
            let vn: i64 = __mind_load_i64(e + 40);
            p = mrec_uleb_put(d, p, vn);
            let _ = mrec_copy(__mind_load_i64(e + 32), d + p, vn);
            p = p + vn;
        }
        i = i + 1;
    }
    __mind_store_i64(b + 0, d);
    __mind_store_i64(b + 8, total);
    __mind_store_i64(b + 16, total);
    b
}

pub fn mrec_buf_addr(b: i64) -> i64 {
    __mind_load_i64(b + 0)
}

pub fn mrec_buf_len(b: i64) -> i64 {
    __mind_load_i64(b + 8)
}

// ---------------------------------------------------------------------------
// Decode.
// ---------------------------------------------------------------------------

// Read one entry into h through the writer's own checks (key rules, UTF-8,
// duplicates, limits), so reader and writer accept the same records.
#[protection]
fn mrec_rd_entry(rd: i64, h: i64) -> i64 {
    let a: i64 = __mind_load_i64(rd + 0);
    let kl: i64 = mrec_rd_len(rd, mrec_max_key_bytes());
    if kl != 0 {
        return kl;
    }
    let kn: i64 = __mind_load_i64(rd + 24);
    let ka: i64 = a + __mind_load_i64(rd + 16);
    let tp: i64 = __mind_load_i64(rd + 16) + kn;
    if tp >= __mind_load_i64(rd + 8) {
        return mrec_e_truncated();
    }
    let tag: i64 = mrec_b(a, tp);
    __mind_store_i64(rd + 16, tp + 1);
    let mut rc: i64 = 0;
    if tag == 1 {
        let ic: i64 = mrec_rd_uleb(rd);
        if ic != 0 {
            return ic;
        }
        rc = mrec_put(h, ka, kn, 1, mrec_unzigzag(__mind_load_i64(rd + 24)), 0, 0);
    } else {
        if tag > 2 {
            return mrec_e_tag();
        }
        let vl: i64 = mrec_rd_len(rd, mrec_max_record_bytes());
        if vl != 0 {
            return vl;
        }
        let vn: i64 = __mind_load_i64(rd + 24);
        let va: i64 = a + __mind_load_i64(rd + 16);
        __mind_store_i64(rd + 16, __mind_load_i64(rd + 16) + vn);
        rc = mrec_put(h, ka, kn, tag, 0, va, vn);
    }
    if rc != 0 {
        return rc;
    }
    // The table stays sorted, so a key that sorts before an earlier key does
    // not land at the end: the input is out of order.
    if mrec_find(h, ka, kn) != __mind_load_i64(h + 8) - 1 {
        return mrec_e_order();
    }
    0
}

// Decode the n bytes at a. Returns a record handle (> 0), or a named error
// (< 0). Only the canonical form mrec_encode writes is accepted.
#[protection]
pub fn mrec_decode(a: i64, n: i64) -> i64 {
    if n < 0 {
        return mrec_e_value();
    }
    if n > mrec_max_record_bytes() {
        return mrec_e_oversized();
    }
    let hc: i64 = mrec_check_head(a, n);
    if hc != 0 {
        return hc;
    }
    let rd: i64 = __mind_alloc(32);
    if rd == 0 {
        return mrec_e_no_memory();
    }
    __mind_store_i64(rd + 0, a);
    __mind_store_i64(rd + 8, n);
    __mind_store_i64(rd + 16, mrec_body_len() + 1);
    __mind_store_i64(rd + 24, 0);
    let r: i64 = mrec_decode_at(rd, n);
    __mind_free(rd);
    r
}

// Read the entry count and the entries at the reader cursor rd (n input
// bytes) into a new record. Returns the handle, or a named error once the
// partly built record is freed. mrec_decode owns and frees rd.
#[protection]
fn mrec_decode_at(rd: i64, n: i64) -> i64 {
    let cc: i64 = mrec_rd_uleb(rd);
    if cc != 0 {
        return cc;
    }
    // Refuse an impossible entry count before the handle or any entry is
    // allocated: bit 63 reads as negative, a count over the entry limit is
    // oversized, and a count the remaining bytes cannot hold (each entry is at
    // least mrec_min_entry_bytes()) is truncated.
    let count: i64 = __mind_load_i64(rd + 24);
    if count < 0 {
        return mrec_e_oversized();
    }
    if count > mrec_max_entries() {
        return mrec_e_oversized();
    }
    if count > (__mind_load_i64(rd + 8) - __mind_load_i64(rd + 16)) / mrec_min_entry_bytes() {
        return mrec_e_truncated();
    }
    let h: i64 = mrec_new();
    if h == 0 {
        return mrec_e_no_memory();
    }
    let mut i: i64 = 0;
    while i < count {
        let ec: i64 = mrec_rd_entry(rd, h);
        if ec != 0 {
            let _ = mrec_free(h);
            return ec;
        }
        i = i + 1;
    }
    if __mind_load_i64(rd + 16) != n {
        let _ = mrec_free(h);
        return mrec_e_trailing();
    }
    h
}

// ---------------------------------------------------------------------------
// Lookup.
// ---------------------------------------------------------------------------

// Index of the entry with the key, or mrec_e_not_found().
pub fn mrec_find(h: i64, ka: i64, kn: i64) -> i64 {
    if h == 0 {
        return mrec_e_handle();
    }
    if kn < 0 {
        return mrec_e_value();
    }
    let pos: i64 = mrec_lower_bound(h, ka, kn);
    if pos < __mind_load_i64(h + 8) {
        if mrec_ent_cmp(mrec_ent(h, pos), ka, kn) == 0 {
            return pos;
        }
    }
    mrec_e_not_found()
}

// Write the Int under the key to out (8 bytes). Returns 0 or a named error.
pub fn mrec_get_int(h: i64, ka: i64, kn: i64, out: i64) -> i64 {
    let i: i64 = mrec_find(h, ka, kn);
    if i < 0 {
        return i;
    }
    if mrec_tag_at(h, i) != 1 {
        return mrec_e_type();
    }
    __mind_store_i64(out, mrec_field(h, i, 24));
    0
}

// Write the address and length of the String (tag 0) or Bytes (tag 2) value
// under the key to out and out + 8. Returns 0 or a named error.
pub fn mrec_get_val(h: i64, ka: i64, kn: i64, tag: i64, out: i64) -> i64 {
    let i: i64 = mrec_find(h, ka, kn);
    if i < 0 {
        return i;
    }
    if mrec_tag_at(h, i) != tag {
        return mrec_e_type();
    }
    __mind_store_i64(out + 0, mrec_field(h, i, 32));
    __mind_store_i64(out + 8, mrec_field(h, i, 40));
    0
}
