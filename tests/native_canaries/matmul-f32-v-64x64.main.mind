// Native canary probe of fixture matmul-f32-v-64x64: 4x4 zero buffers, enough to read the
// refusal key. A driver that prints the reference output replaces it before the row is gated.
fn main() -> i64 {
    let a: i64 = __mind_alloc(4096);
    let b: i64 = __mind_alloc(4096);
    let c: i64 = __mind_alloc(4096);
    xsi_out_i64(mmf32(a, b, c, 4, 4));
    0
}
