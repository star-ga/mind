// Author: STARGA Inc. Test-only allocation observer; never a product allocator.
// Rewrites only allocation/free calls in the sealed source, threading state.
// State fields: fail, calls, frees, live, livebytes, peakbytes, error.
// Entries at128: returned address, requested size, live flag (32-byte stride).
fn st_get(s:i64,o:i64)->i64 { __mind_load_i64(s+o) }
fn st_set(s:i64,o:i64,v:i64)->i64 { __mind_store_i64(s+o,v);v }
fn st_fill(p:i64,n:i64,b:i64)->i64 {
    let mut i:i64=0;while i<n { __mind_store_i8(p+i,b);i=i+1; }0
}
fn st_reset(s:i64,fail:i64)->i64 { st_fill(s,4096,0);st_set(s,0,fail);0 }
fn st_allocate(s:i64,n:i64)->i64 {
    let call:i64=st_get(s,8)+1;st_set(s,8,call);
    if call==st_get(s,0) { return 0; }
    if call>32 || n<1 || n>8388608 { st_set(s,48,1);return 0; }
    let base:i64=__mind_alloc(n+32);
    if base==0 { st_set(s,48,2);return 0; }
    st_fill(base,16,231);st_fill(base+16,n,165);st_fill(base+16+n,16,231);
    let row:i64=s+128+(call-1)*32;
    __mind_store_i64(row,base+16);__mind_store_i64(row+8,n);__mind_store_i64(row+16,1);
    st_set(s,24,st_get(s,24)+1);st_set(s,32,st_get(s,32)+n);
    if st_get(s,32)>st_get(s,40) { st_set(s,40,st_get(s,32)); }
    base+16
}
fn st_live(s:i64,p:i64)->i64 {
    let mut i:i64=0;while i<32 {
        let row:i64=s+128+i*32;
        if __mind_load_i64(row)==p && __mind_load_i64(row+16)==1 { return 1; }
        i=i+1;
    }0
}
fn st_release(s:i64,p:i64)->i64 {
    let mut i:i64=0;while i<32 {
        let row:i64=s+128+i*32;
        if __mind_load_i64(row)==p && __mind_load_i64(row+16)==1 {
            let n:i64=__mind_load_i64(row+8);let mut j:i64=0;
            while j<16 {
                if __mind_load_i8(p-16+j)!=231 || __mind_load_i8(p+n+j)!=231 { st_set(s,48,3); }
                j=j+1;
            }
            __mind_store_i64(row+16,0);st_set(s,16,st_get(s,16)+1);
            st_set(s,24,st_get(s,24)-1);st_set(s,32,st_get(s,32)-n);
            st_fill(p,n,171);__mind_free(p-16);return 0;
        }
        i=i+1;
    }st_set(s,48,4);0
}
fn st_account(s:i64,calls:i64,frees:i64,live:i64,bytes:i64)->i64 {
    if st_observed()==0 { return 1; }
    if st_get(s,8)!=calls || st_get(s,16)!=frees || st_get(s,24)!=live || st_get(s,32)!=bytes || st_get(s,48)!=0 { return 0; }1
}
