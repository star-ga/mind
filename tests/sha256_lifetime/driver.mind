fn st_equal(p:i64,q:i64,n:i64)->i64 {
    let mut i:i64=0;while i<n { if __mind_load_i8(p+i)!=__mind_load_i8(q+i) { return 0; }i=i+1; }1
}
fn st_sentinel(p:i64,n:i64,b:i64)->i64 {
    let mut i:i64=0;while i<n { if __mind_load_i8(p+i)!=b { return 0; }i=i+1; }1
}
fn st_input(p:i64,n:i64,mode:i64)->i64 {
