fn st_wrapper_kat(s:i64,b:bytes,want:i64)->i64 {
    st_reset(s,0);let result=st_wrapped(s,b);
    if result==0 { return 0; }
    if st_observed()==1 && st_live(s,result)!=1 { return 0; }
