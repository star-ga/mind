fn st_wrapper_refuse(s:i64,b:bytes,fail:i64)->i64 {
    st_reset(s,fail);let result=st_wrapped(s,b);
    if result!=0 { return 0; }
    let calls:i64=if fail>0 { fail } else { 0 };
    let frees:i64=if fail>0 { fail-1 } else { 0 };
