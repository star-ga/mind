# TEST-ONLY RSA-3072 key of leaf_rsa3072.der (tests/https_loopback/README.md).
# Public by design; NEVER use it for real traffic or trust.
# openssl asn1parse -genconf leaf_rsa3072_key_test_only.cnf -out key.der  (PKCS#1 RSAPrivateKey DER)
asn1=SEQUENCE:rsa_key

[rsa_key]
version=INTEGER:0
modulus=INTEGER:
publicExponent=INTEGER:65537
privateExponent=INTEGER:
prime1=INTEGER:
prime2=INTEGER:
exponent1=INTEGER:
exponent2=INTEGER:
coefficient=INTEGER:
