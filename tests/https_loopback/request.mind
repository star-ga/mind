// One std.https request for tests/std_https_openssl.rs (TEST-ONLY).
//
// The harness writes the request on stdin as six fields, each a little-endian
// i64 length followed by that many bytes padded to a multiple of 8: kind
// ("G" or "P"), URL, request header block, content type, body and the
// NUL-terminated CA bundle path (empty: the system bundle). The program calls
// https_get_with_headers or https_post_with_headers once and writes the result
// on stdout:
//   E <error> / S <status> / V <chain verdict> / C <Set-Cookie count>, one
//   line each; then per Set-Cookie header "K <len>" and its value, "P <len>"
//   and its cookie-pair (each followed by a newline); then "B <len>" and the
//   body bytes. The exit status is 0 when stdin held a well-formed request.

fn rq_b(p: i64) -> i64 {
    __mind_load_i8(p) & 255
}

// Read all of stdin into a buffer of `cap` bytes; returns {addr, len} or 0.
fn rq_read_stdin(cap: i64) -> i64 {
    let buf: i64 = __mind_alloc(cap);
    let mut got: i64 = 0;
    let mut going: i64 = 1;
    while going == 1 {
        let n: i64 = __mind_read(0, buf + got, cap - got, 0 - 1);
        if n <= 0 {
            going = 0;
        } else {
            got = got + n;
            if got >= cap {
                going = 0;
            }
        }
    }
    let rec: i64 = __mind_alloc(16);
    __mind_store_i64(rec, buf);
    __mind_store_i64(rec + 8, got);
    rec
}

// Field `idx` of the request in [buf, buf+len): {addr, len} written at out, or
// -1 when the request is malformed.
fn rq_field(buf: i64, len: i64, idx: i64, out: i64) -> i64 {
    let mut pos: i64 = 0;
    let mut i: i64 = 0;
    let mut rc: i64 = 0;
    while rc == 0 && i <= idx {
        if pos + 8 > len {
            rc = 0 - 1;
        } else {
            let n: i64 = __mind_load_i64(buf + pos);
            let padded: i64 = (n + 7) / 8 * 8;
            if n < 0 || pos + 8 + padded > len {
                rc = 0 - 1;
            } else {
                if i == idx {
                    __mind_store_i64(out, buf + pos + 8);
                    __mind_store_i64(out + 8, n);
                }
                pos = pos + 8 + padded;
            }
        }
        i = i + 1;
    }
    rc
}

// Append the decimal digits of v at dst; returns the count.
fn rq_dec(dst: i64, v: i64) -> i64 {
    let tmp: i64 = __mind_alloc(24);
    let mut n: i64 = 0;
    let mut x: i64 = v;
    let mut neg: i64 = 0;
    if x < 0 {
        neg = 1;
        x = 0 - x;
    }
    if x == 0 {
        __mind_store_i8(tmp, 48);
        n = 1;
    }
    while x > 0 {
        __mind_store_i8(tmp + n, 48 + x % 10);
        x = x / 10;
        n = n + 1;
    }
    let mut p: i64 = 0;
    if neg == 1 {
        __mind_store_i8(dst, 45);
        p = 1;
    }
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + p + i, __mind_load_i8(tmp + n - 1 - i));
        i = i + 1;
    }
    __mind_free(tmp);
    p + n
}

// "<tag> <v>\n" at dst; returns the count.
fn rq_line(dst: i64, tag: i64, v: i64) -> i64 {
    __mind_store_i8(dst, tag);
    __mind_store_i8(dst + 1, 32);
    let n: i64 = 2 + rq_dec(dst + 2, v);
    __mind_store_i8(dst + n, 10);
    n + 1
}

// "<tag> <len>\n" then the bytes then "\n" at dst; returns the count.
fn rq_blob(dst: i64, tag: i64, addr: i64, len: i64) -> i64 {
    let mut p: i64 = rq_line(dst, tag, len);
    let mut i: i64 = 0;
    while i < len {
        __mind_store_i8(dst + p + i, __mind_load_i8(addr + i));
        i = i + 1;
    }
    p = p + len;
    __mind_store_i8(dst + p, 10);
    p + 1
}

fn rq_write_all(addr: i64, len: i64) -> i64 {
    let mut off: i64 = 0;
    let mut going: i64 = 1;
    while going == 1 && off < len {
        let n: i64 = __mind_write(1, addr + off, len - off, 0 - 1);
        if n <= 0 {
            going = 0;
        } else {
            off = off + n;
        }
    }
    off
}

fn main() -> i64 {
    let input: i64 = rq_read_stdin(16777216);
    let buf: i64 = __mind_load_i64(input);
    let len: i64 = __mind_load_i64(input + 8);
    let f: i64 = __mind_alloc(96);
    let mut k: i64 = 0;
    while k < 6 {
        if rq_field(buf, len, k, f + k * 16) != 0 {
            return 2;
        }
        k = k + 1;
    }
    let kind: i64 = rq_b(__mind_load_i64(f));
    let url: i64 = __mind_load_i64(f + 16);
    let url_len: i64 = __mind_load_i64(f + 24);
    let hdr: i64 = __mind_load_i64(f + 32);
    let hdr_len: i64 = __mind_load_i64(f + 40);
    let ct: i64 = __mind_load_i64(f + 48);
    let ct_len: i64 = __mind_load_i64(f + 56);
    let body: i64 = __mind_load_i64(f + 64);
    let body_len: i64 = __mind_load_i64(f + 72);
    let mut ca: i64 = __mind_load_i64(f + 80);
    if __mind_load_i64(f + 88) == 0 {
        ca = 0;
    }
    let mut r: i64 = 0;
    if kind == 80 {
        r = https_post_with_headers(url, url_len, hdr, hdr_len, body, body_len, ct, ct_len, ca);
    } else {
        r = https_get_with_headers(url, url_len, hdr, hdr_len, ca);
    }
    let cookies: i64 = https_set_cookie_count(r);
    let out: i64 = __mind_alloc(https_body_len(r) + 262144);
    let mut p: i64 = 0;
    p = p + rq_line(out + p, 69, https_error(r));
    p = p + rq_line(out + p, 83, https_status(r));
    p = p + rq_line(out + p, 86, https_tls_verdict(r));
    p = p + rq_line(out + p, 67, cookies);
    let mut c: i64 = 0;
    while c < cookies && c < 8 {
        let v: i64 = https_set_cookie(r, c);
        p = p + rq_blob(out + p, 75, __mind_load_i64(v), __mind_load_i64(v + 8));
        __mind_free(v);
        let pr: i64 = https_set_cookie_pair(r, c);
        if pr == 0 {
            p = p + rq_blob(out + p, 80, 0, 0);
        } else {
            p = p + rq_blob(out + p, 80, __mind_load_i64(pr), __mind_load_i64(pr + 8));
            __mind_free(pr);
        }
        c = c + 1;
    }
    p = p + rq_blob(out + p, 66, https_body_addr(r), https_body_len(r));
    rq_write_all(out, p);
    https_free(r);
    0
}
