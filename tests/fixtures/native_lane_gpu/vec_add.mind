    if cuMemAlloc_v2(db as *mut i64, 32) as i64 != 0 { let _g: i64 = __mind_sys_exit_group(7); }
    if cuMemAlloc_v2(dc as *mut i64, 32) as i64 != 0 { let _g: i64 = __mind_sys_exit_group(8); }
