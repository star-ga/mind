// A libc image that DECLARES a driver row it never calls. The exit decision
// follows the declared rows, so the runtime bounds trap and the entry return
// use exit_group (231); the NEEDED list follows the called rows, so the image
// lists libc.so.6 only. The index is 3 at run time, so the trap exits 77.
extern "C" {
    fn getuid() -> i32;
    fn cuInit(flags: u32) -> i32;
}
fn main() -> i64 {
    let a = [10, 20, 30];
    let i: i64 = (getuid() as i64) * 0 + 3;
    return a[i];
}
