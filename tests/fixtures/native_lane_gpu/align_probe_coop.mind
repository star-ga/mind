// The 10-argument cuLaunchCooperativeKernel row next to the 11-argument
// cuLaunchKernel row in one frame. The even overflow count (4) takes no pad,
// the odd one (5) takes one, and each cleanup drops exactly its own block.
// Every call returns align_driver.c's frame nibble; all aligned exits 42.
extern "C" {
    fn cuLaunchKernel(f: *mut u8, gx: u32, gy: u32, gz: u32, bx: u32, by: u32, bz: u32, shared: u32, stream: *mut u8, kparams: *mut *mut u8, extra: *mut *mut u8) -> i32;
    fn cuLaunchCooperativeKernel(f: *mut u8, gx: u32, gy: u32, gz: u32, bx: u32, by: u32, bz: u32, shared: u32, stream: *mut u8, kparams: *mut *mut u8) -> i32;
}

fn mixed(f: i64, stream: i64, kp: i64, ex: i64) -> i64 {
    let x: i64 = 5;
    let a: i64 = cuLaunchCooperativeKernel(f as *mut u8, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 0 as u32, stream as *mut u8, kp as *mut *mut u8) as i64;
    if a != 0 { return 10 + a; }
    let b: i64 = cuLaunchKernel(f as *mut u8, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 0 as u32, stream as *mut u8, kp as *mut *mut u8, ex as *mut *mut u8) as i64;
    if b != 0 { return 30 + b; }
    let c: i64 = cuLaunchCooperativeKernel(f as *mut u8, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 0 as u32, stream as *mut u8, kp as *mut *mut u8) as i64;
    if c != 0 { return 50 + c; }
    if x != 5 { return 70; }
    return 0;
}

fn coop_loop(f: i64, stream: i64, kp: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 3 {
        let a: i64 = cuLaunchCooperativeKernel(f as *mut u8, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 0 as u32, stream as *mut u8, kp as *mut *mut u8) as i64;
        if a != 0 { return 10 + a; }
        i = i + 1;
    }
    return 0;
}

fn main() -> i64 {
    let fnp: i64 = __mind_alloc(8);
    __mind_store_i64(fnp, 3);
    let stream: i64 = __mind_alloc(8);
    __mind_store_i64(stream, 1);
    let slot: i64 = __mind_alloc(8);
    __mind_store_i64(slot, 1);
    let kp: i64 = __mind_alloc(8);
    __mind_store_i64(kp, slot);
    let ex: i64 = __mind_alloc(8);
    __mind_store_i64(ex, slot);
    let f: i64 = __mind_load_i64(fnp);
    let a: i64 = cuLaunchCooperativeKernel(f as *mut u8, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 0 as u32, stream as *mut u8, kp as *mut *mut u8) as i64;
    if a != 0 { return 100 + a; }
    let b: i64 = cuLaunchCooperativeKernel(f as *mut u8, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 1 as u32, 0 as u32, stream as *mut u8, kp as *mut *mut u8) as i64;
    if b != 0 { return 120 + b; }
    let m: i64 = mixed(f, stream, kp, ex);
    if m != 0 { return 140 + m; }
    let l: i64 = coop_loop(f, stream, kp);
    if l != 0 { return 220 + l; }
    return 42;
}
