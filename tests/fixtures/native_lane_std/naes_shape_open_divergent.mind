import std.sha256;

// naes_shape_closed_vendored plus a call into the std seed (`sha256`) outside
// every loop. The image is open, so it cannot omit the seed: the divergent
// private collision still refuses closure.std_symbol_collision.

fn sha_mask32(x: i64) -> i64 {
    x & 4294967295
}

// sha_rotr32 — right-rotate in the 32-bit domain.
fn sha_rotr32(x: i64, n: i64) -> i64 {
    ((x >> n) | (x << (32 - n))) & 4294967295
}

// sha_shr32 — logical right-shift in the 32-bit domain.
fn sha_shr32(x: i64, n: i64) -> i64 {
    (x >> n) & 4294967295
}

// ---------------------------------------------------------------------------
// FIPS 180-4 §4.1.2 Boolean functions
// ---------------------------------------------------------------------------

// sha_ch(x,y,z) = (x AND y) XOR (NOT x AND z).
// NOT x in the 32-bit domain: 4294967295 - (x & 4294967295).
fn sha_ch(x: i64, y: i64, z: i64) -> i64 {
    let notx: i64 = 4294967295 - (x & 4294967295);
    sha_mask32((x & y) ^ (notx & z))
}

// sha_maj(x,y,z) = (x AND y) XOR (x AND z) XOR (y AND z).
fn sha_maj(x: i64, y: i64, z: i64) -> i64 {
    sha_mask32((x & y) ^ (x & z) ^ (y & z))
}

// Σ0(a) = ROTR2(a) XOR ROTR13(a) XOR ROTR22(a).
fn sha_bsig0(x: i64) -> i64 {
    sha_mask32(sha_rotr32(x, 2) ^ sha_rotr32(x, 13) ^ sha_rotr32(x, 22))
}

// Σ1(e) = ROTR6(e) XOR ROTR11(e) XOR ROTR25(e).
fn sha_bsig1(x: i64) -> i64 {
    sha_mask32(sha_rotr32(x, 6) ^ sha_rotr32(x, 11) ^ sha_rotr32(x, 25))
}

// σ0(w) = ROTR7(w) XOR ROTR18(w) XOR SHR3(w).
fn sha_ssig0(x: i64) -> i64 {
    sha_mask32(sha_rotr32(x, 7) ^ sha_rotr32(x, 18) ^ sha_shr32(x, 3))
}

// σ1(w) = ROTR17(w) XOR ROTR19(w) XOR SHR10(w).
fn sha_ssig1(x: i64) -> i64 {
    sha_mask32(sha_rotr32(x, 17) ^ sha_rotr32(x, 19) ^ sha_shr32(x, 10))
}

// ---------------------------------------------------------------------------
// Round constants K[0..63] — FIPS 180-4 §4.2.2
//
// First 32 bits of the fractional parts of the cube roots of the first
// 64 primes, expressed in decimal.  sha_k_word(i) returns K[i].
// ---------------------------------------------------------------------------

