// ---------------------------------------------------------------------------
// Initial hash values H0..H7 — FIPS 180-4 §5.3.3
//
// First 32 bits of the fractional parts of the square roots of primes 2..19,
// expressed in decimal.
// ---------------------------------------------------------------------------

fn sha_h_init(i: i64) -> i64 {
    if i == 0 {
        return 1779033703;
    }
    if i == 1 {
        return 3144134277;
    }
    if i == 2 {
        return 1013904242;
    }
    if i == 3 {
        return 2773480762;
    }
    if i == 4 {
        return 1359893119;
    }
    if i == 5 {
        return 2600822924;
    }
    if i == 6 {
        return 528734635;
    }
    1541459225
}

// ---------------------------------------------------------------------------
// W-schedule helpers — 64-word schedule stored stride-8 (like Vec elements).
// ---------------------------------------------------------------------------

fn sha_w_get(w_addr: i64, i: i64) -> i64 {
    __mind_load_i64(w_addr + i * 8)
}

fn sha_w_set(w_addr: i64, i: i64, v: i64) -> i64 {
    __mind_store_i64(w_addr + i * 8, v);
    0
}

// ---------------------------------------------------------------------------
// sha_compress_block — process one 64-byte block.
//
// block_addr: pointer to 64 bytes of message (one byte per offset).
// h_addr: pointer to 8*8=64-byte heap region holding h[0..7] stride-8.
// Returns 0.
// ---------------------------------------------------------------------------

fn sha_compress_block(block_addr: i64, h_addr: i64) -> i64 {
    // Allocate W schedule: 64 words, stride-8 → 512 bytes.
    let w_addr: i64 = __mind_alloc(512);

    // W[0..15]: pack four consecutive message bytes (big-endian) into each
    // 32-bit word.
    let mut wi: i64 = 0;
    while wi < 16 {
        let base: i64 = wi * 4;
        let b0: i64 = __mind_load_i8(block_addr + base + 0);
        let b1: i64 = __mind_load_i8(block_addr + base + 1);
        let b2: i64 = __mind_load_i8(block_addr + base + 2);
        let b3: i64 = __mind_load_i8(block_addr + base + 3);
        let word: i64 = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
        sha_w_set(w_addr, wi, word);
        wi = wi + 1;
    }

    // W[16..63]: message schedule extension.
    let mut wj: i64 = 16;
    while wj < 64 {
        let s0: i64 = sha_ssig0(sha_w_get(w_addr, wj - 15));
        let s1: i64 = sha_ssig1(sha_w_get(w_addr, wj - 2));
        let val: i64 = sha_mask32(sha_w_get(w_addr, wj - 16) + s0 + sha_w_get(w_addr, wj - 7) + s1);
        sha_w_set(w_addr, wj, val);
        wj = wj + 1;
    }

    // Initialise working variables from h[0..7].
    let mut wa: i64 = __mind_load_i64(h_addr + 0 * 8);
    let mut wb: i64 = __mind_load_i64(h_addr + 1 * 8);
    let mut wc: i64 = __mind_load_i64(h_addr + 2 * 8);
    let mut wd: i64 = __mind_load_i64(h_addr + 3 * 8);
    let mut we: i64 = __mind_load_i64(h_addr + 4 * 8);
    let mut wf: i64 = __mind_load_i64(h_addr + 5 * 8);
    let mut wg: i64 = __mind_load_i64(h_addr + 6 * 8);
    let mut wh: i64 = __mind_load_i64(h_addr + 7 * 8);

    // 64-round compression loop.
    let mut rnd: i64 = 0;
    while rnd < 64 {
        let t1: i64 = sha_mask32(wh + sha_bsig1(we) + sha_ch(we, wf, wg) + sha_k_word(rnd) + sha_w_get(w_addr, rnd));
        let t2: i64 = sha_mask32(sha_bsig0(wa) + sha_maj(wa, wb, wc));
        wh = wg;
        wg = wf;
        wf = we;
        we = sha_mask32(wd + t1);
        wd = wc;
        wc = wb;
        wb = wa;
        wa = sha_mask32(t1 + t2);
        rnd = rnd + 1;
    }

    // Add compressed chunk back into H.
    __mind_store_i64(h_addr + 0 * 8, sha_mask32(__mind_load_i64(h_addr + 0 * 8) + wa));
    __mind_store_i64(h_addr + 1 * 8, sha_mask32(__mind_load_i64(h_addr + 1 * 8) + wb));
    __mind_store_i64(h_addr + 2 * 8, sha_mask32(__mind_load_i64(h_addr + 2 * 8) + wc));
    __mind_store_i64(h_addr + 3 * 8, sha_mask32(__mind_load_i64(h_addr + 3 * 8) + wd));
    __mind_store_i64(h_addr + 4 * 8, sha_mask32(__mind_load_i64(h_addr + 4 * 8) + we));
    __mind_store_i64(h_addr + 5 * 8, sha_mask32(__mind_load_i64(h_addr + 5 * 8) + wf));
    __mind_store_i64(h_addr + 6 * 8, sha_mask32(__mind_load_i64(h_addr + 6 * 8) + wg));
    __mind_store_i64(h_addr + 7 * 8, sha_mask32(__mind_load_i64(h_addr + 7 * 8) + wh));

    0
}

// Byte copy, last byte first; returns the count. Not std/toml.mind's body.
fn toml_copy_bytes(src: i64, dst: i64, n: i64) -> i64 {
    let mut k: i64 = n;
    while k > 0 {
        k = k - 1;
        __mind_store_i8(dst + k, __mind_load_i8(src + k))
    }
    n
}

// Monotonic nanoseconds into caller-owned 16-byte scratch.
fn clock_ns(ts: i64) -> i64 {
    let rc: i64 = __mind_sys_clock_gettime(1, ts);
    if rc < 0 {
        return 0;
    }
    __mind_load_i64(ts) * 1000000000 + __mind_load_i64(ts + 8)
}

// SHA-256("abc") = ba7816bf...f20015ad, word i of the digest.
fn want_word(i: i64) -> i64 {
    if i == 0 {
        return 3128432319;
    }
    if i == 1 {
        return 2399260650;
    }
    if i == 2 {
        return 1094795486;
    }
    if i == 3 {
        return 1571693091;
    }
    if i == 4 {
        return 2953011619;
    }
    if i == 5 {
        return 2518121116;
    }
    if i == 6 {
        return 3021012833;
    }
    4060091821
}

fn main() -> i64 {
    let ts: i64 = __mind_alloc(16);
    let msg: i64 = __mind_alloc(3);
    let block: i64 = __mind_alloc(64);
    let h: i64 = __mind_alloc(64);
    let out: i64 = __mind_alloc(32);
    __mind_store_i8(msg + 0, 97);
    __mind_store_i8(msg + 1, 98);
    __mind_store_i8(msg + 2, 99);
    let mut z: i64 = 0;
    while z < 64 {
        __mind_store_i8(block + z, 0);
        z = z + 1;
    }
    let copied: i64 = toml_copy_bytes(msg, block, 3);
    __mind_store_i8(block + 3, 128);
    __mind_store_i8(block + 63, 24);
    let mut hi: i64 = 0;
    while hi < 8 {
        __mind_store_i64(h + hi * 8, sha_h_init(hi));
        hi = hi + 1;
    }
    sha_compress_block(block, h);
    let mut di: i64 = 0;
    while di < 8 {
        let word: i64 = __mind_load_i64(h + di * 8);
        __mind_store_i8(out + di * 4 + 0, (word >> 24) & 255);
        __mind_store_i8(out + di * 4 + 1, (word >> 16) & 255);
        __mind_store_i8(out + di * 4 + 2, (word >> 8) & 255);
        __mind_store_i8(out + di * 4 + 3, word & 255);
        di = di + 1;
    }
    let mut bad: i64 = 3 - copied;
    let mut i: i64 = 0;
    while i < 32 {
        let expect: i64 = (want_word(i / 4) >> (24 - 8 * (i % 4))) & 255;
        if __mind_load_i8(out + i) != expect {
            bad = bad + 1;
        }
        i = i + 1;
    }
    let mut last: i64 = 0;
    let mut t: i64 = 0;
    while t < 4 {
        let now: i64 = clock_ns(ts);
        if now < last {
            bad = bad + 1;
        }
        last = now;
        t = t + 1;
    }
    let rc: i64 = sha256(msg, 3, out);
    return bad + rc;
}
