import std.sha256;

// std.sha256's `sha256` reached from a loop. Its scratch is freed on every
// pass; a free in a loop builds and reclaims. The message is empty, so `out`
// holds the digest of the empty string after each pass; it is written once.

fn main() -> i64 {
    let msg: i64 = __mind_alloc(8);
    let out: i64 = __mind_alloc(32);
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < 3 {
        let rc: i64 = sha256(msg, 0, out);
        acc = acc + rc + __mind_load_i8(out);
        i = i + 1;
    }
    __mind_write(1, out, 32, 0 - 1);
    return acc;
}
