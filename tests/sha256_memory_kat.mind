    }
    if sha256_checked(input, 1, 0) != -1 {
        return sm_fail(205);
    }
    if sha256_checked(input, 1, 9223372036854775776) != -1 {
        return sm_fail(206);
    }
    i = 0;
    while i < 32 {
        if __mind_load_i8(output + 8 + i) != 90 {
            return sm_fail(210);
        }
        i = i + 1;
    }
    if sm_guard(output) != 1 {
        return sm_fail(211);
    }
    // Overlap is valid: every input byte must be consumed before output writes.
    sm_fill(input, 129);
    if sha256_checked(input, 129, input + 0) != 0 {
