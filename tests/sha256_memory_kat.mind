// Exact known-answer and failure-contract checks for std/sha256.mind.
// Assemble after the module, without importing a separately bundled std.sha256.
// Expected digests are fixed bytes; no external hash/runtime verifier is used.
fn sm_fail(id: i64) -> i64 {
    print(id);
    return 1;
}
fn sm_word(p: i64, off: i64, expected: i64) -> i64 {
    if __mind_load_i64(p + off) != expected {
        return 0;
    }
    return 1;
}
fn sm_guard(p: i64) -> i64 {
    if __mind_load_i64(p) != 714134952123 || __mind_load_i64(p + 40) != 714134952123 {
        return 0;
    }
    return 1;
}
fn sm_fill(p: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(p + i, (i * 37 + 11) & 255);
        i = i + 1;
    }
    return 0;
}
pub fn main() -> i64 {
    let input: i64 = __mind_alloc(1048576);
    let output: i64 = __mind_alloc(48);
