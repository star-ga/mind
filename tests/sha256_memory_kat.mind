    if sm_word(output + 8, 0, 5653587436571836783) != 1 || sm_word(output + 8, 8, 5102954681448860001) != 1 || sm_word(output + 8, 16, -1514265681278277689) != 1 || sm_word(output + 8, 24, -8609768105081169693) != 1 || sm_guard(output) != 1 {
        return sm_fail(125);
    }
    if sha256_checked(input, 1048576, output + 8) != 0 {
        return sm_fail(26);
    }
    if sm_word(output + 8, 0, 4653730330120651066) != 1 || sm_word(output + 8, 8, 599815076629812676) != 1 || sm_word(output + 8, 16, -1611306539877105421) != 1 || sm_word(output + 8, 24, 3261701431063903622) != 1 || sm_guard(output) != 1 {
        return sm_fail(126);
    }
    // Raw ABI rejects invalid arithmetic without changing any output byte.
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(output + 8 + i, 90);
        i = i + 1;
    }
    if sha256_checked(input, -1, output + 8) != -1 {
        return sm_fail(200);
    }
    if sha256_checked(input, 1152921504606846976, output + 8) != -1 {
        return sm_fail(201);
    }
    if sha256_checked(0, 1, output + 8) != -1 {
        return sm_fail(202);
    }
    if sha256_checked(-1, 0, output + 8) != -1 {
        return sm_fail(203);
    }
    if sha256_checked(9223372036854775800, 8, output + 8) != -1 {
