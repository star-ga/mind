    if sm_word(output + 8, 0, 1165512232190755918) != 1 || sm_word(output + 8, 8, 4924467516824704717) != 1 || sm_word(output + 8, 16, 6515429063933902369) != 1 || sm_word(output + 8, 24, -1439619136232728524) != 1 || sm_guard(output) != 1 {
