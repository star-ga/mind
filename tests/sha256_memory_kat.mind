    if sm_word(output + 8, 0, -194702309423793409) != 1 || sm_word(output + 8, 8, 6827422774722278101) != 1 || sm_word(output + 8, 16, -4408925111459267864) != 1 || sm_word(output + 8, 24, 5169750524620318907) != 1 || sm_guard(output) != 1 {
        return sm_fail(123);
