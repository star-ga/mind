    }
    if sm_word(input + 0, 0, -1676747210729515185) != 1 || sm_word(input + 0, 8, 6536804535814027117) != 1 || sm_word(input + 0, 16, 7900697469709014257) != 1 || sm_word(input + 0, 24, 9211332578240723155) != 1 {
