// Driver of the allocator row default/x25519_chain (self_host_native_alloc_bounded_smoke.py).
// std.x25519 is not a native seed module, so the row puts the source of std/x25519.mind in
// the user unit and this driver after it. RFC 7748 section 5.2, iterated: k = u = 9, then
// 1000 times (k, u) = (x25519(k, u), k). Writes the 32 bytes of k (684cf59b...532c51) and
// exits with the count of calls that did not return 0.

fn copy32(dst: i64, src: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 32 {
        __mind_store_i8(dst + j, __mind_load_i8(src + j));
        j = j + 1;
    }
    return 0;
}

fn zero32(dst: i64) -> i64 {
    let mut j: i64 = 0;
    while j < 32 {
        __mind_store_i8(dst + j, 0);
        j = j + 1;
    }
    return 0;
}

fn main() -> i64 {
    let k: i64 = __mind_alloc(32);
    let u: i64 = __mind_alloc(32);
    let o: i64 = __mind_alloc(32);
    zero32(k);
    zero32(u);
    __mind_store_i8(k, 9);
    __mind_store_i8(u, 9);
    let mut i: i64 = 0;
    let mut bad: i64 = 0;
    while i < 1000 {
        let rc: i64 = x25519(k, u, o);
        if rc != 0 {
            bad = bad + 1;
        }
        copy32(u, k);
        copy32(k, o);
        i = i + 1;
    }
    __mind_write(1, k, 32, 0 - 1);
    return bad;
}
