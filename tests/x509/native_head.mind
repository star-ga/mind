// tests/x509/native_main_head.mind + native_main_body.mind — NATIVE-backend
// harness for x509_verify_server_chain.  build_native.sh concatenates the std
// crypto sources (imports stripped) + this head + the hex-embedded manifest +
// this body, producing one self-contained main.mind (no runtime IO in the
// native backend, so fixtures are embedded).

fn nat_ld(b: i64) -> i64 {
    __mind_load_i64(b)
}

fn nat_cpy(dst: i64, src: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + i, __mind_load_i8(src + i));
        i = i + 1;
    }
    0
}

// hex digit value: '0'..'9' -> 0..9, 'a'..'f' -> 10..15
fn nat_hexval(c: i64) -> i64 {
    if c >= 97 {
        return c - 87;
    }
    if c >= 65 {
        return c - 55;
    }
    c - 48
}

// build a chain/anchor blob at ws from the manifest cursor at src+pos;
// returns the cursor position after the blob (records are 8-byte aligned).
fn nat_blob(src: i64, pos: i64, ws: i64) -> i64 {
    let cnt: i64 = nat_ld(src + pos);
    __mind_store_i64(ws, cnt);
    let mut p: i64 = pos + 8;
    let mut off: i64 = 8 + 16 * cnt;
    let mut i: i64 = 0;
    while i < cnt {
        let ln: i64 = nat_ld(src + p);
        __mind_store_i64(ws + 8 + i * 16, off);
        __mind_store_i64(ws + 16 + i * 16, ln);
        nat_cpy(ws + off, src + p + 8, ln);
        off = off + ln;
        p = p + 8 + ln;
        let pad: i64 = (8 - ln % 8) % 8;
        p = p + pad;
        i = i + 1;
    }
    p
}

fn main() -> i64 {
